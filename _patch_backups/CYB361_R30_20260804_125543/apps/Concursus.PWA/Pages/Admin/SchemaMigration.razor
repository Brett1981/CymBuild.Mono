    private static bool HasEffectiveDefinitionMatch(SchemaMigrationObjectComparisonModel row)
    {
        if (!row.DifferenceType.Equals("Different", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return NormalizeSchemaDefinition(row.SourceDefinition)
            .Equals(NormalizeSchemaDefinition(row.TargetDefinition), StringComparison.Ordinal);
    }

    private static MarkupString DefinitionDiffMarkup(string definition, string otherDefinition)
    {
        if (string.IsNullOrWhiteSpace(definition))
        {
            return new MarkupString("<div class=\"schema-diff-empty\">No definition captured.</div>");
        }

        var lines = SplitDefinitionPreviewLines(definition);
        var otherLines = SplitDefinitionPreviewLines(otherDefinition);
        var alignedLines = AlignDefinitionLines(lines, otherLines);
        var fullNormalisedMatch = NormalizeSchemaDefinition(definition).Equals(NormalizeSchemaDefinition(otherDefinition), StringComparison.Ordinal);

        var html = new StringBuilder();
        html.Append("<div class=\"schema-diff-lines\">");

        var lineNumber = 0;
        foreach (var pair in alignedLines)
        {
            if (pair.CurrentLine is not null)
            {
                lineNumber++;
            }

            var currentLine = pair.CurrentLine ?? string.Empty;
            var otherLine = pair.OtherLine ?? string.Empty;
            var currentNormalised = NormalizeSchemaDefinition(currentLine);
            var otherNormalised = NormalizeSchemaDefinition(otherLine);
            var changed = !fullNormalisedMatch
                && !currentNormalised.Equals(otherNormalised, StringComparison.Ordinal)
                && !(string.IsNullOrWhiteSpace(currentNormalised) && string.IsNullOrWhiteSpace(otherNormalised));

            html.Append(changed ? "<div class=\"schema-diff-line changed\"" : "<div class=\"schema-diff-line\"");
            html.Append(" data-line=\"");
            html.Append(pair.CurrentLine is null ? string.Empty : lineNumber.ToString());
            html.Append("\"><code>");
            html.Append(changed
                ? InlineDefinitionDiffMarkup(currentLine, otherLine)
                : WebUtility.HtmlEncode(currentLine.Length == 0 ? " " : currentLine));
            html.Append("</code></div>");
        }

        html.Append("</div>");
        return new MarkupString(html.ToString());
    }

    private static List<DefinitionLinePair> AlignDefinitionLines(IReadOnlyList<string> currentLines, IReadOnlyList<string> otherLines)
    {
        var result = new List<DefinitionLinePair>();
        var currentIndex = 0;
        var otherIndex = 0;

        while (currentIndex < currentLines.Count || otherIndex < otherLines.Count)
        {
            if (currentIndex >= currentLines.Count)
            {
                result.Add(new DefinitionLinePair(null, otherLines[otherIndex++]));
                continue;
            }

            if (otherIndex >= otherLines.Count)
            {
                result.Add(new DefinitionLinePair(currentLines[currentIndex++], null));
                continue;
            }

            var currentLine = currentLines[currentIndex];
            var otherLine = otherLines[otherIndex];
            var currentNormalised = NormalizeSchemaDefinition(currentLine);
            var otherNormalised = NormalizeSchemaDefinition(otherLine);

            if (currentNormalised.Equals(otherNormalised, StringComparison.Ordinal))
            {
                result.Add(new DefinitionLinePair(currentLine, otherLine));
                currentIndex++;
                otherIndex++;
                continue;
            }

            var nextCurrentMatchesOther = currentIndex + 1 < currentLines.Count
                && NormalizeSchemaDefinition(currentLines[currentIndex + 1]).Equals(otherNormalised, StringComparison.Ordinal);
            var currentMatchesNextOther = otherIndex + 1 < otherLines.Count
                && currentNormalised.Equals(NormalizeSchemaDefinition(otherLines[otherIndex + 1]), StringComparison.Ordinal);

            if (nextCurrentMatchesOther && !currentMatchesNextOther)
            {
                result.Add(new DefinitionLinePair(currentLine, null));
                currentIndex++;
                continue;
            }

            if (currentMatchesNextOther && !nextCurrentMatchesOther)
            {
                result.Add(new DefinitionLinePair(null, otherLine));
                otherIndex++;
                continue;
            }

            result.Add(new DefinitionLinePair(currentLine, otherLine));
            currentIndex++;
            otherIndex++;
        }

        return result;
    }

    private static string InlineDefinitionDiffMarkup(string currentLine, string otherLine)
    {
        if (string.IsNullOrEmpty(currentLine))
        {
            return "<mark class=\"schema-diff-token\"> </mark>";
        }

        var currentNormalised = NormalizeSchemaDefinition(currentLine);
        var otherNormalised = NormalizeSchemaDefinition(otherLine);
        if (string.IsNullOrWhiteSpace(currentNormalised) || string.IsNullOrWhiteSpace(otherNormalised))
        {
            return HighlightSemanticLine(currentLine);
        }

        var currentTokens = TokenizeDefinitionLine(currentLine);
        var otherTokenKeys = TokenizeDefinitionLine(otherLine)
            .Select(x => x.Normalised)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();

        var matchedCurrentIndexes = FindMatchedTokenIndexes(currentTokens.Select(x => x.Normalised).ToList(), otherTokenKeys);
        var html = new StringBuilder();
        for (var i = 0; i < currentTokens.Count; i++)
        {
            var token = currentTokens[i];
            var encoded = WebUtility.HtmlEncode(token.Text);
            if (!string.IsNullOrWhiteSpace(token.Normalised) && !matchedCurrentIndexes.Contains(i))
            {
                html.Append("<mark class=\"schema-diff-token\">");
                html.Append(encoded);
                html.Append("</mark>");
            }
            else
            {
                html.Append(encoded);
            }
        }

        return html.ToString();
    }

    private static HashSet<int> FindMatchedTokenIndexes(IReadOnlyList<string> currentTokens, IReadOnlyList<string> otherTokens)
    {
        var currentSemanticIndexes = currentTokens
            .Select((value, index) => new { value, index })
            .Where(x => !string.IsNullOrWhiteSpace(x.value))
            .ToList();
        var otherSemanticTokens = otherTokens.Where(x => !string.IsNullOrWhiteSpace(x)).ToList();
        var matched = new HashSet<int>();

        var currentCount = currentSemanticIndexes.Count;
        var otherCount = otherSemanticTokens.Count;
        if (currentCount == 0 || otherCount == 0)
        {
            return matched;
        }

        var lengths = new int[currentCount + 1, otherCount + 1];
        for (var i = currentCount - 1; i >= 0; i--)
        {
            for (var j = otherCount - 1; j >= 0; j--)
            {
                lengths[i, j] = currentSemanticIndexes[i].value.Equals(otherSemanticTokens[j], StringComparison.Ordinal)
                    ? lengths[i + 1, j + 1] + 1
                    : Math.Max(lengths[i + 1, j], lengths[i, j + 1]);
            }
        }

        var currentPointer = 0;
        var otherPointer = 0;
        while (currentPointer < currentCount && otherPointer < otherCount)
        {
            if (currentSemanticIndexes[currentPointer].value.Equals(otherSemanticTokens[otherPointer], StringComparison.Ordinal))
            {
                matched.Add(currentSemanticIndexes[currentPointer].index);
                currentPointer++;
                otherPointer++;
            }
            else if (lengths[currentPointer + 1, otherPointer] >= lengths[currentPointer, otherPointer + 1])
            {
                currentPointer++;
            }
            else
            {
                otherPointer++;
            }
        }

        return matched;
    }

    private static string HighlightSemanticLine(string line)
    {
        var tokens = TokenizeDefinitionLine(line);
        var html = new StringBuilder();
        foreach (var token in tokens)
        {
            var encoded = WebUtility.HtmlEncode(token.Text);
            if (string.IsNullOrWhiteSpace(token.Normalised))
            {
                html.Append(encoded);
            }
            else
            {
                html.Append("<mark class=\"schema-diff-token\">");
                html.Append(encoded);
                html.Append("</mark>");
            }
        }

        return html.ToString();
    }

    private static List<DefinitionToken> TokenizeDefinitionLine(string line)
    {
        var tokens = new List<DefinitionToken>();
        if (line.Length == 0)
        {
            return tokens;
        }

        var token = new StringBuilder();
        TokenKind? kind = null;

        foreach (var ch in line)
        {
            var nextKind = char.IsLetterOrDigit(ch) || ch == '_' ? TokenKind.Word
                : char.IsWhiteSpace(ch) ? TokenKind.Whitespace
                : TokenKind.Symbol;

            if (kind is null || kind == nextKind)
            {
                token.Append(ch);
                kind = nextKind;
                continue;
            }

            AddDefinitionToken(tokens, token.ToString(), kind.Value);
            token.Clear();
            token.Append(ch);
            kind = nextKind;
        }

        if (kind is not null)
        {
            AddDefinitionToken(tokens, token.ToString(), kind.Value);
        }

        return tokens;
    }

    private static void AddDefinitionToken(ICollection<DefinitionToken> tokens, string text, TokenKind kind)
    {
        var normalised = kind == TokenKind.Whitespace || text is "[" or "]"
            ? string.Empty
            : NormalizeSchemaDefinition(text);
        tokens.Add(new DefinitionToken(text, normalised));
    }

    private static IReadOnlyList<string> SplitDefinitionPreviewLines(string definition) =>
        DefinitionPreview(definition).Replace("\r\n", "\n", StringComparison.Ordinal).Replace('\r', '\n').Split('\n');

    private sealed record DefinitionLinePair(string? CurrentLine, string? OtherLine);
    private sealed record DefinitionToken(string Text, string Normalised);
    private enum TokenKind
    {
        Word,
        Whitespace,
        Symbol
    }

    private static string DefinitionPreview(string definition)
    {
        if (string.IsNullOrWhiteSpace(definition))
        {
            return string.Empty;
        }

        return definition.Length <= 8000 ? definition : definition[..8000] + "\n... truncated in UI preview ...";
    }

    private static string NormalizeSchemaDefinition(string definition)
    {
        if (string.IsNullOrWhiteSpace(definition))
        {
            return string.Empty;
        }

        var builder = new StringBuilder(definition.Length);
        var inString = false;
        var i = 0;

        while (i < definition.Length)
        {
            var ch = definition[i];

            if (!inString && ch == '-' && i + 1 < definition.Length && definition[i + 1] == '-')
            {
                i += 2;
                while (i < definition.Length && definition[i] != '\r' && definition[i] != '\n')
                {
                    i++;
                }
                continue;
            }

            if (!inString && ch == '/' && i + 1 < definition.Length && definition[i + 1] == '*')
            {
                i += 2;
                while (i + 1 < definition.Length && !(definition[i] == '*' && definition[i + 1] == '/'))
                {
                    i++;
                }
                i = Math.Min(i + 2, definition.Length);
                continue;
            }

            if (ch == '\'')
            {
                builder.Append(ch);
                if (inString && i + 1 < definition.Length && definition[i + 1] == '\'')
                {
                    builder.Append(definition[i + 1]);
                    i += 2;
                    continue;
                }

                inString = !inString;
                i++;
                continue;
            }

            if (inString)
            {
                builder.Append(ch);
                i++;
                continue;
            }

            if (char.IsWhiteSpace(ch) || ch is '[' or ']')
            {
                i++;
                continue;
            }

            builder.Append(char.ToUpperInvariant(ch));
            i++;
        }

        return builder.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        if (schemaMigrationWorkbenchModule is not null)
        {
            try
            {
                await schemaMigrationWorkbenchModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Browser disconnected during component disposal; no user-facing action required.
            }
        }
    }


    }

    private async Task LoadObjectDetailAsync(SchemaMigrationObjectComparisonModel row)
    {
        if (!HasRunGuid || row.ComparisonGuid == Guid.Empty)
        {
            shouldBindDefinitionScrollSync = true;
            return;
        }

        var detail = await CurrentFormHelper.SchemaMigrationObjectDetailAsync(
            CurrentRunGuid(),
            row.ComparisonGuid,
            TargetServerName,
            TargetDatabaseName);

        if (detail is not null && SelectedObjectRow?.ComparisonGuid == row.ComparisonGuid)
        {
            // Preserve unsaved checkbox state held by the lightweight list row.
            detail.IsSelected = row.IsSelected;
            detail.HasExplicitSelection = row.HasExplicitSelection;
            SelectedObjectRow = detail;
        }

        shouldBindDefinitionScrollSync = true;
    }


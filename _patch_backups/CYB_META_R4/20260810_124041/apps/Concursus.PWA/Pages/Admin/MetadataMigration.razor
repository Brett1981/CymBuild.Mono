    private async Task AcceptApplyPreviewAsync() => await ExecuteAsync(async () =>
    {
        if (ApplyPreview is null)
        {
            throw new InvalidOperationException("Generate an apply preview before accepting it for deployment.");
        }

        var acceptance = await CurrentFormHelper.MetadataMigrationApplyPreviewAcceptAsync(
            CurrentRunGuid(),
            ApplyPreview.ApplySelectedOnly,
            ApplyPreview.PreviewFingerprint,
            TargetServerName,
            TargetDatabaseName);

        ApplyPreview.IsAccepted = acceptance.IsAccepted;
        ApplyPreview.AcceptedOnUtcText = acceptance.AcceptedOnUtcText;
        ApplyPreview.AcceptedByUserId = acceptance.AcceptedByUserId;
        ApplyPreviewReviewed = acceptance.IsAccepted
            && acceptance.PreviewFingerprint.Equals(ApplyPreview.PreviewFingerprint, StringComparison.OrdinalIgnoreCase)
            && acceptance.ApplySelectedOnly == ApplyPreview.ApplySelectedOnly;

        await RefreshDashboardCoreAsync(false);
        Message = acceptance.Message;
    }, busyMessage: "Accepting the reviewed metadata preview for deployment. Please wait.");


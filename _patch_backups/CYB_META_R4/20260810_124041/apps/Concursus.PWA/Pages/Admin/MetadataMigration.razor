    private bool HasCurrentIdentityMapReview()
    {
        var logs = Dashboard?.ExecutionLog;
        if (logs is null || logs.Count == 0)
        {
            return false;
        }

        var latestBuildIndex = -1;
        var latestReviewIndex = -1;

        for (var index = 0; index < logs.Count; index++)
        {
            var log = logs[index];
            if (log.StepName.Equals("BuildIdentityMap", StringComparison.OrdinalIgnoreCase))
            {
                latestBuildIndex = index;
            }

            if (log.StepName.Equals("IdentityMapReview", StringComparison.OrdinalIgnoreCase)
                && log.StepStatus.Equals("Reviewed", StringComparison.OrdinalIgnoreCase))
            {
                latestReviewIndex = index;
            }
        }

        return latestReviewIndex >= 0 && latestReviewIndex > latestBuildIndex;
    }

    private string GetNextRunActionText()
    {
        if (!HasRunGuid)
        {
            return "Create or select a metadata migration run to begin.";
        }

        if (!HasDashboardLoaded)
        {
            return "Refresh the dashboard to load the latest run state.";
        }

        if (!HasStagedMetadata)
        {
            return "Next: stage the selected run. This may take a while for large metadata sets.";
        }

        if (ValidationErrorCount > 0)
        {
            return "Next: resolve validation errors before applying metadata.";
        }

        if (!HasValidationCompleted)
        {
            return "Next: validate the staged metadata.";
        }

        if (!HasIdentityMapBuilt)
        {
            return "Next: build the identity map for lookup and relationship mapping.";
        }

        if (IdentityMapNeedsReview)
        {
            return "Next: review identity map rows classified as review needed, then mark the identity map as reviewed.";
        }

        if (ApplyPreview is null)
        {
            return "Next: generate an apply preview for selected records or all valid records.";
        }

        if (IsApplyPreviewBlocked)
        {
            return "Next: resolve preview blockers before applying metadata.";
        }

        if (!ApplyPreviewReviewed)
        {
            return "Next: review the preview and accept that exact fingerprint for deployment.";
        }

        if (HasAppliedRun)
        {
            return "This run has been applied. Use Audit to review the execution log.";
        }

        return "Ready: the selected apply path is available through the guarded backend apply procedure.";
    }

    private static bool HasUsefulDateText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return false;
        }

        var trimmedValue = value.Trim();
        return !trimmedValue.Equals("-", StringComparison.OrdinalIgnoreCase)
            && !trimmedValue.Equals("N/A", StringComparison.OrdinalIgnoreCase)
            && !trimmedValue.StartsWith("01/01/0001", StringComparison.OrdinalIgnoreCase);
    }

    private static string BadgeClass(string text)
    {
        var normalized = text ?? string.Empty;
        if (normalized.Equals("Fail", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Failed", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Blocked", StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (normalized.Equals("Warn", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Warning", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Skip", StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        if (normalized.Equals("Applied", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Complete", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Completed", StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        return "info";
    }

    private static string DifferenceBadgeClass(string differenceType) => differenceType switch
    {
        DifferenceInsert => "success",
        DifferenceUpdate => "info",
        DifferenceNoChange => "muted",
        _ => "warning"
    };

    private static string GetValue(MetadataMigrationDiffRowModel row, string key)
    {
        if (row.SourceValues.TryGetValue(key, out var sourceValue) && !string.IsNullOrWhiteSpace(sourceValue))
        {
            return sourceValue;
        }

        return row.TargetValues.TryGetValue(key, out var targetValue) ? targetValue : string.Empty;
    }

    private static string GetSourceValue(MetadataMigrationDiffRowModel row, string key) => row.SourceValues.TryGetValue(key, out var value) ? value : string.Empty;
    private static string GetTargetValue(MetadataMigrationDiffRowModel row, string key) => row.TargetValues.TryGetValue(key, out var value) ? value : string.Empty;

    private static IReadOnlyList<string> AllColumnNames(MetadataMigrationDiffRowModel row) => row.SourceValues.Keys
        .Union(row.TargetValues.Keys, StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private static string ComparisonRowClass(string sourceValue, string targetValue)
    {
        if (StringComparer.Ordinal.Equals(sourceValue ?? string.Empty, targetValue ?? string.Empty))
        {
            return string.Empty;
        }

        if (string.IsNullOrWhiteSpace(targetValue) && !string.IsNullOrWhiteSpace(sourceValue))
        {
            return "metadata-row-added";
        }

        if (string.IsNullOrWhiteSpace(sourceValue) && !string.IsNullOrWhiteSpace(targetValue))
        {
            return "metadata-row-removed";
        }

        return "metadata-row-changed";
    }

    private static string FirstNonEmpty(params string[] values) => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;


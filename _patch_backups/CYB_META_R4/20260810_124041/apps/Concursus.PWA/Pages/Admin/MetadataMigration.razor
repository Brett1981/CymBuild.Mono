    private async Task LoadEntityTypeScopeAsync() => await ExecuteAsync(async () =>
    {
        EntityTypeScopeRows = await CurrentFormHelper.MetadataMigrationEntityTypeScopeListAsync(
            EntityTypeScopeServerName,
            EntityTypeScopeDatabaseName,
            EntityTypeScopeShowMetadataOnly,
            EntityTypeScopeSearchText);

        EntityTypeScopeOriginalValues = EntityTypeScopeRows
            .GroupBy(row => row.EntityTypeGuid)
            .ToDictionary(group => group.Key, group => group.First().IsMetaData);

        Message = $"Loaded {EntityTypeScopeRows.Count} EntityType metadata scope row(s) from {EntityTypeScopeDatabaseName}.";
    });

    private async Task SaveEntityTypeScopeAsync() => await ExecuteAsync(async () =>
    {
        var changes = EntityTypeScopeRows
            .Where(IsEntityTypeScopeDirty)
            .Select(row => new MetadataMigrationEntityTypeScopeUpdateItemModel
            {
                EntityTypeGuid = row.EntityTypeGuid,
                IsMetaData = row.IsMetaData
            })
            .ToList();

        if (changes.Count == 0)
        {
            Message = "No EntityType metadata scope changes to save.";
            return;
        }

        var result = await CurrentFormHelper.MetadataMigrationEntityTypeScopeSaveAsync(
            EntityTypeScopeServerName,
            EntityTypeScopeDatabaseName,
            changes);

        Message = result.Message;

        EntityTypeScopeRows = await CurrentFormHelper.MetadataMigrationEntityTypeScopeListAsync(
            EntityTypeScopeServerName,
            EntityTypeScopeDatabaseName,
            EntityTypeScopeShowMetadataOnly,
            EntityTypeScopeSearchText);

        EntityTypeScopeOriginalValues = EntityTypeScopeRows
            .GroupBy(row => row.EntityTypeGuid)
            .ToDictionary(group => group.Key, group => group.First().IsMetaData);
    }, busyMessage: "Saving EntityType metadata scope changes. Please wait.");

    private void SetEntityTypeScopeValue(MetadataMigrationEntityTypeScopeRowModel row, ChangeEventArgs args)
    {
        if (args.Value is bool boolValue)
        {
            row.IsMetaData = boolValue;
            return;
        }

        row.IsMetaData = bool.TryParse(Convert.ToString(args.Value), out var parsedValue) && parsedValue;
    }

    private bool IsEntityTypeScopeDirty(MetadataMigrationEntityTypeScopeRowModel row) =>
        EntityTypeScopeOriginalValues.TryGetValue(row.EntityTypeGuid, out var originalValue) && originalValue != row.IsMetaData;

    private string EntityTypeScopeRowClass(MetadataMigrationEntityTypeScopeRowModel row)
    {
        var classes = new List<string>();
        if (row.IsMetaData)
        {
            classes.Add("metadata-entity-scope-included");
        }

        if (IsEntityTypeScopeDirty(row))
        {
            classes.Add("metadata-entity-scope-dirty");
        }

        return string.Join(" ", classes);
    }


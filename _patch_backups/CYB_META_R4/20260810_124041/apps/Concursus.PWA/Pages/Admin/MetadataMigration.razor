@page "/admin/metadata-migration"
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using Concursus.API.Client.Models.MetadataMigration
@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@inject Core.CoreClient coreClient
@inject UserService userService
<div class="metadata-workbench">
    <aside class="metadata-workbench-sidebar">
        <div class="metadata-workbench-brand">
            <span class="metadata-workbench-brand-icon bi bi-database"></span>
            <div>
                <h1>Metadata Migration</h1>
                <span>SMigration workbench</span>
            </div>
        </div>

        <nav class="metadata-workbench-nav" aria-label="Metadata migration sections">
            @NavButton("overview", "bi-house", "Overview")
            <div class="metadata-nav-heading">Migration</div>
            @NavButton("setup", "bi-gear", "Setup")
            @NavButton("runs", "bi-clock-history", "Runs")
            @NavButton("stage", "bi-columns-gap", "Stage & Compare")
            @NavButton("identity", "bi-diagram-3", "Identity Map")
            @NavButton("release", "bi-file-earmark-code", "Release Artefacts")
            @NavButton("guardrails", "bi-shield-check", "Guardrails")

            @NavButton("apply", "bi-arrow-right-circle", "Apply")
            @NavButton("audit", "bi-card-checklist", "Audit")
            <div class="metadata-nav-heading">Configuration</div>
            @NavButton("ignored", "bi-slash-circle", "Ignored Records")
            @NavButton("rules", "bi-signpost-split", "Rules")
            @NavButton("registry", "bi-list-columns-reverse", "Registry")
        </nav>
    </aside>

    <main class="metadata-workbench-main">
        <header class="metadata-workbench-topbar">
            <div class="metadata-environment-flow">
                <div class="metadata-environment-chip">
                    <span class="metadata-env-icon source bi bi-database-fill"></span>
                    <div>
                        <span>Source Environment</span>
                        <strong>@SourceEnvironment</strong>
                        <small>@SourceDatabaseName</small>
                    </div>
                </div>
                <span class="metadata-flow-arrow bi bi-arrow-right-short"></span>
                <div class="metadata-environment-chip">
                    <span class="metadata-env-icon target bi bi-database-fill"></span>
                    <div>
                        <span>Target Environment</span>
                        <strong>@TargetEnvironment</strong>
                        <small>@TargetDatabaseName</small>
                    </div>
                </div>
            </div>

            <div class="metadata-topbar-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="RefreshCurrentViewAsync" disabled="@(IsBusy || !HasRunGuid)">
                    <span class="bi bi-arrow-clockwise"></span>
                    Refresh
                </button>
                <button type="button" class="cb-v2-btn-primary" @onclick="CreateRunAsync" disabled="@(IsBusy || !CanCreateRun)">
                    <span class="bi bi-plus-circle"></span>
                    Create Run
                </button>
                <label class="metadata-run-picker">
                    <span>Run:</span>
                    <select class="cb-v2-select" @bind="RunGuidText">
                        <option value="">New run...</option>
                        @foreach (var run in AvailableRuns)
                        {
                            <option value="@run.RunGuid">@FormatRunOption(run)</option>
                        }
                    </select>
                </label>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="metadata-notice metadata-notice-info">
                <span class="bi bi-info-circle"></span>
                <span>@Message</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="metadata-notice metadata-notice-error">
                <span class="bi bi-exclamation-triangle"></span>
                <span>@Error</span>
            </div>
        }

        @if (IsBusy && !string.IsNullOrWhiteSpace(BusyMessage))
        {
            <div class="metadata-notice metadata-notice-processing" role="status" aria-live="polite">
                <span class="metadata-spinner" aria-hidden="true"></span>
                <span>@BusyMessage</span>
            </div>
        }

        @SummaryCards()

        @if (SelectedSection == "overview")
        {
            @OverviewSection()
        }
        else if (SelectedSection == "setup")
        {
            @SetupSection()
        }
        else if (SelectedSection == "runs")
        {
            @RunsSection()
        }
        else if (SelectedSection == "stage")
        {
            @StageCompareSection()
        }
        else if (SelectedSection == SectionIdentity)
        {
            @IdentitySection()
        }
        else if (SelectedSection == SectionRelease)
        {
            @ReleaseArtefactsSection()
        }
        else if (SelectedSection == SectionGuardrails)
        {
            @GuardrailsSection()
        }
        else if (SelectedSection == "apply")
        {
            @ApplySection()
        }
        else if (SelectedSection == "audit")
        {
            @AuditSection()
        }
        else if (SelectedSection == "ignored")
        {
            @IgnoredRecordsSection()
        }
        else if (SelectedSection == "rules")
        {
            @RulesSection()
        }
        else if (SelectedSection == "registry")
        {
            @RegistrySection()
        }
    </main>
</div>

@code {
    private const string DifferenceInsert = "Insert";
    private const string DifferenceUpdate = "Update";
    private const string DifferenceNoChange = "NoChange";
    private const string SectionSetup = "setup";
    private const string SectionStage = "stage";
    private const string SectionIdentity = "identity";
    private const string SectionAudit = "audit";
    private const string SectionApply = "apply";
    private const string SectionRelease = "release";
    private const string SectionGuardrails = "guardrails";
    private const string SectionIgnored = "ignored";
    private const string SectionRules = "rules";
    private const string EntityTypeScopeSourceDatabase = "Source";
    private const string EntityTypeScopeTargetDatabase = "Target";

    private string SelectedSection { get; set; } = "stage";
    private string SelectedDetailTab { get; set; } = "comparison";
    private bool IsBusy { get; set; }
    private string Message { get; set; } = string.Empty;
    private string Error { get; set; } = string.Empty;
    private string BusyMessage { get; set; } = string.Empty;

    private string SourceEnvironment { get; set; } = "DEV";
    private string TargetEnvironment { get; set; } = "QA";
    private string SourceServerName { get; set; } = @"SOC-SQLDEVBRE01\GENERAL";
    private string SourceDatabaseName { get; set; } = "CymBuild_Dev";
    private string TargetServerName { get; set; } = @"SOC-SQLDEVBRE01\GENERAL";
    private string TargetDatabaseName { get; set; } = "CymBuild_QA";
    private bool IsValidateOnly { get; set; }
    private bool ForceApply { get; set; }
    private string RunGuidText { get; set; } = string.Empty;

    private MetadataMigrationDashboardModel? Dashboard { get; set; }
    private List<MetadataMigrationRunModel> AvailableRuns { get; set; } = new();
    private List<MetadataMigrationDiffRowModel> DiffRows { get; set; } = new();
    private List<MetadataMigrationIdentityMapDetailModel> IdentityMapDetailRows { get; set; } = new();
    private List<MetadataMigrationIdentityMapCandidateModel> IdentityMapCandidateRows { get; set; } = new();
    private MetadataMigrationIdentityMapModel? SelectedIdentityMapSummary { get; set; }
    private MetadataMigrationIdentityMapDetailModel? SelectedIdentityMapDetail { get; set; }
    private MetadataMigrationIdentityMapCandidateModel? SelectedIdentityMapCandidate { get; set; }
    private MetadataMigrationDiffRowModel? SelectedDiffRow { get; set; }
    private MetadataTableSummaryRow? SelectedTableSummary { get; set; }
    private List<MetadataMigrationIgnoredRecordModel> IgnoredRecords { get; set; } = new();
    private List<MetadataMigrationEntityTypeScopeRowModel> EntityTypeScopeRows { get; set; } = new();
    private Dictionary<Guid, bool> EntityTypeScopeOriginalValues { get; set; } = new();
    private MetadataMigrationApplyPreviewModel? ApplyPreview { get; set; }
    private DateTime? ApplyPreviewGeneratedOn { get; set; }
    private bool ApplyPreviewReviewed { get; set; }


    private string SelectedEntityName { get; set; } = string.Empty;
    private string SelectedDifferenceType { get; set; } = DifferenceUpdate;
    private string TableSearchText { get; set; } = string.Empty;
    private string RecordSearchText { get; set; } = string.Empty;
    private string SelectedSchemaFilter { get; set; } = string.Empty;
    private string SelectedAuditSeverity { get; set; } = string.Empty;
    private bool ShowNoChange { get; set; }
    private bool ShowIgnored { get; set; }
    private bool ShowInactiveIgnoredRecords { get; set; }
    private bool ShowMissingTargetsOnly { get; set; }
    private bool IdentityMapIncludeIgnoredIssues { get; set; } = true;
    private string IdentityMapSearchText { get; set; } = string.Empty;
    private string IdentityMapIssueReason { get; set; } = string.Empty;
    private string IdentityMapCandidateSearchText { get; set; } = string.Empty;
    private string IdentityMapOverrideReason { get; set; } = string.Empty;
    private string IgnoreReason { get; set; } = string.Empty;
    private string EntityTypeScopeSelectedDatabase { get; set; } = EntityTypeScopeSourceDatabase;
    private bool EntityTypeScopeShowMetadataOnly { get; set; } = true;
    private string EntityTypeScopeSearchText { get; set; } = string.Empty;
    private string ApplyPreviewSearchText { get; set; } = string.Empty;
    private bool ApplyPreviewShowSkipped { get; set; } = true;
    private string ReleaseArtefactTab { get; set; } = "manifest";

    private HashSet<string> SelectedRecordKeys { get; } = new(StringComparer.OrdinalIgnoreCase);

    private Concursus.API.Client.FormHelper? formHelper;

    protected override void OnInitialized()
    {
        formHelper = new Concursus.API.Client.FormHelper(
            coreClient,
            Guid.Empty.ToString(),
            userService);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRunsAsync();
    }

    private Concursus.API.Client.FormHelper CurrentFormHelper =>
        formHelper ?? throw new InvalidOperationException("FormHelper has not been initialised.");

    private bool HasRunGuid => Guid.TryParse(RunGuidText, out _);
    private bool CanCreateRun => !string.IsNullOrWhiteSpace(SourceEnvironment)
        && !string.IsNullOrWhiteSpace(TargetEnvironment)
        && !string.IsNullOrWhiteSpace(SourceDatabaseName)
        && !string.IsNullOrWhiteSpace(TargetDatabaseName);
    private bool CanLoadEntityTypeScope => !string.IsNullOrWhiteSpace(EntityTypeScopeServerName)
        && !string.IsNullOrWhiteSpace(EntityTypeScopeDatabaseName);
    private bool IsForceApplyDisabled => !TargetEnvironment.Equals("LIVE", StringComparison.OrdinalIgnoreCase);
    private bool CanApplyBase => HasRunGuid && !IsValidateOnly && (IsForceApplyDisabled || ForceApply) && (Dashboard?.FailCount ?? 0) == 0;
    private bool CanApply => CanApplyBase && IsApplyPreviewReadyForScope(false);
    private bool CanApplySelected => CanApplyBase && SelectedPersistedCount > 0 && IsApplyPreviewReadyForScope(true);

    private int InsertCount => Dashboard?.InsertCount ?? 0;
    private int UpdateCount => Dashboard?.UpdateCount ?? 0;
    private int NoChangeCount => Dashboard?.NoChangeCount ?? 0;
    private int ValidationErrorCount => Dashboard?.FailCount ?? 0;
    private int WarningCount => Dashboard?.WarnCount ?? 0;
    private int IgnoredCount => Dashboard?.IgnoredCount ?? 0;
    private int SelectedPersistedCount => Dashboard?.SelectedCount ?? 0;
    private int SelectedLoadedCount => DiffRows.Count(row => row.IsSelected);
    private int OnlyInSourceCount => InsertCount;
    private int OnlyInTargetCount => Dashboard?.MissingTargetRows ?? 0;
    private int EntityTypeScopePendingCount => EntityTypeScopeRows.Count(row => EntityTypeScopeOriginalValues.TryGetValue(row.EntityTypeGuid, out var originalValue) && originalValue != row.IsMetaData);
    private int ApplyPreviewApplyCount => ApplyPreview?.ApplyCount ?? 0;
    private int ApplyPreviewSkipCount => ApplyPreview?.SkipCount ?? 0;
    private int ApplyPreviewBlockedCount => ApplyPreview?.BlockedCount ?? 0;
    private int ApplyPreviewIgnoredSkipCount => ApplyPreview?.IgnoredSkipCount ?? 0;
    private bool HasApplyPreview => ApplyPreview is not null;
    private bool IsApplyPreviewBlocked => ApplyPreviewBlockedCount > 0 || (ApplyPreview?.RunValidationFailureCount ?? 0) > 0;
    private bool CanConfirmApplyPreview => HasApplyPreview && !IsApplyPreviewBlocked && ApplyPreviewApplyCount > 0;
    private bool CanAcceptApplyPreview => CanConfirmApplyPreview
        && !ApplyPreviewReviewed
        && (ApplyPreview?.PreviewFingerprint?.Length ?? 0) == 64;
    private string ApplyPreviewGeneratedOnText => ApplyPreviewGeneratedOn?.ToString("dd/MM/yyyy HH:mm:ss") ?? "-";
    private string ApplyPreviewAcceptedOnText => string.IsNullOrWhiteSpace(ApplyPreview?.AcceptedOnUtcText)
        ? "-"
        : ApplyPreview.AcceptedOnUtcText;
    private string EntityTypeScopeServerName => EntityTypeScopeSelectedDatabase.Equals(EntityTypeScopeTargetDatabase, StringComparison.OrdinalIgnoreCase) ? TargetServerName : SourceServerName;
    private string EntityTypeScopeDatabaseName => EntityTypeScopeSelectedDatabase.Equals(EntityTypeScopeTargetDatabase, StringComparison.OrdinalIgnoreCase) ? TargetDatabaseName : SourceDatabaseName;
    private int ActionableDifferenceCount => InsertCount + UpdateCount;
    private int StagedEntityCount => TableSummaryRows.Count;
    private int IdentityMapRowCount => Dashboard?.IdentityMap?.Count ?? 0;
    private int IdentityMapReviewNeededCount => Dashboard?.IdentityMap?.Sum(row => row.MissingTargetRows) ?? 0;
    private int IdentityMapDetailUnresolvedCount => IdentityMapDetailRows.Count(row => row.NeedsReview);
    private int IdentityMapDetailIgnoredCount => IdentityMapDetailRows.Count(row => !row.IsResolved && row.IsIgnoredIssue);
    private int IdentityMapDetailExpectedInsertCount => IdentityMapDetailRows.Count(row => row.IssueCode.Equals("ExpectedInsert", StringComparison.OrdinalIgnoreCase));
    private int IdentityMapDetailResolvedCount => IdentityMapDetailRows.Count(row => row.IsResolved && !row.IssueCode.Equals("ExpectedInsert", StringComparison.OrdinalIgnoreCase));
    private int IdentityMapDetailOverrideCount => IdentityMapDetailRows.Count(row => row.HasOverride);
    private int LoadedActiveIgnoredRecordCount => IgnoredRecords.Count(row => row.IsActive);
    private int LoadedInactiveIgnoredRecordCount => IgnoredRecords.Count(row => !row.IsActive);
    private int LoadedEntityTypeMetadataCount => EntityTypeScopeRows.Count(row => row.IsMetaData);
    private int LoadedEntityTypeNonMetadataCount => EntityTypeScopeRows.Count(row => !row.IsMetaData);
    private int PersistentRuleSignalCount => LoadedActiveIgnoredRecordCount + IdentityMapDetailIgnoredCount + IdentityMapDetailOverrideCount + EntityTypeScopePendingCount;
    private string SelectedIdentityMapEntityName => SelectedIdentityMapSummary is null ? string.Empty : SelectedIdentityMapSummary.EntityName;
    private bool HasIdentityMapDetailRows => IdentityMapDetailRows.Count > 0;
    private bool HasIdentityMapCandidateRows => IdentityMapCandidateRows.Count > 0;
    private Dictionary<string, string> SelectedIdentitySourceValues => ParseJsonValues(SelectedIdentityMapDetail?.SourcePayloadJson);
    private Dictionary<string, string> SelectedIdentityTargetValues => ParseJsonValues(SelectedIdentityMapCandidate?.TargetPayloadJson);
    private int ExecutionLogCount => Dashboard?.ExecutionLog?.Count ?? 0;
    private bool HasDashboardLoaded => Dashboard is not null;
    private bool HasStagedMetadata => StagedEntityCount > 0;
    private bool HasValidationCompleted => HasUsefulDateText(Dashboard?.Run?.ValidatedOnUtcText);
    private bool HasAppliedRun => HasUsefulDateText(Dashboard?.Run?.AppliedOnUtcText)
        || (Dashboard?.Run?.RunStatus ?? string.Empty).Contains("Applied", StringComparison.OrdinalIgnoreCase);
    private bool HasIdentityMapBuilt => IdentityMapRowCount > 0;
    private bool IdentityMapHasReviewNeededRows => IdentityMapReviewNeededCount > 0;
    private bool IsIdentityMapReviewCurrent => HasCurrentIdentityMapReview();
    private bool IdentityMapNeedsReview => HasIdentityMapBuilt && IdentityMapHasReviewNeededRows && !IsIdentityMapReviewCurrent;
    private bool CanMarkIdentityMapReviewed => HasRunGuid && HasIdentityMapBuilt && IdentityMapHasReviewNeededRows && !IsIdentityMapReviewCurrent;
    private string IdentityMapReviewBannerClass => $"metadata-identity-review-banner {(IsIdentityMapReviewCurrent ? "reviewed" : "warning")}";
    private string IdentityMapReviewIconClass => $"bi {(IsIdentityMapReviewCurrent ? "bi-check-circle" : "bi-exclamation-circle")}";
    private string NextRunActionText => GetNextRunActionText();
    private bool HasPrioritySelectedScope => SelectedPersistedCount > 0;
    private string RecommendedApplyPreviewScopeText => HasPrioritySelectedScope ? "Preview Selected" : "Preview All Valid";
    private string PriorityReviewScopeCss => HasPrioritySelectedScope ? "metadata-review-scope-selected" : "metadata-review-scope-all";
    private string PriorityReviewScopeTitle => HasPrioritySelectedScope
        ? $"Selected records are the priority confirmation scope ({SelectedPersistedCount})"
        : "No selected records - all valid records are the confirmation scope";
    private string PriorityReviewScopeDetail => HasPrioritySelectedScope
        ? "Identity Map and Release Artefacts still show the full-run context, but selected records should be reviewed and previewed first before Apply Selected."
        : "Because no records are selected, review and preview should be based on all valid staged records before Apply All Valid.";
    private string CurrentApplyPreviewScopeText => ApplyPreview is null
        ? $"Recommended next preview: {RecommendedApplyPreviewScopeText}"
        : $"Current preview: {(ApplyPreview.ApplySelectedOnly ? "selected records" : "all valid records")}";



    private IEnumerable<MetadataMigrationApplyPreviewRowModel> FilteredApplyPreviewRows => (ApplyPreview?.Rows ?? new List<MetadataMigrationApplyPreviewRowModel>())
        .Where(row => ApplyPreviewShowSkipped || row.WillApply || row.IsBlocked)
        .Where(row => string.IsNullOrWhiteSpace(ApplyPreviewSearchText)
            || row.EntityName.Contains(ApplyPreviewSearchText, StringComparison.OrdinalIgnoreCase)
            || row.SourceRowGuid.ToString().Contains(ApplyPreviewSearchText, StringComparison.OrdinalIgnoreCase)
            || row.DifferenceType.Contains(ApplyPreviewSearchText, StringComparison.OrdinalIgnoreCase)
            || row.ApplyAction.Contains(ApplyPreviewSearchText, StringComparison.OrdinalIgnoreCase)
            || row.SkipReason.Contains(ApplyPreviewSearchText, StringComparison.OrdinalIgnoreCase)
            || row.ChangedColumns.Contains(ApplyPreviewSearchText, StringComparison.OrdinalIgnoreCase))
        .OrderBy(row => ApplyPreviewActionSort(row.ApplyAction))
        .ThenBy(row => HasPrioritySelectedScope && !row.IsSelected ? 1 : 0)
        .ThenBy(row => row.SchemaName)
        .ThenBy(row => row.TableName)
        .ThenBy(row => row.SourceRowId);

    private bool IsApplyPreviewReadyForScope(bool selectedOnly)
    {
        return CanConfirmApplyPreview
            && ApplyPreviewReviewed
            && ApplyPreview is not null
            && ApplyPreview.ApplySelectedOnly == selectedOnly;
    }

    private string ApplyPreviewRequiredText(bool selectedOnly)
    {
        var scopeName = selectedOnly ? "selected records" : "all valid records";

        if (!HasRunGuid)
        {
            return "Select a run first.";
        }

        if (!CanApplyBase)
        {
            return "Resolve validation/LIVE/validate-only gating first.";
        }

        if (ApplyPreview is null)
        {
            return $"Generate a preview for {scopeName}.";
        }

        if (ApplyPreview.ApplySelectedOnly != selectedOnly)
        {
            return $"Current preview is for {(ApplyPreview.ApplySelectedOnly ? "selected records" : "all valid records")}; generate a preview for {scopeName}.";
        }

        if (IsApplyPreviewBlocked)
        {
            return "Preview is blocked by validation failures.";
        }

        if (ApplyPreviewApplyCount == 0)
        {
            return "Preview has no records to apply.";
        }

        if (!ApplyPreviewReviewed)
        {
            return "Accept the reviewed preview for deployment before applying.";
        }

        return "Ready to apply.";
    }

    private void ClearApplyPreview()
    {
        ApplyPreview = null;
        ApplyPreviewGeneratedOn = null;
        ApplyPreviewReviewed = false;
        ApplyPreviewSearchText = string.Empty;
        ApplyPreviewShowSkipped = true;
    }

    private static int ApplyPreviewActionSort(string applyAction)
    {
        if (applyAction.Equals("Blocked", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        if (applyAction.Equals("Apply", StringComparison.OrdinalIgnoreCase))
        {
            return 1;
        }

        if (applyAction.Equals("Skip", StringComparison.OrdinalIgnoreCase)
            || applyAction.Equals("Skipped", StringComparison.OrdinalIgnoreCase))
        {
            return 2;
        }

        return 9;
    }

    private string ApplyPreviewSummaryText()
    {
        if (ApplyPreview is null)
        {
            return "Generate an apply preview to review the exact records before running the guarded apply.";
        }

        var scopeText = ApplyPreview.ApplySelectedOnly ? "selected records" : "all valid records";
        if (ApplyPreview.Rows.Count == 0)
        {
            return $"Preview for {scopeText}: no records are currently in scope.";
        }

        var summaryParts = new List<string>
        {
            $"{ApplyPreview.ApplyCount} apply",
            $"{ApplyPreview.SkipCount} skipped"
        };

        if (ApplyPreview.BlockedCount > 0)
        {
            summaryParts.Add($"{ApplyPreview.BlockedCount} blocked");
        }

        if (ApplyPreview.IgnoredSkipCount > 0)
        {
            summaryParts.Add($"{ApplyPreview.IgnoredSkipCount} ignored");
        }

        return $"Preview for {scopeText}: {string.Join(", ", summaryParts)}.";
    }

    private static string ApplyPreviewRowClass(MetadataMigrationApplyPreviewRowModel row)
    {
        if (row.HasValidationFailure
            || row.IsBlocked
            || row.ApplyAction.Equals("Blocked", StringComparison.OrdinalIgnoreCase))
        {
            return "metadata-apply-preview-blocked";
        }

        if (row.WillApply
            || row.ApplyAction.Equals("Apply", StringComparison.OrdinalIgnoreCase))
        {
            return "metadata-apply-preview-apply";
        }

        return "metadata-apply-preview-skip";
    }

    private IEnumerable<MetadataMigrationEntityTypeScopeRowModel> FilteredEntityTypeScopeRows => EntityTypeScopeRows
        .Where(row => string.IsNullOrWhiteSpace(EntityTypeScopeSearchText)
            || row.Name.Contains(EntityTypeScopeSearchText, StringComparison.OrdinalIgnoreCase)
            || row.MainHoBTSchemaName.Contains(EntityTypeScopeSearchText, StringComparison.OrdinalIgnoreCase)
            || row.MainHoBTObjectName.Contains(EntityTypeScopeSearchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(row => row.IsMetaData)
        .ThenBy(row => row.Name);

    private IEnumerable<string> SchemaFilters => TableSummaryRows
        .Select(x => x.SchemaName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x);

    private List<MetadataTableSummaryRow> TableSummaryRows
    {
        get
        {
            if (Dashboard?.StagedCounts is null || Dashboard.StagedCounts.Count == 0)
            {
                return new List<MetadataTableSummaryRow>();
            }

            var validationGroups = (Dashboard.ValidationIssues ?? new List<MetadataMigrationValidationIssueModel>())
                .GroupBy(x => x.EntityName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.Count(v => v.Severity.Equals("Fail", StringComparison.OrdinalIgnoreCase)), StringComparer.OrdinalIgnoreCase);

            var missingTargetGroups = (Dashboard.IdentityMap ?? new List<MetadataMigrationIdentityMapModel>())
                .ToDictionary(x => x.EntityName, x => x.MissingTargetRows, StringComparer.OrdinalIgnoreCase);

            return Dashboard.StagedCounts
                .GroupBy(x => x.EntityName, StringComparer.OrdinalIgnoreCase)
                .Select(group =>
                {
                    var first = group.First();
                    var entityName = first.EntityName;
                    return new MetadataTableSummaryRow
                    {
                        SchemaName = first.SchemaName,
                        TableName = first.TableName,
                        EntityName = entityName,
                        InsertCount = group.Where(x => x.DifferenceType.Equals(DifferenceInsert, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Count),
                        UpdateCount = group.Where(x => x.DifferenceType.Equals(DifferenceUpdate, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Count),
                        NoChangeCount = group.Where(x => x.DifferenceType.Equals(DifferenceNoChange, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Count),
                        ValidationErrorCount = validationGroups.TryGetValue(entityName, out var failCount) ? failCount : 0,
                        MissingTargetCount = missingTargetGroups.TryGetValue(entityName, out var missingTargetCount) ? missingTargetCount : 0
                    };
                })
                .OrderBy(x => x.SchemaName)
                .ThenBy(x => x.TableName)
                .ToList();
        }
    }

    private IEnumerable<MetadataTableSummaryRow> FilteredTableSummaryRows => TableSummaryRows
        .Where(row => string.IsNullOrWhiteSpace(SelectedSchemaFilter) || row.SchemaName.Equals(SelectedSchemaFilter, StringComparison.OrdinalIgnoreCase))
        .Where(row => ShowNoChange || row.InsertCount > 0 || row.UpdateCount > 0 || row.ValidationErrorCount > 0 || row.MissingTargetCount > 0)
        .Where(row => string.IsNullOrWhiteSpace(TableSearchText) || row.EntityName.Contains(TableSearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MetadataMigrationDiffRowModel> FilteredDiffRows => DiffRows
        .Where(row => ShowNoChange || !row.DifferenceType.Equals(DifferenceNoChange, StringComparison.OrdinalIgnoreCase))
        .Where(row => ShowIgnored || !row.IsIgnored)
        .Where(row => string.IsNullOrWhiteSpace(RecordSearchText)
            || row.SourceRowGuid.ToString().Contains(RecordSearchText, StringComparison.OrdinalIgnoreCase)
            || row.SourceValues.Values.Concat(row.TargetValues.Values).Any(v => v.Contains(RecordSearchText, StringComparison.OrdinalIgnoreCase))
            || row.DifferingColumns.Any(v => v.Contains(RecordSearchText, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<MetadataMigrationValidationIssueModel> FilteredValidationIssues => (Dashboard?.ValidationIssues ?? Enumerable.Empty<MetadataMigrationValidationIssueModel>())
        .Where(row => string.IsNullOrWhiteSpace(SelectedAuditSeverity) || row.Severity.Equals(SelectedAuditSeverity, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MetadataMigrationIdentityMapModel> FilteredIdentityMap => (Dashboard?.IdentityMap ?? Enumerable.Empty<MetadataMigrationIdentityMapModel>())
        .Where(row => !ShowMissingTargetsOnly || row.MissingTargetRows > 0)
        .OrderByDescending(row => row.MissingTargetRows)
        .ThenBy(row => row.SchemaName)
        .ThenBy(row => row.TableName);

    private IEnumerable<MetadataMigrationIdentityMapDetailModel> FilteredIdentityMapDetails => IdentityMapDetailRows
        .Where(row => IdentityMapIncludeIgnoredIssues || !row.IsIgnoredIssue)
        .Where(row => string.IsNullOrWhiteSpace(IdentityMapSearchText)
            || row.EntityName.Contains(IdentityMapSearchText, StringComparison.OrdinalIgnoreCase)
            || row.SourceRowGuid.ToString().Contains(IdentityMapSearchText, StringComparison.OrdinalIgnoreCase)
            || row.SourceDisplayName.Contains(IdentityMapSearchText, StringComparison.OrdinalIgnoreCase)
            || row.IssueCode.Contains(IdentityMapSearchText, StringComparison.OrdinalIgnoreCase)
            || row.IssueStatus.Contains(IdentityMapSearchText, StringComparison.OrdinalIgnoreCase)
            || row.Reason.Contains(IdentityMapSearchText, StringComparison.OrdinalIgnoreCase)
            || row.SuggestedAction.Contains(IdentityMapSearchText, StringComparison.OrdinalIgnoreCase))
        .OrderBy(row => row.IsResolved ? 2 : row.IsIgnoredIssue ? 1 : 0)
        .ThenBy(row => row.SourceRowId)
        .ThenBy(row => row.SourceRowGuid);

    private RenderFragment NavButton(string section, string icon, string label) => @<button type="button"
        class="metadata-nav-button @(SelectedSection == section ? "selected" : string.Empty)"
        @onclick="@(() => SelectSectionAsync(section))">
        <span class="bi @icon"></span>
        <span>@label</span>
    </button>;

    private RenderFragment SummaryCards() => @<section class="metadata-summary-grid" aria-label="Metadata migration summary">
        @SummaryCard("Insert", InsertCount, "success", () => OpenStageWithDifferenceAsync(DifferenceInsert))
        @SummaryCard("Update", UpdateCount, "info", () => OpenStageWithDifferenceAsync(DifferenceUpdate))
        @SummaryCard("No Change", NoChangeCount, "muted", () => OpenStageWithDifferenceAsync(DifferenceNoChange))
        @SummaryCard("Only in Source", OnlyInSourceCount, "orange", () => OpenStageWithDifferenceAsync(DifferenceInsert))
        @SummaryCard("Only in Target", OnlyInTargetCount, "purple", OpenMissingTargetsAsync)
        @SummaryCard("Ignored", IgnoredCount, "muted", () => SelectSectionAsync("ignored"))
        @SummaryCard("Validation Errors", ValidationErrorCount, "danger", () => OpenAuditSeverityAsync("Fail"))
        @SummaryCard("Warnings", WarningCount, "warning", () => OpenAuditSeverityAsync("Warn"))
    </section>;

    private RenderFragment SummaryCard(string title, int count, string tone, Func<Task> onClick) => @<button type="button"
        class="metadata-summary-card metadata-summary-card-@tone"
        @onclick="@(() => onClick())"
        disabled="@IsSummaryCardDisabled(title)">
        <span>@title</span>
        <strong>@count</strong>
    </button>;

    private bool IsSummaryCardDisabled(string title) => IsBusy || (!HasRunGuid && !title.Equals("Ignored", StringComparison.OrdinalIgnoreCase));

    private RenderFragment OverviewSection() => @<section class="metadata-card">
        <div class="metadata-overview-grid">
            <div>
                <h2>Run overview</h2>
                <p>The workbench keeps the existing CymBuild migration route and presents the staged comparison in a single review surface.</p>
                @ReviewScopePanel(SectionApply)

        <dl class="metadata-definition-grid">
                    <dt>Current run</dt><dd>@(HasRunGuid ? RunGuidText : "No run selected")</dd>
                    <dt>Status</dt><dd>@(Dashboard?.Run?.RunStatus ?? "Not loaded")</dd>
                    <dt>Created UTC</dt><dd>@(Dashboard?.Run?.CreatedOnUtcText ?? "-")</dd>
                    <dt>Validated UTC</dt><dd>@(Dashboard?.Run?.ValidatedOnUtcText ?? "-")</dd>
                    <dt>Applied UTC</dt><dd>@(Dashboard?.Run?.AppliedOnUtcText ?? "-")</dd>
                    <dt>Staged entities</dt><dd>@StagedEntityCount</dd>
                    <dt>Actionable differences</dt><dd>@ActionableDifferenceCount</dd>
                    <dt>Execution log entries</dt><dd>@ExecutionLogCount</dd>
                </dl>
            </div>
            <div class="metadata-step-list">
                <h3>Recommended flow</h3>
                <ol>
                    <li>Create or select a run.</li>
                    <li>Stage source metadata into the run.</li>
                    <li>Validate and build identity map.</li>
                    <li>Review differences, selections and ignored records.</li>
                    <li>Generate the apply preview and confirm review.</li>
                    <li>Apply using the existing guarded apply path.</li>
                </ol>
            </div>
        </div>
        @RunReadinessPanel("overview")
    </section>;

    private RenderFragment SetupSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Setup</h2>
                <p>Configure source and target for the migration run.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="LoadRunsAsync" disabled="@IsBusy">Load Runs</button>
                <button type="button" class="cb-v2-btn-primary" @onclick="CreateRunAsync" disabled="@(IsBusy || !CanCreateRun)">Create Run</button>
            </div>
        </div>

        <div class="metadata-form-grid">
            <label class="metadata-field">
                <span>Source Environment</span>
                <select class="cb-v2-select" @bind="SourceEnvironment">
                    <option>DEV</option>
                    <option>QA</option>
                    <option>UAT</option>
                </select>
            </label>
            <label class="metadata-field">
                <span>Target Environment</span>
                <select class="cb-v2-select" @bind="TargetEnvironment">
                    <option>QA</option>
                    <option>UAT</option>
                    <option>LIVE</option>
                </select>
            </label>
            <label class="metadata-field">
                <span>Source Server</span>
                <input class="cb-v2-input" @bind="SourceServerName" />
            </label>
            <label class="metadata-field">
                <span>Source Database</span>
                <input class="cb-v2-input" @bind="SourceDatabaseName" />
            </label>
            <label class="metadata-field">
                <span>Target Server</span>
                <input class="cb-v2-input" @bind="TargetServerName" />
            </label>
            <label class="metadata-field">
                <span>Target Database</span>
                <input class="cb-v2-input" @bind="TargetDatabaseName" />
            </label>
        </div>

        <div class="metadata-toggle-row">
            <label><input type="checkbox" @bind="IsValidateOnly" /> Validate only</label>
            <label><input type="checkbox" @bind="ForceApply" disabled="@IsForceApplyDisabled" /> Force apply for LIVE</label>
        </div>

        <div class="metadata-scope-panel">
            <div class="metadata-section-header compact">
                <div>
                    <h3>Metadata Entity Type Scope</h3>
                    <p>Select active EntityTypes to be treated as metadata in the selected database. Changes apply to future runs for that database.</p>
                </div>
                <div class="metadata-section-actions">
                    <button type="button" class="cb-v2-btn-secondary" @onclick="LoadEntityTypeScopeAsync" disabled="@(IsBusy || !CanLoadEntityTypeScope)">Load Entity Types</button>
                    <button type="button" class="cb-v2-btn-primary" @onclick="SaveEntityTypeScopeAsync" disabled="@(IsBusy || EntityTypeScopePendingCount == 0)">Save Metadata Scope Changes (@EntityTypeScopePendingCount)</button>
                </div>
            </div>

            <div class="metadata-notice metadata-notice-warning metadata-scope-warning">
                <span class="bi bi-info-circle"></span>
                <span>Only the IsMetaData flag is updated from this grid. EntityTypes are filtered to active rows where RowStatus is not 0 or 254.</span>
            </div>

            <div class="metadata-toolbar metadata-scope-toolbar">
                <label class="metadata-field compact">
                    <span>Database scope</span>
                    <select class="cb-v2-select" @bind="EntityTypeScopeSelectedDatabase">
                        <option value="@EntityTypeScopeSourceDatabase">Source database</option>
                        <option value="@EntityTypeScopeTargetDatabase">Target database</option>
                    </select>
                </label>
                <label class="metadata-field compact metadata-scope-database-name">
                    <span>Selected database</span>
                    <input class="cb-v2-input" value="@EntityTypeScopeDatabaseName" readonly />
                </label>
                <label class="metadata-check">
                    <input type="checkbox" @bind="EntityTypeScopeShowMetadataOnly" />
                    Show IsMetaData only
                </label>
                <input class="cb-v2-input metadata-scope-search" placeholder="Search EntityTypes..." @bind="EntityTypeScopeSearchText" />
            </div>

            <div class="metadata-scope-status">
                <span>@EntityTypeScopeRows.Count loaded EntityType(s).</span>
                <span>@EntityTypeScopePendingCount pending change(s).</span>
            </div>

            <div class="metadata-table-wrap metadata-entity-scope-table-wrap">
                <table class="metadata-table metadata-entity-scope-table">
                    <thead>
                        <tr>
                            <th>IsMetaData</th>
                            <th>Entity Type</th>
                            <th>Main HoBT</th>
                            <th>Has Main HoBT</th>
                            <th>Documents</th>
                            <th>Root</th>
                            <th>Deletable</th>
                            <th>Pending</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredEntityTypeScopeRows)
                        {
                            <tr class="@(EntityTypeScopeRowClass(row))">
                                <td>
                                    <input type="checkbox" checked="@row.IsMetaData" @onchange="@((ChangeEventArgs args) => SetEntityTypeScopeValue(row, args))" disabled="@IsBusy" />
                                </td>
                                <td>
                                    <strong>@row.Name</strong>
                                    <small>@row.EntityTypeGuid</small>
                                </td>
                                <td>@row.MainHoBTDisplayName</td>
                                <td>@(row.HasMainHoBT ? "Yes" : "No")</td>
                                <td>@(row.HasDocuments ? "Yes" : "No")</td>
                                <td>@(row.IsRootEntity ? "Yes" : "No")</td>
                                <td>@(row.IsDeletable ? "Yes" : "No")</td>
                                <td>
                                    @if (IsEntityTypeScopeDirty(row))
                                    {
                                        @Badge("Pending")
                                    }
                                    else
                                    {
                                        <span class="metadata-muted-icon bi bi-dash-circle" title="No pending change"></span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>;

    private RenderFragment RunsSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Runs</h2>
                <p>Select an existing migration run or create a new one from Setup.</p>
            </div>
            <button type="button" class="cb-v2-btn-secondary" @onclick="LoadRunsAsync" disabled="@IsBusy">Refresh Runs</button>
        </div>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead>
                    <tr>
                        <th>Run</th>
                        <th>Source</th>
                        <th>Target</th>
                        <th>Classification</th>
                        <th>Created UTC</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in AvailableRuns)
                    {
                        <tr class="@(RunGuidText == run.RunGuid.ToString() ? "selected" : string.Empty)">
                            <td>@run.RunGuid</td>
                            <td>@run.SourceEnvironment / @run.SourceDatabaseName</td>
                            <td>@run.TargetEnvironment / @run.TargetDatabaseName</td>
                            <td>@Badge(run.RunStatus)</td>
                            <td>@run.CreatedOnUtcText</td>
                            <td><button type="button" class="cb-v2-btn-secondary" @onclick="@(() => SelectRunAsync(run))" disabled="@IsBusy">Select</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment StageCompareSection() => @<section class="metadata-stage-layout">
        <div class="metadata-card metadata-table-summary-card">
            <div class="metadata-section-header compact">
                <div>
                    <h2>Differences</h2>
                    <p>@TableSummaryRows.Count table(s) staged for the selected run.</p>
                </div>
                <div class="metadata-section-actions">
                    <button type="button" class="cb-v2-btn-secondary" @onclick="StageAsync" disabled="@(IsBusy || !HasRunGuid)">Stage</button>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="ValidateAsync" disabled="@(IsBusy || !HasRunGuid)">Validate</button>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="BuildIdentityMapAsync" disabled="@(IsBusy || !HasRunGuid)">Build Map</button>
                </div>
            </div>

            <div class="metadata-toolbar">
                <input class="cb-v2-input" placeholder="Search tables..." @bind="TableSearchText" />
                <select class="cb-v2-select" @bind="SelectedSchemaFilter">
                    <option value="">All Schemas</option>
                    @foreach (var schema in SchemaFilters)
                    {
                        <option value="@schema">@schema</option>
                    }
                </select>
                <label><input type="checkbox" @bind="ShowNoChange" /> Show no change</label>
                <label><input type="checkbox" checked="@ShowIgnored" @onchange="ToggleShowIgnoredAsync" /> Show ignored</label>
            </div>

            <div class="metadata-table-wrap metadata-table-summary-wrap">
                <table class="metadata-table metadata-table-summary">
                    <thead>
                        <tr>
                            <th>Schema</th>
                            <th>Table</th>
                            <th>Insert</th>
                            <th>Update</th>
                            <th>No Change</th>
                            <th>Only in Source</th>
                            <th>Only in Target</th>
                            <th>Validation</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredTableSummaryRows)
                        {
                            <tr class="@(SelectedEntityName.Equals(row.EntityName, StringComparison.OrdinalIgnoreCase) ? "selected" : string.Empty)" @onclick="@(() => SelectTableAsync(row))">
                                <td>@row.SchemaName</td>
                                <td><strong>@row.TableName</strong></td>
                                <td class="metadata-count success">@row.InsertCount</td>
                                <td class="metadata-count info">@row.UpdateCount</td>
                                <td>@row.NoChangeCount</td>
                                <td class="metadata-count orange">@row.InsertCount</td>
                                <td class="metadata-count purple">@row.MissingTargetCount</td>
                                <td class="@(row.ValidationErrorCount > 0 ? "metadata-count danger" : string.Empty)">@row.ValidationErrorCount</td>
                                <td><button type="button" class="cb-v2-btn-secondary compact" @onclick:stopPropagation="true" @onclick="@(() => SelectTableAsync(row))">View</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="metadata-record-panels">
            <div class="metadata-card metadata-record-grid-card">
                <div class="metadata-section-header compact">
                    <div>
                        <h2>@(string.IsNullOrWhiteSpace(SelectedEntityName) ? "Records" : SelectedEntityName)</h2>
                        <p>@DiffRows.Count loaded record(s), @SelectedLoadedCount selected in this table, @SelectedPersistedCount selected in run.</p>
                    </div>
                    <div class="metadata-section-actions">
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="SelectVisibleRecordsAsync" disabled="@(IsBusy || !FilteredDiffRows.Any(IsSelectableForApply))">Select Visible</button>
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="ClearTableSelectionAsync" disabled="@(IsBusy || SelectedLoadedCount == 0)">Clear Table</button>
                    </div>
                </div>

                <div class="metadata-toolbar">
                    <select class="cb-v2-select" @bind="SelectedDifferenceType">
                        <option value="">All</option>
                        <option value="Insert">Insert</option>
                        <option value="Update">Update</option>
                        <option value="NoChange">No Change</option>
                    </select>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="LoadRecordsAsync" disabled="@(IsBusy || !HasRunGuid || string.IsNullOrWhiteSpace(SelectedEntityName))">Load Records</button>
                    <input class="cb-v2-input" placeholder="Search records..." @bind="RecordSearchText" />
                </div>

                <div class="metadata-table-wrap metadata-record-table-wrap">
                    <table class="metadata-table metadata-record-table">
                        <thead>
                            <tr>
                                <th class="metadata-checkbox-col"></th>
                                <th>ID / Guid</th>
                                <th>Difference</th>
                                <th>Changed Columns</th>
                                <th>Default?</th>
                                <th>Description</th>
                                <th>Selected</th>
                                <th>Ignored</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredDiffRows)
                            {
                                <tr class="@(RecordRowClass(row))" @onclick="@(() => SelectRecord(row))">
                                    <td class="metadata-checkbox-col">
                                        <input type="checkbox" checked="@IsRecordSelected(row)" disabled="@(!IsSelectableForApply(row) && !row.IsSelected)" @onclick:stopPropagation="true" @onchange="@((ChangeEventArgs args) => PersistRecordSelectionAsync(row, args))" />
                                    </td>
                                    <td>
                                        <strong>@GetDisplayId(row)</strong>
                                        <small>@row.SourceRowGuid</small>
                                    </td>
                                    <td>@DifferenceBadge(row.DifferenceType)</td>
                                    <td>@row.DifferingColumns.Count</td>
                                    <td>@GetValue(row, "IsDefault")</td>
                                    <td>@FirstNonEmpty(GetValue(row, "Description"), GetValue(row, "Name"), GetValue(row, "Code"), "-")</td>
                                    <td>
                                        @if (row.IsSelected)
                                        {
                                            @Badge("Selected")
                                        }
                                        else
                                        {
                                            <span class="metadata-muted-icon bi bi-dash-circle" title="Not selected for apply"></span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.IsIgnored)
                                        {
                                            @Badge("Ignored")
                                        }
                                        else
                                        {
                                            <span class="metadata-muted-icon bi bi-dash-circle" title="Not ignored"></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="metadata-card metadata-comparison-card">
                <div class="metadata-comparison-header">
                    <div>
                        <h2>Comparison</h2>
                        <p>@(SelectedDiffRow is null ? "Select a record to compare source and target values." : $"{SelectedDiffRow.SchemaName}.{SelectedDiffRow.TableName} / {SelectedDiffRow.SourceRowGuid}")</p>
                    </div>
                    <div class="metadata-ignore-actions">
                        <input class="cb-v2-input metadata-ignore-reason" placeholder="Ignore reason (optional)" @bind="IgnoreReason" disabled="@(IsBusy || SelectedDiffRow?.IsIgnored == true)" />
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="ToggleIgnoreSelectedRecordAsync" disabled="@(IsBusy || SelectedDiffRow is null)">
                            <span class="bi bi-slash-circle"></span>
                            @(SelectedDiffRow?.IsIgnored == true ? "Unignore Record" : "Ignore Record")
                        </button>
                    </div>
                </div>

                <div class="metadata-tab-row">
                    @DetailTabButton("comparison", "Comparison")
                    @DetailTabButton("json", "JSON")
                    @DetailTabButton("sql", "SQL View")
                </div>

                @if (SelectedDetailTab == "comparison")
                {
                    @ComparisonPanel()
                }
                else if (SelectedDetailTab == "json")
                {
                    @JsonPanel()
                }
                else
                {
                    @SqlPreviewPanel()
                }
            </div>
        </div>
    </section>;

    private RenderFragment IdentitySection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Identity Map</h2>
                <p>Identity map coverage and classified target-resolution detail for the selected metadata run.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="BuildIdentityMapAsync" disabled="@(IsBusy || !HasRunGuid)">Build Identity Map</button>
                <button type="button" class="cb-v2-btn-primary" @onclick="MarkIdentityMapReviewedAsync" disabled="@(IsBusy || !CanMarkIdentityMapReviewed)">Mark Reviewed</button>
            </div>
        </div>
        @ReviewScopePanel(SectionIdentity)

        @if (HasIdentityMapBuilt && IdentityMapHasReviewNeededRows)
        {
            <div class="@IdentityMapReviewBannerClass">
                <span class="@IdentityMapReviewIconClass"></span>
                <span>
                    @(IsIdentityMapReviewCurrent
                        ? $"Identity map review acknowledged for {IdentityMapReviewNeededCount} review-needed mapping row(s)."
                        : $"{IdentityMapReviewNeededCount} identity-map row(s) need review. Expected inserts are not counted as review items. Select a summary row below to inspect the classified detail, then use Mark Reviewed once checked.")
                </span>
            </div>
        }
        <div class="metadata-identity-stack">
            <div class="metadata-identity-summary">
                <div class="metadata-subsection-title">
                    <div>
                        <h3>Summary</h3>
                        <p>Click a row to drill into classified identity-map records. Expected inserts are informational; review-needed rows require action or acknowledgement.</p>
                    </div>
                    <label class="metadata-inline-check">
                        <input type="checkbox" @bind="ShowMissingTargetsOnly" />
                        <span>Review-needed only</span>
                    </label>
                </div>
                <div class="metadata-table-wrap">
                    <table class="metadata-table">
                        <thead><tr><th>Entity</th><th>Map Rows</th><th>Review Needed</th><th>Action</th></tr></thead>
                        <tbody>
                            @foreach (var row in FilteredIdentityMap)
                            {
                                <tr class="@IdentityMapSummaryRowClass(row)" @onclick="@(() => SelectIdentityMapSummaryAsync(row))">
                                    <td>@row.EntityName</td>
                                    <td>@row.MapRows</td>
                                    <td class="@(row.MissingTargetRows > 0 ? "metadata-count danger" : string.Empty)">@row.MissingTargetRows</td>
                                    <td><button type="button" class="cb-v2-btn-secondary compact" @onclick:stopPropagation="true" @onclick="@(() => SelectIdentityMapSummaryAsync(row))">Details</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="metadata-identity-details">
                <div class="metadata-subsection-title">
                    <div>
                        <h3>Identity Map Detail</h3>
                        <p>@(SelectedIdentityMapSummary is null ? "Select a summary row to load detail." : $"{SelectedIdentityMapEntityName}: {IdentityMapDetailUnresolvedCount} review needed, {IdentityMapDetailExpectedInsertCount} expected insert, {IdentityMapDetailIgnoredCount} ignored, {IdentityMapDetailResolvedCount} resolved/mapped.")</p>
                    </div>
                    <div class="metadata-section-actions compact-actions">
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="LoadIdentityMapDetailsAsync" disabled="@(IsBusy || SelectedIdentityMapSummary is null)">Reload Details</button>
                    </div>
                </div>

                <div class="metadata-filter-row identity-filter-row">
                    <input class="cb-v2-input" placeholder="Search identity-map rows..." @bind="IdentityMapSearchText" />
                    <label class="metadata-inline-check">
                        <input type="checkbox" @bind="IdentityMapIncludeIgnoredIssues" />
                        <span>Show ignored issues</span>
                    </label>
                    <input class="cb-v2-input metadata-ignore-reason" placeholder="Ignore reason (optional)" @bind="IdentityMapIssueReason" />
                </div>

                @if (SelectedIdentityMapSummary is null)
                {
                    <div class="metadata-empty-state">Select a summary row to view classified identity-map records for that entity.</div>
                }
                else if (!HasIdentityMapDetailRows)
                {
                    <div class="metadata-empty-state">No detail rows loaded yet. Use Reload Details.</div>
                }
                else
                {
                    <div class="metadata-table-wrap metadata-identity-detail-table">
                        <table class="metadata-table">
                            <thead>
                                <tr>
                                    <th>Classification</th>
                                    <th>Source Record</th>
                                    <th>Difference</th>
                                    <th>Reason</th>
                                    <th>Suggested Fix / Review Action</th>
                                    <th>Manual Mapping</th>
                                    <th>Ignore</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in FilteredIdentityMapDetails)
                                {
                                    <tr class="@IdentityMapDetailRowClass(row)" @onclick="@(() => SelectIdentityMapDetail(row))">
                                        <td>
                                            <span class="metadata-status-pill @IdentityMapDetailStatusClass(row)">@row.IssueStatus</span>
                                            @if (row.IsIgnoredIssue)
                                            {
                                                <small class="metadata-muted-block">Ignored @row.IgnoredOnUtcText</small>
                                            }
                                        </td>
                                        <td>
                                            <strong>@(string.IsNullOrWhiteSpace(row.SourceDisplayName) ? row.SourceRowGuid.ToString() : row.SourceDisplayName)</strong>
                                            <small class="metadata-muted-block">ID: @row.SourceRowId / @row.SourceRowGuid</small>
                                        </td>
                                        <td>@DisplayDifference(row.DifferenceType)</td>
                                        <td>@row.Reason</td>
                                        <td>@row.SuggestedAction</td>
                                        <td>
                                            @if (row.HasOverride)
                                            {
                                                <span class="metadata-status-pill mapped">Mapped</span>
                                                <small class="metadata-muted-block">@row.OverrideTargetDisplayName</small>
                                            }
                                            else
                                            {
                                                <span class="metadata-muted-block">No manual mapping</span>
                                            }
                                        </td>
                                        <td>
                                            @if (row.IsResolved && !row.IsIgnoredIssue)
                                            {
                                                <span class="metadata-muted-block">No review action</span>
                                            }
                                            else
                                            {
                                                <button type="button" class="cb-v2-btn-secondary compact" @onclick:stopPropagation="true" @onclick="@(() => ToggleIdentityMapIssueIgnoreAsync(row))" disabled="@IsBusy">
                                                    @(row.IsIgnoredIssue ? "Unignore" : "Ignore Issue")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @IdentityMapIssueInspector()
        </div>
    </section>;

    private RenderFragment IdentityMapIssueInspector() => @<div class="metadata-identity-inspector">
        <div class="metadata-subsection-title">
            <div>
                <h3>Selected Identity Map Row</h3>
                <p>@(SelectedIdentityMapDetail is null ? "Select an identity-map row to inspect the source record and, where needed, find target candidates." : $"{SelectedIdentityMapDetail.EntityName} / {SelectedIdentityMapDetail.SourceDisplayName}")</p>
            </div>
            <div class="metadata-section-actions compact-actions">
                <button type="button" class="cb-v2-btn-secondary compact" @onclick="LoadIdentityMapCandidatesAsync" disabled="@(IsBusy || SelectedIdentityMapDetail is null)">Find Target Candidates</button>
                @if (SelectedIdentityMapDetail?.HasOverride == true)
                {
                    <button type="button" class="cb-v2-btn-secondary compact" @onclick="ClearIdentityMapOverrideAsync" disabled="@IsBusy">Clear Manual Mapping</button>
                }
            </div>
        </div>

        @if (SelectedIdentityMapDetail is null)
        {
            <div class="metadata-empty-state">No identity map issue selected.</div>
        }
        else
        {
            <div class="metadata-identity-inspector-grid">
                <aside class="metadata-record-info-panel metadata-identity-info-panel">
                    <h3>Problem Record</h3>
                    <dl>
                        <dt>Entity</dt><dd>@SelectedIdentityMapDetail.EntityName</dd>
                        <dt>Source Record</dt><dd>@SelectedIdentityMapDetail.SourceDisplayName</dd>
                        <dt>Source ID / Guid</dt><dd>@SelectedIdentityMapDetail.SourceRowId / @SelectedIdentityMapDetail.SourceRowGuid</dd>
                        <dt>Classification</dt><dd><span class="metadata-status-pill @IdentityMapDetailStatusClass(SelectedIdentityMapDetail)">@SelectedIdentityMapDetail.IssueStatus</span></dd>
                        <dt>Reason</dt><dd>@SelectedIdentityMapDetail.Reason</dd>
                        <dt>Suggested Action</dt><dd>@SelectedIdentityMapDetail.SuggestedAction</dd>
                    </dl>
                    <h3>Review Actions</h3>
                    <dl>
                        <dt>Ignored</dt><dd>@(SelectedIdentityMapDetail.IsIgnoredIssue ? "Yes" : "No")</dd>
                        <dt>Ignore Reason</dt><dd>@(string.IsNullOrWhiteSpace(SelectedIdentityMapDetail.IgnoreReason) ? "-" : SelectedIdentityMapDetail.IgnoreReason)</dd>
                        <dt>Manual Mapping</dt><dd>@(SelectedIdentityMapDetail.HasOverride ? SelectedIdentityMapDetail.OverrideTargetDisplayName : "None")</dd>
                    </dl>
                    <input class="cb-v2-input" placeholder="Manual mapping reason (optional)" @bind="IdentityMapOverrideReason" />
                </aside>

                <div class="metadata-identity-json-area">
                    <div class="metadata-json-grid">
                        @IdentityJsonViewer("Source JSON", SelectedIdentitySourceValues, SelectedIdentityTargetValues, true)
                        @IdentityJsonViewer("Selected Target Candidate JSON", SelectedIdentityTargetValues, SelectedIdentitySourceValues, false)
                    </div>
                </div>
            </div>

            <div class="metadata-identity-candidate-panel">
                <div class="metadata-subsection-title compact">
                    <div>
                        <h3>Potential Target Matches</h3>
                        <p>Use this only when the target record already exists but has a different Guid. Expected inserts do not need manual mapping unless you know an equivalent target row already exists. This persists a database-scoped mapping override; it does not directly change source or target record Guids.</p>
                    </div>
                    <div class="metadata-filter-row identity-candidate-filter-row">
                        <input class="cb-v2-input" placeholder="Search target records..." @bind="IdentityMapCandidateSearchText" />
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="LoadIdentityMapCandidatesAsync" disabled="@IsBusy">Search</button>
                    </div>
                </div>

                @if (!HasIdentityMapCandidateRows)
                {
                    <div class="metadata-empty-state">No target candidates loaded. Use Find Target Candidates, or enter search text and select Search.</div>
                }
                else
                {
                    <div class="metadata-table-wrap metadata-identity-candidate-table">
                        <table class="metadata-table">
                            <thead><tr><th>Target Record</th><th>Target ID / Guid</th><th>Match</th><th>Action</th></tr></thead>
                            <tbody>
                                @foreach (var candidate in IdentityMapCandidateRows)
                                {
                                    <tr class="@(SelectedIdentityMapCandidate?.TargetRowGuid == candidate.TargetRowGuid ? "selected" : string.Empty)" @onclick="@(() => SelectIdentityMapCandidate(candidate))">
                                        <td><strong>@candidate.TargetDisplayName</strong></td>
                                        <td><small>@candidate.TargetRowId / @candidate.TargetRowGuid</small></td>
                                        <td><span class="metadata-status-pill mapped">@candidate.MatchReason</span></td>
                                        <td>
                                            <button type="button" class="cb-v2-btn-primary compact" @onclick:stopPropagation="true" @onclick="@(() => SaveIdentityMapOverrideAsync(candidate))" disabled="@IsBusy">Map to this Target</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>;

    private RenderFragment ApplySection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Apply</h2>
                <p>Preview the apply scope before using the existing guarded backend apply path.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="@(() => LoadApplyPreviewAsync(true))" disabled="@(IsBusy || !HasRunGuid)">Preview Selected</button>
                <button type="button" class="cb-v2-btn-secondary" @onclick="@(() => LoadApplyPreviewAsync(false))" disabled="@(IsBusy || !HasRunGuid)">Preview All Valid</button>
                <button type="button" class="cb-v2-btn-secondary" @onclick="ApplySelectedAsync" disabled="@(IsBusy || !CanApplySelected)">Apply Selected (@SelectedPersistedCount)</button>
                <button type="button" class="cb-v2-btn-primary" @onclick="ApplyAsync" disabled="@(IsBusy || !CanApply)">Apply All Valid</button>
            </div>
        </div>
        @ReviewScopePanel(SectionApply)

        <dl class="metadata-definition-grid">
            <dt>Run</dt><dd>@(HasRunGuid ? RunGuidText : "No run selected")</dd>
            <dt>Validation errors</dt><dd>@ValidationErrorCount</dd>
            <dt>Warnings</dt><dd>@WarningCount</dd>
            <dt>Selected records</dt><dd>@SelectedPersistedCount</dd>
            <dt>LIVE force apply</dt><dd>@(ForceApply ? "Enabled" : "Disabled")</dd>
            <dt>Validate only</dt><dd>@(IsValidateOnly ? "Yes" : "No")</dd>
            <dt>Preview apply</dt><dd>@ApplyPreviewApplyCount</dd>
            <dt>Preview skipped</dt><dd>@ApplyPreviewSkipCount</dd>
            <dt>Preview blocked</dt><dd>@ApplyPreviewBlockedCount</dd>
            <dt>Ignored skipped</dt><dd>@ApplyPreviewIgnoredSkipCount</dd>
        </dl>
        @RunReadinessPanel("apply")
        @if (TargetEnvironment == "LIVE" && !ForceApply)
        {
            <div class="metadata-notice metadata-notice-warning">
                <span class="bi bi-shield-lock"></span>
                <span>LIVE apply remains blocked until Force apply for LIVE is explicitly enabled.</span>
            </div>
        }
        @if ((ApplyPreview?.RunValidationFailureCount ?? 0) > 0)
        {
            <div class="metadata-notice metadata-notice-error">
                <span class="bi bi-exclamation-triangle"></span>
                <span>The selected run has validation failures. Apply remains blocked until validation failures are resolved.</span>
            </div>
        }

        <div class="metadata-apply-readiness-grid">
            <div class="metadata-apply-readiness-card @(CanApplySelected ? "ready" : "pending")">
                <span>Apply Selected</span>
                <strong>@ApplyPreviewRequiredText(true)</strong>
            </div>
            <div class="metadata-apply-readiness-card @(CanApply ? "ready" : "pending")">
                <span>Apply All Valid</span>
                <strong>@ApplyPreviewRequiredText(false)</strong>
            </div>
        </div>

        @if (ApplyPreview is not null)
        {
            <div class="metadata-notice metadata-notice-info metadata-apply-review-notice">
                <span class="bi bi-clipboard-check"></span>
                <div>
                    <label class="metadata-apply-review-check">
                        <input type="checkbox" checked="@ApplyPreviewReviewed" disabled />
                        <span>This exact @(ApplyPreview.ApplySelectedOnly ? "selected records" : "all valid records") preview is accepted for deployment on the server.</span>
                    </label>
                    <small>Preview generated: @ApplyPreviewGeneratedOnText. Accepted: @ApplyPreviewAcceptedOnText. Any stage, validation, selection, ignore, override, payload or scope change invalidates this acceptance.</small>
                </div>
                <button type="button" class="cb-v2-btn-primary compact" @onclick="AcceptApplyPreviewAsync" disabled="@(IsBusy || !CanAcceptApplyPreview)">Accept for Deployment</button>
            </div>
        }
        else
        {
            <div class="metadata-notice metadata-notice-warning">
                <span class="bi bi-info-circle"></span>
                <span>Generate and review a matching apply preview before applying metadata.</span>
            </div>
        }

        <div class="metadata-apply-preview-panel">
            <div class="metadata-section-header compact">
                <div>
                    <h3>Apply Preview</h3>
                    <p>@ApplyPreviewSummaryText()</p>
                </div>
                <div class="metadata-section-actions">
                    <label class="metadata-check"><input type="checkbox" @bind="ApplyPreviewShowSkipped" /> Show skipped</label>
                    <input class="cb-v2-input metadata-apply-preview-search" placeholder="Search preview..." @bind="ApplyPreviewSearchText" />
                </div>
            </div>
            <div class="metadata-table-wrap metadata-apply-preview-table-wrap">
                <table class="metadata-table">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Entity</th>
                            <th>ID / Guid</th>
                            <th>Difference</th>
                            <th>Selected</th>
                            <th>Ignored</th>
                            <th>Changed Columns</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredApplyPreviewRows)
                        {
                            <tr class="@ApplyPreviewRowClass(row)">
                                <td>@Badge(row.ApplyAction)</td>
                                <td>@row.EntityName</td>
                                <td><small>@row.SourceRowId<br />@row.SourceRowGuid</small></td>
                                <td>@DifferenceBadge(row.DifferenceType)</td>
                                <td>@(row.IsSelected ? "Yes" : "No")</td>
                                <td>@(row.IsIgnored ? "Yes" : "No")</td>
                                <td>@(string.IsNullOrWhiteSpace(row.ChangedColumns) ? "-" : row.ChangedColumns)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.SkipReason) ? "-" : row.SkipReason)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>;

    private RenderFragment GuardrailsSection() => @<section class="metadata-card metadata-guardrails-card">
        <div class="metadata-section-header">
            <div>
                <h2>Automation Parity & Environment Guardrails</h2>
                <p>Review the safeguards that keep the workbench aligned with CymBuild metadata CI/CD and environment rules.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionRelease))" disabled="@IsBusy">Release Artefacts</button>
                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionApply))" disabled="@IsBusy">Apply</button>
                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionRules))" disabled="@IsBusy">Rules</button>
            </div>
        </div>

        <div class="metadata-notice metadata-notice-info">
            <span class="bi bi-shield-check"></span>
            <span>Guardrail/readiness view. It does not change backend metadata apply behaviour, and it does not add a UI dependency to CI/CD automation.</span>
        </div>

        @if (BuildEnvironmentGuardrailChecks().Any(check => check.Tone.Equals("danger", StringComparison.OrdinalIgnoreCase)))
        {
            <div class="metadata-notice metadata-notice-error">
                <span class="bi bi-exclamation-triangle"></span>
                <span>One or more environment guardrails are blocked. Review them before manually applying metadata from the workbench.</span>
            </div>
        }
        else if (BuildEnvironmentGuardrailChecks().Any(check => check.Tone.Equals("warning", StringComparison.OrdinalIgnoreCase)))
        {
            <div class="metadata-notice metadata-notice-warning">
                <span class="bi bi-info-circle"></span>
                <span>One or more guardrails need review. This does not stop CI/CD unless automation is explicitly configured to check these signals.</span>
            </div>
        }

        <div class="metadata-guardrail-grid">
            <div class="metadata-step-list metadata-guardrail-panel">
                <h3>Environment guardrails</h3>
                <p>These are manual workbench safety checks. Backend procedures still enforce their own validation and apply rules.</p>
                <table class="metadata-table compact metadata-guardrail-table">
                    <thead><tr><th>Guardrail</th><th>Status</th><th>Detail</th><th>Action</th></tr></thead>
                    <tbody>
                        @foreach (var check in BuildEnvironmentGuardrailChecks())
                        {
                            <tr class="@GuardrailRowClass(check)">
                                <td><strong>@check.Name</strong></td>
                                <td>@Badge(check.Status)</td>
                                <td>@check.Detail</td>
                                <td>@check.Action</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="metadata-step-list metadata-guardrail-panel">
                <h3>Automation parity</h3>
                <p>These confirm which decisions are persistent backend inputs and which are UI-only review aids.</p>
                <table class="metadata-table compact metadata-guardrail-table">
                    <thead><tr><th>Check</th><th>Status</th><th>Detail</th><th>Automation impact</th></tr></thead>
                    <tbody>
                        @foreach (var check in BuildAutomationParityChecks())
                        {
                            <tr class="@GuardrailRowClass(check)">
                                <td><strong>@check.Name</strong></td>
                                <td>@Badge(check.Status)</td>
                                <td>@check.Detail</td>
                                <td>@check.Action</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="metadata-step-list metadata-guardrail-ci-card">
            <h3>Recommended discipline</h3>
            <ol>
                <li>Use this workbench in DEV/QA/UAT to understand scope, identity-map risk and apply preview.</li>
                <li>Capture intended release decisions in source-controlled schema SQL and metadata manifests through Release Artefacts.</li>
                <li>Keep CI/CD deterministic: schema deploy, metadata validate, metadata apply.</li>
                <li>Do not rely on silent manual LIVE database changes. Any persistent rule needed by automation must be explicit and auditable.</li>
                <li>Persistent decisions that can affect future backend runs are EntityType IsMetaData scope, ignored metadata records, identity-map ignored issues and manual map overrides.</li>
            </ol>
        </div>

        <div class="metadata-audit-summary metadata-guardrail-summary">
            <div>Target environment: <strong>@TargetEnvironment</strong></div>
            <div>Validate only: <strong>@(IsValidateOnly ? "Yes" : "No")</strong></div>
            <div>LIVE force apply: <strong>@(ForceApply ? "Enabled" : "Disabled")</strong></div>
            <div>Persistent rule signals loaded: <strong>@PersistentRuleSignalCount</strong></div>
        </div>
    </section>;

    private RenderFragment ReleaseArtefactsSection() => @<section class="metadata-card metadata-release-card">
        <div class="metadata-section-header">
            <div>
                <h2>Release Artefacts</h2>
                <p>Capture the selected run and persistent migration decisions into source-control friendly artefacts for review before CI/CD release.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="PrepareReleaseArtefactsAsync" disabled="@(IsBusy || !HasRunGuid)">
                    <span class="bi bi-arrow-clockwise"></span>
                    Refresh Release Signals
                </button>
                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionRules))" disabled="@IsBusy">Rules</button>
                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionApply))" disabled="@IsBusy">Apply Preview</button>
            </div>
        </div>

        <div class="metadata-notice metadata-notice-info">
            <span class="bi bi-info-circle"></span>
            <span>This page does not write to Git or mutate metadata. It prepares copyable release artefacts so intended workbench decisions can be committed to source-controlled schema SQL and metadata manifests before automated deployment.</span>
        </div>

        <div class="metadata-release-grid">
            <div class="metadata-step-list">
                <h3>Release context</h3>
                <dl class="metadata-definition-grid metadata-release-definition-grid">
                    <dt>Run</dt><dd>@(HasRunGuid ? RunGuidText : "No run selected")</dd>
                    <dt>Source</dt><dd>@SourceEnvironment / @SourceDatabaseName</dd>
                    <dt>Target</dt><dd>@TargetEnvironment / @TargetDatabaseName</dd>
                    <dt>Run status</dt><dd>@(Dashboard?.Run?.RunStatus ?? "Not loaded")</dd>
                    <dt>Validated</dt><dd>@(Dashboard?.Run?.ValidatedOnUtcText ?? "-")</dd>
                    <dt>Applied</dt><dd>@(Dashboard?.Run?.AppliedOnUtcText ?? "-")</dd>
                    <dt>Generated filename stem</dt><dd>@ReleaseArtefactFileStem</dd>
                </dl>
            </div>
            <div class="metadata-step-list">
                <h3>Captured signal summary</h3>
                <dl class="metadata-definition-grid metadata-release-definition-grid">
                    <dt>Staged table groups</dt><dd>@StagedEntityCount</dd>
                    <dt>Insert / Update</dt><dd>@InsertCount / @UpdateCount</dd>
                    <dt>Validation errors / warnings</dt><dd>@ValidationErrorCount / @WarningCount</dd>
                    <dt>Selected / ignored</dt><dd>@SelectedPersistedCount / @IgnoredCount</dd>
                    <dt>Identity review-needed</dt><dd>@IdentityMapReviewNeededCount</dd>
                    <dt>Apply preview</dt><dd>@ApplyPreviewSummaryText()</dd>
                    <dt>Persistent signal loaded</dt><dd>@PersistentRuleSignalCount</dd>
                </dl>
            </div>
        </div>

        <div class="metadata-release-checklist">
            <h3>Before committing artefacts</h3>
            <ol>
                <li>Refresh release signals after staging, validation, identity-map review and apply preview.</li>
                <li>Copy the manifest/checklist into the relevant source-controlled release folder.</li>
                <li>Convert any intentional DB-scoped configuration into source-controlled SQL or metadata manifests.</li>
                <li>Do not rely on silent manual target database edits for LIVE release behaviour.</li>
                <li>Keep automated deployment as schema deploy --> metadata validate --> metadata apply.</li>
            </ol>
        </div>

        <div class="metadata-tab-row metadata-release-tabs">
            @ReleaseArtefactTabButton("manifest", "Manifest JSON")
            @ReleaseArtefactTabButton("markdown", "Review Checklist")
            @ReleaseArtefactTabButton("sql", "SQL Capture Notes")
        </div>

        <div class="metadata-release-output-panel">
            <div class="metadata-section-header compact">
                <div>
                    <h3>@ReleaseArtefactOutputTitle()</h3>
                    <p>Copy this content into source control after review. The generated text is intentionally run-scoped and non-destructive.</p>
                </div>
                <div class="metadata-section-actions compact-actions">
                    <span class="metadata-status-pill info">Copy from text area</span>
                </div>
            </div>

            @if (ReleaseArtefactTab == "manifest")
            {
                <textarea class="cb-v2-input metadata-release-output" readonly>@BuildReleaseManifestJson()</textarea>
            }
            else if (ReleaseArtefactTab == "markdown")
            {
                <textarea class="cb-v2-input metadata-release-output" readonly>@BuildReleaseChecklistMarkdown()</textarea>
            }
            else
            {
                <textarea class="cb-v2-input metadata-release-output" readonly>@BuildReleaseSqlCaptureNotes()</textarea>
            }
        </div>
    </section>;
    private RenderFragment AuditSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Audit</h2>
                <p>Validation issues, identity map warnings and execution log for the selected run.</p>
            </div>
            <button type="button" class="cb-v2-btn-secondary" @onclick="ClearAuditFiltersAsync" disabled="@IsBusy">Clear Filters</button>
        </div>

        <div class="metadata-audit-summary">
            <div>Status: <strong>@(Dashboard?.Run?.RunStatus ?? "")</strong></div>
            <div>Run: <strong>@RunGuidText</strong></div>
            <div>Applied: <strong>@(Dashboard?.Run?.AppliedOnUtcText ?? "-")</strong></div>
        </div>

        @RunReadinessPanel("audit")

        @AuditQaPolishPanel()

        <h3>Validation Issues</h3>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Severity</th><th>Entity</th><th>Issue Code</th><th>Message</th></tr></thead>
                <tbody>
                    @foreach (var row in FilteredValidationIssues)
                    {
                        <tr>
                            <td>@Badge(row.Severity)</td>
                            <td>@row.EntityName</td>
                            <td>@row.IssueCode</td>
                            <td>@row.IssueMessage</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3>Execution Log</h3>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Step</th><th>Classification</th><th>Message</th><th>Created UTC</th></tr></thead>
                <tbody>
                    @foreach (var row in Dashboard?.ExecutionLog ?? Enumerable.Empty<MetadataMigrationExecutionLogItemModel>())
                    {
                        <tr>
                            <td>@row.StepName</td>
                            <td>@Badge(row.StepStatus)</td>
                            <td>@row.Message</td>
                            <td>@row.CreatedOnUtcText</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;


    private RenderFragment AuditQaPolishPanel() => @<div class="metadata-audit-polish">
        <div class="metadata-step-list metadata-audit-timeline-card">
            <div class="metadata-subsection-title compact">
                <div>
                    <h3>Run Timeline</h3>
                    <p>High-level execution and review path for the selected metadata migration run.</p>
                </div>
                <div class="metadata-section-actions compact-actions">
                    <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionStage))" disabled="@IsBusy">Stage</button>
                    <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionIdentity))" disabled="@IsBusy">Identity Map</button>
                    <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionRelease))" disabled="@IsBusy">Release Artefacts</button>
                    <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionApply))" disabled="@IsBusy">Apply</button>
                </div>
            </div>

            <div class="metadata-audit-timeline">
                @foreach (var item in BuildAuditTimelineRows())
                {
                    <button type="button" class="@AuditTimelineRowClass(item)" @onclick="@(() => SelectSectionAsync(item.Section))" disabled="@IsBusy">
                        <span class="metadata-audit-timeline-index">@item.Sequence</span>
                        <span class="metadata-audit-timeline-body">
                            <strong>@item.Title</strong>
                            <small>@item.Detail</small>
                            <small class="metadata-muted-block">@item.TimestampText</small>
                        </span>
                        <span class="metadata-status-pill @item.Tone">@item.StatusText</span>
                    </button>
                }
            </div>
        </div>

        <div class="metadata-step-list metadata-qa-checklist-card">
            <div class="metadata-subsection-title compact">
                <div>
                    <h3>QA Review Checklist</h3>
                    <p>Read-only test checklist for DEV/QA verification. This does not change metadata or block automation.</p>
                </div>
                <span class="metadata-status-pill info">QA aid</span>
            </div>

            <div class="metadata-table-wrap metadata-qa-checklist-wrap">
                <table class="metadata-table compact metadata-qa-checklist-table">
                    <thead>
                        <tr>
                            <th>Area</th>
                            <th>Check</th>
                            <th>Status</th>
                            <th>Evidence</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var check in BuildQaChecklistRows())
                        {
                            <tr class="@QaChecklistRowClass(check)">
                                <td><strong>@check.Area</strong></td>
                                <td>@check.Check</td>
                                <td><span class="metadata-status-pill @check.Tone">@check.StatusText</span></td>
                                <td>@check.Evidence</td>
                                <td><button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(check.Section))" disabled="@IsBusy">Open</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>;
    private RenderFragment IgnoredRecordsSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Ignored Records</h2>
                <p>Ignored metadata records are persisted for @TargetDatabaseName and are skipped in future runs against that database.</p>
            </div>
            <div class="metadata-section-actions">
                <label><input type="checkbox" @bind="ShowInactiveIgnoredRecords" /> Show inactive</label>
                <button type="button" class="cb-v2-btn-secondary" @onclick="LoadIgnoredRecordsAsync" disabled="@(IsBusy || !HasRunGuid)">Refresh Ignored</button>
            </div>
        </div>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Database</th><th>Table</th><th>Source Guid</th><th>Reason</th><th>Ignored UTC</th><th>Classification</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var row in IgnoredRecords)
                    {
                        <tr>
                            <td>@row.DatabaseName</td>
                            <td>@row.EntityName</td>
                            <td>@row.SourceRowGuid</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Reason) ? "-" : row.Reason)</td>
                            <td>@row.IgnoredOnUtcText</td>
                            <td>@(row.IsActive ? Badge("Active") : Badge("Inactive"))</td>
                            <td>
                                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => UnignoreRecordAsync(row))" disabled="@(IsBusy || !row.IsActive)">Unignore</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment RulesSection() => @<section class="metadata-card metadata-rules-impact-card">
        <div class="metadata-section-header">
            <div>
                <h2>Rules & Automation Impact</h2>
                <p>Review which workbench decisions are guidance, which are server-enforced run gates and which persistent rules affect future metadata runs.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => SelectSectionAsync(SectionSetup))" disabled="@IsBusy">EntityType Scope</button>

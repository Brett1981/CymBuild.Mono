    private string ReleaseArtefactFileStem
    {
        get
        {
            var runPart = HasRunGuid ? RunGuidText : "no-run";
            var raw = $"metadata-release-{TargetDatabaseName}-{runPart}";
            foreach (var invalid in System.IO.Path.GetInvalidFileNameChars().Concat(new[] { '\\', '/', ':', ' ' }))
            {
                raw = raw.Replace(invalid, '-');
            }

            return raw;
        }
    }

    private async Task PrepareReleaseArtefactsAsync() => await ExecuteAsync(async () =>
    {
        await RefreshDashboardCoreAsync(false);
        await LoadIgnoredRecordsCoreAsync();

        if (SelectedIdentityMapSummary is not null)
        {
            await LoadIdentityMapDetailsCoreAsync();
        }

        Message = "Release artefact signals refreshed. Review the generated manifest/checklist before committing anything to source control.";
    }, busyMessage: "Refreshing release artefact signals. Please wait.");

    private string BuildReleaseManifestJson()
    {
        var manifest = new
        {
            schemaVersion = "cymbuild.metadata-release.v1",
            generatedOnLocal = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss"),
            generatedBy = "CymBuild Metadata Migration Workbench",
            purpose = "Source-control capture draft. Review and commit intended metadata/schema artefacts before CI/CD release.",
            run = new
            {
                runGuid = HasRunGuid ? RunGuidText : string.Empty,
                status = Dashboard?.Run?.RunStatus ?? string.Empty,
                sourceEnvironment = SourceEnvironment,
                sourceServer = SourceServerName,
                sourceDatabase = SourceDatabaseName,
                targetEnvironment = TargetEnvironment,
                targetServer = TargetServerName,
                targetDatabase = TargetDatabaseName,
                createdOnUtc = Dashboard?.Run?.CreatedOnUtcText ?? string.Empty,
                validatedOnUtc = Dashboard?.Run?.ValidatedOnUtcText ?? string.Empty,
                appliedOnUtc = Dashboard?.Run?.AppliedOnUtcText ?? string.Empty,
                validateOnly = IsValidateOnly,
                forceApply = ForceApply
            },
            counts = new
            {
                stagedTableGroups = StagedEntityCount,
                insert = InsertCount,
                update = UpdateCount,
                noChange = NoChangeCount,
                onlyInTarget = OnlyInTargetCount,
                ignored = IgnoredCount,
                selected = SelectedPersistedCount,
                validationErrors = ValidationErrorCount,
                warnings = WarningCount,
                identityMapRows = IdentityMapRowCount,
                identityMapReviewNeeded = IdentityMapReviewNeededCount,
                loadedPersistentSignals = PersistentRuleSignalCount
            },
            applyPreview = ApplyPreview is null ? null : new
            {
                generatedOn = ApplyPreviewGeneratedOnText,
                selectedOnly = ApplyPreview.ApplySelectedOnly,
                reviewed = ApplyPreviewReviewed,
                acceptedForDeployment = ApplyPreviewReviewed,
                previewFingerprint = ApplyPreview.PreviewFingerprint,
                acceptedOnUtc = ApplyPreview.AcceptedOnUtcText,
                acceptedByUserId = ApplyPreview.AcceptedByUserId,
                apply = ApplyPreview.ApplyCount,
                skipped = ApplyPreview.SkipCount,
                blocked = ApplyPreview.BlockedCount,
                ignoredSkipped = ApplyPreview.IgnoredSkipCount,
                rows = ApplyPreview.Rows
                    .Where(row => row.WillApply || row.IsBlocked || row.IsIgnored)
                    .Take(500)
                    .Select(row => new
                    {
                        row.EntityName,
                        row.SchemaName,
                        row.TableName,
                        row.SourceRowId,
                        row.SourceRowGuid,
                        row.DifferenceType,
                        row.ApplyAction,
                        row.ChangedColumns,
                        row.SkipReason,
                        row.IsSelected,
                        row.IsIgnored,
                        row.IsBlocked
                    })
                    .ToList()
            },
            stagedTables = TableSummaryRows.Select(row => new
            {
                row.SchemaName,
                row.TableName,
                row.EntityName,
                row.InsertCount,
                row.UpdateCount,
                row.NoChangeCount,
                row.ValidationErrorCount,
                row.MissingTargetCount
            }).ToList(),
            ignoredMetadataRecordsLoaded = IgnoredRecords
                .Where(row => row.IsActive)
                .Take(500)
                .Select(row => new
                {
                    row.DatabaseName,
                    row.SchemaName,
                    row.TableName,
                    row.EntityName,
                    row.SourceRowGuid,
                    row.Reason,
                    row.IgnoredOnUtcText
                })
                .ToList(),
            entityTypeScopeLoaded = new
            {
                database = EntityTypeScopeDatabaseName,
                loadedRows = EntityTypeScopeRows.Count,
                metadataRows = LoadedEntityTypeMetadataCount,
                pendingChanges = EntityTypeScopePendingCount,
                pending = EntityTypeScopeRows
                    .Where(IsEntityTypeScopeDirty)
                    .Select(row => new
                    {
                        row.EntityTypeGuid,
                        row.Name,
                        row.MainHoBTSchemaName,
                        row.MainHoBTObjectName,
                        row.IsMetaData
                    })
                    .ToList()
            },
            identityMapLoadedDetail = new
            {
                selectedEntity = SelectedIdentityMapEntityName,
                reviewNeeded = IdentityMapDetailUnresolvedCount,
                expectedInsert = IdentityMapDetailExpectedInsertCount,
                ignoredIssues = IdentityMapDetailIgnoredCount,
                resolved = IdentityMapDetailResolvedCount,
                overrides = IdentityMapDetailOverrideCount,
                rows = IdentityMapDetailRows
                    .Take(500)
                    .Select(row => new
                    {
                        row.EntityName,
                        row.SchemaName,
                        row.TableName,
                        row.SourceRowId,
                        row.SourceRowGuid,
                        row.SourceDisplayName,
                        row.IssueCode,
                        row.IssueStatus,
                        row.Reason,
                        row.SuggestedAction,
                        row.IsIgnoredIssue,
                        row.HasOverride,
                        row.OverrideTargetRowGuid,
                        row.OverrideTargetDisplayName
                    })
                    .ToList()
            },
            sourceControlReminder = new[]
            {
                "Commit intended schema SQL and metadata manifests; do not treat this UI export as a production database fix.",
                "Persistent rules that must affect CI/CD should be represented in source-controlled scripts/manifests.",
                "Automated deployment remains schema deploy -> metadata validate -> metadata apply."
            }
        };

        return JsonSerializer.Serialize(manifest, new JsonSerializerOptions { WriteIndented = true });
    }


    private string BuildReleaseStagedTablesMarkdown()
    {
        var rows = TableSummaryRows
            .OrderBy(row => row.SchemaName)
            .ThenBy(row => row.TableName)
            .ToList();

        var headers = new[] { "Entity", "Insert", "Update", "No Change", "Validation", "Identity Review" };
        var tableRows = rows
            .Select(row => new[]
            {
                $"`{row.EntityName}`",
                row.InsertCount.ToString(),
                row.UpdateCount.ToString(),
                row.NoChangeCount.ToString(),
                row.ValidationErrorCount.ToString(),
                row.MissingTargetCount.ToString()
            })
            .ToList();

        var widths = headers.Select(header => header.Length).ToArray();
        foreach (var tableRow in tableRows)
        {
            for (var index = 0; index < headers.Length; index++)
            {
                widths[index] = Math.Max(widths[index], tableRow[index]?.Length ?? 0);
            }
        }

        static string Left(string value, int width) => (value ?? string.Empty).PadRight(width);
        static string Right(string value, int width) => (value ?? string.Empty).PadLeft(width);

        var builder = new System.Text.StringBuilder();
        builder.Append("| ");
        builder.Append(Left(headers[0], widths[0]));
        builder.Append(" | ");
        builder.Append(Right(headers[1], widths[1]));
        builder.Append(" | ");
        builder.Append(Right(headers[2], widths[2]));
        builder.Append(" | ");
        builder.Append(Right(headers[3], widths[3]));
        builder.Append(" | ");
        builder.Append(Right(headers[4], widths[4]));
        builder.Append(" | ");
        builder.Append(Right(headers[5], widths[5]));
        builder.AppendLine(" |");

        builder.Append("| ");
        builder.Append(new string('-', widths[0]));
        builder.Append(" | ");
        builder.Append(new string('-', Math.Max(widths[1] - 1, 0)) + ":");
        builder.Append(" | ");
        builder.Append(new string('-', Math.Max(widths[2] - 1, 0)) + ":");
        builder.Append(" | ");
        builder.Append(new string('-', Math.Max(widths[3] - 1, 0)) + ":");
        builder.Append(" | ");
        builder.Append(new string('-', Math.Max(widths[4] - 1, 0)) + ":");
        builder.Append(" | ");
        builder.Append(new string('-', Math.Max(widths[5] - 1, 0)) + ":");
        builder.AppendLine(" |");

        foreach (var tableRow in tableRows)
        {
            builder.Append("| ");
            builder.Append(Left(tableRow[0], widths[0]));
            builder.Append(" | ");
            builder.Append(Right(tableRow[1], widths[1]));
            builder.Append(" | ");
            builder.Append(Right(tableRow[2], widths[2]));
            builder.Append(" | ");
            builder.Append(Right(tableRow[3], widths[3]));
            builder.Append(" | ");
            builder.Append(Right(tableRow[4], widths[4]));
            builder.Append(" | ");
            builder.Append(Right(tableRow[5], widths[5]));
            builder.AppendLine(" |");
        }

        return builder.ToString();
    }
    private string BuildReleaseChecklistMarkdown()
    {
        var builder = new System.Text.StringBuilder();
        builder.AppendLine($"# CymBuild Metadata Release Capture - {TargetEnvironment}");
        builder.AppendLine();
        builder.AppendLine($"- Run: `{(HasRunGuid ? RunGuidText : "No run selected")}`");
        builder.AppendLine($"- Source: `{SourceEnvironment}` / `{SourceDatabaseName}`");
        builder.AppendLine($"- Target: `{TargetEnvironment}` / `{TargetDatabaseName}`");
        builder.AppendLine($"- Status: `{Dashboard?.Run?.RunStatus ?? "Not loaded"}`");
        builder.AppendLine($"- Generated: `{DateTime.Now:yyyy-MM-dd HH:mm:ss}`");
        builder.AppendLine();
        builder.AppendLine("## Staged summary");
        builder.AppendLine();
        builder.AppendLine($"- Staged table groups: **{StagedEntityCount}**");
        builder.AppendLine($"- Inserts: **{InsertCount}**");
        builder.AppendLine($"- Updates: **{UpdateCount}**");
        builder.AppendLine($"- No change: **{NoChangeCount}**");
        builder.AppendLine($"- Validation errors: **{ValidationErrorCount}**");
        builder.AppendLine($"- Warnings: **{WarningCount}**");
        builder.AppendLine($"- Ignored metadata records: **{IgnoredCount}**");
        builder.AppendLine($"- Identity-map review-needed rows: **{IdentityMapReviewNeededCount}**");
        builder.AppendLine();
        builder.AppendLine("## Apply preview");
        builder.AppendLine();
        builder.AppendLine($"- [ ] Priority confirmation scope: **{(HasPrioritySelectedScope ? $"selected records ({SelectedPersistedCount})" : "all valid records")}**.");
        builder.AppendLine(ApplyPreview is null
            ? "- [ ] Generate and review an apply preview before release artefacts are committed."
            : $"- [ ] Preview generated for {(ApplyPreview.ApplySelectedOnly ? "selected records" : "all valid records")}: {ApplyPreviewApplyCount} apply, {ApplyPreviewSkipCount} skipped, {ApplyPreviewBlockedCount} blocked.");
        builder.AppendLine($"- [ ] Exact preview fingerprint accepted for deployment on the server: {(ApplyPreviewReviewed ? "Yes" : "No")}");
        builder.AppendLine();
        builder.AppendLine("## Persistent decisions to capture in source control");
        builder.AppendLine();
        builder.AppendLine($"- [ ] EntityType IsMetaData scope reviewed for `{EntityTypeScopeDatabaseName}`. Pending loaded changes: **{EntityTypeScopePendingCount}**.");
        builder.AppendLine($"- [ ] Ignored metadata records reviewed for `{TargetDatabaseName}`. Active loaded ignores: **{LoadedActiveIgnoredRecordCount}**.");
        builder.AppendLine($"- [ ] Identity-map ignored issues reviewed. Loaded ignored issues: **{IdentityMapDetailIgnoredCount}**.");
        builder.AppendLine($"- [ ] Identity-map manual overrides reviewed. Loaded overrides: **{IdentityMapDetailOverrideCount}**.");
        builder.AppendLine();
        builder.AppendLine("## CI/CD checklist");
        builder.AppendLine();
        builder.AppendLine("- [ ] Schema SQL committed and deployment-safe.");
        builder.AppendLine("- [ ] Metadata manifests committed and validated.");
        builder.AppendLine("- [ ] Environment-specific rules are explicit and auditable.");
        builder.AppendLine("- [ ] No manual LIVE database changes are required.");
        builder.AppendLine("- [ ] Automated deployment path remains `schema deploy -> metadata validate -> metadata apply`.");
        builder.AppendLine();
        builder.AppendLine("## Staged tables");
        builder.AppendLine();
        builder.Append(BuildReleaseStagedTablesMarkdown());
        builder.AppendLine();

        return builder.ToString();
    }

    private string BuildReleaseSqlCaptureNotes()
    {
        var builder = new System.Text.StringBuilder();
        builder.AppendLine("/*");
        builder.AppendLine("    CymBuild Metadata Release Capture Notes");
        builder.AppendLine("    ------------------------------------------------------------");
        builder.AppendLine("    This is a source-control capture aid generated by the DEV/QA workbench.");
        builder.AppendLine("    It is not a direct production database fix and must be reviewed before commit.");
        builder.AppendLine("*/");
        builder.AppendLine();
        builder.AppendLine($"-- RunGuid: {(HasRunGuid ? RunGuidText : "<none>")}");
        builder.AppendLine($"-- Source: {SourceEnvironment} / {SourceServerName} / {SourceDatabaseName}");
        builder.AppendLine($"-- Target: {TargetEnvironment} / {TargetServerName} / {TargetDatabaseName}");
        builder.AppendLine($"-- Generated: {DateTime.Now:yyyy-MM-dd HH:mm:ss}");
        builder.AppendLine();
        builder.AppendLine("-- Intended automated deployment sequence:");
        builder.AppendLine("--   1. Schema deploy using idempotent SQL.");
        builder.AppendLine("--   2. Metadata validate using the backend/CLI metadata validation path.");
        builder.AppendLine("--   3. Metadata preview and acceptance using the backend service path.");
        builder.AppendLine("--   4. Metadata apply using the backend/CLI metadata apply path.");
        builder.AppendLine();
        builder.AppendLine("-- Workbench run summary:");
        builder.AppendLine($"--   Inserts: {InsertCount}");
        builder.AppendLine($"--   Updates: {UpdateCount}");
        builder.AppendLine($"--   Validation errors: {ValidationErrorCount}");
        builder.AppendLine($"--   Warnings: {WarningCount}");
        builder.AppendLine($"--   Ignored metadata records: {IgnoredCount}");
        builder.AppendLine($"--   Identity-map review-needed rows: {IdentityMapReviewNeededCount}");
        builder.AppendLine();
        builder.AppendLine("-- Review before release:");
        builder.AppendLine("--   * Convert intended EntityType IsMetaData changes into source-controlled SQL/metadata manifests.");
        builder.AppendLine("--   * Convert intended ignored records or map overrides into explicit deployment artefacts where they must affect CI/CD.");
        builder.AppendLine("--   * Do not rely on direct LIVE database edits.");
        builder.AppendLine();
        builder.AppendLine("-- Non-executing reference only:");
        builder.AppendLine($"-- EXEC SMigration.MetadataApplyPreview_Get @RunGuid = '{(HasRunGuid ? RunGuidText : "00000000-0000-0000-0000-000000000000")}', @ApplySelectedOnly = 0, @IncludeIgnored = 1;");
        builder.AppendLine($"-- EXEC SMigration.MetadataApplyPreview_Accept @RunGuid = '{(HasRunGuid ? RunGuidText : "00000000-0000-0000-0000-000000000000")}', @ApplySelectedOnly = 0, @ExpectedPreviewFingerprint = '{ApplyPreview?.PreviewFingerprint ?? new string('0', 64)}';");
        builder.AppendLine($"-- EXEC SMigration.MetadataApply_Run @RunGuid = '{(HasRunGuid ? RunGuidText : "00000000-0000-0000-0000-000000000000")}', @ForceApply = {(ForceApply ? 1 : 0)}, @ApplySelectedOnly = 0;");
        return builder.ToString();
    }

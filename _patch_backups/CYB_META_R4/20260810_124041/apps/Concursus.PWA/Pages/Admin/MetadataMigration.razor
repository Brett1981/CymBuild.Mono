        var firstTable = FilteredTableSummaryRows.FirstOrDefault(row => differenceType switch
        {
            DifferenceInsert => row.InsertCount > 0,
            DifferenceUpdate => row.UpdateCount > 0,
            DifferenceNoChange => row.NoChangeCount > 0,
            _ => row.TotalCount > 0
        }) ?? FilteredTableSummaryRows.FirstOrDefault();

        if (firstTable is not null)

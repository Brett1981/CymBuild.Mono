    private IReadOnlyList<MetadataGuardrailCheck> BuildEnvironmentGuardrailChecks()
    {
        var checks = new List<MetadataGuardrailCheck>();
        var sameSourceTarget = SourceServerName.Equals(TargetServerName, StringComparison.OrdinalIgnoreCase)
            && SourceDatabaseName.Equals(TargetDatabaseName, StringComparison.OrdinalIgnoreCase);
        var targetIsLive = TargetEnvironment.Equals("LIVE", StringComparison.OrdinalIgnoreCase);

        checks.Add(new MetadataGuardrailCheck
        {
            Name = "Target environment",
            Status = targetIsLive ? (ForceApply ? "Reviewed" : "Blocked") : "Ready",
            Tone = targetIsLive && !ForceApply ? "danger" : targetIsLive ? "warning" : "ready",
            Detail = targetIsLive
                ? "The selected target is LIVE. Manual workbench apply remains blocked unless Force apply for LIVE is explicitly enabled."
                : $"Target is {TargetEnvironment}. Standard DEV/QA/UAT review controls apply.",
            Action = targetIsLive && !ForceApply
                ? "Enable Force apply only after release approval, or use CI/CD for controlled deployment."
                : "Continue with normal review."
        });

        checks.Add(new MetadataGuardrailCheck
        {
            Name = "Source/target database",
            Status = sameSourceTarget ? "Review" : "Ready",
            Tone = sameSourceTarget ? "warning" : "ready",
            Detail = sameSourceTarget
                ? "Source and target server/database values match. This may indicate an accidental self-comparison."
                : $"{SourceDatabaseName} -> {TargetDatabaseName}",
            Action = sameSourceTarget ? "Confirm setup before staging or applying." : "No action required."
        });

        checks.Add(new MetadataGuardrailCheck
        {
            Name = "Validate only mode",
            Status = IsValidateOnly ? "Apply blocked" : "Ready",
            Tone = IsValidateOnly ? "warning" : "ready",
            Detail = IsValidateOnly
                ? "This run is marked Validate only, so manual apply should remain unavailable."
                : "Run is not validate-only.",
            Action = IsValidateOnly ? "Create a non-validate-only run when apply is required." : "No action required."
        });

        checks.Add(new MetadataGuardrailCheck
        {
            Name = "Validation state",
            Status = ValidationErrorCount > 0 ? "Blocked" : HasValidationCompleted ? "Ready" : "Pending",
            Tone = ValidationErrorCount > 0 ? "danger" : HasValidationCompleted ? "ready" : "warning",
            Detail = ValidationErrorCount > 0
                ? $"{ValidationErrorCount} validation error(s) are present."
                : HasValidationCompleted ? $"Validation completed with {WarningCount} warning(s)." : "Validation has not yet completed for this run.",
            Action = ValidationErrorCount > 0 ? "Resolve validation errors before apply." : HasValidationCompleted ? "Continue." : "Run Validate."
        });

        checks.Add(new MetadataGuardrailCheck
        {
            Name = "Release artefact capture",
            Status = HasRunGuid ? "Available" : "Pending",
            Tone = HasRunGuid ? "ready" : "warning",
            Detail = HasRunGuid
                ? "Release Artefacts can capture the current run context for source-control review."
                : "No run is selected, so release artefacts cannot be generated yet.",
            Action = HasRunGuid ? "Refresh Release Signals before commit." : "Create or select a run."
        });

        return checks;
    }


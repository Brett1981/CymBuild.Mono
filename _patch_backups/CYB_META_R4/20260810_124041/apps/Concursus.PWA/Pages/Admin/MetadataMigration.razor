        }

        var row = SelectedDiffRow;
        var shouldIgnore = !row.IsIgnored;

        await ExecuteAsync(async () =>
        {
            var result = await CurrentFormHelper.MetadataMigrationIgnoreUpsertAsync(
                CurrentRunGuid(),
                row.SchemaName,
                row.TableName,
                row.SourceRowGuid,
                shouldIgnore,
                shouldIgnore ? IgnoreReason : string.Empty,
                TargetServerName,
                TargetDatabaseName);

            ClearApplyPreview();
            await RefreshDashboardCoreAsync(false);

    private async Task RefreshDashboardCoreAsync(bool clearMessage = true)
    {
        Dashboard = await CurrentFormHelper.MetadataMigrationDashboardAsync(CurrentRunGuid(), TargetServerName, TargetDatabaseName);

        if (Dashboard.Run is not null && Dashboard.Run.RunGuid != Guid.Empty)
        {
            if (!string.IsNullOrWhiteSpace(Dashboard.Run.SourceEnvironment))
            {
                SourceEnvironment = Dashboard.Run.SourceEnvironment;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.TargetEnvironment))
            {
                TargetEnvironment = Dashboard.Run.TargetEnvironment;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.SourceServerName))
            {
                SourceServerName = Dashboard.Run.SourceServerName;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.SourceDatabaseName))
            {
                SourceDatabaseName = Dashboard.Run.SourceDatabaseName;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.TargetServerName))
            {
                TargetServerName = Dashboard.Run.TargetServerName;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.TargetDatabaseName))
            {
                TargetDatabaseName = Dashboard.Run.TargetDatabaseName;
            }
        }

        if (clearMessage)
        {
            Message = "Metadata dashboard refreshed.";
        }

        if (string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            var firstTable = FilteredTableSummaryRows.FirstOrDefault();
            if (firstTable is not null)
            {
                SelectedTableSummary = firstTable;
                SelectedEntityName = firstTable.EntityName;
            }
        }
    }

    private async Task LoadRecordsCoreAsync(bool setMessage = true)
    {
        var (schema, table) = SplitEntityName(SelectedEntityName);
        DiffRows = await CurrentFormHelper.MetadataMigrationDiffAsync(CurrentRunGuid(), schema, table, SelectedDifferenceType, TargetServerName, TargetDatabaseName, ShowIgnored);
        SelectedRecordKeys.Clear();
        foreach (var selectedRow in DiffRows.Where(row => row.IsSelected))
        {
            SelectedRecordKeys.Add(RecordKey(selectedRow));
        }

        SelectedDiffRow = FilteredDiffRows.FirstOrDefault();
        if (setMessage)
        {
            Message = $"Loaded {DiffRows.Count} record(s) for {SelectedEntityName}.";
        }
    }

    private async Task ClearAuditFiltersAsync()
    {
        SelectedAuditSeverity = string.Empty;
        ShowMissingTargetsOnly = false;
        await RefreshDashboardAsync(false);
    }

    private Guid CurrentRunGuid() => Guid.TryParse(RunGuidText, out var runGuid)
        ? runGuid
        : throw new InvalidOperationException("A metadata run must be selected first.");

    private async Task ExecuteAsync(Func<Task> action, bool clearMessage = true, string busyMessage = "")
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        BusyMessage = string.IsNullOrWhiteSpace(busyMessage)
            ? "Metadata operation is running. Please wait."
            : busyMessage;

        if (clearMessage)
        {
            Message = string.Empty;
            Error = string.Empty;
        }

        await InvokeAsync(StateHasChanged);

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
            BusyMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }



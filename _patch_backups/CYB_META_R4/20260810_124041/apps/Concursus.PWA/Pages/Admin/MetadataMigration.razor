    private async Task PersistRecordSelectionAsync(MetadataMigrationDiffRowModel row, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool checkedValue && checkedValue;
        if (isChecked && !IsSelectableForApply(row))
        {
            Error = "Only Insert and Update metadata rows can be selected for apply.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (await SaveSelectionAsync(new[]
        {
            ToSelectionItem(row, isChecked)
        }))
        {
            row.IsSelected = isChecked;
            SyncSelectionKey(row);
        }
    }

    private async Task SelectVisibleRecordsAsync()
    {
        var rows = FilteredDiffRows.Where(IsSelectableForApply).ToList();
        if (rows.Count == 0)
        {
            Message = "There are no visible Insert or Update rows to select.";
            return;
        }

        if (await SaveSelectionAsync(rows.Select(row => ToSelectionItem(row, true)).ToList()))
        {
            foreach (var row in rows)
            {
                row.IsSelected = true;
                SyncSelectionKey(row);
            }
        }
    }

    private async Task ClearTableSelectionAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            return;
        }

        var (schema, table) = SplitEntityName(SelectedEntityName);

        await ExecuteAsync(async () =>
        {
            var result = await CurrentFormHelper.MetadataMigrationSelectionClearAsync(CurrentRunGuid(), schema, table, string.Empty, TargetServerName, TargetDatabaseName);
            foreach (var row in DiffRows)
            {
                row.IsSelected = false;
                SelectedRecordKeys.Remove(RecordKey(row));
            }

            ClearApplyPreview();
            await RefreshDashboardCoreAsync(false);
            Message = result.Message;
        }, false);
    }

    private async Task<bool> SaveSelectionAsync(IReadOnlyCollection<MetadataMigrationSelectionItemModel> items)
    {
        if (items.Count == 0)
        {
            return true;
        }

        var succeeded = false;
        await ExecuteAsync(async () =>
        {
            var result = await CurrentFormHelper.MetadataMigrationSelectionUpsertAsync(CurrentRunGuid(), items, TargetServerName, TargetDatabaseName);
            ClearApplyPreview();
            await RefreshDashboardCoreAsync(false);
            Message = result.Message;
            succeeded = true;
        });

        return succeeded;
    }

    private static bool IsRecordSelected(MetadataMigrationDiffRowModel row) => row.IsSelected;

    private static bool IsSelectableForApply(MetadataMigrationDiffRowModel row) =>
        row.DifferenceType.Equals(DifferenceInsert, StringComparison.OrdinalIgnoreCase)
        || row.DifferenceType.Equals(DifferenceUpdate, StringComparison.OrdinalIgnoreCase);

    private static MetadataMigrationSelectionItemModel ToSelectionItem(MetadataMigrationDiffRowModel row, bool isSelected) => new()
    {
        SchemaName = row.SchemaName,
        TableName = row.TableName,
        SourceRowGuid = row.SourceRowGuid,
        DifferenceType = row.DifferenceType,
        IsSelected = isSelected
    };

    private void SyncSelectionKey(MetadataMigrationDiffRowModel row)
    {
        var key = RecordKey(row);
        if (row.IsSelected)
        {
            SelectedRecordKeys.Add(key);
        }
        else
        {
            SelectedRecordKeys.Remove(key);
        }
    }

    private static string RecordKey(MetadataMigrationDiffRowModel row) => $"{row.SchemaName}.{row.TableName}:{row.SourceRowGuid}";

    private string RecordRowClass(MetadataMigrationDiffRowModel row)
    {
        var classes = new List<string>();
        if (SelectedDiffRow == row)
        {
            classes.Add("selected");
        }

        if (row.IsIgnored)
        {
            classes.Add("metadata-record-ignored");
        }

        return string.Join(" ", classes);
    }

    private string IdentityMapSummaryRowClass(MetadataMigrationIdentityMapModel row)
    {
        var classes = new List<string> { "metadata-clickable-row" };
        if (SelectedIdentityMapSummary == row)
        {
            classes.Add("selected");
        }

        if (row.MissingTargetRows > 0)
        {
            classes.Add("metadata-identity-summary-warning");
        }

        return string.Join(" ", classes);
    }

    private string IdentityMapDetailRowClass(MetadataMigrationIdentityMapDetailModel row)
    {
        var rowClass = row.IsResolved
            ? "metadata-identity-detail-resolved"
            : row.IsIgnoredIssue ? "metadata-identity-detail-ignored" : "metadata-identity-detail-unresolved";

        if (SelectedIdentityMapDetail?.SourceRowGuid == row.SourceRowGuid &&
            SelectedIdentityMapDetail.SchemaName.Equals(row.SchemaName, StringComparison.OrdinalIgnoreCase) &&
            SelectedIdentityMapDetail.TableName.Equals(row.TableName, StringComparison.OrdinalIgnoreCase))
        {
            rowClass += " selected";
        }

        return rowClass;
    }

    private static string IdentityMapDetailStatusClass(MetadataMigrationIdentityMapDetailModel row)
    {
        if (row.IssueCode.Equals("ExpectedInsert", StringComparison.OrdinalIgnoreCase))
        {
            return "info";
        }

        if (row.HasOverride)
        {
            return "mapped";
        }

        if (row.IsResolved)
        {
            return "ready";
        }

        return row.IsIgnoredIssue ? "info" : "warning";
    }

    private static (string Schema, string Table) SplitEntityName(string entityName)
    {
        var parts = (entityName ?? string.Empty).Split('.', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 2 ? (parts[0], parts[1]) : (string.Empty, string.Empty);
    }


                    </tbody>
                </table>
            </div>

            <div class="metadata-step-list">
                <h3>Run-specific checks</h3>
                <table class="metadata-table compact">
                    <thead><tr><th>Check</th><th>Scope</th><th>Automation impact</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>Selected records</td>
                            <td>Current run only</td>

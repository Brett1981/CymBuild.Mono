    {
        var id = GetValue(row, "ID");
        return string.IsNullOrWhiteSpace(id) ? "-" : id;
    }

    private RenderFragment IdentityJsonViewer(string title, Dictionary<string, string>? values, Dictionary<string, string>? comparisonValues, bool isSource) => @<div class="metadata-json-panel">
        <h3>@title</h3>
        @if (values is null || values.Count == 0)
        {
            <pre>{}</pre>
        }
        else
        {
            <div class="metadata-json-lines" role="table" aria-label="@title">
                @foreach (var line in PrettyJsonLines(values))
                {
                    <div class="@IdentityJsonLineClass(line, values, comparisonValues, isSource)" role="row">
                        <span class="metadata-json-line-number" role="cell">@line.LineNumber</span>
                        <code role="cell">@line.Text</code>
                    </div>
                }
            </div>
        }
    </div>;

    private static Dictionary<string, string> ParseJsonValues(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }

        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.ValueKind != JsonValueKind.Object)
            {
                return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            }

            var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var property in document.RootElement.EnumerateObject())
            {
                result[property.Name] = property.Value.ValueKind switch
                {
                    JsonValueKind.Null => string.Empty,
                    JsonValueKind.String => property.Value.GetString() ?? string.Empty,
                    _ => property.Value.GetRawText()
                };
            }
            return result;
        }
        catch (JsonException)
        {
            return new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private static string IdentityJsonLineClass(JsonDisplayLine line, Dictionary<string, string>? values, Dictionary<string, string>? comparisonValues, bool isSource)
    {
        var baseClass = isSource
            ? "metadata-json-line metadata-json-line-source"
            : "metadata-json-line metadata-json-line-target";

        if (string.IsNullOrWhiteSpace(line.PropertyName) || values is null || comparisonValues is null)
        {
            return baseClass;
        }

        values.TryGetValue(line.PropertyName, out var value);
        comparisonValues.TryGetValue(line.PropertyName, out var comparisonValue);

        if (StringComparer.Ordinal.Equals(value ?? string.Empty, comparisonValue ?? string.Empty))
        {
            return baseClass;
        }

        if (string.IsNullOrWhiteSpace(comparisonValue) && !string.IsNullOrWhiteSpace(value))
        {
            return $"{baseClass} metadata-json-line-added";
        }

        if (string.IsNullOrWhiteSpace(value) && !string.IsNullOrWhiteSpace(comparisonValue))
        {
            return $"{baseClass} metadata-json-line-removed";
        }

        return $"{baseClass} metadata-json-line-changed";
    }

    private static string PrettyJson(Dictionary<string, string>? values)
    {
        if (values is null || values.Count == 0)
        {
            return "{}";
        }

        return System.Text.Json.JsonSerializer.Serialize(values, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    private static IReadOnlyList<JsonDisplayLine> PrettyJsonLines(Dictionary<string, string>? values)
    {
        var json = PrettyJson(values);
        var lines = json.Replace("\r\n", "\n").Split('\n');

        return lines
            .Select((text, index) => new JsonDisplayLine(index + 1, text, ExtractJsonPropertyName(text)))
            .ToList();
    }

    private static string ExtractJsonPropertyName(string line)
    {
        if (string.IsNullOrWhiteSpace(line))
        {
            return string.Empty;
        }

        var match = System.Text.RegularExpressions.Regex.Match(line, @"^\s*""(?<key>(?:\\.|[^""\\])*)""\s*:");
        return match.Success
            ? System.Text.RegularExpressions.Regex.Unescape(match.Groups["key"].Value)
            : string.Empty;
    }

    private static string JsonLineClass(JsonDisplayLine line, MetadataMigrationDiffRowModel? row, bool isSource)
    {
        var baseClass = isSource
            ? "metadata-json-line metadata-json-line-source"
            : "metadata-json-line metadata-json-line-target";

        if (row is null || string.IsNullOrWhiteSpace(line.PropertyName) || !IsDifferingJsonProperty(row, line.PropertyName))
        {
            return baseClass;
        }

        var sourceValue = GetSourceValue(row, line.PropertyName);
        var targetValue = GetTargetValue(row, line.PropertyName);

        if (string.IsNullOrWhiteSpace(targetValue) && !string.IsNullOrWhiteSpace(sourceValue))
        {
            return $"{baseClass} metadata-json-line-added";
        }

        if (string.IsNullOrWhiteSpace(sourceValue) && !string.IsNullOrWhiteSpace(targetValue))
        {
            return $"{baseClass} metadata-json-line-removed";
        }

        return $"{baseClass} metadata-json-line-changed";
    }

    private static bool IsDifferingJsonProperty(MetadataMigrationDiffRowModel row, string propertyName)
    {
        if (row.DifferingColumns.Any(column => column.Equals(propertyName, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        var sourceValue = GetSourceValue(row, propertyName) ?? string.Empty;
        var targetValue = GetTargetValue(row, propertyName) ?? string.Empty;

        return !StringComparer.Ordinal.Equals(sourceValue, targetValue);
    }

    private string SqlPreviewText()
    {
        if (SelectedDiffRow is null)
        {
            return "-- Select a record to view apply context.";
        }

        var applySelectedOnly = SelectedDiffRow.IsSelected ? 1 : 0;
        var note = SelectedDiffRow.IsIgnored
            ? "-- This record is currently ignored and will be skipped by apply unless unignored."
            : "-- Record is not ignored.";

        return $"EXEC SMigration.MetadataApplyPreview_Get @RunGuid = '{RunGuidText}', @ApplySelectedOnly = {applySelectedOnly}, @IncludeIgnored = 1;\nEXEC SMigration.MetadataApply_Run @RunGuid = '{RunGuidText}', @ForceApply = {(ForceApply ? 1 : 0)}, @ApplySelectedOnly = {applySelectedOnly};\n-- Selected record context: {SelectedDiffRow.SchemaName}.{SelectedDiffRow.TableName} / {SelectedDiffRow.SourceRowGuid}\n{note}";
    }

    private sealed class JsonDisplayLine

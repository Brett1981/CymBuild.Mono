    private string FindExecutionLogTimestamp(string stepNameFragment)
    {
        var log = (Dashboard?.ExecutionLog ?? new List<MetadataMigrationExecutionLogItemModel>())
            .LastOrDefault(row => row.StepName.Contains(stepNameFragment, StringComparison.OrdinalIgnoreCase));

        return log?.CreatedOnUtcText ?? "-";
    }


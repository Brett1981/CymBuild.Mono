    private async Task ToggleIdentityMapIssueIgnoreAsync(MetadataMigrationIdentityMapDetailModel row) => await ExecuteAsync(async () =>
    {
        var shouldIgnore = !row.IsIgnoredIssue;
        var result = await CurrentFormHelper.MetadataMigrationIdentityMapIssueUpsertAsync(
            CurrentRunGuid(),
            row.SchemaName,
            row.TableName,
            row.SourceRowGuid,
            shouldIgnore,
            shouldIgnore ? IdentityMapIssueReason : string.Empty,
            TargetServerName,
            TargetDatabaseName);

        await LoadIdentityMapDetailsCoreAsync();
        IdentityMapIssueReason = string.Empty;
        Message = result.Message;
    }, busyMessage: "Saving identity map issue review decision. Please wait.");

    private async Task MarkIdentityMapReviewedAsync() => await ExecuteAsync(async () =>
    {
        var message = await CurrentFormHelper.MetadataMigrationIdentityMapReviewSetAsync(CurrentRunGuid(), TargetServerName, TargetDatabaseName);
        await RefreshDashboardCoreAsync(false);
        Message = string.IsNullOrWhiteSpace(message)
            ? "Identity map review acknowledged."
            : message;
    }, busyMessage: "Saving identity map review acknowledgement. Please wait.");


    private async Task LoadApplyPreviewAsync(bool selectedOnly) => await ExecuteAsync(async () =>
    {
        ApplyPreview = await CurrentFormHelper.MetadataMigrationApplyPreviewAsync(
            CurrentRunGuid(),
            selectedOnly,
            TargetServerName,
            TargetDatabaseName,
            includeIgnored: true);
        ApplyPreviewGeneratedOn = DateTime.Now;
        ApplyPreviewReviewed = ApplyPreview.IsAccepted;

        Message = selectedOnly
            ? $"Selected apply preview loaded. {ApplyPreview.ApplyCount} record(s) would apply, {ApplyPreview.SkipCount} skipped, {ApplyPreview.BlockedCount} blocked."
            : $"Apply all preview loaded. {ApplyPreview.ApplyCount} record(s) would apply, {ApplyPreview.SkipCount} skipped, {ApplyPreview.BlockedCount} blocked.";

@page "/ai-assistant"
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using Concursus.API.Core
@using Concursus.PWA.Classes
@using Microsoft.AspNetCore.Components.Forms
@inject Core.CoreClient coreClient
@inject UserService userService
@inject Sage200Microservice.API.Protos.Invoice.InvoiceService.InvoiceServiceClient sageIntegrationService
@inject HttpClient httpClient
@attribute [Authorize]


<div class="cb-v2-shell ai-assistant-shell">
    <div class="cb-v2-page ai-assistant-page">

        <div class="cb-v2-card ai-assistant-hero">
            <div class="cb-v2-card-body">
                <div class="cb-v2-panel-header ai-assistant-hero-header">
                    <div class="ai-assistant-title-wrap">
                        <div class="cb-v2-icon-wrap">AI</div>
                        <div>
                            <h2 class="cb-v2-title">CymBuild Assistant</h2>
                            <div class="cb-v2-description">
                                Ask questions, get guided steps, search trusted help content and save useful answers.
                            </div>
                        </div>
                    </div>

                    <div class="cb-v2-actions">
                        <button type="button"
                                class="cb-v2-btn-chip @(ModeCode == "BEGINNER" ? "selected" : string.Empty)"
                                @onclick="@(() => SetMode("BEGINNER"))">
                            Beginner
                        </button>
                        <button type="button"
                                class="cb-v2-btn-chip @(ModeCode == "EXPERT" ? "selected" : string.Empty)"
                                @onclick="@(() => SetMode("EXPERT"))">
                            Expert
                        </button>
                        <button type="button"
                                class="cb-v2-btn-secondary"
                                disabled="@IsBusy"
                                @onclick="StartNewConversationAsync">
                            New chat
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="cb-v2-card">
                <div class="cb-v2-card-body ai-assistant-inline-message">
                    <span class="cb-v2-badge cb-v2-badge-danger">Error</span>
                    <span>@Error</span>
                </div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="cb-v2-card">
                <div class="cb-v2-card-body ai-assistant-inline-message">
                    <span class="cb-v2-badge cb-v2-badge-info">Info</span>
                    <span>@Message</span>
                </div>
            </div>
        }

        <div class="ai-assistant-layout">
            <aside class="cb-v2-card ai-assistant-side-panel">
                <div class="cb-v2-card-body">
                    <div class="cb-v2-panel-header ai-assistant-side-header">
                        <div>
                            <h3 class="cb-v2-title ai-assistant-small-title">Saved conversations</h3>
                            <div class="cb-v2-description">Continue where you left off.</div>
                        </div>
                    </div>

                    @if (Conversations.Count == 0)
                    {
                        <div class="cb-v2-empty-state compact">
                            <strong>No conversations yet</strong>
                            <span>Start by asking a CymBuild question.</span>
                        </div>
                    }
                    else
                    {
                        <div class="ai-assistant-conversation-list">
                            @foreach (var conversation in Conversations)
                            {
                                var isSelected = SelectedConversation?.Guid == conversation.Guid;

                                <button type="button"
                                        class="ai-assistant-conversation-card @(isSelected ? "selected" : string.Empty)"
                                        @onclick="@(() => SelectConversationAsync(conversation))">
                                    <span class="ai-assistant-conversation-title">@conversation.Title</span>
                                    <span class="ai-assistant-conversation-preview">
                                        @(string.IsNullOrWhiteSpace(conversation.LastMessagePreview)
                                            ? "No messages yet"
                                            : conversation.LastMessagePreview)
                                    </span>
                                </button>
                            }
                        </div>
                    }
                </div>
            </aside>

            <main class="cb-v2-card ai-assistant-chat-panel">
                <div class="cb-v2-card-body ai-assistant-chat-body">
                    <div class="ai-assistant-chat-header">
                        <div>
                            <h3 class="cb-v2-title ai-assistant-small-title">
                                @(SelectedConversation?.Title ?? "Ask CymBuild")
                            </h3>
                            <div class="cb-v2-description">
                                Answers show whether they came from BlueGen, CymBuild knowledge, attachments, or internal fallback.
                            </div>
                        </div>
                    </div>

                    <div class="ai-assistant-messages" id="ai-assistant-messages">
                        @if (Messages.Count == 0)
                        {
                            <div class="cb-v2-empty-state">
                                <strong>What would you like help with?</strong>
                                <span>Try one of the starter questions below.</span>
                                <div class="cb-v2-actions ai-assistant-starters">
                                    @foreach (var starter in StarterQuestions)
                                    {
                                        <button type="button"
                                                class="cb-v2-btn-chip"
                                                disabled="@IsBusy"
                                                @onclick="@(() => UseStarterQuestionAsync(starter))">
                                            @starter
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var message in Messages)
                            {

                                <article class="ai-assistant-message @(message.MessageRoleCode == "USER" ? "user" : "assistant")">
                                    <div class="ai-assistant-message-meta">
                                        <span class="cb-v2-badge @(message.MessageRoleCode == "USER" ? "cb-v2-badge-info" : "cb-v2-badge-success")">
                                            @(message.MessageRoleCode == "USER" ? "You" : "Assistant")
                                        </span>

                                        @if (string.Equals(message.MessageRoleCode, "ASSISTANT", StringComparison.OrdinalIgnoreCase))
                                        {
                                            @foreach (var badge in GetAssistantMessageBadges(message))
                                            {
                                                <span class="@badge.CssClass">@badge.Label</span>
                                            }

                                            @if (message.ConfidenceScore > 0)
                                            {
                                                <span class="cb-v2-badge cb-v2-badge-info">
                                                    @GetConfidenceDisplay(message)
                                                </span>
                                            }
                                        }
                                    </div>

                                    <div class="ai-assistant-message-content">
                                        @((MarkupString)FormatMessageMarkdown(message.ContentMarkdown))
                                    </div>

                                    @if (message.MessageRoleCode == "ASSISTANT")
                                    {

                                        <div class="ai-assistant-message-actions">
                                            <button type="button"
                                                    class="cb-v2-btn-link"
                                                    disabled="@IsBusy"
                                                    @onclick="@(() => BookmarkMessageAsync(message))">
                                                Bookmark
                                            </button>
                                            <button type="button"
                                                    class="cb-v2-btn-link"
                                                    disabled="@IsBusy"
                                                    @onclick="@(() => SubmitFeedbackAsync(message, "helpful"))">
                                                Helpful
                                            </button>
                                            <button type="button"
                                                    class="cb-v2-btn-link"
                                                    disabled="@IsBusy"
                                                    @onclick="@(() => SubmitFeedbackAsync(message, "unhelpful"))">
                                                Not helpful
                                            </button>
                                        </div>
                                    }
                                </article>
                            }
                        }
                    </div>

                    @if (LastSources.Count > 0)
                    {
                        <div class="ai-assistant-sources">
                            <h4 class="cb-v2-title ai-assistant-source-title">Sources used</h4>
                            <div class="ai-assistant-source-grid">
                                @foreach (var source in LastSources)
                                {
                                    @if (!string.IsNullOrWhiteSpace(source.Url))
                                    {
                                        <a class="ai-assistant-source-card" href="@source.Url" target="_blank" rel="noopener noreferrer">
                                            <span class="ai-assistant-source-card-title">@source.Title</span>
                                            <span class="ai-assistant-source-card-meta">
                                                @source.TypeCode
                                                @if (source.IsAuthoritative)
                                                {
                                                    <span> · Authoritative</span>
                                                }
                                            </span>
                                        </a>
                                    }
                                    else
                                    {
                                        <div class="ai-assistant-source-card">
                                            <span class="ai-assistant-source-card-title">@source.Title</span>
                                            <span class="ai-assistant-source-card-meta">
                                                @source.TypeCode
                                                @if (source.IsAuthoritative)
                                                {
                                                    <span> · Authoritative</span>
                                                }
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    @if (LastFollowUps.Count > 0)
                    {
                        <div class="ai-assistant-followups">
                            @foreach (var followUp in LastFollowUps)
                            {
                                <button type="button"
                                        class="cb-v2-btn-chip"
                                        disabled="@IsBusy"
                                        @onclick="@(() => UseStarterQuestionAsync(followUp.Prompt))">
                                    @followUp.Text
                                </button>
                            }
                        </div>
                    }

                    <div class="ai-assistant-upload-strip">
                        <div class="ai-assistant-upload-copy">
                            <strong>Screenshot or file context</strong>
                            <span>Attach a CymBuild screenshot or file, wait until it appears as ready below, then send your question.</span>
                        </div>
                        <label class="cb-v2-btn-chip ai-assistant-upload-button">
                            Attach file
                            <InputFile class="ai-assistant-file-input"
                                       OnChange="OnAssistantFileSelectedAsync"
                                       disabled="@(IsBusy || IsUploadBusy)" />
                        </label>
                    </div>

                    @if (IsUploadBusy)
                    {
                        <div class="ai-assistant-upload-status">
                            <span class="cb-v2-badge cb-v2-badge-info">Uploading</span>
                            <span>Preparing the attachment for the assistant...</span>
                        </div>
                    }

                    @if (PendingUploads.Count > 0)
                    {
                        <div class="ai-assistant-upload-list" aria-label="Ready assistant attachments">
                            @foreach (var upload in PendingUploads)
                            {
                                var isReady = IsAssistantUploadReadyForSend(upload);
                                <div class="ai-assistant-upload-item @(isReady ? "ready" : "not-ready")">
                                    <span class="ai-assistant-upload-file-name">@upload.FileName</span>
                                    <span class="@GetUploadStatusBadgeCss(upload)">@GetUploadStatusLabel(upload)</span>
                                    <button type="button"
                                            class="cb-v2-btn-link"
                                            disabled="@(IsBusy || IsUploadBusy)"
                                            @onclick="@(() => RemovePendingUpload(upload.Guid))">
                                        Remove
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    <div class="ai-assistant-composer">
                        <textarea class="cb-v2-input ai-assistant-textarea"
                                  placeholder="Ask CymBuild anything..."
                                  @bind="Prompt"
                                  @bind:event="oninput"
                                  disabled="@IsBusy"></textarea>

                        <button type="button"
                                class="cb-v2-btn-secondary ai-assistant-send-button"
                                disabled="@IsSendDisabled"
                                @onclick="SendPromptAsync">
                            @(IsBusy ? "Working..." : "Send")
                        </button>
                    </div>
                </div>
            </main>

            <aside class="cb-v2-card ai-assistant-help-panel">
                <div class="cb-v2-card-body">
                    <h3 class="cb-v2-title ai-assistant-small-title">Quick actions</h3>
                    <div class="cb-v2-description">
                        Useful prompts for common CymBuild work.
                    </div>

                    <div class="ai-assistant-quick-actions">
                        @foreach (var action in QuickActions)
                        {
                            <button type="button"
                                    class="cb-v2-summary-card ai-assistant-quick-action"
                                    disabled="@IsBusy"
                                    @onclick="@(() => UseStarterQuestionAsync(action.Prompt))">
                                <span class="cb-v2-summary-title">@action.Title</span>
                                <span class="cb-v2-summary-subtitle">@action.Description</span>
                            </button>
                        }
                    </div>
                </div>
            </aside>
        </div>
    </div>
</div>

@code {
    private API.Client.FormHelper? _formHelper;

    private string Prompt = string.Empty;
    private string ModeCode = "BEGINNER";
    private string Message = string.Empty;
    private string Error = string.Empty;
    private bool IsBusy;
    private bool IsUploadBusy;
    private bool _loaded;

    private AIAssistantConversation? SelectedConversation;
    private List<AIAssistantConversation> Conversations = new();
    private List<AIAssistantMessage> Messages = new();
    private List<AIAssistantSource> LastSources = new();
    private List<AIAssistantFollowUp> LastFollowUps = new();
    private List<AIAssistantUpload> PendingUploads = new();

    private const long MaxAssistantUploadBytes = 20L * 1024L * 1024L;

    private bool IsSendDisabled => IsBusy || IsUploadBusy || string.IsNullOrWhiteSpace(Prompt) || userService.UserId <= 0;

    private API.Client.FormHelper FormHelper =>
        _formHelper ?? throw new InvalidOperationException("FormHelper has not been initialised.");

    private static readonly string[] StarterQuestions =
    [
        "How do I create a new enquiry?",
        "Why can’t I send this quote?",
        "How do I troubleshoot invoice automation?",
        "What should I check before setting up a project?"
    ];

    private static readonly QuickAction[] QuickActions =
    [
        new("Troubleshoot", "Find likely blockers and next checks.", "Help me troubleshoot this CymBuild issue step by step."),
        new("Create checklist", "Turn a task into clear actions.", "Create a CymBuild checklist for the task I am trying to complete."),
        new("Explain workflow", "Understand statuses and transitions.", "Explain how this CymBuild workflow works in plain language."),
        new("Admin guidance", "Support/admin view of a problem.", "Give me the admin/support checklist for this CymBuild issue.")
    ];

    protected override Task OnInitializedAsync()
    {
        _formHelper = new API.Client.FormHelper(
            coreClient,
            sageIntegrationService,
            Guid.Empty.ToString(),
            userService);

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (_loaded)
            return;

        if (userService.UserId <= 0)
            return;

        _loaded = true;

        await LoadConversationsAsync();

        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadConversationsAsync()
    {
        if (userService.UserId <= 0)
        {
            return;
        }

        await ExecuteAsync(async () =>
        {
            Conversations = (await FormHelper.AIAssistantConversationListAsync(
                    userService.UserId,
                    includeArchived: false))
                .ToList();

            SelectedConversation = Conversations.FirstOrDefault();

            if (SelectedConversation is not null)
            {
                await LoadMessagesAsync(SelectedConversation);
            }
        });
    }

    private async Task StartNewConversationAsync()
    {
        await ExecuteAsync(async () =>
        {
            SelectedConversation = await FormHelper.AIAssistantConversationCreateAsync(
                userService.UserId,
                "New assistant conversation",
                ModeCode);

            Conversations.Insert(0, SelectedConversation);
            Messages.Clear();
            LastSources.Clear();
            LastFollowUps.Clear();
            Prompt = string.Empty;
            Message = "New conversation started.";
        });
    }

    private async Task SelectConversationAsync(AIAssistantConversation conversation)
    {
        await ExecuteAsync(async () =>
        {
            SelectedConversation = conversation;
            await LoadMessagesAsync(conversation);
            LastSources.Clear();
            LastFollowUps.Clear();
        });
    }

    private async Task LoadMessagesAsync(AIAssistantConversation conversation)
    {
        if (!Guid.TryParse(conversation.Guid, out var conversationGuid))
        {
            throw new InvalidOperationException("The selected conversation Guid is invalid.");
        }

        Messages = (await FormHelper.AIAssistantMessageListAsync(conversationGuid)).ToList();
    }

    private async Task UseStarterQuestionAsync(string question)
    {
        Prompt = question;
        await SendPromptAsync();
    }

    private async Task SendPromptAsync()
    {
        var promptToSend = Prompt.Trim();

        if (string.IsNullOrWhiteSpace(promptToSend))
            return;

        await ExecuteAsync(async () =>
        {
            if (SelectedConversation is null)
            {
                SelectedConversation = await FormHelper.AIAssistantConversationCreateAsync(
                    userService.UserId,
                    CreateConversationTitle(promptToSend),
                    ModeCode);

                Conversations.Insert(0, SelectedConversation);
            }

            if (!Guid.TryParse(SelectedConversation.Guid, out var conversationGuid))
            {
                throw new InvalidOperationException("The selected conversation Guid is invalid.");
            }

            if (PendingUploads.Count > 0)
            {
                await EnsurePendingUploadsLinkedToConversationAsync(conversationGuid);
            }

            Prompt = string.Empty;

            var attachedUploadGuids = PendingUploads
                .Where(IsAssistantUploadReadyForSend)
                .Select(upload => upload.Guid)
                .Where(guid => !string.IsNullOrWhiteSpace(guid))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (PendingUploads.Count > 0 && attachedUploadGuids.Count == 0)
            {
                throw new InvalidOperationException("The selected attachment is not ready yet. Please wait for it to show as Ready, then send your question.");
            }

            var response = await FormHelper.AIAssistantMessageSendAsync(
                userService.UserId,
                conversationGuid,
                promptToSend,
                ModeCode,
                attachedUploadGuids: attachedUploadGuids);

            Messages.Add(response.UserMessage);
            Messages.Add(response.AssistantMessage);

            LastSources = response.Sources.ToList();
            LastFollowUps = response.FollowUps.ToList();

            if (attachedUploadGuids.Count > 0 && !response.AssistantMessage.UsedAttachments)
            {
                Message = "The question was sent, but the assistant did not report the attachment as used. Please re-attach and try again if the answer needed file or screenshot analysis.";
            }

            PendingUploads.Clear();

            await LoadConversationsAsync();

            if (SelectedConversation is not null)
            {
                SelectedConversation = Conversations.FirstOrDefault(x => x.Guid == SelectedConversation.Guid) ?? SelectedConversation;
            }
        });
    }

    private async Task BookmarkMessageAsync(AIAssistantMessage message)
    {
        await ExecuteAsync(async () =>
        {
            if (SelectedConversation is null)
                return;

            if (!Guid.TryParse(SelectedConversation.Guid, out var conversationGuid))
                return;

            if (!Guid.TryParse(message.Guid, out var messageGuid))
                return;

            await FormHelper.AIAssistantBookmarkCreateAsync(
                userService.UserId,
                conversationGuid,
                messageGuid,
                "Saved assistant answer");

            Message = "Answer bookmarked.";
        }, clearMessage: false);
    }

    private async Task SubmitFeedbackAsync(AIAssistantMessage message, string feedbackCode)
    {
        await ExecuteAsync(async () =>
        {
            if (SelectedConversation is null)
                return;

            if (!Guid.TryParse(SelectedConversation.Guid, out var conversationGuid))
                return;

            if (!Guid.TryParse(message.Guid, out var messageGuid))
                return;

            await FormHelper.AIAssistantFeedbackCreateAsync(
                userService.UserId,
                conversationGuid,
                messageGuid,
                feedbackCode);

            Message = "Feedback saved.";
        }, clearMessage: false);
    }


    private async Task OnAssistantFileSelectedAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            return;
        }

        await ExecuteAsync(async () =>
        {
            IsUploadBusy = true;

            try
            {
                if (userService.UserId <= 0)
                {
                    throw new InvalidOperationException("A valid user is required before uploading files.");
                }

                if (file.Size <= 0)
            {
                throw new InvalidOperationException("The selected file is empty.");
            }

            if (file.Size > MaxAssistantUploadBytes)
            {
                throw new InvalidOperationException($"The selected file is too large. Maximum allowed size is {MaxAssistantUploadBytes / 1024 / 1024} MB.");
            }

            var contentType = string.IsNullOrWhiteSpace(file.ContentType)
                ? "application/octet-stream"
                : file.ContentType;

            var conversationGuid = SelectedConversation?.Guid ?? string.Empty;
            var uploadPurposeCode = ResolveAssistantUploadPurposeCode(contentType);

            var presign = await FormHelper.AIAssistantUploadPresignAsync(
                userService.UserId,
                file.Name,
                contentType,
                file.Size,
                uploadPurposeCode: uploadPurposeCode,
                conversationGuid: conversationGuid);

            await using var fileStream = file.OpenReadStream(MaxAssistantUploadBytes);
            using var uploadRequest = new HttpRequestMessage(HttpMethod.Put, presign.UploadUrl);
            uploadRequest.Content = new StreamContent(fileStream);
            uploadRequest.Content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(contentType);

            foreach (var header in presign.UploadHeaders)
            {
                if (!uploadRequest.Headers.TryAddWithoutValidation(header.Key, header.Value))
                {
                    uploadRequest.Content.Headers.TryAddWithoutValidation(header.Key, header.Value);
                }
            }

            using var uploadResponse = await httpClient.SendAsync(uploadRequest);
            uploadResponse.EnsureSuccessStatusCode();

            var uploaded = await FormHelper.AIAssistantUploadCompleteAsync(
                userService.UserId,
                presign.UploadGuid,
                string.IsNullOrWhiteSpace(presign.StorageUrl) ? presign.UploadUrl : presign.StorageUrl,
                file.Name,
                contentType,
                file.Size,
                uploadPurposeCode: uploadPurposeCode,
                processingStatusCode: "UPLOADED",
                conversationGuid: conversationGuid);

                PendingUploads.Add(uploaded);
                Message = $"Attached {file.Name}. It is ready and will be sent with your next question.";
            }
            finally
            {
                IsUploadBusy = false;
            }
        }, clearMessage: false);
    }

    private async Task EnsurePendingUploadsLinkedToConversationAsync(Guid conversationGuid)
    {
        if (PendingUploads.Count == 0)
        {
            return;
        }

        var conversationGuidText = conversationGuid.ToString();
        var updatedUploads = new List<AIAssistantUpload>(PendingUploads.Count);

        foreach (var upload in PendingUploads)
        {
            if (string.Equals(upload.ConversationGuid, conversationGuidText, StringComparison.OrdinalIgnoreCase))
            {
                updatedUploads.Add(upload);
                continue;
            }

            var updated = await FormHelper.AIAssistantUploadCompleteAsync(
                userService.UserId,
                upload.Guid,
                upload.StorageUrl,
                upload.FileName,
                upload.ContentType,
                upload.FileSizeBytes,
                uploadPurposeCode: string.IsNullOrWhiteSpace(upload.UploadPurposeCode) ? ResolveAssistantUploadPurposeCode(upload.ContentType) : upload.UploadPurposeCode,
                processingStatusCode: string.IsNullOrWhiteSpace(upload.ProcessingStatusCode) ? "UPLOADED" : upload.ProcessingStatusCode,
                conversationGuid: conversationGuidText);

            updatedUploads.Add(updated);
        }

        PendingUploads = updatedUploads;
    }

    private void RemovePendingUpload(string uploadGuid)
    {
        if (string.IsNullOrWhiteSpace(uploadGuid))
        {
            return;
        }

        PendingUploads = PendingUploads
            .Where(upload => !string.Equals(upload.Guid, uploadGuid, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void SetMode(string modeCode)
    {
        ModeCode = string.Equals(modeCode, "EXPERT", StringComparison.OrdinalIgnoreCase)
            ? "EXPERT"
            : "BEGINNER";
    }

    private async Task ExecuteAsync(Func<Task> action, bool clearMessage = true)
    {
        try
        {
            IsBusy = true;
            Error = string.Empty;

            if (clearMessage)
            {
                Message = string.Empty;
            }

            await action();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
            StateHasChanged();
        }
    }

    private static string CreateConversationTitle(string prompt)
    {
        if (string.IsNullOrWhiteSpace(prompt))
            return "New assistant conversation";

        var title = prompt.Trim();

        return title.Length <= 80
            ? title
            : title[..80];
    }

    private static string FormatMessageMarkdown(string markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
            return string.Empty;

        // Minimal safe formatting for the first page version.
        // This avoids adding a markdown package dependency at this stage.
        var encoded = System.Net.WebUtility.HtmlEncode(markdown);

        return encoded
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Replace("\n", "<br />", StringComparison.Ordinal)
            .Replace("### ", "<strong>", StringComparison.Ordinal)
            .Replace("#### ", "<strong>", StringComparison.Ordinal)
            .Replace("**", string.Empty, StringComparison.Ordinal);
    }

    private static IReadOnlyList<AssistantBadge> GetAssistantMessageBadges(AIAssistantMessage message)
    {
        if (!string.Equals(message.MessageRoleCode, "ASSISTANT", StringComparison.OrdinalIgnoreCase))
        {
            return Array.Empty<AssistantBadge>();
        }

        var isBlueGenUnavailable = string.Equals(message.AnswerTypeCode, "BLUEGEN_UNAVAILABLE", StringComparison.OrdinalIgnoreCase);

        var badges = new List<AssistantBadge>
        {
            isBlueGenUnavailable
                ? new AssistantBadge("Provider: BlueGen unavailable", "cb-v2-badge cb-v2-badge-danger")
                : message.UsedBlueGen
                    ? new AssistantBadge("Provider: BlueGen", "cb-v2-badge cb-v2-badge-bluegen")
                    : new AssistantBadge("Provider: Internal", "cb-v2-badge cb-v2-badge-internal")
        };

        if (message.UsedInternalKnowledge
            || string.Equals(message.AnswerTypeCode, "TRUSTED_KNOWLEDGE", StringComparison.OrdinalIgnoreCase))
        {
            badges.Add(new AssistantBadge("CymBuild knowledge", "cb-v2-badge cb-v2-badge-bluegen-knowledge"));
        }

        if (string.Equals(message.AnswerTypeCode, "ATTACHMENT_UNAVAILABLE", StringComparison.OrdinalIgnoreCase))
        {
            badges.Add(new AssistantBadge("Attachment not available", "cb-v2-badge cb-v2-badge-danger"));
        }
        else if (message.UsedAttachments
            || string.Equals(message.AnswerTypeCode, "ATTACHMENT_ANALYSIS", StringComparison.OrdinalIgnoreCase)
            || string.Equals(message.AnswerTypeCode, "ATTACHMENT_RECEIVED", StringComparison.OrdinalIgnoreCase))
        {
            badges.Add(new AssistantBadge("Attachment used", "cb-v2-badge cb-v2-badge-attachment"));
        }

        if (!isBlueGenUnavailable && badges.Count == 1 && !message.UsedBlueGen && message.ConfidenceScore < 0.60d)
        {
            badges.Add(new AssistantBadge("General response", "cb-v2-badge cb-v2-badge-muted"));
        }

        return badges;
    }

    private static string GetUploadStatusLabel(AIAssistantUpload upload)
    {
        return IsAssistantUploadReadyForSend(upload)
            ? "Ready to send"
            : string.IsNullOrWhiteSpace(upload.ProcessingStatusCode) ? "Not ready" : upload.ProcessingStatusCode;
    }

    private static string GetUploadStatusBadgeCss(AIAssistantUpload upload)
    {
        return IsAssistantUploadReadyForSend(upload)
            ? "cb-v2-badge cb-v2-badge-success"
            : "cb-v2-badge cb-v2-badge-warning";
    }

    private static bool IsAssistantUploadReadyForSend(AIAssistantUpload upload)
    {
        if (upload is null || string.IsNullOrWhiteSpace(upload.Guid))
        {
            return false;
        }

        return string.Equals(upload.ProcessingStatusCode, "UPLOADED", StringComparison.OrdinalIgnoreCase)
            || string.Equals(upload.ProcessingStatusCode, "EXTRACTED", StringComparison.OrdinalIgnoreCase)
            || string.Equals(upload.ProcessingStatusCode, "PUBLISHED", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetConfidenceDisplay(AIAssistantMessage message)
    {
        if (message.ConfidenceScore <= 0)
        {
            return string.Empty;
        }

        return $"Confidence {Math.Round(message.ConfidenceScore * 100, 0)}%";
    }

    private static string ResolveAssistantUploadPurposeCode(string? contentType)
    {
        return !string.IsNullOrWhiteSpace(contentType)
            && contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
            ? "SCREENSHOT"
            : "ATTACHMENT";
    }

    private sealed record AssistantBadge(string Label, string CssClass);

    private sealed record QuickAction(string Title, string Description, string Prompt);
}


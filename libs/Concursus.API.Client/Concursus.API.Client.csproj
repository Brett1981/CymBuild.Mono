<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Concursus.API.Client</Title>
    <Description>Concursus API Client</Description>
    <Copyright>Shore Engineering 2023</Copyright>
    <Version>8.0.0.02</Version>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release;Test</Configurations>
  </PropertyGroup>
  <ItemGroup>
<!-- Link all API protos into the client; set ProtoRoot so imports resolve -->
  <Protobuf Include="$(ProtosRoot)**\*.proto" Link="Protos\%(RecursiveDir)%(Filename)%(Extension)" GrpcServices="Client" ProtoRoot="$(ProtosRoot)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <!--<PackageReference Include="Grpc.AspNetCore.Server" Version="2.71.0" />-->
    <PackageReference Include="Grpc.Net.Client.Web" Version="2.84.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.84.0" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="itext" Version="9.8.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client.Core" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Common" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Graph" Version="6.8.0" />
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
    <PackageReference Include="Microsoft.Net.Http.Headers" Version="10.0.13" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <!-- Pin: MimeKit pulls Pkcs 10.0.0 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7) -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- CYB-537: Telerik.DataSource removed - only consumer was TypeHelpers.cs, which had zero callers and was deleted -->
    <PackageReference Include="Microsoft.AspNetCore.Components" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Concursus.Common.Shared\Concursus.Common.Shared.csproj" />
  </ItemGroup>
</Project>

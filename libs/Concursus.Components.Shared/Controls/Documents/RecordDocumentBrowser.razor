@* FILE: Concursus.Components.Shared/Controls/Documents/RecordDocumentBrowser.razor *@
@using Concursus.API.Client
@using Concursus.API.Core
@using Microsoft.Extensions.Configuration
@using Google.Protobuf.WellKnownTypes
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IConfiguration Config

<div class="record-doc-browser native-record-doc-browser">
    <div class="doc-toolbar native-doc-toolbar">
        <div class="left native-doc-location">
            @if (_breadcrumbs.Count > 0)
            {
                <div class="breadcrumb-bar">
                    @for (var i = 0; i < _breadcrumbs.Count; i++)
                    {
                        var crumb = _breadcrumbs[i];

                        <button type="button" class="btn btn-sm btn-link crumb" @onclick="@(async () => await OnCrumbClickAsync(i))">
                            @crumb.Name
                        </button>

                        @if (i < _breadcrumbs.Count - 1)
                        {
                            <span class="crumb-sep">/</span>
                        }
                    }
                </div>
            }
        </div>

        <div class="right native-doc-actions">
            <input class="form-control form-control-sm native-doc-search"
                   value="@_searchText"
                   @oninput="OnSearchInput"
                   @onkeydown="OnSearchKeyDownAsync"
                   placeholder="Search documents..."
                   aria-label="Search documents" />
            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="ApplySearchAsync" disabled="@_filesLoading">Search</button>
            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="RefreshAsync" disabled="@_filesLoading">↻ Refresh</button>

            @if (!string.IsNullOrWhiteSpace(_location?.SharePointWebUrl))
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenInSharePointAsync">↗ Open</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_fatalError))
    {
        <div class="alert alert-danger">
            <strong>Documents unavailable.</strong> @_fatalError
            <button type="button" class="btn btn-sm btn-outline-danger ms-2" @onclick="InitializeAsync">Retry</button>
        </div>
    }
    else
    {
        <div class="doc-body">
            <div class="folders">
                <div class="panel-title">Folders</div>

                @if (_foldersLoading)
                {
                    <div class="p-3">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading folders...
                    </div>
                }
                else
                {
                    <div class="native-doc-tree" role="tree" aria-label="Document folders">
                        @foreach (var node in _folderNodes)
                        {
                            <NativeDocumentFolderNode Node="node"
                                                      CurrentFolderId="@_currentFolderId"
                                                      OnToggle="ToggleFolderAsync"
                                                      OnSelect="SelectFolderAsync" />
                        }
                    </div>
                }
            </div>

            <div class="files">
                <div class="panel-title">Documents</div>

                @if (_filesLoading)
                {
                    <div class="p-3">
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Loading documents...
                    </div>
                }
                else
                {
                    @if (_fileRows.Count == 0)
                    {
                        <div class="native-doc-empty" role="status">No documents found in this folder.</div>
                    }
                    else
                    {
                        <div class="native-doc-table-wrap">
                            <table class="table table-sm table-hover native-doc-table" aria-label="Documents">
                                <thead><tr>
                                    <th><button type="button" class="native-doc-sort" @onclick="@(() => SetSort(FileSort.Name))">Name @GetSortIndicator(FileSort.Name)</button></th>
                                    <th><button type="button" class="native-doc-sort" @onclick="@(() => SetSort(FileSort.Modified))">Date Modified @GetSortIndicator(FileSort.Modified)</button></th>
                                    <th><button type="button" class="native-doc-sort" @onclick="@(() => SetSort(FileSort.Size))">Size @GetSortIndicator(FileSort.Size)</button></th>
                                    <th>Actions</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var item in SortedFileRows)
                                    {
                                        <tr>
                                            <td><span class="doc-name"><span class="doc-icon">@GetIcon(item)</span>
                                                <button type="button" class="native-doc-name-action" style="border: 0 !important; box-shadow: none !important;" @onclick="@(() => ActivateItemAsync(item))">@item.Name</button>
                                            </span></td>
                                            <td class="text-nowrap">@FormatTimestamp(item.LastModifiedUtc)</td>
                                            <td class="text-nowrap">@(item.IsFolder ? "" : FormatBytes(item.Size))</td>
                                            <td>@if (!item.IsFolder && item.CanDownload) { <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => DownloadAsync(item))">Download</button> }</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_nextPageToken))
                    {
                        <div class="load-more">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadMoreAsync" disabled="@_filesLoading">Load more</button>
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public FormHelper? FormHelper { get; set; }
    [Parameter] public DataObject? DataObject { get; set; }
    [Parameter] public int EntityTypeId { get; set; } = -1;
    [Parameter] public string EntityQueryGuid { get; set; } = Guid.Empty.ToString();

    private DocumentsLocation? _location;

    private readonly List<Crumb> _breadcrumbs = new();
    private readonly List<FolderTreeNode> _folderNodes = new();
    private readonly List<DocumentsListItem> _fileRows = new();

    private string? _currentFolderId;
    private string? _nextPageToken;

    private bool _foldersLoading;
    private bool _filesLoading;
    private string? _fatalError;
    private string _searchText = "";
    private FileSort _currentSort = FileSort.Name;
    private bool _sortDescending;

    private IEnumerable<DocumentsListItem> SortedFileRows
    {
        get
        {
            Func<DocumentsListItem, object?> selector = _currentSort switch
            {
                FileSort.Modified => item => item.LastModifiedUtc?.ToDateTime(),
                FileSort.Size => item => item.Size,
                _ => item => item.Name
            };

            var sorted = _sortDescending
                ? _fileRows.OrderByDescending(selector)
                : _fileRows.OrderBy(selector);

            return sorted.ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnParametersSetAsync()
        => await InitializeAsync();

    private async Task InitializeAsync()
    {
        _fatalError = null;
        _location = null;

        _folderNodes.Clear();
        _fileRows.Clear();
        _breadcrumbs.Clear();
        _nextPageToken = null;
        _currentFolderId = null;

        if (FormHelper is null)
        {
            _fatalError = "Missing FormHelper parameter.";
            return;
        }

        if (DataObject is null)
        {
            _fatalError = "Missing DataObject parameter.";
            return;
        }

        var recordGuid = DataObject.Guid ?? "";
        if (!Guid.TryParse(recordGuid, out var rg) || rg == Guid.Empty)
        {
            _fatalError = "Missing record context (DataObject.Guid is empty/invalid).";
            return;
        }

        if (!Guid.TryParse(EntityQueryGuid, out var eq) || eq == Guid.Empty)
        {
            _fatalError = "Missing entity query context (EntityQueryGuid is empty/invalid).";
            return;
        }

        try
        {
            _foldersLoading = true;
            _filesLoading = true;

            _location = await FormHelper.DocumentsResolveAsync(DataObject, EntityTypeId, EntityQueryGuid);

            if (_location is null)
            {
                _fatalError = "DocumentsResolve returned no location.";
                return;
            }


            if (string.IsNullOrWhiteSpace(_location.DriveId) || string.IsNullOrWhiteSpace(_location.RootFolderId))
            {
                _fatalError = "Documents location is missing DriveId or RootFolderId.";
                return;
            }

            _currentFolderId = _location.RootFolderId;

            BuildRootFolderTree(_location);
            BuildBreadcrumbRoot(_location);

            await LoadFolderAsync(_currentFolderId, reset: true);
        }
        catch (Exception ex)
        {
            _fatalError = ex.Message;
        }
        finally
        {
            _foldersLoading = false;
            _filesLoading = false;
        }
    }

    private void BuildRootFolderTree(DocumentsLocation loc)
    {
        _folderNodes.Add(new FolderTreeNode
        {
            Id = loc.RootFolderId,
            Name = string.IsNullOrWhiteSpace(loc.RootFolderName) ? "Documents" : loc.RootFolderName,
            HasChildren = true
        });
    }

    private void BuildBreadcrumbRoot(DocumentsLocation loc)
    {
        _breadcrumbs.Clear();
        _breadcrumbs.Add(new Crumb
        {
            Name = string.IsNullOrWhiteSpace(loc.RootFolderName) ? "Documents" : loc.RootFolderName,
            FolderId = loc.RootFolderId
        });
    }

    private async Task ToggleFolderAsync(FolderTreeNode node)
    {
        if (node.IsExpanded)
        {
            node.IsExpanded = false;
            return;
        }

        if (node.ChildrenLoaded)
        {
            node.IsExpanded = true;
            return;
        }

        if (_location is null || FormHelper is null || !node.HasChildren) return;

        try
        {
            _foldersLoading = true;

            var resp = await FormHelper.DocumentsListAsync(
                driveId: _location.DriveId,
                folderId: node.Id,
                pageSize: 200,
                pageToken: null,
                searchText: null);

            // Only folders in left tree
            node.Children = resp.Items
                .Where(i => i.IsFolder)
                .Select(i => new FolderTreeNode
                {
                    Id = i.Id,
                    Name = i.Name,
                    HasChildren = i.HasChildren
                })
                .ToList();

            node.ChildrenLoaded = true;
            node.IsExpanded = true;
        }
        catch (Exception ex)
        {
            _fatalError = ex.Message;
        }
        finally
        {
            _foldersLoading = false;
        }
    }

    private async Task SelectFolderAsync(FolderTreeNode node) => await NavigateToFolderIdAsync(node.Id, node.Name);

    private async Task NavigateToFolderIdAsync(string folderId, string folderName)
    {
        _currentFolderId = folderId;
        PushBreadcrumb(folderName, folderId);
        await LoadFolderAsync(folderId, reset: true);
    }

    private async Task NavigateToFolderAsync(DocumentsListItem folder)
        => await NavigateToFolderIdAsync(folder.Id, folder.Name);

    private async Task ActivateItemAsync(DocumentsListItem item)
    {
        if (item.IsFolder) await NavigateToFolderAsync(item);
        else await DownloadAsync(item);
    }

    private void OnSearchInput(ChangeEventArgs args) => _searchText = args.Value?.ToString() ?? string.Empty;

    private async Task OnSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await ApplySearchAsync();
    }

    private async Task ApplySearchAsync()
    {
        if (!string.IsNullOrWhiteSpace(_currentFolderId)) await LoadFolderAsync(_currentFolderId, reset: true);
    }

    private void SetSort(FileSort sort)
    {
        if (_currentSort == sort) _sortDescending = !_sortDescending;
        else { _currentSort = sort; _sortDescending = false; }
    }

    private string GetSortIndicator(FileSort sort) => _currentSort != sort ? string.Empty : _sortDescending ? "▼" : "▲";

    private async Task LoadFolderAsync(string folderId, bool reset)
    {
        if (_location is null || FormHelper is null) return;

        try
        {
            _filesLoading = true;

            if (reset)
            {
                _fileRows.Clear();
                _nextPageToken = null;
            }

            var resp = await FormHelper.DocumentsListAsync(
                driveId: _location.DriveId,
                folderId: folderId,
                pageSize: 100,
                pageToken: _nextPageToken,
                searchText: string.IsNullOrWhiteSpace(_searchText) ? null : _searchText.Trim());

            _fileRows.AddRange(resp.Items);
            _nextPageToken = string.IsNullOrWhiteSpace(resp.NextPageToken) ? null : resp.NextPageToken;
        }
        catch (Exception ex)
        {
            _fatalError = ex.Message;
        }
        finally
        {
            _filesLoading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (string.IsNullOrWhiteSpace(_nextPageToken) || string.IsNullOrWhiteSpace(_currentFolderId)) return;
        await LoadFolderAsync(_currentFolderId!, reset: false);
    }

    private async Task RefreshAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentFolderId)) return;
        await LoadFolderAsync(_currentFolderId!, reset: true);
    }

    private async Task DownloadAsync(DocumentsListItem file)
    {
        if (_location is null || FormHelper is null) return;
        if (file.IsFolder || !file.CanDownload) return;

        var url = FormHelper.BuildDocumentsDownloadUrl(Config, _location.DriveId, file.Id);
        await JS.InvokeVoidAsync("cymbuild.downloadFile", url);
    }

    private async Task OpenInSharePointAsync()
    {
        if (string.IsNullOrWhiteSpace(_location?.SharePointWebUrl)) return;
        await JS.InvokeVoidAsync("open", _location.SharePointWebUrl, "_blank");
    }

    private void PushBreadcrumb(string name, string folderId)
    {
        var idx = _breadcrumbs.FindIndex(b => b.FolderId == folderId);
        if (idx >= 0)
        {
            _breadcrumbs.RemoveRange(idx + 1, _breadcrumbs.Count - (idx + 1));
            return;
        }

        _breadcrumbs.Add(new Crumb { Name = name, FolderId = folderId });
    }

    private async Task OnCrumbClickAsync(int index)
    {
        if (index < 0 || index >= _breadcrumbs.Count) return;

        var target = _breadcrumbs[index];
        if (index < _breadcrumbs.Count - 1)
        {
            _breadcrumbs.RemoveRange(index + 1, _breadcrumbs.Count - (index + 1));
        }

        _currentFolderId = target.FolderId;
        await LoadFolderAsync(target.FolderId, reset: true);
    }

    private static string GetIcon(DocumentsListItem item) => item.IsFolder ? "📁" : "📄";

    private static string FormatBytes(long bytes)
    {
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        int unit = 0;
        double size = bytes;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{size:0.##} {units[unit]}";
    }

    private static string FormatTimestamp(Timestamp ts)
    {
        if (ts == null) return "";
        var dt = ts.ToDateTime().ToLocalTime();
        return dt.ToString("dd/MM/yyyy HH:mm");
    }

    private sealed class Crumb
    {
        public string Name { get; set; } = "";
        public string FolderId { get; set; } = "";
    }

    public sealed class FolderTreeNode
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public bool HasChildren { get; set; }

        public bool ChildrenLoaded { get; set; }
        public bool IsExpanded { get; set; }
        public List<FolderTreeNode> Children { get; set; } = new();
    }

    private enum FileSort { Name, Modified, Size }
}

@attribute [Authorize]
@using Concursus.Components.Shared.Modals

<div class="schedule-item-readonly">
    <div class="row mb-2">
        <div class="col-md-3"><strong>Start Date:</strong></div>
        <div class="col-md-9">@Display(StartDateTime)</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-3"><strong>End Date:</strong></div>
        <div class="col-md-9">@Display(EndDateTime)</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-3"><strong>Title:</strong></div>
        <div class="col-md-9">@Display(Title)</div>
    </div>

    <div class="row mb-2">
        <div class="col-md-3"><strong>Description:</strong></div>
        <div class="col-md-9">@Display(Description)</div>
    </div>

    <div class="row mb-3">
        <div class="col-md-3"><strong>Job Number:</strong></div>
        <div class="col-md-9">@Display(JobNumber)</div>
    </div>

</div>

@code {
    [Parameter] public string StartDateTime { get; set; } = string.Empty;
    [Parameter] public string EndDateTime { get; set; } = string.Empty;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string JobNumber { get; set; } = string.Empty;

    private static string Display(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }
}
@page "/debug-interactions"
@using Concursus.Components.Shared.Services
@inject NavigationManager NavManager
@inject UserInteractionTrackerService InteractionTracker

<section class="cb-native-dev-page" aria-labelledby="interaction-debug-title">
    <header class="cb-native-dev-header">
        <div class="cb-native-dev-title-wrap">
            <span aria-hidden="true">🔍</span>
            <div>
                <h3 id="interaction-debug-title" class="mb-1">User Interaction Debug Viewer</h3>
                <p class="text-muted mb-0">Review interaction steps captured during this browser session.</p>
            </div>
        </div>
    </header>

    <div class="cb-native-dev-card cb-v2-card">
        <div class="cb-v2-card-body cb-native-dev-toolbar">
            <label for="interaction-page-filter"><strong>Page filter</strong></label>
            <select id="interaction-page-filter"
                    class="form-select cb-native-dev-search"
                    value="@SelectedPageKey"
                    @onchange="OnPageFilterChanged">
                @foreach (var item in AllPageKeys)
                {
                    <option value="@item.Value">@item.Text</option>
                }
            </select>
            <span class="cb-native-dev-toolbar-spacer"></span>
            <button type="button" class="btn btn-outline-danger" @onclick="ClearLogs" disabled="@(!InteractionTracker.GetAllLogs().Any())">
                <span aria-hidden="true">🗑</span> Clear all logs
            </button>
        </div>
    </div>

    @if (FilteredLogs.Count > 0)
    {
        <div class="cb-native-dev-table-wrap">
            <table class="table table-sm table-hover cb-native-dev-table cb-native-dev-table-compact" aria-label="User interaction logs">
                <thead>
                    <tr>
                        <th scope="col">Timestamp</th>
                        <th scope="col">Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in PagedLogs)
                    {
                        <tr>
                            <td class="text-nowrap">@entry.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@entry.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="cb-native-dev-pager" aria-label="Interaction log pages">
            <span>Showing @FirstVisibleLog to @LastVisibleLog of @FilteredLogs.Count</span>
            <button type="button" class="btn btn-outline-secondary" @onclick="PreviousPage" disabled="@(CurrentPage == 1)">Previous</button>
            <span>Page @CurrentPage of @TotalPages</span>
            <button type="button" class="btn btn-outline-secondary" @onclick="NextPage" disabled="@(CurrentPage == TotalPages)">Next</button>
        </nav>
    }
    else
    {
        <div class="cb-native-dev-empty" role="status">No interaction logs recorded for the selected page.</div>
    }
</section>

@code {
    private const int PageSize = 10;
    private int CurrentPage { get; set; } = 1;
    private string CurrentPageKey => NavManager.Uri.Replace(NavManager.BaseUri, string.Empty).TrimEnd('/');
    private string SelectedPageKey { get; set; } = "ALL";

    private List<string> PageKeys => InteractionTracker.GetAllPageKeys().OrderBy(key => key, StringComparer.OrdinalIgnoreCase).ToList();

    private List<LogEntry> FilteredLogs =>
        SelectedPageKey == "ALL"
            ? InteractionTracker.GetAllLogs()
            : InteractionTracker.GetLogsForPage(SelectedPageKey).OrderByDescending(entry => entry.Timestamp).ToList();

    private List<DropdownItem> AllPageKeys =>
        new[] { new DropdownItem("ALL", "All pages") }
            .Concat(PageKeys.Select(key => new DropdownItem(key, key == CurrentPageKey ? $"{key} (current)" : key)))
            .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredLogs.Count / (double)PageSize));
    private IEnumerable<LogEntry> PagedLogs => FilteredLogs.Skip((CurrentPage - 1) * PageSize).Take(PageSize);
    private int FirstVisibleLog => FilteredLogs.Count == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int LastVisibleLog => Math.Min(CurrentPage * PageSize, FilteredLogs.Count);

    private void OnPageFilterChanged(ChangeEventArgs args)
    {
        SelectedPageKey = args.Value?.ToString() ?? "ALL";
        CurrentPage = 1;
    }

    private void PreviousPage() => CurrentPage = Math.Max(1, CurrentPage - 1);
    private void NextPage() => CurrentPage = Math.Min(TotalPages, CurrentPage + 1);

    private void ClearLogs()
    {
        InteractionTracker.ClearAll();
        SelectedPageKey = "ALL";
        CurrentPage = 1;
    }

    private sealed record DropdownItem(string Value, string Text);
}

@namespace Concursus.Components.Shared.Controls
@inject NavigationManager Navigation
@using Concursus.API.Core

<div class="cb-modern-metric cb-modern-metric-number @(CanOpenMetric ? "cb-modern-metric-clickable" : "")"
     role="@(CanOpenMetric ? "button" : null)"
     tabindex="@(CanOpenMetric ? "0" : null)"
     @onclick="HandleClickOnMetric">
    <div class="cb-modern-metric-top">
        <div>
            <div class="cb-modern-metric-label">@Metric?.Label</div>
            <div class="cb-modern-metric-subtitle">@Subtitle</div>
        </div>
        <div class="cb-modern-metric-icon">
            <i class="bi bi-graph-up-arrow"></i>
        </div>
    </div>

    <div class="cb-modern-metric-value">
        @DisplayValue
    </div>

    <div class="cb-modern-metric-progress">
        <div class="cb-modern-metric-progress-bar"
             style="width:@ProgressPercent%;"></div>
    </div>

    <div class="cb-modern-metric-footer">
        <span>Min @FormatNumber(Min)</span>
        <span>Max @FormatNumber(Max)</span>
    </div>
</div>

@code {
    [Parameter] public DashboardMetric? Metric { get; set; }

    private double Value => Metric?.Values.FirstOrDefault()?.Value ?? 0;
    private double Min => Metric?.Min ?? 0;
    private double Max => Metric?.Max > Min ? Metric.Max : 100;

    private string DisplayValue => FormatNumber(Value);

    private string Subtitle =>
        Metric?.Values.Count > 1
            ? $"{Metric.Values.Count} values"
            : "Current value";

    private double ProgressPercent
    {
        get
        {
            var range = Max - Min;
            if (range <= 0)
            {
                return 0;
            }

            var percentage = ((Value - Min) / range) * 100;
            return Math.Clamp(percentage, 0, 100);
        }
    }

    private static string FormatNumber(double value)
    {
        return value % 1 == 0
            ? value.ToString("N0")
            : value.ToString("N2");
    }
}
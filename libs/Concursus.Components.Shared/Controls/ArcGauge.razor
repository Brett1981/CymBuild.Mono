@inject Core.CoreClient CoreClient
@inject NavigationManager Navigation
@namespace Concursus.Components.Shared.Controls
@using Concursus.API.Core

<div class="cb-modern-metric cb-modern-metric-gauge @(CanOpenMetric ? "cb-modern-metric-clickable" : "")"
     role="@(CanOpenMetric ? "button" : null)"
     tabindex="@(CanOpenMetric ? "0" : null)"
     @onclick="HandleClickOnMetric">
    <div class="cb-modern-metric-top">
        <div>
            <div class="cb-modern-metric-label">@Metric?.Label</div>
            <div class="cb-modern-metric-subtitle">Arc gauge</div>
        </div>
        <div class="cb-modern-metric-pill">@ProgressPercent.ToString("N0")%</div>
    </div>

    <div class="cb-modern-arc-wrap">
        <svg viewBox="0 0 120 70" class="cb-modern-arc">
            <path d="M 15 60 A 45 45 0 0 1 105 60"
                  class="cb-modern-arc-track" />

            <path d="M 15 60 A 45 45 0 0 1 105 60"
                  class="cb-modern-arc-value"
                  style="stroke-dasharray:@ArcDashArray;" />
        </svg>

        <div class="cb-modern-arc-value-text">
            @DisplayValue
        </div>
    </div>

    <div class="cb-modern-metric-footer">
        <span>@FormatNumber(Min)</span>
        <span>@FormatNumber(Max)</span>
    </div>
</div>

@code {
    [Parameter] public DashboardMetric? Metric { get; set; }

    private double Value => Metric?.Values.FirstOrDefault()?.Value ?? 0;
    private double Min => Metric?.Min ?? 0;
    private double Max => Metric?.Max > Min ? Metric.Max : 100;

    private string DisplayValue => FormatNumber(Value);

    private double ProgressPercent
    {
        get
        {
            var range = Max - Min;
            if (range <= 0)
            {
                return 0;
            }

            var percentage = ((Value - Min) / range) * 100;
            return Math.Clamp(percentage, 0, 100);
        }
    }

    private string ArcDashArray
    {
        get
        {
            const double pathLength = 141.4;
            var filled = pathLength * (ProgressPercent / 100.0);
            var empty = pathLength - filled;
            return $"{filled:N2} {empty:N2}";
        }
    }

    private static string FormatNumber(double value)
    {
        return value % 1 == 0
            ? value.ToString("N0")
            : value.ToString("N2");
    }
}
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>1af6dd54-af63-4515-ac7d-aa5f1afa814e</UserSecretsId>
    <Configurations>Debug;Release;Test</Configurations>
    <FileVersion>10.0.22.103</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="CSharp\**" />
    <Compile Remove="EntityFramework\**" />
    <Compile Remove="k8s\**" />
    <Content Remove="CSharp\**" />
    <Content Remove="EntityFramework\**" />
    <Content Remove="k8s\**" />
    <EmbeddedResource Remove="CSharp\**" />
    <EmbeddedResource Remove="EntityFramework\**" />
    <EmbeddedResource Remove="k8s\**" />
    <None Remove="CSharp\**" />
    <None Remove="EntityFramework\**" />
    <None Remove="k8s\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Classes\WordDocumentService - Copy.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Concursus.API.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="appsettings.Production.json" />
    <Content Remove="nuget.config" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="DockerFile" />
    <None Remove="Protos\NUL" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos\core.proto" GrpcServices="Server" />

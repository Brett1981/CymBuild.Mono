@using Concursus.API.Client.Models
@using Concursus.Components.Shared.Services
@using Concursus.PWA.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Concursus.PWA.Helpers

@inject Core.CoreClient CoreClient
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime
@inject UserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAccessTokenProvider TokenProvider
@inject AiErrorReporter AiErrorReporter
@inject UserInteractionTrackerService InteractionTracker
@inject IToastService Toast

@attribute [Authorize]

<style>
    .custom-telerik-grid {
        max-height: auto;
        width: 100%;
        height: auto;
        overflow: auto;
    }

    .card h5 {
        max-width: 200px;
    }

    .custom-ellipsis,
    .k-grid td.custom-ellipsis,
    .k-grid tr.custom-ellipsis .k-table-td {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-v2-dashboard-loading {
        min-height: 90px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<AuthorizeView>
    <Authorized>
        <MessageDisplay @ref="_messageDisplay"
                        ErrorMessage="@ErrorMessage"
                        PageMethod="@PageMethod"
                        MessageType="MessageType" />

        <h4>
            <i class="bi bi-house-fill me-2" style="font-size: 1.2rem;"></i>
            Dashboard
        </h4>

        <div class="d-flex flex-row flex-wrap justify-content-around align-items-start transition-fade-in">
            <div class="col-lg-3 align-items-start">

                <div class="card shadow-sm p-2 m-2" style="max-height:auto">
                    <div class="card-body">
                        <div class="card-title d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Recent</h5>
                        </div>

                        @if (_recentItemsLoading)
                        {
                            <div class="cb-v2-dashboard-loading">
                                <div class="cb-v2-muted">Loading recent items...</div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_recentItemsError))
                        {
                            <div class="cb-v2-badge cb-v2-badge-danger">@_recentItemsError</div>
                        }
                        else if (_recentItems?.RecentItems?.Count > 0)
                        {
                            <TelerikGrid Data="@_recentItems.RecentItems"
                                         PageSize="10"
                                         Class="custom-telerik-grid"
                                         SelectionMode="GridSelectionMode.Single"
                                         OnRowDoubleClick="HandleRowDoubleClick">
                                <GridColumns>
                                    <GridColumn Field="@nameof(RecentItem.EntityTypeLabel)" Title="Type" />
                                    <GridColumn Field="@nameof(RecentItem.Label)" Title="Record" />
                                </GridColumns>
                            </TelerikGrid>
                        }
                        else
                        {
                            <div class="cb-v2-muted">No recent items found.</div>
                        }
                    </div>
                </div>

                <div class="card shadow-sm p-2 m-2" style="max-height:auto">
                    <div class="card-body">
                        <div class="card-title d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Schedule</h5>

                            <button type="button"
                                    class="btn btn-default"
                                    id="_schedule"
                                    @onclick="@(_ => HandleClickOnMetric("_schedule"))">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                        </div>

                        @if (_scheduleItemsLoading)
                        {
                            <div class="cb-v2-dashboard-loading">
                                <div class="cb-v2-muted">Loading scheduled items...</div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_scheduleItemsError))
                        {
                            <div class="cb-v2-badge cb-v2-badge-danger">@_scheduleItemsError</div>
                        }
                        else
                        {
                            <div class="cb-v2-table-wrap">
                                <table class="cb-v2-table">
                                    <thead>
                                        <tr>
                                            <th>Start</th>
                                            <th>Title</th>
                                            <th class="text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (_scheduleItems?.ScheduleItems == null || _scheduleItems.ScheduleItems.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="3">
                                                    <div class="cb-v2-muted">No scheduled items found.</div>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in _scheduleItems.ScheduleItems)
                                            {
                                                <tr>
                                                    <td>@UiFormattingHelper.FormatDateForUI(item.Start.ToDateTime(), false)</td>
                                                    <td>
                                                        <div class="cb-v2-ellipsis" title="@item.Title">
                                                            @item.Title
                                                        </div>
                                                    </td>
                                                    <td class="text-end">
                                                        <button type="button"
                                                                class="cb-v2-btn-secondary"
                                                                @onclick="() => OpenScheduleInfoAsync(item)">
                                                            View
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-9 d-flex flex-wrap">
                @if (_metricsLoading)
                {
                    <div class="card shadow-sm p-2 m-2 flex-fill">
                        <div class="cb-v2-dashboard-loading">
                            <div class="cb-v2-muted">Loading dashboard metrics...</div>
                        </div>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(_metricsError))
                {
                    <div class="card shadow-sm p-2 m-2 flex-fill">
                        <div class="cb-v2-badge cb-v2-badge-danger">@_metricsError</div>
                    </div>
                }
                else
                {
                    @foreach (var dm in Metrics.OrderBy(m => m.DisplayGroupName).ThenBy(m => m.DisplayOrder))
                    {
                        switch (dm.MetricTypeName)
                        {
                            case "NumberValue":
                                <div class="card shadow-sm p-2 m-2 flex-fill">
                                    <NumberValue Metric="dm" />
                                </div>
                                break;

                            case "ArcGauge":
                                <div class="card shadow-sm p-2 m-2 flex-fill">
                                    <ArcGauge Metric="dm" />
                                </div>
                                break;

                            case "RadialGauge":
                                <div class="card shadow-sm p-2 m-2 flex-fill">
                                    <RadialGauge Metric="dm" />
                                </div>
                                break;
                        }
                    }
                }
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <p>You are not authorized to view this content. Please log in.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        StartDashboardDataLoads();

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated == true)
            {
                var result = await TokenProvider.RequestAccessToken();

                if (result.TryGetToken(out var token))
                {
                    await JsRuntime.InvokeVoidAsync("sendTokenToIframe", token.Value);
                }
            }
            else
            {
                var ex = new Exception("Unable to identify if the user is authenticated")
                {
                    Data =
                    {
                        { "MessageType", MessageDisplay.ShowMessageType.Error },
                        { "AdditionalInfo", "Unable to identify if the user is authenticated." },
                        { "PageMethod", "Dashboard/OnAfterRenderAsync()" }
                    }
                };

                await OnError(ex);
            }
        }
        catch (Exception ex)
        {
            ex.Data["MessageType"] = MessageDisplay.ShowMessageType.Error;
            ex.Data["AdditionalInfo"] = "Error during dashboard post-render authentication setup.";
            ex.Data["PageMethod"] = "Dashboard/OnAfterRenderAsync()";
            await OnError(ex);
        }
    }
}
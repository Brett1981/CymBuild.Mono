@using System.Dynamic
@using System.Globalization
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using Concursus.API.Core
@using Concursus.PWA.Classes
@using Concursus.PWA.Helpers
@using Microsoft.AspNetCore.Components
@implements IDisposable

@inject Core.CoreClient coreClient
@inject ModalService modalService
@inject UserService userService

@attribute [Authorize]

@if (_bulkRecordChangeVisible)
{
    <div class="activity-bulk-change-backdrop">
        <div class="activity-bulk-change-modal">
            <div class="activity-bulk-change-header">
                <div>
                    <div class="cb-v2-subtitle">Bulk activity update</div>
                    <h4 class="cb-v2-title mb-0">Apply selected changes</h4>
                </div>
                <button type="button" class="cb-v2-btn-secondary" @onclick="CloseBulkRecordChangeAsync">Close</button>
            </div>

            <div class="activity-bulk-change-body">
                <DynamicComponent Type="@Type.GetType($"Concursus.PWA.Pages.BulkRecordChange")"
                                  Parameters="@_detailPageParameters" />
            </div>
        </div>
    </div>
}

<div class="cb-v2-page activity-bulk-update-page">
    <div class="cb-v2-card activity-bulk-update-card">
        <div class="cb-v2-card-body">
            <div class="cb-v2-header-row activity-bulk-update-header mb-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="cb-v2-icon-wrap">
                        <i class="bi bi-list-check"></i>
                    </div>
                    <div>
                        <div class="cb-v2-subtitle">Select Items for Bulk Editing</div>
                        <h4 class="cb-v2-title mb-1">@DisplayText(ViewDefinition?.Name, "Job Activity")</h4>
                        <p class="cb-v2-description mb-0">
                            Filter, sort, page, and select activities before applying a bulk update.
                        </p>
                    </div>
                </div>

                <div class="cb-v2-actions activity-bulk-update-actions">
                    <button type="button" class="cb-v2-btn-secondary" @onclick="ResetFiltersAsync" disabled="@_isLoading">
                        Reset filters
                    </button>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="LoadAllRowsAsync" disabled="@_isLoading">
                        @if (_isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        Refresh
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="alert @(_isError ? "alert-danger" : "alert-info") activity-bulk-update-message">
                    @_message
                </div>
            }

            <div class="cb-v2-toolbar activity-bulk-update-toolbar mb-3">
                <div class="cb-v2-toolbar-left activity-bulk-update-toolbar-left">
                    <div>
                        <label class="form-label">Search all visible fields</label>
                        <input class="cb-v2-input activity-bulk-search"
                               value="@_searchText"
                               @oninput="OnSearchChanged"
                               disabled="@_isLoading"
                               placeholder="Search activity rows..." />
                    </div>
                </div>

                <div class="cb-v2-toolbar-right activity-bulk-update-toolbar-right">
                    <div class="cb-v2-stat-pill">
                        <span class="cb-v2-pill-label">Rows</span>
                        <span class="cb-v2-pill-value">@_filteredRows.Count</span>
                    </div>
                    <div class="cb-v2-stat-pill">
                        <span class="cb-v2-pill-label">Selected</span>
                        <span class="cb-v2-pill-value">@_selectedRowKeys.Count</span>
                    </div>
                </div>
            </div>

            @if (_isLoading)
            {
                <div class="cb-v2-empty-state activity-bulk-loading-state">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Loading Job Activity records...
                </div>
            }
            else if (ViewDefinition is null)
            {
                <div class="cb-v2-empty-state">Activity grid metadata was not supplied.</div>
            }
            else
            {
                <div class="cb-v2-table-wrap activity-bulk-table-wrap">
                    <table class="cb-v2-table activity-bulk-table">
                        <thead>
                            <tr>
                                <th class="activity-bulk-checkbox-col">
                                    <input type="checkbox"
                                           checked="@IsCurrentPageFullySelected"
                                           @onchange="ToggleSelectAllCurrentPage" />
                                </th>
                                @foreach (var column in VisibleColumns)
                                {
                                    <th class="activity-bulk-sortable-header" @onclick="() => ToggleSort(column.Name)">
                                        <span>@GetColumnTitle(column)</span>
                                        @if (string.Equals(_sortColumn, column.Name, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="activity-bulk-sort-indicator">@(_sortDescending ? "▼" : "▲")</span>
                                        }
                                    </th>
                                }
                            </tr>
                            <tr class="activity-bulk-filter-row">
                                <th></th>
                                @foreach (var column in VisibleColumns)
                                {
                                    <th>
                                        <input class="activity-bulk-column-filter"
                                               value="@GetColumnFilter(column.Name)"
                                               @oninput="args => SetColumnFilter(column.Name, args.Value?.ToString())"
                                               disabled="@_isLoading"
                                               placeholder="Filter..." />
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (_pageRows.Count == 0)
                            {
                                <tr>
                                    <td colspan="@(VisibleColumns.Count + 1)">
                                        <div class="cb-v2-empty-state">No Job Activity rows match the current filters.</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in _pageRows)
                                {
                                    var rowDict = (IDictionary<string, object>)row;
                                    var rowKey = GetRowKey(rowDict);
                                    var isSelected = !string.IsNullOrWhiteSpace(rowKey) && _selectedRowKeys.Contains(rowKey);

                                    <tr class="@(isSelected ? "cb-v2-table-row-selected" : string.Empty)">
                                        <td class="activity-bulk-checkbox-col">
                                            <input type="checkbox"
                                                   checked="@isSelected"
                                                   disabled="@(string.IsNullOrWhiteSpace(rowKey))"
                                                   @onchange="args => ToggleRowSelection(rowDict, args.Value)" />
                                        </td>

                                        @foreach (var column in VisibleColumns)
                                        {
                                            <td class="cb-v2-ellipsis activity-bulk-cell" title="@RenderCellValue(rowDict, column.Name)">
                                                @RenderCellValue(rowDict, column.Name)
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="activity-bulk-footer">
                    <div class="activity-bulk-footer-left">
                        Showing @PageStartRow to @PageEndRow of @_filteredRows.Count rows
                    </div>
                    <div class="activity-bulk-footer-right">
                        <button type="button" class="cb-v2-btn-secondary" @onclick="FirstPageAsync" disabled="@(_currentPage <= 1)">«</button>
                        <button type="button" class="cb-v2-btn-secondary" @onclick="PreviousPageAsync" disabled="@(_currentPage <= 1)">‹</button>
                        <span class="activity-bulk-page-pill">Page @_currentPage of @TotalPages</span>
                        <button type="button" class="cb-v2-btn-secondary" @onclick="NextPageAsync" disabled="@(_currentPage >= TotalPages)">›</button>
                        <button type="button" class="cb-v2-btn-secondary" @onclick="LastPageAsync" disabled="@(_currentPage >= TotalPages)">»</button>
                    </div>
                </div>

                <div class="activity-bulk-command-row">
                    <button type="button" class="btn btn-primary" @onclick="MoveNextAsync" disabled="@(_selectedRowKeys.Count == 0)">
                        Next
                    </button>
                    <button type="button" class="btn btn-danger" @onclick="CancelAsync">
                        Cancel
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>

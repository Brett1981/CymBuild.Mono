        padding: 1.5rem;
    }

    .activity-bulk-change-modal {
        width: min(1100px, 96vw);
        max-height: 94vh;
        overflow: hidden;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.24);
    }

    .activity-bulk-change-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #e5edf7;
    }

    .activity-bulk-change-body {
        max-height: calc(94vh - 76px);
        overflow: auto;
        padding: 1rem;
    }
</style>

@code {
    private const int ClientPageSize = 10;
    private const int ServerPageSize = 500;
    private const int MaxRowsToLoad = 10000;

    private readonly List<ExpandoObject> _allRows = new();
    private readonly List<ExpandoObject> _filteredRows = new();
    private readonly List<ExpandoObject> _pageRows = new();
    private readonly Dictionary<string, string> _columnFilters = new(StringComparer.OrdinalIgnoreCase);
    private readonly HashSet<string> _selectedRowKeys = new(StringComparer.OrdinalIgnoreCase);

    private Dictionary<string, object> _detailPageParameters = new();
    private FormHelper? _formHelper;
    private CancellationTokenSource? _loadCancellation;
    private string _loadedKey = string.Empty;
    private string _message = string.Empty;
    private string _searchText = string.Empty;
    private string _sortColumn = string.Empty;
    private string _bulkModalId = string.Empty;
    private bool _bulkRecordChangeVisible;
    private bool _isError;
    private bool _isLoading;
    private bool _sortDescending;
    private int _currentPage = 1;

    [Parameter] public EventCallback OnActionCompleted { get; set; }
    [Parameter] public GridViewDefinition? ViewDefinition { get; set; }
    [Parameter] public string GridCode { get; set; } = string.Empty;
    [Parameter] public DataObjectReference ParentDataObjectReference { get; set; } = new("", "");
    [Parameter] public string ParentGuid { get; set; } = Guid.Empty.ToString();
    [Parameter] public bool FullGrid { get; set; }

    private IReadOnlyList<GridViewColumnDefinition> VisibleColumns =>
        ViewDefinition?.Columns
            .Where(c => c is not null && !c.IsHidden && !string.Equals(c.Name, "Guid", StringComparison.OrdinalIgnoreCase))
            .OrderBy(c => c.ColumnOrder)
            .ToList()
        ?? new List<GridViewColumnDefinition>();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_filteredRows.Count / (double)ClientPageSize));
    private int PageStartRow => _filteredRows.Count == 0 ? 0 : ((_currentPage - 1) * ClientPageSize) + 1;
    private int PageEndRow => Math.Min(_currentPage * ClientPageSize, _filteredRows.Count);

    private bool IsCurrentPageFullySelected =>
        _pageRows.Count > 0
        && _pageRows.All(row =>
        {
            var rowKey = GetRowKey((IDictionary<string, object>)row);
            return !string.IsNullOrWhiteSpace(rowKey) && _selectedRowKeys.Contains(rowKey);
        });

    protected override async Task OnParametersSetAsync()
    {
        var key = $"{GridCode}|{ViewDefinition?.Code}|{ParentGuid}";
        if (!string.Equals(_loadedKey, key, StringComparison.Ordinal))
        {
            _loadedKey = key;
            InitialiseSort();
            await LoadAllRowsAsync();
        }
    }

    public void Dispose()
    {
        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        UnregisterBulkModal();
    }

    private void EnsureFormHelper()
    {
        var entityTypeGuid = ViewDefinition?.EntityTypeGuid.ToString() ?? Guid.Empty.ToString();
        _formHelper ??= new FormHelper(coreClient, entityTypeGuid, userService);
    }

    private void InitialiseSort()
    {
        _sortColumn = ViewDefinition?.DefaultSortColumnName ?? string.Empty;
        _sortDescending = ViewDefinition?.IsDefaultSortDescending ?? false;
    }

    private async Task LoadAllRowsAsync()
    {
        if (ViewDefinition is null)
        {
            return;
        }

        _loadCancellation?.Cancel();
        _loadCancellation?.Dispose();
        _loadCancellation = new CancellationTokenSource();
        var cancellationToken = _loadCancellation.Token;

        EnsureFormHelper();
        _isLoading = true;
        _isError = false;
        _message = string.Empty;
        StateHasChanged();

        try
        {
            var loadedRows = new List<ExpandoObject>();
            var parentGuid = PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(ParentGuid).ToString();
            var page = 1;
            var totalRows = 0;

            do
            {
                var request = new GridDataListRequest
                {
                    GridCode = GridCode,
                    GridViewCode = ViewDefinition.Code,
                    Page = page,
                    PageSize = ServerPageSize,
                    ParentGuid = parentGuid
                };

                var reply = await _formHelper!.GridDataListAsync(request, cancellationToken);
                cancellationToken.ThrowIfCancellationRequested();

                totalRows = (int)reply.TotalRows;
                loadedRows.AddRange(ConvertRows(reply));

                page++;
            }
            while (loadedRows.Count < totalRows && loadedRows.Count < MaxRowsToLoad);

            _allRows.Clear();
            _allRows.AddRange(loadedRows);

            if (totalRows > MaxRowsToLoad)
            {
                _message = $"Loaded the first {MaxRowsToLoad:N0} of {totalRows:N0} activity rows. Narrow the parent grid context if more rows are required.";
                _isError = false;
            }

            ApplyClientSideView(resetPage: true);
        }
        catch (OperationCanceledException)
        {
            // A newer load request has replaced this one.
        }
        catch (Exception ex)
        {
            _allRows.Clear();
            _filteredRows.Clear();
            _pageRows.Clear();
            _isError = true;
            _message = $"Failed to load Job Activity rows: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private static IEnumerable<ExpandoObject> ConvertRows(GridDataListReply reply)
    {
        foreach (var row in reply.DataTable)
        {
            IDictionary<string, object> expando = new ExpandoObject();

            foreach (var column in row.Columns)
            {
                var value = column.Value;

                if (DateTime.TryParse(value, CultureInfo.CurrentCulture, DateTimeStyles.None, out var dateTimeValue))
                {
                    value = UiFormattingHelper.FormatDynamicDate(column.Name, dateTimeValue);
                }

                expando[column.Name] = value;
            }

            yield return (ExpandoObject)expando;
        }
    }

    private void ApplyClientSideView(bool resetPage)
    {
        IEnumerable<ExpandoObject> working = _allRows;

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            working = working.Where(RowContainsSearchText);
        }

        foreach (var filter in _columnFilters.Where(f => !string.IsNullOrWhiteSpace(f.Value)))
        {
            working = working.Where(row => CellContains((IDictionary<string, object>)row, filter.Key, filter.Value));
        }

        if (!string.IsNullOrWhiteSpace(_sortColumn))
        {
            working = _sortDescending
                ? working.OrderByDescending(row => GetSortToken((IDictionary<string, object>)row, _sortColumn), StringComparer.OrdinalIgnoreCase)
                : working.OrderBy(row => GetSortToken((IDictionary<string, object>)row, _sortColumn), StringComparer.OrdinalIgnoreCase);
        }

        _filteredRows.Clear();
        _filteredRows.AddRange(working);

        if (resetPage)
        {
            _currentPage = 1;
        }

        if (_currentPage > TotalPages)
        {
            _currentPage = TotalPages;
        }

        if (_currentPage < 1)
        {
            _currentPage = 1;
        }

        _pageRows.Clear();
        _pageRows.AddRange(_filteredRows.Skip((_currentPage - 1) * ClientPageSize).Take(ClientPageSize));
    }

    private bool RowContainsSearchText(ExpandoObject row)
    {
        var dict = (IDictionary<string, object>)row;
        return VisibleColumns.Any(column => CellContains(dict, column.Name, _searchText));
    }

    private static bool CellContains(IDictionary<string, object> row, string columnName, string searchText)
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return true;
        }

        var cellValue = RenderCellValue(row, columnName);
        return cellValue.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase);
    }

    private static string GetSortToken(IDictionary<string, object> row, string columnName)
    {
        var value = RenderCellValue(row, columnName);

        if (DateTime.TryParse(value, CultureInfo.CurrentCulture, DateTimeStyles.None, out var dateValue))
        {
            return dateValue.ToString("O", CultureInfo.InvariantCulture);
        }

        if (decimal.TryParse(value, NumberStyles.Any, CultureInfo.CurrentCulture, out var decimalValue))
        {
            return decimalValue.ToString("00000000000000000000.000000", CultureInfo.InvariantCulture);
        }

        return value;
    }

    private void OnSearchChanged(ChangeEventArgs args)
    {
        _searchText = args.Value?.ToString() ?? string.Empty;
        ApplyClientSideView(resetPage: true);
    }

    private void SetColumnFilter(string columnName, string? value)
    {
        _columnFilters[columnName] = value ?? string.Empty;
        ApplyClientSideView(resetPage: true);
    }

    private string GetColumnFilter(string columnName) =>
        _columnFilters.TryGetValue(columnName, out var filter) ? filter : string.Empty;

    private async Task ResetFiltersAsync()
    {
        _searchText = string.Empty;
        _columnFilters.Clear();
        _selectedRowKeys.Clear();
        InitialiseSort();
        ApplyClientSideView(resetPage: true);
        await Task.CompletedTask;
    }

    private void ToggleSort(string columnName)
    {
        if (string.Equals(_sortColumn, columnName, StringComparison.OrdinalIgnoreCase))
        {
            _sortDescending = !_sortDescending;
        }
        else
        {
            _sortColumn = columnName;
            _sortDescending = false;
        }

        ApplyClientSideView(resetPage: false);
    }

    private void ToggleSelectAllCurrentPage(ChangeEventArgs args)
    {
        var shouldSelect = args.Value is bool boolValue && boolValue;

        foreach (var row in _pageRows)
        {
            var rowKey = GetRowKey((IDictionary<string, object>)row);
            if (string.IsNullOrWhiteSpace(rowKey))
            {
                continue;
            }

            if (shouldSelect)
            {
                _selectedRowKeys.Add(rowKey);
            }
            else
            {
                _selectedRowKeys.Remove(rowKey);
            }
        }
    }

    private void ToggleRowSelection(IDictionary<string, object> row, object? value)
    {
        var rowKey = GetRowKey(row);
        if (string.IsNullOrWhiteSpace(rowKey))
        {
            return;
        }

        var shouldSelect = value is bool boolValue && boolValue;

        if (shouldSelect)
        {
            _selectedRowKeys.Add(rowKey);
        }
        else
        {
            _selectedRowKeys.Remove(rowKey);
        }
    }

    private Task FirstPageAsync()
    {
        _currentPage = 1;
        ApplyClientSideView(resetPage: false);
        return Task.CompletedTask;
    }

    private Task PreviousPageAsync()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            ApplyClientSideView(resetPage: false);
        }

        return Task.CompletedTask;
    }

    private Task NextPageAsync()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            ApplyClientSideView(resetPage: false);
        }

        return Task.CompletedTask;
    }

    private Task LastPageAsync()
    {
        _currentPage = TotalPages;
        ApplyClientSideView(resetPage: false);
        return Task.CompletedTask;
    }

    private async Task MoveNextAsync()
    {
        var selectedRows = GetSelectedRows();
        if (selectedRows.Count == 0)
        {
            _isError = true;
            _message = "No activities selected for bulk update.";
            return;
        }

        if (ViewDefinition is null)
        {
            _isError = true;
            _message = "Activity grid metadata was not supplied.";
            return;
        }

        var (parentDataObjectReference, serializedParentDataObjectReference) = PWAFunctions.ProcessDataObjectReference(
            modalService,
            ParentDataObjectReference,
            ParentGuid,
            ViewDefinition.EntityTypeGuid.ToString());

        _bulkModalId = Guid.NewGuid().ToString();
        _detailPageParameters = new Dictionary<string, object>
        {
            { "EntityTypeGuid", PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(ViewDefinition.EntityTypeGuid).ToString() },
            { "Windowed", true },
            { "CloseWindow", EventCallback.Factory.Create(this, CloseBulkRecordChangeAsync) },
            { "RecordGuid", Guid.Empty.ToString() },
            { "GridUpdated", EventCallback.Factory.Create(this, BulkRecordChangeUpdatedAsync) },
            { "SerializedDataObjectReference", serializedParentDataObjectReference },
            { "ParentDataObjectReference", parentDataObjectReference },
            { "ModalId", _bulkModalId },
            { "SelectedItems", selectedRows },
            { "IsDetailWindowed", true },
            { "IsBulkUpdate", true }
        };

        modalService.RegisterModal(_bulkModalId, parentDataObjectReference);
        _bulkRecordChangeVisible = true;
        await Task.CompletedTask;
    }

    private async Task CancelAsync()
    {
        if (OnActionCompleted.HasDelegate)
        {
            await OnActionCompleted.InvokeAsync();
        }
    }

    private async Task CloseBulkRecordChangeAsync()
    {
        _bulkRecordChangeVisible = false;
        UnregisterBulkModal();
        await Task.CompletedTask;
    }

    private async Task BulkRecordChangeUpdatedAsync()
    {
        _bulkRecordChangeVisible = false;
        UnregisterBulkModal();

        if (OnActionCompleted.HasDelegate)
        {
            await OnActionCompleted.InvokeAsync();
        }
    }

    private void UnregisterBulkModal()
    {
        if (!string.IsNullOrWhiteSpace(_bulkModalId))
        {
            modalService.UnregisterModal(_bulkModalId);
            _bulkModalId = string.Empty;
        }
    }

    private List<ExpandoObject> GetSelectedRows()
    {
        return _allRows
            .Where(row =>
            {
                var rowKey = GetRowKey((IDictionary<string, object>)row);
                return !string.IsNullOrWhiteSpace(rowKey) && _selectedRowKeys.Contains(rowKey);
            })
            .ToList();
    }

    private static string GetRowKey(IDictionary<string, object> row)
    {
        foreach (var guidColumn in new[] { "Guid", "GUID", "guid" })
        {
            if (row.TryGetValue(guidColumn, out var guidValue)
                && Guid.TryParse(guidValue?.ToString(), out var parsedGuid)
                && parsedGuid != Guid.Empty)
            {
                return parsedGuid.ToString("D");
            }
        }

        if (row.TryGetValue("ID", out var idValue) && !string.IsNullOrWhiteSpace(idValue?.ToString()))
        {
            return $"ID:{idValue}";
        }

        return string.Empty;
    }

    private static string RenderCellValue(IDictionary<string, object> row, string columnName)
    {
        if (!row.TryGetValue(columnName, out var value) || value is null)
        {
            return string.Empty;
        }

        return value.ToString() ?? string.Empty;
    }

    private static string GetColumnTitle(GridViewColumnDefinition column) =>
        string.IsNullOrWhiteSpace(column.Title) ? column.Name : column.Title;

    private static string DisplayText(string? value, string fallback = "-") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;
}

        padding: 0;
    }

    .activity-bulk-update-card {
        box-shadow: none;
        border: 0;
    }

    .activity-bulk-update-header {
        align-items: flex-start;
        gap: 1rem;
    }

    .activity-bulk-update-toolbar {
        align-items: end;
        gap: 1rem;
    }

    .activity-bulk-update-toolbar-left {
        min-width: min(420px, 100%);
    }

    .activity-bulk-search {
        min-width: min(380px, 80vw);
    }

    .activity-bulk-table-wrap {
        max-height: 48vh;
        overflow: auto;
        border: 1px solid #e5edf7;
        border-radius: 12px;
    }

    .activity-bulk-table {
        min-width: 1120px;
    }

    .activity-bulk-table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        background: #f8fafc;
    }

    .activity-bulk-table .activity-bulk-filter-row th {
        top: 38px;
        z-index: 1;
        background: #ffffff;
    }

    .activity-bulk-checkbox-col {
        width: 44px;
        text-align: center;
    }

    .activity-bulk-sortable-header {
        cursor: pointer;
        user-select: none;
        white-space: nowrap;
    }

    .activity-bulk-sort-indicator {
        margin-left: 0.35rem;
        font-size: 0.75rem;
    }

    .activity-bulk-column-filter {
        width: 100%;
        min-width: 120px;
        border: 1px solid #d8e2ee;
        border-radius: 8px;
        padding: 0.35rem 0.5rem;
        font-size: 0.85rem;
    }

    .activity-bulk-cell {
        max-width: 220px;
    }

    .activity-bulk-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 0;
        flex-wrap: wrap;
    }

    .activity-bulk-footer-right {
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .activity-bulk-page-pill {
        border: 1px solid #d8e2ee;
        border-radius: 999px;
        padding: 0.35rem 0.75rem;
        background: #ffffff;
        color: #334155;
        font-size: 0.9rem;
    }

    .activity-bulk-command-row {
        display: flex;

                                                                                                                                            <SignatureControl ExistingSignature="@existingSignature" OnSignatureCleared="HandleSignatureCleared" OnSignatureSaved="HandleSignatureSaved" user="@user" />
                                                                                                                                        </div>
                                                                                                                                    </div>
                                                                                                                                    break;
                                                                                                                                default:
                                                                                                                                    <div class="shore-input-field" style="width: 100%; min-width: 0; max-width: 100%;">
                                                                                                                                        <div class="input-group" title="@ValueTooltip">
                                                                                                                                            <div class="input-group-text" title="@ValueTooltip">
                                                                                                                                                <label for="@PropertyId" title="@LabelTooltip">@PropertyName</label>
                                                                                                                                            </div>
                                                                                                                                            @*
                                    OE: CBLD-501: Added @OnInput to ensure the value is updated
                                    as the user is typing.
                                *@
                                                                                                                                            <input @ref="@InputRef"
                                                                                                                                                   type="@InputType"
                                                                                                                                                   class="form-control @(DataProperty.IsInvalid ? "is-invalid" : "is-data-valid")"
                                                                                                                                                   id="@PropertyId"
                                                                                                                                                   name="@PropertyName"
                                                                                                                                                   placeholder="@Placeholder"
                                                                                                                                                   @bind-value="@StringValueBinding"
                                                                                                                                                   readonly="@((DataProperty.IsReadOnly || Disabled || (@EffectiveDisabled)))">
                                                                                                                                                @if (!string.IsNullOrEmpty(EntityProperty.HelpText))
                                                                                                                                                {
                                                                                                                                                    <div class="dropdown">
                                                                                                                                                        <button class="btn btn-outline-secondary dropdown-toggle"
                                                                                                                                                                type="button"
                                                                                                                                                                data-bs-toggle="dropdown">
                                                                                                                                                            <span class="bi bi-info-circle"></span>
                                                                                                                                                        </button>

                                                                                                                                                        <div class="dropdown-menu p-3">
                                                                                                                                                            <div class="fw-semibold mb-2">
                                                                                                                                                                @EntityProperty.HelpText
                                                                                                                                                            </div>
                                                                                                                                                        </div>
                                                                                                                                                    </div>
                                                                                                                                                }
                                                                                                                                                <div class="invalid-feedback">
                                                                                                                                                    @DataProperty.ValidationMessage
                                                                                                                                                </div>
                                                                                                                                                <div class="valid-feedback"></div>
                                                                                                                                            </div>
                                                                                                                                        </div>
                                                                                                                                        break;
                                                                                                                                    }
                                                                                                                                }
                                                                                                                            }
                                                                                                                        }

                                                                                                                    }
                                                                                                                }
                                                                                                                @if (WindowIsVisible)
                                                                                                                {
                                                                                                                    var detailComponentType = DetailPageComponentType;

                                                                                                                    <div class="shore-input-modal-backdrop"></div>
                                                                                                                    <div class="shore-input-modal-shell" role="dialog" aria-modal="true">
                                                                                                                        <div class="@NativeModalCardCss">
                                                                                                                            <div class="shore-input-modal-header">
                                                                                                                                <div class="shore-input-modal-title-wrap">
                                                                                                                                    <div class="shore-input-modal-title">
                                                                                                                                        <i class="bi bi-arrow-up-right-square"></i>
                                                                                                                                        <span>@(WindowTitle ?? "Record Details")</span>
                                                                                                                                    </div>
                                                                                                                                    <div class="shore-input-modal-subtitle">@PropertyName</div>
                                                                                                                                </div>
                                                                                                                                <div class="shore-input-modal-actions">
                                                                                                                                    <button type="button" class="btn btn-sm btn-outline-light" title="Maximise" @onclick="ToggleNativeModalMaximized">
                                                                                                                                        <i class="bi bi-arrows-fullscreen"></i>
                                                                                                                                    </button>
                                                                                                                                    <button type="button" class="btn btn-sm btn-outline-light" title="Close" @onclick="CloseWindow">
                                                                                                                                        <i class="bi bi-x-lg"></i>
                                                                                                                                    </button>
                                                                                                                                </div>
                                                                                                                            </div>
                                                                                                                            <div class="shore-input-modal-body">
                                                                                                                                @if (detailComponentType is not null)
                                                                                                                                {
                                                                                                                                    <DynamicComponent Type="@detailComponentType" Parameters="@_detailPageParameters" />
                                                                                                                                }
                                                                                                                                else
                                                                                                                                {
                                                                                                                                    <div class="alert alert-warning mb-0">
                                                                                                                                        Could not resolve detail component: @EntityProperty.DetailPageUri
                                                                                                                                    </div>
                                                                                                                                }
                                                                                                                            </div>
                                                                                                                        </div>
                                                                                                                    </div>
                                                                                                                }

                                                                                                                @if (ModalIsVisible)
                                                                                                                {
                                                                                                                    var informationComponentType = InformationPageComponentType;

                                                                                                                    <div class="shore-input-modal-backdrop"></div>
                                                                                                                    <div class="shore-input-modal-shell" role="dialog" aria-modal="true">
                                                                                                                        <div class="@NativeModalCardCss">
                                                                                                                            <div class="shore-input-modal-header">
                                                                                                                                <div class="shore-input-modal-title-wrap">
                                                                                                                                    <div class="shore-input-modal-title">
                                                                                                                                        <i class="bi bi-info-circle"></i>
                                                                                                                                        <span>@(WindowTitle ?? "Information")</span>
                                                                                                                                    </div>
                                                                                                                                    <div class="shore-input-modal-subtitle">@PropertyName</div>
                                                                                                                                </div>
                                                                                                                                <div class="shore-input-modal-actions">
                                                                                                                                    <button type="button" class="btn btn-sm btn-outline-light" title="Maximise" @onclick="ToggleNativeModalMaximized">
                                                                                                                                        <i class="bi bi-arrows-fullscreen"></i>
                                                                                                                                    </button>
                                                                                                                                    <button type="button" class="btn btn-sm btn-outline-light" title="Close" @onclick="CloseWindow">
                                                                                                                                        <i class="bi bi-x-lg"></i>
                                                                                                                                    </button>
                                                                                                                                </div>
                                                                                                                            </div>
                                                                                                                            <div class="shore-input-modal-body">
                                                                                                                                @if (informationComponentType is not null)
                                                                                                                                {
                                                                                                                                    <DynamicComponent Type="@informationComponentType" Parameters="@_detailPageParameters" />
                                                                                                                                }
                                                                                                                                else
                                                                                                                                {
                                                                                                                                    <div class="alert alert-warning mb-0">
                                                                                                                                        Could not resolve information component: @EntityProperty.InformationPageUri
                                                                                                                                    </div>
                                                                                                                                }
                                                                                                                            </div>
                                                                                                                        </div>
                                                                                                                    </div>
                                                                                                                }

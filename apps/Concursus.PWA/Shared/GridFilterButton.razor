@using Concursus.API.Client
@inherits ComponentBase

<div class="cb-grid-filter-menu" @onfocusout="HandleFocusOutAsync">
    <button type="button"
            class="btn btn-primary btn-sm gridfilterbtn cb-grid-filter-button"
            title="Filters"
            aria-haspopup="true"
            aria-expanded="@_menuOpen"
            @onclick="ToggleMenu">
        <i class="bi bi-funnel me-1" aria-hidden="true"></i>
        Filters
        <i class="bi bi-chevron-down ms-1" aria-hidden="true"></i>
    </button>

    @if (_menuOpen)
    {
        <div class="cb-grid-filter-dropdown shadow-sm" role="menu">
            <button type="button"
                    class="cb-grid-filter-dropdown-item"
                    role="menuitem"
                    @onclick="ClearAllFiltersAsync">
                <i class="bi bi-x-circle me-2" aria-hidden="true"></i>
                All Grids [Clear Filters]
            </button>
        </div>
    }
</div>

@if (!string.IsNullOrWhiteSpace(_toastMessage))
{
    <div class="cb-grid-filter-toast alert alert-success py-2 px-3 shadow-sm" role="status">
        @_toastMessage
    </div>
}

        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        transform: scale(1.0);
        padding: 20px;
        background-color: #ffffff;
    }

    .exit-fullscreen {
        position: absolute;
        top: 10px;
        right: 10px;
        padding: 5px 10px;
        background-color: #f44336;
        color: white;
        border: none;
        cursor: pointer;
        border-radius: 5px;
    }

    .editButton {
        background-color: #565e64 !important;
        color: #ffffff !important;
    }

    .fullscreen-tile {
        position: absolute;
        width: 100vw;
        height: 100vh;
        top: 0;
        left: 0;
        z-index: 1000;
    }

    .emptyBoard {
        height: 90vh;
    }

    .hideBoard {
        visibility: hidden;
    }

    .cb-dashboard-grid {
        display: grid;
        grid-template-columns: repeat(10, minmax(0, 1fr));
        grid-auto-flow: dense;
        grid-auto-rows: minmax(190px, auto);
        gap: 1rem;
        padding: 1rem;
        min-height: 70vh;
    }

    .cb-widget-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        min-height: var(--cb-widget-min-height, 260px);
        background-color: #ffffff;
        border-radius: 0.5rem;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .cb-widget-header {
        display: flex;
        align-items: center;
        min-height: 44px;
        padding: 0.5rem 0.75rem;
        border-bottom: 1px solid rgba(0, 0, 0, 0.125);
        border-top-left-radius: 0.5rem;
        border-top-right-radius: 0.5rem;
    }

    .cb-widget-title {
        color: #000000;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cb-widget-content {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
        padding: 0.5rem;
    }

    .cb-widget-colour-input {
        width: 38px;
        height: 32px;
        padding: 2px;
    }

    .cb-dashboard-grid-fullscreen-active .cb-widget-card:not(.cb-widget-fullscreen) {
        opacity: 0.25;
        pointer-events: none;
    }

    @@media (max-width: 768px) {
        .k-table-td {
            max-width: 120px !important;
            width: 100% !important;
        }

        .cb-dashboard-grid {
            grid-template-columns: 1fr;
            padding: 0.5rem;
        }

        .cb-widget-card {
            grid-column: 1 / -1 !important;
            min-height: 320px;
        }

        .WidgetButtons {
            max-width: 100%;
        }
    }

    /* 09F dashboard action button contrast */
    .cb-widget-header .WidgetButtons .btn:not(.btn-danger),
    .WidgetOptions .btn-outline-secondary {
        background-color: rgba(255, 255, 255, 0.94) !important;
        color: #0f1f37 !important;
        border: 1px solid rgba(15, 31, 55, 0.35) !important;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
    }

    .cb-widget-header .WidgetButtons .btn:not(.btn-danger):hover,
    .WidgetOptions .btn-outline-secondary:hover {
        background-color: #ffffff !important;
        color: #061327 !important;

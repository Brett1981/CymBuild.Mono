    private Task SetWidgetColor(DashBoardWidget widget, string? newColor)
    {
        if (string.IsNullOrWhiteSpace(newColor))
        {
            return Task.CompletedTask;
        }

        widget.Color = NormaliseColour(newColor);
        HasChanges = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string NormaliseColour(string? colour)
    {
        return string.IsNullOrWhiteSpace(colour) ? "#f8f9fa" : colour;
    }

    private string GetWidgetCardClass(DashBoardWidget widget)
    {
        return $"cb-widget-card widget tileBorder {(widget.IsFullScreen ? "cb-widget-fullscreen fullscreen" : string.Empty)}";
    }

    private string GetWidgetCardStyle(DashBoardWidget widget)
    {
        var colSpan = Math.Clamp(widget.ColSpan <= 0 ? 1 : widget.ColSpan, 1, NumberOfColumns);
        var rowSpan = Math.Clamp(widget.RowSpan <= 0 ? 1 : widget.RowSpan, 1, 4);
        var minHeight = Math.Max(220, rowSpan * 240);
        return $"grid-column: span {colSpan}; --cb-widget-min-height: {minHeight}px;";
    }

    private IEnumerable<ButtonSelection> AvailableWidgetSelections =>
        Data.Where(item => DashboardWidgets.All(widget => widget.Id != item.Id && widget.Title != item.Text))
            .OrderBy(item => item.WidgetType)
            .ThenBy(item => item.Text);

    // ====== [CBLD-611] ======
    // Meant to handle the "The render handle is not yet assigned" error
    //Saves the state (so that the JSON is up to date with the CSS bits) + performs a refresh.
    private void HandleRenderHandleError(Exception ex)
    {
        if (ex.Message.Contains("The render handle is not yet assigned"))
        {
            SaveStateToDB(false);
            Toast.ShowInfo("Page will be refreshed to prevent update related error - please, ensure all your widgets are present on the board after the page has reloaded.");
            _ = Task.Run(async () =>
            {
                await Task.Delay(3000);
                await InvokeAsync(() => Navigation.Refresh());
            });
        }
    }




    [JSInvokable]
    private Task SetWidgetHeaderColor(string headerID, string colour)
    {

    //Should also capture the current state of the tile
    private void ToggleEditMode()
    {

        if (BoardIsEmpty)
        {
            DashBoardStateAsJSON = "{ \"ItemStates\": [] }";
            BoardIsEmpty = false;
        }
        else
        {
            //This is to reset the state if the edit mode is cancelled.
            DashBoardStateAsJSON =  GetCurrentDashBoardLayout();
        }


        IsEditMode = !IsEditMode;

        if (IsEditMode)
            IsEditModeClass = "editModeOn";
        else
            IsEditModeClass = "editModeOff";

        //Check if the user is saving an empty board.
        if (!DashboardWidgets.Any())
            BoardIsEmpty = true;

        StateHasChanged();
    }



        StateHasChanged();
    }


    /*
     * Used when trying to navigate to a different page.
     * Shows a confirmation dialog if there are changes
     */
    private async Task OnNavigation(LocationChangingContext context)
{
    if (HasChanges)
    {
        if (!await ShowDialogAsync())
        {
            context.PreventNavigation();
            return;
        }
    }

    await RemoveAdjustFunctionSafelyAsync();
}

    private async Task<Task> Navigate()
{
    await CloseDialogAsync(true);
    await RemoveAdjustFunctionSafelyAsync();
    return Task.CompletedTask;
}

     private Task Cancel()
        => CloseDialogAsync(false);



    private Task CloseDialogAsync(bool navigate)
    {
        _showDialog = false;

            // Sets the Task to completed.
         _taskCompletionSource.SetResult(navigate);


        // Queue a Render Request
        StateHasChanged();

        return Task.CompletedTask;
    }


    private Task<bool> ShowDialogAsync()
    {
        _showDialog = true;
        _taskCompletionSource = new();
        // Queue a Render Request
        StateHasChanged();
        // returns the Task associated with the TaskCompletionSource instance
        // this is a running Task that the caller can await
        return _taskCompletionSource.Task;
    }

    private async Task RemoveAdjustFunctionSafelyAsync()
{
    try
    {
        await JS.InvokeVoidAsync("removeAdjustFunction");
    }
    catch (JSException)
    {
        // Do NOT block navigation or rendering for optional UI cleanup.
    }
    catch (TaskCanceledException)
    {
        // Ignore cancellation during navigation / disposal.
    }
}


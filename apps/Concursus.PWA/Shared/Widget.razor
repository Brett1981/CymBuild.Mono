@using static Concursus.PWA.Shared.MessageDisplay

<MessageDisplay @ref="_messageDisplay" ErrorMessage="@ErrorMessage" PageMethod="@PageMethod" MessageType="MessageType" />
<NavigationLock OnBeforeInternalNavigation=this.OnNavigation />

<div class="@DialogCss" tabindex="-1" z-index="10">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Exit Page</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick=this.Cancel></button>
            </div>
            <div class="modal-body">
                <p>Changes have been made, Are you sure you want to exit without saving?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" @onclick=this.Navigate>Yes</button>
                <button type="button" class="btn btn-primary" @onclick=this.Cancel>Cancel</button>
            </div>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="d-flex flex-column justify-content-center align-items-center vh-100">
        <div class="spinner-border text-secondary" role="status" aria-hidden="true"></div>
        <h1 class="mt-2">Loading...</h1>
    </div>
}
else
{
    <div class="WidgetContainer d-flex flex-column cb-native-dashboard-shell">
        @if (!IsEditMode)
        {
            <div class="d-flex flex-row justify-content-end mb-3">
                <button type="button" class="btn btn-secondary editButton" @onclick="ToggleEditMode">Edit</button>
            </div>
        }

        @if (IsEditMode)
        {
            <div class="WidgetOptions d-flex flex-column flex-lg-row justify-content-between gap-2 mb-3">
                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-center">
                    <label class="form-label mb-0 fw-semibold" for="dashboardWidgetPicker">Add widget</label>
                    <select id="dashboardWidgetPicker" class="form-select cb-dashboard-widget-picker" @onchange="AddWidgetFromSelect">
                        <option value="">Select a widget...</option>
                        @foreach (var item in AvailableWidgetSelections)
                        {
                            <option value="@item.Id">@item.Text</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <button type="button" class="btn btn-outline-secondary" title="Decrease Widgets Size" @onclick="@(async () => await ChangeWidgetAreaSize(-1))">
                        <i class="bi bi-dash-circle-fill"></i> Smaller
                    </button>
                    <button type="button" class="btn btn-outline-secondary" title="Increase Widgets Size" @onclick="@(async () => await ChangeWidgetAreaSize(1))">
                        <i class="bi bi-plus-circle-fill"></i> Larger
                    </button>
                    <button class="btn btn-success" type="button" @onclick="@(() => this.SaveStateToDB())">
                        <i class="bi bi-save-fill"></i> Save
                    </button>
                    <button class="btn btn-warning" type="button" @onclick="@(() => this.CancelEditMode())">
                        <i class="bi bi-x-square"></i> Cancel
                    </button>
                </div>
            </div>
        }

        <div class="WidgetArea">
            @if (BoardIsEmpty)
            {
                <div class="emptyBoard d-flex flex-column justify-content-center text-center" style="background-color: #ffffff">
                    <i class="bi bi-folder" style="font-size: 60px; color: lightblue;"></i>
                    <h1 style="font-size: 40px; color: lightblue;">Start a new dashboard by clicking "Edit".</h1>
                </div>
            }
            else
            {
                <div class="cb-dashboard-grid @(isFullScreen ? "cb-dashboard-grid-fullscreen-active" : "")">
                    @foreach (var Widget in DashboardWidgets)
                    {
                        <section class="@GetWidgetCardClass(Widget)" style="@GetWidgetCardStyle(Widget)" @key="@Widget.Id">
                            <header class="cb-widget-header" style="background-color: @Widget.Color">
                                <div class="d-flex flex-row justify-content-between align-items-center gap-2 w-100">
                                    <strong class="cb-widget-title">@Widget.Title</strong>

                                    <div class="WidgetButtons d-flex flex-row flex-wrap gap-1 justify-content-end align-items-center">
                                        @if (!IsEditMode)
                                        {
                                            var MyInvoicingId = "41291bdc-7fac-47f0-8517-e2afe51e9ec3";

                                            @if (Widget.Id == MyInvoicingId)
                                            {
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        title="Grey arrow: previous month gross/1000. Blue arrow: current month gross/1000. Green bar: currently no specific function.">
                                                    <i class="bi bi-info-circle"></i>
                                                </button>
                                            }

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-secondary"
                                                    title="Toggle full screen"
                                                    @onclick="() => ToggleFullScreen(Widget)"
                                                    disabled="@(isFullScreen && !Widget.IsFullScreen)">
                                                <i class="bi bi-arrows-angle-expand"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" title="Move widget left/up" @onclick="@(() => MoveWidget(Widget, -1))">
                                                <i class="bi bi-arrow-left"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" title="Move widget right/down" @onclick="@(() => MoveWidget(Widget, 1))">
                                                <i class="bi bi-arrow-right"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" title="Decrease width" @onclick="@(() => ChangeWidgetSpan(Widget, -1, 0))">
                                                <i class="bi bi-arrows-collapse-vertical"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" title="Increase width" @onclick="@(() => ChangeWidgetSpan(Widget, 1, 0))">
                                                <i class="bi bi-arrows-expand-vertical"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" title="Decrease height" @onclick="@(() => ChangeWidgetSpan(Widget, 0, -1))">
                                                <i class="bi bi-dash-lg"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" title="Increase height" @onclick="@(() => ChangeWidgetSpan(Widget, 0, 1))">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                            <input type="color"
                                                   class="form-control form-control-color cb-widget-colour-input"
                                                   title="Widget colour"
                                                   value="@(NormaliseColour(Widget.Color))"
                                                   @oninput="@(args => SetWidgetColor(Widget, args.Value?.ToString()))" />
                                            <button class="btn btn-sm btn-danger" title="Delete Widget" @onclick="@(async () => await RemoveWidget(Widget.Title, Widget.WidgetType))">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </header>

                            <div class="cb-widget-content">
                                @Widget.Content
                            </div>
                        </section>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .sticky {
        position: static !important;
    }

    h5.view-name {
        display: none;
    }

    .WidgetOptions {
        background-color: white;
        padding: 10px;
        border-radius: 20px;
    }


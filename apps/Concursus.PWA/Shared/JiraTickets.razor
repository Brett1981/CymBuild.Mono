    .priority-p1 { background-color: #c0392b; color: #fff; }
    .priority-p2 { background-color: #e67e22; color: #fff; }
    .priority-p3 { background-color: #f1c40f; color: #000; }
    .priority-p4 { background-color: #3498db; color: #fff; }
    .priority-p5 { background-color: #95a5a6; color: #000; }
</style>

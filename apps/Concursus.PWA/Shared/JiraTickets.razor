@using System.Text.Json
@using Concursus.Components.Shared.Dto
@using Concursus.Components.Shared.Helpers
@using Concursus.Components.Shared.Services
@using System.Text

@inject HttpClient Http
@inject IConfiguration Config
@inject IToastService Toast

<h3>
    <svg width="32" height="32" viewBox="0 0 256 256" style="vertical-align: middle; margin-right: 6px;">
        <path fill="#2684FF" d="M141.12 131.38l-16.72 17.06L92.54 116.6l16.7-17.08z" />
        <path fill="#0052CC" d="M188.57 84.88l-16.7 17.08-39.48-40.26 16.7-17.06z" />
        <path fill="#2684FF" d="M67.38 158.64l16.7-17.08 39.48 40.26-16.7 17.08z" />
    </svg>
    Jira Tickets
</h3>

@if (isLoading)
{
    <div class="alert alert-info d-flex align-items-center gap-2" role="status">
        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
        <span>Refreshing Jira Status</span>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <strong>Jira Tickets</strong>
                <span class="badge rounded-pill text-bg-light ms-2">Rows @FilteredErrorReports.Count</span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <input class="form-control form-control-sm" style="width: 260px;" placeholder="Search tickets..." @bind-value="SearchTerm" @bind-value:event="oninput" />
                <select class="form-select form-select-sm" style="width: 92px;" @bind="PageSize">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadErrorReportsAsync" disabled="@isLoading">Refresh</button>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Ticket</th>
                    <th>Title</th>
                    <th>Priority</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (CurrentPageItems.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center py-4">No Jira tickets found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in CurrentPageItems)
                    {
                        <tr>
                            <td>@item.CreatedUtc.ToString("g")</td>
                            <td><span class="@GetStatusCss(item.JiraStatus)">@SafeText(item.JiraStatus, "N/A")</span></td>
                            <td>@SafeText(item.JiraTicketKey, "-")</td>
                            <td><span title="@item.ErrorMessage">@Truncate(item.ErrorMessage, 50)</span></td>
                            <td><span class="@GetPriorityCss(item.JiraPriority)">@SafeText(item.JiraPriority, "-")</span></td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="@(() => ShowDetails(item))">👁 View</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <span class="text-muted small">Page @EffectivePage of @TotalPages</span>
        <div class="btn-group btn-group-sm" role="group" aria-label="Jira ticket paging">
            <button type="button" class="btn btn-outline-secondary" disabled="@(EffectivePage <= 1)" @onclick="@(async () => await ChangePageAsync(EffectivePage - 1))">Previous</button>
            <button type="button" class="btn btn-outline-secondary" disabled="@(EffectivePage >= TotalPages)" @onclick="@(async () => await ChangePageAsync(EffectivePage + 1))">Next</button>
        </div>
    </div>
</div>

@if (detailsVisible && selected is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="jira-details-title">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 id="jira-details-title" class="modal-title">Jira Details</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDetails"></button>
                </div>
                <div class="modal-body">
                    <p><strong>Ticket:</strong></p>
                    <pre>@selected.JiraTicketKey</pre>

                    <p><strong>Status:</strong></p>
                    <span class="@GetStatusCss(selected.JiraStatus)">@selected.JiraStatus</span>

                    <p class="mt-2"><strong>Priority:</strong></p>
                    <span class="@GetPriorityCss(selected.JiraPriority)">@selected.JiraPriority</span>

                    <p><strong>Title:</strong></p>
                    <textarea class="form-control ai-field" readonly style="height:40px">@selected.ErrorMessage</textarea>

                    <p><strong>Jira Description:</strong></p>
                    @if (!string.IsNullOrWhiteSpace(selected.JiraDescription) && selected.JiraDescription.Trim().StartsWith("{"))
                    {
                        <div class="jira-description-box">
                            @((MarkupString)JiraDescriptionFormatter.ConvertAdfToHtml(selected.JiraDescription))
                        </div>
                    }
                    else
                    {
                        <p><em>No Jira description available</em></p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" @onclick="CloseDetails">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback<Exception> OnError { get; set; }

    private List<AiErrorReportDto> errorReports = new();
    private bool isLoading;
    private AiErrorReportDto? selected;
    private bool detailsVisible;
    private string baseUrl => Config["AiErrorService:BaseUrl"].TrimEnd('/') + "/";
    private int currentPage = 1;
    private int pageSize = 10;
    private string searchTerm = string.Empty;

    private string SearchTerm
    {
        get => searchTerm;
        set
        {
            searchTerm = value ?? string.Empty;
            currentPage = 1;
        }
    }

    private int PageSize
    {
        get => pageSize;
        set
        {
            pageSize = Math.Max(1, value);
            currentPage = 1;
        }
    }

    private List<AiErrorReportDto> FilteredErrorReports => ApplyErrorFilter(errorReports).ToList();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredErrorReports.Count / (double)PageSize));
    private int EffectivePage => Math.Min(Math.Max(currentPage, 1), TotalPages);
    private List<AiErrorReportDto> CurrentPageItems => FilteredErrorReports.Skip((EffectivePage - 1) * PageSize).Take(PageSize).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadErrorReportsAsync();
    }

    private async Task LoadErrorReportsAsync()
    {
        try
        {
            isLoading = true;
            errorReports = await Http.GetFromJsonAsync<List<AiErrorReportDto>>($"{baseUrl}api/ErrorReport/all") ?? new List<AiErrorReportDto>();
            errorReports = errorReports.OrderByDescending(e => e.CreatedUtc).ToList();
            currentPage = Math.Min(currentPage, TotalPages);
            await RefreshStatusesForVisibleAsync(CurrentPageItems);
        }
        catch (Exception ex)
        {
            Toast.ShowError($"❌ Failed to load Jira tickets: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private IEnumerable<AiErrorReportDto> ApplyErrorFilter(IEnumerable<AiErrorReportDto> rows)
    {
        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            return rows;
        }

        var term = SearchTerm.Trim();
        return rows.Where(row =>
            Contains(row.JiraTicketKey, term) ||
            Contains(row.JiraStatus, term) ||
            Contains(row.JiraPriority, term) ||
            Contains(row.ErrorMessage, term) ||
            Contains(row.UserId, term));
    }

    private static bool Contains(string? value, string term) => value?.IndexOf(term, StringComparison.OrdinalIgnoreCase) >= 0;

    private async Task ChangePageAsync(int page)
    {
        currentPage = Math.Min(Math.Max(page, 1), TotalPages);
        await RefreshStatusesForVisibleAsync(CurrentPageItems);
    }

    private async Task RefreshStatusesForVisibleAsync(IReadOnlyList<AiErrorReportDto> visibleRows)
    {
        foreach (var row in visibleRows.Where(r => !string.IsNullOrWhiteSpace(r.JiraTicketKey)))
        {
            try
            {
                var result = await Http.GetFromJsonAsync<AiStatusDto>($"{baseUrl}api/ErrorReport/status/{row.JiraTicketKey}");
                if (result != null)
                {
                    row.JiraStatus = result.JiraStatus;
                    row.JiraPriority = result.JiraPriority;
                    row.JiraLastSyncedUtc = result.JiraLastSyncedUtc;
                    row.JiraDescription = result.JiraDescription;
                }
            }
            catch (Exception ex)
            {
                Toast.ShowWarning($"⚠️ Status check failed for {row.JiraTicketKey}: {ex.Message}");
            }
        }

        StateHasChanged();
    }

    private void ShowDetails(AiErrorReportDto report)
    {
        selected = report;
        detailsVisible = true;
    }

    private void CloseDetails()
    {
        detailsVisible = false;
        selected = null;
    }

    private static string Truncate(string? value, int length)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return value.Length > length ? value.Substring(0, length) + "..." : value;
    }

    private static string SafeText(string? value, string fallback) => string.IsNullOrWhiteSpace(value) ? fallback : value;

    private static string GetStatusCss(string? status)
    {
        var safeStatus = string.IsNullOrWhiteSpace(status) ? "other" : status;
        return "badge-jira-status status-" + NormalizeCssToken(safeStatus);
    }

    private static string GetPriorityCss(string? priority)
    {
        var safePriority = priority ?? string.Empty;
        var priorityClass = safePriority.StartsWith("P1") ? "priority-p1" :
            safePriority.StartsWith("P2") ? "priority-p2" :
            safePriority.StartsWith("P3") ? "priority-p3" :
            safePriority.StartsWith("P4") ? "priority-p4" :
            safePriority.StartsWith("P5") ? "priority-p5" : "priority-p5";

        return $"badge-jira-priority {priorityClass}";
    }

    private static string NormalizeCssToken(string value) => System.Text.RegularExpressions.Regex.Replace(value.ToLowerInvariant(), @"[^a-z0-9\-]", "-");

    public class AiStatusDto
    {
        public string JiraStatus { get; set; } = string.Empty;
        public string JiraPriority { get; set; } = string.Empty;
        public string JiraDescription { get; set; } = string.Empty;
        public DateTime? JiraLastSyncedUtc { get; set; }
    }

    public class AiErrorReportDto
    {
        public string Hash { get; set; } = string.Empty;
        public string UserId { get; set; } = string.Empty;
        public string AiAnalysis { get; set; } = string.Empty;
        public string JiraTicketKey { get; set; } = string.Empty;
        public string JiraUrl { get; set; } = string.Empty;
        public string JiraStatus { get; set; } = string.Empty;
        public string JiraDescription { get; set; } = string.Empty;
        public string JiraPriority { get; set; } = string.Empty;
        public string ErrorMessage { get; set; } = string.Empty;
        public string StackTrace { get; set; } = string.Empty;
        public string ContextJson { get; set; } = string.Empty;
        public DateTime CreatedUtc { get; set; }
        public DateTime? JiraLastSyncedUtc { get; set; }
    }
}

<style>

    .status-awaiting-discovery { background-color: #c0392b; color: #fff; }
    .status-awaiting-development { background-color: #8e44ad; color: #fff; }
    .status-ready-for-test { background-color: #2980b9; color: #fff; }
    .status-ready-for-development { background-color: #1abc9c; color: #fff; }
    .status-prioritised { background-color: #d35400; color: #fff; }
    .status-testing-failed { background-color: #c0392b; color: #fff; }
    .status-other { background-color: #7f8c8d; color: #fff; }
    .status-won-t-do { background-color: #7f8c8d; color: white; }
    .status-to-do { background-color: #bdc3c7; color: black; }
    .status-deployed-live { background-color: #2ecc71; color: #fff; }
    .status-development-in-progress { background-color: #f1c40f; color: #fff; }

@using Concursus.PWA.Classes
@using System
@using System.Collections.Generic
@inject IHttpClientFactory HttpFactory
@inject IConfiguration Config
@inject HttpClient Http

@if (!uiEnabled)
{
    <p><em>Postcode lookup is turned off in configuration.</em></p>
}
else
{
    <div class="postcode-lookup-tab-shell">
        <div class="cb-native-tabstrip postcode-lookup-native-tabstrip" role="tablist" aria-label="Postcode lookup modes">
            <button type="button"
                    role="tab"
                    aria-selected="@(activeTab == 0)"
                    class="@GetTabButtonCss(0)"
                    @onclick="@(() => SetActiveTab(0))">
                <i class="bi bi-mailbox me-2"></i>
                Postcode
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@(activeTab == 1)"
                    class="@GetTabButtonCss(1)"
                    @onclick="@(() => SetActiveTab(1))">
                <i class="bi bi-geo-alt me-2"></i>
                Address
            </button>
        </div>

        @if (postcodeTabVisited)
        {
            <div class="postcode-lookup-tab-panel @(activeTab == 0 ? string.Empty : "d-none")" role="tabpanel">
                <h3>Postcode Lookup Test</h3>

                <label class="form-check mb-3">
                    <input type="checkbox" class="form-check-input" @bind="enterManually" />
                    <span class="form-check-label">Enter address manually</span>
                </label>

                @if (!enterManually)
                {
                    <div class="postcode-lookup-inline-search mb-3">
                        <input placeholder="Postcode" @bind="postcodeInput" class="form-control" />
                        <button type="button" class="btn btn-primary" @onclick="Search">Search</button>
                    </div>

                    @if (addresses != null)
                    {
                        <select @onchange="OnSelect" class="form-select postcode-lookup-select" aria-label="Choose an address">
                            <option value="-1">-- choose an address --</option>
                            @for (int i = 0; i < addresses.Count; i++)
                            {
                                <option value="@i">@addresses[i].FormattedAddress</option>
                            }
                        </select>
                    }
                }
                else
                {
                    <div class="postcode-lookup-manual-card mt-4">
                        <h4>Address Details</h4>
                        <div class="postcode-lookup-form-grid">
                            <label>UPRN (read-only):</label>
                            <input readonly value="@SelectedAddressDetails.Uprn" class="form-control" />

                            <label>Local Authority:</label>
                            <input value="@SelectedAddressDetails.LocalAuthority" class="form-control" />

                            <label>Address Line 1:</label>
                            <input @bind="SelectedAddressDetails.Line1" class="form-control" />

                            <label>Address Line 2:</label>
                            <input @bind="SelectedAddressDetails.Line2" class="form-control" />

                            <label>Town / City:</label>
                            <input @bind="SelectedAddressDetails.Town" class="form-control" />

                            <label>County:</label>
                            <input @bind="SelectedAddressDetails.County" class="form-control" />

                            <label>Postcode:</label>
                            <input @bind="SelectedAddressDetails.Postcode" class="form-control" />

                            <label>Country:</label>
                            <input @bind="SelectedAddressDetails.Country" class="form-control" />
                        </div>

                        <button type="button" class="btn btn-primary mt-3" @onclick="SearchByAddress">Search</button>
                    </div>
                }
            </div>
        }

        @if (addressTabVisited)
        {
            <div class="postcode-lookup-tab-panel @(activeTab == 1 ? string.Empty : "d-none")" role="tabpanel">
                <div id="outer-container" class="postcode-lookup-address-grid">
                    <div id="search-fields" class="postcode-lookup-card">
                        <h5>Search for an address:</h5>
                        <div id="search-inputs" class="postcode-lookup-stacked-controls">
                            <input placeholder="Enter the address:"
                                   @bind="AddressSearchInput"
                                   class="form-control" />

                            <select class="form-select" @bind="selectedISO" aria-label="Address lookup country context">
                                @foreach (var isoCode in ISOCodes)
                                {
                                    <option value="@isoCode.iso">@isoCode.name</option>
                                }
                            </select>
                        </div>

                        <button type="button" class="btn btn-primary mt-3" @onclick="SearchByAddress">Search</button>
                    </div>

                    <div id="suggested-addresses" class="postcode-lookup-card">
                        <h5>Select a suggestion:</h5>
                        <select class="form-select postcode-lookup-suggestion-list"
                                size="8"
                                @bind="SelectedAddressRecommendationId"
                                aria-label="Address search suggestions">
                            <option value="">-- choose a suggestion --</option>
                            @foreach (var item in ListBoxData)
                            {
                                <option value="@item.Id">@item.Suggestion</option>
                            }
                        </select>
                        <button type="button" class="btn btn-success mt-3" @onclick="ResolveSelectedAddress">
                            Select Address
                        </button>
                    </div>

                    <div id="resolved-address" class="postcode-lookup-card">
                        <h5>Selected Address:</h5>
                        <div class="postcode-lookup-form-grid mt-4">
                            <label>UPRN (read-only):</label>
                            <input readonly @bind="ResolvedAddress.Uprn" class="form-control" />

                            <label>Local Authority:</label>
                            <input @bind="ResolvedAddress.AuthorityCode" class="form-control" />

                            <label>Address Line 1:</label>
                            <input @bind="ResolvedAddress.Line1" class="form-control" />

                            <label>Address Line 2:</label>
                            <input @bind="ResolvedAddress.Line2" class="form-control" />

                            <label>Town / City:</label>
                            <input @bind="ResolvedAddress.Town" class="form-control" />

                            <label>County:</label>
                            <input @bind="ResolvedAddress.County" class="form-control" />

                            <label>Postcode:</label>
                            <input @bind="ResolvedAddress.Postcode" class="form-control" />

                            <label>Country:</label>
                            <input @bind="ResolvedAddress.Country" class="form-control" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    // UI state
    bool uiEnabled;
    bool enterManually;
    string postcodeInput = "";
    List<AddressResponse>? addresses;
    AddressResponse? selected;
    int selectedIndex = -1;

    //ISO code dropdown:
    List<CountryWithISO> ISOCodes = new();
    private string selectedISO { get; set; } = "GBR";
    List<AddressSearchResult> addressRecommendations = new();
    AddressSearchResult SelectecRecommendation;
    string AddressSearchInput = "";

    //Variables for the box that displays suggestions:
    private List<AddressSearchResult> ListBoxData { get; set; } = new List<AddressSearchResult>();
    private string SelectedAddressRecommendationId { get; set; } = string.Empty;

    //Resolved address:
    AddressResponse ResolvedAddress = new();

    private int activeTab = 0;
    private bool postcodeTabVisited = true;
    private bool addressTabVisited = false;

    private AddressResponse SelectedAddressDetails
    {
        get
        {
            selected ??= new AddressResponse();
            return selected;
        }
        set => selected = value;
    }

    public class AddressLookupInputs
    {
        public string AddressLine1 { get; set; } = "";
        public string AddressLine2 { get; set; } = "";
        public string Town { get; set; } = "";
        public string County { get; set; } = "";
        public string Postcode { get; set; } = "";
        public string Country { get; set; } = "";
    }

    //Class defintion for reading the country codes.
    public class CountryWithISO
    {
        public string name { get; set; }
        public string iso { get; set; }
    }

    //Class defintion for the suggestions returned by Ideal Postcode Lookup.
    public class ListBoxModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    protected override void OnInitialized()
    {
        uiEnabled = Config.GetValue<bool>("PostcodeLookupUI:Enabled");
        AddressLookupInputs addressLookupInputs = new AddressLookupInputs();
        LoadCountryISOCodes();
    }

    private void SetActiveTab(int tabIndex)
    {
        activeTab = tabIndex;

        if (tabIndex == 0)
        {
            postcodeTabVisited = true;
        }
        else if (tabIndex == 1)
        {
            addressTabVisited = true;
        }
    }

    private string GetTabButtonCss(int tabIndex)
    {
        return activeTab == tabIndex
            ? "cb-native-tab active"
            : "cb-native-tab";
    }

    private async void LoadCountryISOCodes()
    {
        string jsonFileName = "PostCodeLookup_Assets/country_iso_codes.json";
        ISOCodes = await Http.GetFromJsonAsync<List<CountryWithISO>>(jsonFileName);
    }

    async Task Search()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(postcodeInput))
                return;
            var client = HttpFactory.CreateClient("PostcodeLookupUI");
            var resp = await client.PostAsJsonAsync("PostcodeLookup", new { postcode = postcodeInput, forceApi = true });
            resp.EnsureSuccessStatusCode();
            addresses = await resp.Content.ReadFromJsonAsync<List<AddressResponse>>();
            selected = null;
            selectedIndex = -1;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    /*
     * Function for searching for an address.
     * This only returns sugesstions, meaning a selected address will have to be resolved.
     */
    async Task SearchByAddress()
    {
        try
        {
            //var client   = HttpFactory.CreateClient("AddressLookupUI");
            //var resp = await client.PostAsJsonAsync("GetAddress", new { address = AddressSearchInput, context = selectedISO, forceApi = true });

            string BaseUrl = "http://localhost:5041/api/AddressLookup/";
            string GetAddressEndpoint = "GetAddress";

            var client = HttpFactory.CreateClient("AddressLookupUI");
            var resp = await client.PostAsJsonAsync($"{BaseUrl}{GetAddressEndpoint}", new
            {
                address = AddressSearchInput,
                context = selectedISO,
                forceApi = true
            });

            resp.EnsureSuccessStatusCode();
            addressRecommendations = await resp.Content.ReadFromJsonAsync<List<AddressSearchResult>>();
            SelectedAddressRecommendationId = string.Empty;

            if(addressRecommendations?.Count > 0)
            {
                ListBoxData = addressRecommendations;
                StateHasChanged();
            }
            else
            {
                addressRecommendations.Add(new AddressSearchResult()
                {
                    Id = "NA",
                    Suggestion ="Could not find any address",
                    Udprn = "NA",
                    Urls = "NA"
                });
                ListBoxData = addressRecommendations;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
        }
    }

    async Task ResolveSelectedAddress()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(SelectedAddressRecommendationId))
                return;

            string BaseUrl = "http://localhost:5041/api/AddressLookup/";
            string GetAddressEndpoint = "ResolveAddress";

            var client = HttpFactory.CreateClient("AddressLookupUI");

            var ID = SelectedAddressRecommendationId;

            var resp = await client.PostAsJsonAsync($"{BaseUrl}{GetAddressEndpoint}", new
            {
                id = ID,
                context = selectedISO
            });

            resp.EnsureSuccessStatusCode();

            ResolvedAddress = await resp.Content.ReadFromJsonAsync<AddressResponse>();
            StateHasChanged();
        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    void OnSelect(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx)
            && addresses != null
            && idx >= 0
            && idx < addresses.Count)
        {
            selected = addresses[idx];
            // once an address is picked we “lock” into manual‐mode so that the
            // freeform fields are shown and the lookup UI hidden
            enterManually = true;
        }
    }
}

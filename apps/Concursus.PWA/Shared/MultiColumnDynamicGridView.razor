@using System.Dynamic
@using Concursus.API.Client.Models
@using Concursus.PWA.Classes
@using Microsoft.AspNetCore.Components.Web

@inject Core.CoreClient coreClient
@inject NavigationManager NavManager
@inject IJSRuntime JsRuntime
@inject ModalService modalService
@inject RefreshService refreshService
@inject IJSRuntime JSRuntime
@inject IJSRuntime JS
@inject Helpers.LocalStorageAccessor LocalStorageAccessor
@inject Helpers.SessionStorageAccessor SessionStorageAccessor

@inherits DynamicGridView
@attribute [Authorize]

<MessageDisplay @ref="_messageDisplay" ErrorMessage="@ErrorMessage" PageMethod="@PageMethod" MessageType="MessageType" />

<ErrorBoundary>
    <ChildContent>
        @if (ViewDefinition is not null)
        {
            <div class="cb-multicol-grid-shell">
                <div class="cb-v2-card cb-multicol-grid-toolbar-card">
                    <div class="cb-v2-toolbar cb-multicol-grid-toolbar">
                        <div class="cb-v2-toolbar-left">
                            <input class="cb-v2-input cb-multicol-grid-search"
                                   placeholder="@NativeSearchPlaceholder"
                                   value="@NativeSearchText"
                                   @oninput="OnNativeSearchChanged"
                                   @onkeydown="OnNativeSearchKeyDown"
                                   disabled="@NativeIsLoading" />

                            <button type="button"
                                    class="cb-v2-btn-secondary"
                                    @onclick="ApplyNativeSearchAsync"
                                    disabled="@NativeIsLoading">
                                Search
                            </button>

                            <button type="button"
                                    class="cb-v2-btn-secondary"
                                    @onclick="ClearNativeSearchAsync"
                                    disabled="@NativeIsLoading">
                                Clear
                            </button>

                            <button type="button"
                                    class="cb-v2-btn-secondary cb-multicol-grid-filter-toggle @(NativeFilterPanelOpen ? "is-active" : string.Empty)"
                                    @onclick="ToggleNativeFilterPanel"
                                    disabled="@NativeIsLoading">
                                <i class="bi bi-funnel me-1" aria-hidden="true"></i>
                                Filters
                                @if (NativeActiveFilterCount > 0)
                                {
                                    <span class="cb-multicol-grid-filter-count">@NativeActiveFilterCount</span>
                                }
                            </button>
                        </div>

                        <div class="cb-v2-toolbar-right">
                            <div class="cb-v2-stat-pill">
                                <span class="cb-v2-pill-label">Rows</span>
                                <span class="cb-v2-pill-value">@NativeTotalRows</span>
                            </div>

                            <label class="cb-multicol-grid-page-size-label" for="multicol-grid-page-size-@ViewDefinition.Code">Rows per page</label>
                            <select id="multicol-grid-page-size-@ViewDefinition.Code"
                                    class="cb-v2-input cb-multicol-grid-page-size-select"
                                    value="@NativePageSize"
                                    @onchange="ChangeNativePageSizeAsync"
                                    disabled="@NativeIsLoading">
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                                <option value="200">200</option>
                            </select>
                        </div>
                    </div>

                    @if (NativeFilterPanelOpen)
                    {
                        <div class="cb-multicol-grid-filter-panel cb-v2-card shadow-sm">
                            <div class="cb-multicol-grid-filter-panel-header">
                                <div class="cb-multicol-grid-filter-panel-title">
                                    <span class="cb-multicol-grid-filter-panel-icon"><i class="bi bi-funnel" aria-hidden="true"></i></span>
                                    <div class="min-w-0">
                                        <div class="cb-multicol-grid-filter-panel-heading">Column filters</div>
                                        <div class="cb-multicol-grid-filter-panel-subtitle">Refine My Work, then apply when ready.</div>
                                    </div>
                                </div>
                                <div class="cb-multicol-grid-filter-panel-summary">@NativeActiveFilterCount active</div>
                            </div>

                            <div class="cb-multicol-grid-filter-grid">
                                @foreach (var column in VisibleGridColumns.Where(c => c.IsFiltered))
                                {
                                    <div class="cb-multicol-grid-filter-field">
                                        <label class="form-label" for="multicol-native-filter-@ViewDefinition.Code-@column.Name">@column.Title</label>
                                        <div class="cb-multicol-grid-filter-input-shell input-group">
                                            <i class="bi bi-search" aria-hidden="true"></i>
                                            <input id="multicol-native-filter-@ViewDefinition.Code-@column.Name"
                                                   class="form-control cb-v2-input cb-multicol-grid-filter-input"
                                                   placeholder="Filter @column.Title..."
                                                   value="@GetNativeFilterValue(column.Name)"
                                                   aria-label="Filter @column.Title"
                                                   @oninput="e => SetNativeFilterValue(column.Name, e.Value?.ToString())"
                                                   @onkeydown="OnNativeFilterKeyDown"
                                                   disabled="@NativeIsLoading" />
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="cb-multicol-grid-filter-actions">
                                <button type="button"
                                        class="btn btn-primary cb-v2-btn-primary d-inline-flex align-items-center gap-2"
                                        @onclick="ApplyNativeColumnFiltersAsync"
                                        disabled="@NativeIsLoading">
                                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                    Apply Filters
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary cb-v2-btn-secondary d-inline-flex align-items-center gap-2"
                                        @onclick="ClearAllNativeColumnFiltersAsync"
                                        disabled="@NativeIsLoading">
                                    <i class="bi bi-x-circle" aria-hidden="true"></i>
                                    Clear Filters
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="cb-v2-card cb-multicol-grid-card">
                    <div class="cb-multicol-grid-status-line">
                        <span>@NativeGridSummaryText</span>
                        @if (NativeIsLoading)
                        {
                            <span class="cb-multicol-grid-loading" role="status" aria-live="polite">
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                Loading…
                            </span>
                        }
                    </div>

                    <div class="cb-multicol-grid-scroll">
                        <table class="cb-v2-table cb-multicol-grid-table">
                            <thead>
                                <tr class="cb-multicol-grid-top-header-row">
                                    @foreach (var topHeader in EffectiveTopColumnHeaders)
                                    {
                                        var headerColumns = GetColumnsForTopHeader(topHeader).ToList();
                                        var topHeaderCssId = GetTopHeaderCssClass(topHeader);
                                        <th class="cb-multicol-grid-top-header @topHeaderCssId" colspan="@Math.Max(1, headerColumns.Count)">
                                            <div class="cb-multicol-grid-top-header-content">
                                                <span>@topHeader</span>
                                                <label class="cb-multicol-grid-colour-control" title="Change header colour">
                                                    <i class="bi bi-palette" aria-hidden="true"></i>
                                                    <input type="color"
                                                           value="@GetHeaderColour(topHeaderCssId)"
                                                           @onchange="e => SetHeaderColour(e.Value?.ToString() ?? DefaultHeaderColour, topHeaderCssId)" />
                                                </label>
                                                @if (!string.Equals(GetHeaderColour(topHeaderCssId), DefaultHeaderColour, StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <button type="button"
                                                            class="btn btn-link btn-sm cb-multicol-grid-colour-reset"
                                                            title="Reset header colour"
                                                            @onclick="() => SetHeaderColour(DefaultHeaderColour, topHeaderCssId)">
                                                        reset
                                                    </button>
                                                }
                                            </div>
                                        </th>
                                    }
                                </tr>
                                <tr>
                                    @foreach (var column in VisibleGridColumns)
                                    {
                                        <th style="@GetColumnWidthStyle(column.Width)">
                                            <button type="button"
                                                    class="cb-multicol-grid-sort-button @GetNativeSortCss(column.Name)"
                                                    title="Sort by @column.Title"
                                                    @onclick="async () => await SortNativeGridAsync(column.Name)">
                                                <span>@column.Title</span>
                                                <span class="cb-multicol-grid-sort-indicator">@GetNativeSortIndicator(column.Name)</span>
                                            </button>
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @if (!NativeGridItems.Any())
                                {
                                    <tr>
                                        <td colspan="@NativeGridColumnCount" class="text-muted text-center py-4">No records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var row in NativeGridItems)
                                    {
                                        <tr @ondblclick="() => OnRowDoubleClickHandler(row)">
                                            @foreach (var column in VisibleGridColumns)
                                            {
                                                var cellCssClass = EncodeClassNameAsBase64(column, row);
                                                var cellValue = GetNativeCellValue(row, column.Name);
                                                var isGreyedOut = string.Equals(cellValue?.ToString(), "#808080", StringComparison.OrdinalIgnoreCase);
                                                <td id="@cellCssClass"
                                                    class="@(isGreyedOut ? "greyed-out-cell" : string.Empty)"
                                                    style="@GetColumnWidthStyle(column.Width)">
                                                    <div class="custom-ellipsis">@(isGreyedOut ? string.Empty : cellValue)</div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="cb-multicol-grid-pager">
                        <div class="cb-multicol-grid-pager-left">
                            <span>Page @NativePage of @NativeTotalPages</span>
                            <span class="text-muted">@NativeGridSummaryText</span>
                        </div>
                        <div class="cb-multicol-grid-pager-right">
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm cb-v2-btn-secondary"
                                    @onclick="GoToPreviousNativePageAsync"
                                    disabled="@(!CanGoPreviousPage)">
                                Previous
                            </button>
                            <button type="button"
                                    class="btn btn-outline-secondary btn-sm cb-v2-btn-secondary"
                                    @onclick="GoToNextNativePageAsync"
                                    disabled="@(!CanGoNextPage)">
                                Next
                            </button>
                        </div>
                    </div>
                </div>

                <div class="back-to-top-button">
                    <button class="btn btn-secondary" @onclick="ScrollToTop">
                        <i class="bi bi-arrow-up-circle"></i> Back To Top
                    </button>
                </div>
            </div>

            @if (ViewDefinition.IsDetailWindowed && WindowIsVisible)
            {
                <div class="cb-multicol-grid-modal-backdrop" role="presentation">
                    <div class="cb-multicol-grid-modal responsive-window" role="dialog" aria-modal="true" aria-label="@WindowTitle">
                        <div class="cb-multicol-grid-modal-header">
                            <h5 class="mb-0">@WindowTitle</h5>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CloseNativeWindow">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i> Close
                                </button>
                            </div>
                        </div>
                        <div class="cb-multicol-grid-modal-body">
                            <DynamicComponent Type="@Type.GetType($"Concursus.PWA.Pages.{ViewDefinition.DetailPageUri}")" Parameters="@_detailPageParameters" />
                        </div>
                    </div>
                </div>
            }
        }
    </ChildContent>
    <ErrorContent Context="ex">
        <ErrorDisplay ErrorMessage="@ex.Message" />
    </ErrorContent>
</ErrorBoundary>

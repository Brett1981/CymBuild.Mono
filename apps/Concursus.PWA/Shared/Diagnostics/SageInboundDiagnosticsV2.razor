</style>

@code {
    private static readonly Guid TransactionEntityTypeGuid = new("3679db86-9a2f-45bd-9e37-8e40967166d1");
    private static readonly Guid TransactionAllocationEntityTypeGuid = new("be4741d2-121a-46e7-8c60-9ba5f598a88e");

    private CymBuildWindowedModal? _modalHost;

    private readonly List<SageInboundDiagnosticsRowModel> _rows = new();
    private readonly SageInboundDiagnosticsGetRequestModel _filters = new();
    private SageInboundDiagnosticsSummaryModel _summary = new();

    private FormHelper? _formHelper;
    private bool _retryableOnlyChecked;
    private bool _isBusy;
    private bool _isError;
    private string _message = string.Empty;
    private Guid? _rowActionGuid;
    private string? _activeSummaryStatus;
    private string? _activePaymentSummary;

    private int _pageNumber = 1;
    private const int PageSize = 50;
    private long _totalCount;
    private int _totalPages => _totalCount <= 0 ? 1 : (int)Math.Ceiling(_totalCount / (double)PageSize);

    [Parameter] public bool IsEmbedded { get; set; }

    protected override async Task OnInitializedAsync()
    {
        EnsureFormHelper();
        await RefreshAsync();
    }

    private void EnsureFormHelper()
    {
        _formHelper ??= new FormHelper(CoreClient, Guid.Empty.ToString(), UserService);
    }

    // Refreshes both the current page of rows and the grand-total summary cards.
    // Use after anything that changes which records match (a filter change, or a
    // row action that could move a record between buckets). resetPage returns to
    // page 1, which is correct for a filter change but wrong for "just reloading
    // the page I'm already looking at" after a row action.
    private async Task RefreshAsync(bool resetPage = true)
    {
        if (resetPage)
        {
            _pageNumber = 1;
        }

        await Task.WhenAll(LoadSummaryAsync(), LoadAsync());
    }

    private async Task LoadAsync()
    {
        EnsureFormHelper();

        _isBusy = true;
        _message = string.Empty;
        _isError = false;

        try
        {
            _filters.StatusCode ??= string.Empty;
            _filters.SageAccountReference ??= string.Empty;
            _filters.SageDocumentNo ??= string.Empty;
            _filters.TransactionNumber ??= string.Empty;
            _filters.OnlyRetryableFailures = _retryableOnlyChecked ? true : null;
            _filters.PaymentFilter = _activePaymentSummary ?? string.Empty;
            _filters.PageNumber = _pageNumber;
            _filters.PageSize = PageSize;

            var page = await _formHelper!.SageInboundDiagnosticsGetAsync(_filters);

            _rows.Clear();
            _rows.AddRange(page.Rows);
            _totalCount = page.TotalCount;
        }
        catch (Exception ex)
        {
            _rows.Clear();
            _totalCount = 0;
            _isError = true;
            _message = $"Failed to load Sage inbound diagnostics: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task LoadSummaryAsync()
    {
        EnsureFormHelper();

        try
        {
            var summaryRequest = new SageInboundDiagnosticsSummaryRequestModel
            {
                SageAccountReference = _filters.SageAccountReference ?? string.Empty,
                SageDocumentNo = _filters.SageDocumentNo ?? string.Empty,
                TransactionNumber = _filters.TransactionNumber ?? string.Empty,
                OnlyRetryableFailures = _retryableOnlyChecked ? true : null,
                InvoiceRequestId = _filters.InvoiceRequestId,
                TransactionId = _filters.TransactionId,
                JobId = _filters.JobId
            };

            _summary = await _formHelper!.SageInboundDiagnosticsSummaryGetAsync(summaryRequest);
        }
        catch (Exception ex)
        {
            _summary = new SageInboundDiagnosticsSummaryModel();
            _isError = true;
            _message = $"Failed to load Sage inbound diagnostics summary: {ex.Message}";
        }
    }

    private async Task GoToPageAsync(int pageNumber)
    {
        if (pageNumber < 1 || pageNumber > _totalPages || pageNumber == _pageNumber)
        {
            return;
        }

        _pageNumber = pageNumber;
        await LoadAsync();
    }

    private async Task ApplyStatusSummaryFilterAsync(string? statusCode)
    {
        _activeSummaryStatus = statusCode;
        _activePaymentSummary = null;
        _filters.StatusCode = statusCode ?? string.Empty;

        await RefreshAsync();
    }

    private async Task ApplyPaymentSummaryFilterAsync(string paymentSummary)
    {
        _activePaymentSummary = paymentSummary;
        _activeSummaryStatus = null;
        _filters.StatusCode = string.Empty;

        await RefreshAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _filters.StatusCode = string.Empty;
        _filters.SageAccountReference = string.Empty;
        _filters.SageDocumentNo = string.Empty;
        _filters.TransactionNumber = string.Empty;
        _filters.OnlyRetryableFailures = null;
        _filters.InvoiceRequestId = null;
        _filters.TransactionId = null;
        _filters.JobId = null;

        _retryableOnlyChecked = false;
        _activeSummaryStatus = null;
        _activePaymentSummary = null;

        await RefreshAsync();
    }

    private async Task RequeueAsync(SageInboundDiagnosticsRowModel row, bool force)
    {
        if (row.CymBuildDocumentGuid == Guid.Empty)
        {
            _isError = true;
            _message = "The selected row does not contain a valid document guid.";
            return;
        }

        EnsureFormHelper();

        _rowActionGuid = row.CymBuildDocumentGuid;
        _message = string.Empty;
        _isError = false;

        try
        {
            await _formHelper!.SageInboundPaymentSyncEnqueueAsync(row.CymBuildDocumentGuid, force);

            _message = force
                ? $"Force requeue submitted for {DisplayText(row.DisplayTransactionNumber)}."
                : $"Requeue submitted for {DisplayText(row.DisplayTransactionNumber)}.";

            await RefreshAsync(resetPage: false);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Requeue failed for {DisplayText(row.DisplayTransactionNumber)}: {ex.Message}";
        }
        finally
        {
            _rowActionGuid = null;
            StateHasChanged();
        }
    }

    private async Task ApplySageReferenceAsync(SageInboundDiagnosticsRowModel row)
        {
            if (row is null)
            {
                return;
            }

            if (row.TransactionId <= 0)
            {
                _isError = true;
                _message = "The selected row does not contain a valid transaction id.";
                return;
            }

            if (string.IsNullOrWhiteSpace(row.LastSageTransactionReference))
            {
                _isError = true;
                _message = "The selected row does not contain a Sage transaction reference to apply.";
                return;
            }

            EnsureFormHelper();

            _rowActionGuid = row.CymBuildDocumentGuid;
            _message = string.Empty;
            _isError = false;

            try
            {
                var appliedCount = await _formHelper!.SageInboundDiagnosticsApplyTransactionReferencesAsync(
                    statusGuid: row.Guid,
                    transactionId: row.TransactionId,
                    dryRun: false);

                _message = appliedCount > 0
                    ? $"Sage reference {DisplayText(row.LastSageTransactionReference)} applied to {DisplayText(row.DisplayTransactionNumber)}."
                    : $"No Sage reference update was required for {DisplayText(row.DisplayTransactionNumber)}.";

                await RefreshAsync(resetPage: false);
            }
            catch (Exception ex)
            {
                _isError = true;
                _message = $"Apply Sage reference failed for {DisplayText(row.DisplayTransactionNumber)}: {ex.Message}";
            }
            finally
            {
                _rowActionGuid = null;
                StateHasChanged();
            }
        }

    private async Task RunSyncNowAsync(SageInboundDiagnosticsRowModel row)
    {
        if (row.CymBuildDocumentGuid == Guid.Empty)
        {
            _isError = true;
            _message = "The selected row does not contain a valid document guid.";
            return;
        }

        EnsureFormHelper();

        _rowActionGuid = row.CymBuildDocumentGuid;
        _message = string.Empty;
        _isError = false;

        try
        {
            await _formHelper!.SageInboundPaymentSyncAsync(row.CymBuildDocumentGuid);

            _message = $"Sync run requested for {DisplayText(row.DisplayTransactionNumber)}.";

            await RefreshAsync(resetPage: false);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Run Sync Now failed for {DisplayText(row.DisplayTransactionNumber)}: {ex.Message}";
        }
        finally
        {
            _rowActionGuid = null;
            StateHasChanged();
        }
    }

    private async Task AutoCorrectRowAsync(SageInboundDiagnosticsRowModel row)
    {
        if (!row.LastMatchedExternalTransactionId.HasValue)
        {
            return;
        }

        EnsureFormHelper();

        _rowActionGuid = row.CymBuildDocumentGuid;
        _message = string.Empty;
        _isError = false;

        try
        {
            // row.Id is SFin.SageInboundDocumentStatus.ID, not a SageExternalTransactions id -
            // the auto-correct proc needs the actual matched external transaction's id.
            var result = await _formHelper!.SageInboundReceiptMaterialisationAutoCorrectAsync(
                externalTransactionId: row.LastMatchedExternalTransactionId.Value,
                batchSize: 1,
                dryRun: false);

            _message =
                $"Auto correct complete for {DisplayText(row.DisplayTransactionNumber)}. " +
                $"Corrected: {result.CorrectedCount}, Failed: {result.FailedCount}.";

            await RefreshAsync(resetPage: false);
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Auto correct failed for {DisplayText(row.DisplayTransactionNumber)}: {ex.Message}";
        }
        finally
        {
            _rowActionGuid = null;
            StateHasChanged();
        }
    }

    private async Task OpenTransactionAsync(SageInboundDiagnosticsRowModel row)
    {
        var transactionGuid =
            row.MatchedTransactionGuid
            ?? row.TransactionGuid
            ?? Guid.Empty;

        if (_modalHost is null)
            return;

        await _modalHost.OpenWindowedEntityAsync<TransactionDetail>(
            recordGuid: transactionGuid,
            entityTypeGuid: TransactionEntityTypeGuid,
            title: row.TransactionIsBatched == true ? "Edit Transaction" : "View Transaction",
            isInformationPage: row.TransactionIsBatched != true,
            isMainRecordContext: true);
    }

    private async Task OpenReceiptAsync(SageInboundDiagnosticsRowModel row)
    {
        if (_modalHost is null)
            return;

        await _modalHost.OpenWindowedEntityAsync<TransactionDetail>(
            recordGuid: row.MaterialisedReceiptTransactionGuid ?? Guid.Empty,
            entityTypeGuid: TransactionEntityTypeGuid,
            title: $"View {row.MaterialisedTransactionLabel}",
            isInformationPage: true,
            isMainRecordContext: true);
    }

    private async Task OpenAllocationAsync(SageInboundDiagnosticsRowModel row)
    {
        if (_modalHost is null)
            return;

        await _modalHost.OpenWindowedEntityAsync<DynamicEdit>(
            recordGuid: row.MaterialisedAllocationGuid ?? Guid.Empty,
            entityTypeGuid: TransactionAllocationEntityTypeGuid,
            title: row.MaterialisedAllocationId.HasValue
                ? $"Allocation #{row.MaterialisedAllocationId}"
                : "View Allocation",
            isInformationPage: false,
            isMainRecordContext: false);
    }

    private bool IsRowBusy(SageInboundDiagnosticsRowModel row)
    {
        return _isBusy || (_rowActionGuid.HasValue && _rowActionGuid.Value == row.CymBuildDocumentGuid);
    }

    private static bool CanApplySageReference(SageInboundDiagnosticsRowModel row)
    {
        if (row is null)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(row.LastSageTransactionReference))
        {
            return false;
        }

        var existingReference = !string.IsNullOrWhiteSpace(row.TransactionSageTransactionReference)
            ? row.TransactionSageTransactionReference
            : row.MatchedTransactionSageTransactionReference;

        if (!string.IsNullOrWhiteSpace(existingReference))
        {
            return false;
        }

        return row.TransactionId > 0 ||
               row.TransactionGuid.HasValue ||
               row.MatchedTransactionGuid.HasValue;
    }

    private string GetSummaryCardClass(string? statusCode)
    {
        return string.Equals(_activeSummaryStatus, statusCode, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }

    private string GetPaymentSummaryCardClass(string paymentSummary)
    {
        return string.Equals(_activePaymentSummary, paymentSummary, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
    }

    private static string FormatUtc(DateTime? value)
    {
        return value.HasValue
            ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)
            : "-";
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2", CultureInfo.InvariantCulture);
    }

    private static string FormatYesNo(bool value)
    {
        return value ? "Yes" : "No";
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    private static string GetStatusBadgeClass(SageInboundDiagnosticsRowModel row)
    {
        return row.StatusCode switch
        {
            "Succeeded" => "cb-v2-badge-success",
            "Failed" => "cb-v2-badge-danger",
            "RetryPending" => "cb-v2-badge-warning",
            "Pending" => "cb-v2-badge-info",
            "PartiallyPaid" => "cb-v2-badge-warning",
            _ when row.IsInProgress => "cb-v2-badge-muted",
            _ => "cb-v2-badge-muted"
        };
    }

    private static string GetPaymentStateBadgeClass(string? paymentStateCode)
    {
        return paymentStateCode switch
        {
            "Paid" => "cb-v2-badge-success",
            "PartiallyPaid" => "cb-v2-badge-warning",
            "Unpaid" => "cb-v2-badge-info",
            "OverAllocated" => "cb-v2-badge-danger",
            _ => "cb-v2-badge-muted"
        };
    }
}
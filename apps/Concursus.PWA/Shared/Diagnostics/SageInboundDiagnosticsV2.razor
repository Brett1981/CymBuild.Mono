@page "/SageInboundDiagnosticsV2"
@using System.Globalization
@using System.Web
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using Concursus.Common.Shared.Models.Finance
@using Concursus.Components.Shared.Classes
@using Concursus.Components.Shared.Modals
@using Concursus.PWA.Shared
@using Newtonsoft.Json
@using Concursus.PWA.Pages
@using static Concursus.API.Client.FormHelper

@inject Core.CoreClient CoreClient
@inject UserService UserService
@inject NavigationManager NavManager
@inject ModalService modalService
@inject Concursus.Components.Shared.Modals.CymBuildModalService CymBuildModalService

<div class="cb-v2-page sage-inbound-v2-page">
    <div class="cb-v2-card">
        <div class="cb-v2-card-body">
            @if (!IsEmbedded)
            {
                <div class="cb-v2-header-row mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="cb-v2-icon-wrap">
                            <i class="fas fa-money-check-alt"></i>
                        </div>

                        <div>
                            <div class="cb-v2-subtitle">Finance Admin</div>
                            <h2 class="cb-v2-title">Sage Inbound Diagnostics</h2>
                            <p class="cb-v2-description mb-0">
                                Monitor inbound payment allocation sync, receipt and credit note creation, matching status, and linked CymBuild transactions.
                            </p>
                        </div>
                    </div>

                    <div class="cb-v2-actions">
                        <button type="button" class="cb-v2-btn-secondary" @onclick="ResetFiltersAsync" disabled="@_isBusy">
                            Reset filters
                        </button>

                        <button type="button" class="cb-v2-btn-secondary" @onclick="() => RefreshAsync()" disabled="@_isBusy">
                            @if (_isBusy)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Refresh
                        </button>
                    </div>
                </div>
            }

            <div class="cb-v2-summary-grid sage-inbound-summary-grid mb-4">
                <button type="button"
                        class="cb-v2-summary-card @(GetSummaryCardClass(null))"
                        @onclick='() => ApplyStatusSummaryFilterAsync(null)'>
                    <div class="cb-v2-summary-title">Total</div>
                    <div class="cb-v2-summary-value">@_summary.TotalCount</div>
                    <div class="cb-v2-summary-subtitle">All records</div>
                </button>

                <button type="button"
                        class="cb-v2-summary-card sage-inbound-summary-green @(GetSummaryCardClass("Succeeded"))"
                        @onclick='() => ApplyStatusSummaryFilterAsync("Succeeded")'>
                    <div class="cb-v2-summary-title">Succeeded</div>
                    <div class="cb-v2-summary-value">@_summary.SucceededCount</div>
                    <div class="cb-v2-summary-subtitle">Completed successfully</div>
                </button>

                <button type="button"
                        class="cb-v2-summary-card sage-inbound-summary-amber @(GetSummaryCardClass("RetryPending"))"
                        @onclick='() => ApplyStatusSummaryFilterAsync("RetryPending")'>
                    <div class="cb-v2-summary-title">Retry Pending</div>
                    <div class="cb-v2-summary-value">@_summary.RetryPendingCount</div>
                    <div class="cb-v2-summary-subtitle">Can be retried</div>
                </button>

                <button type="button"
                        class="cb-v2-summary-card sage-inbound-summary-blue @(GetPaymentSummaryCardClass("Paid"))"
                        @onclick='() => ApplyPaymentSummaryFilterAsync("Paid")'>
                    <div class="cb-v2-summary-title">Paid</div>
                    <div class="cb-v2-summary-value">@_summary.PaidCount</div>
                    <div class="cb-v2-summary-subtitle">Fully settled</div>
                </button>

                <button type="button"
                        class="cb-v2-summary-card sage-inbound-summary-purple @(GetPaymentSummaryCardClass("Receipts"))"
                        @onclick='() => ApplyPaymentSummaryFilterAsync("Receipts")'>
                    <div class="cb-v2-summary-title">Receipts Created</div>
                    <div class="cb-v2-summary-value">@_summary.ReceiptsCreatedCount</div>
                    <div class="cb-v2-summary-subtitle">CymBuild receipts</div>
                </button>

                <button type="button"
                        class="cb-v2-summary-card sage-inbound-summary-purple @(GetPaymentSummaryCardClass("CreditNotes"))"
                        @onclick='() => ApplyPaymentSummaryFilterAsync("CreditNotes")'>
                    <div class="cb-v2-summary-title">Credit Notes Created</div>
                    <div class="cb-v2-summary-value">@_summary.CreditNotesCreatedCount</div>
                    <div class="cb-v2-summary-subtitle">CymBuild credit notes</div>
                </button>
            </div>

            <div class="cb-v2-toolbar mb-4">
                <div class="cb-v2-toolbar-left">
                    <div>
                        <label class="form-label">Status</label>
                        <select class="cb-v2-select" @bind="_filters.StatusCode" disabled="@_isBusy">
                            <option value="">All</option>
                            <option value="Pending">Pending</option>
                            <option value="RetryPending">RetryPending</option>
                            <option value="Failed">Failed</option>
                            <option value="Succeeded">Succeeded</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Account reference</label>
                        <input class="cb-v2-input" @bind="_filters.SageAccountReference" @bind:event="oninput" disabled="@_isBusy" />
                    </div>

                    <div>
                        <label class="form-label">Document no</label>
                        <input class="cb-v2-input" @bind="_filters.SageDocumentNo" @bind:event="oninput" disabled="@_isBusy" />
                    </div>

                    <div>
                        <label class="form-label">Transaction no</label>
                        <input class="cb-v2-input" @bind="_filters.TransactionNumber" @bind:event="oninput" placeholder="FIRE1234" disabled="@_isBusy" />
                    </div>

                    <div class="d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input id="retryableOnly" class="form-check-input" type="checkbox" @bind="_retryableOnlyChecked" disabled="@_isBusy" />
                            <label class="form-check-label" for="retryableOnly">Retryable failures only</label>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="cb-v2-card mb-4">
                    <div class="cb-v2-card-body">
                        <div class="@(_isError ? "cb-v2-badge cb-v2-badge-danger" : "cb-v2-badge cb-v2-badge-success")">
                            @_message
                        </div>
                    </div>
                </div>
            }

            <div class="cb-v2-table-wrap">
                <table class="cb-v2-table">
                    <thead>
                        <tr>
                            <th>Invoice / Transaction</th>
                            <th>Status</th>
                            <th>Amounts</th>
                            <th>Payment</th>
                            <th>Receipt or Credit Note / Allocation</th>
                            <th>Polling</th>
                            <th>Error</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_rows.Count == 0 && !_isBusy)
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="cb-v2-empty-state">No inbound sync records match the current filters.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td class="sage-inbound-col-transaction">
                                        <button type="button" class="cb-v2-btn-link cb-v2-strong" @onclick="() => OpenTransactionAsync(row)">
                                            @DisplayText(row.DisplayTransactionNumber)
                                        </button>

                                        <div class="cb-v2-muted small">@DisplayText(row.InvoiceReference) · @DisplayText(row.TransactionReference) · @DisplayText(row.JobReference)</div>
                                        <div class="cb-v2-muted small">Matched: @DisplayText(row.DisplayMatchedTransactionNumber)</div>
                                        <div class="cb-v2-muted small">Account: @DisplayText(row.SageAccountReference)</div>
                                        <div class="cb-v2-muted small">Doc: @DisplayText(row.SageDocumentNo)</div>

                                        @if (!string.IsNullOrWhiteSpace(row.LastSageTransactionReference))
                                        {
                                            <div class="cb-v2-muted small">Sage Ref: @DisplayText(row.LastSageTransactionReference)</div>
                                        }
                                    </td>

                                    <td>
                                        <span class="cb-v2-badge @GetStatusBadgeClass(row)">@DisplayText(row.StatusCode)</span>

                                        @if (row.IsTerminalState)
                                        {
                                            <div class="cb-v2-muted small mt-1">Terminal</div>
                                        }
                                        else if (row.IsInProgress)
                                        {
                                            <div class="cb-v2-muted small mt-1">In progress</div>
                                        }
                                    </td>

                                    <td>
                                        <div><span class="cb-v2-muted">Gross:</span> @FormatMoney(row.LastGrossAmount)</div>
                                        <div><span class="cb-v2-muted">Allocated:</span> @FormatMoney(row.LastAllocatedValue)</div>
                                        <div><span class="cb-v2-muted">Outstanding:</span> @FormatMoney(row.LastOutstandingAmount)</div>
                                    </td>

                                    <td>
                                        <span class="cb-v2-badge @GetPaymentStateBadgeClass(row.LastPaymentStateCode)">
                                            @DisplayText(row.LastPaymentStateCode)
                                        </span>
                                        <div class="cb-v2-muted small mt-1">Paid: @FormatYesNo(row.LastIsPaid)</div>
                                        <div class="cb-v2-muted small">Fully Paid: @FormatYesNo(row.LastIsFullyPaid)</div>
                                    </td>

                                    <td class="sage-inbound-col-links">
                                        @if (row.HasMaterialisedReceipt)
                                        {
                                            <button type="button" class="cb-v2-btn-link" @onclick="() => OpenReceiptAsync(row)">
                                                @row.MaterialisedTransactionLabel: @DisplayText(row.DisplayReceiptTransactionNumber)
                                            </button>
                                        }
                                        else if (row.IsSettledMethodUnknown)
                                        {
                                            <div class="small" title="Sage could not say whether a receipt or a credit note settled this invoice, so nothing was created.">Settled, method unknown</div>
                                        }
                                        else
                                        {
                                            <div class="cb-v2-muted small">Receipt / Credit Note: -</div>
                                        }

                                        @if (row.HasMaterialisedAllocation)
                                        {
                                            <div class="mt-1">
                                                <button type="button" class="cb-v2-btn-link" @onclick="() => OpenAllocationAsync(row)">
                                                    Allocation: #@row.MaterialisedAllocationId
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="cb-v2-muted small mt-1">Allocation: -</div>
                                        }
                                    </td>

                                    <td>
                                        <div><span class="cb-v2-muted">Next:</span> @FormatUtc(row.NextPollDueOnUtc)</div>
                                        <div class="cb-v2-muted small">Attempts: @row.PollAttemptCount</div>
                                        <div class="cb-v2-muted small">Success: @FormatUtc(row.LastSucceededOnUtc)</div>
                                    </td>

                                    <td class="sage-inbound-col-error">
                                        <div class="cb-v2-ellipsis sage-inbound-error-text" title="@row.EffectiveErrorMessage">
                                            @DisplayText(row.EffectiveErrorMessage)
                                        </div>
                                    </td>

                                    <td class="text-end">
                                        <div class="d-flex flex-column gap-2 align-items-end">
                                            <button type="button" class="cb-v2-btn-secondary" @onclick="() => OpenTransactionAsync(row)" disabled="@IsRowBusy(row)">
                                                @(row.TransactionIsBatched == true ? "Edit Transaction" : "View Transaction")
                                            </button>

                                            @if (row.HasMaterialisedReceipt)
                                            {
                                                <button type="button" class="cb-v2-btn-secondary" @onclick="() => OpenReceiptAsync(row)" disabled="@IsRowBusy(row)">
                                                    View @row.MaterialisedTransactionLabel
                                                </button>
                                            }

                                            <button type="button" class="cb-v2-btn-secondary" @onclick="() => RunSyncNowAsync(row)" disabled="@IsRowBusy(row)">
                                                Run Sync Now
                                            </button>

                                            @if (CanApplySageReference(row))
                                            {
                                                <button type="button"
                                                        class="cb-v2-btn-secondary"
                                                        @onclick="() => ApplySageReferenceAsync(row)"
                                                        disabled="@IsRowBusy(row)">
                                                    Apply Missing Sage Ref
                                                </button>
                                            }

                                            <button type="button" class="cb-v2-btn-secondary" @onclick="() => RequeueAsync(row, true)" disabled="@(!row.CanForceRequeue || IsRowBusy(row))">
                                                Force Requeue
                                            </button>

                                            @if (row.CanFixReceipt)
                                            {
                                                <button type="button"
                                                        class="cb-v2-btn-secondary"
                                                        @onclick="() => AutoCorrectRowAsync(row)"
                                                        disabled="@IsRowBusy(row)">
                                                    Fix Receipt
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="cb-v2-toolbar sage-inbound-pager">
                <div class="cb-v2-muted small">
                    @if (_totalCount > 0)
                    {
                        <text>Showing @(((_pageNumber - 1) * PageSize) + 1)-@(Math.Min(_pageNumber * PageSize, _totalCount)) of @_totalCount</text>
                    }
                    else
                    {
                        <text>No records</text>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="cb-v2-btn-secondary" @onclick="() => GoToPageAsync(_pageNumber - 1)" disabled="@(_isBusy || _pageNumber <= 1)">
                        Previous
                    </button>
                    <span class="cb-v2-muted small">Page @_pageNumber of @_totalPages</span>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="() => GoToPageAsync(_pageNumber + 1)" disabled="@(_isBusy || _pageNumber >= _totalPages)">
                        Next
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<CymBuildWindowedModal @ref="_modalHost" SizeCssClass="cb-v2-modal-lg" />


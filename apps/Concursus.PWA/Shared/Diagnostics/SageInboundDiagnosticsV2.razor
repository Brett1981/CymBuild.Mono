@page "/SageInboundDiagnosticsV2"
@using System.Globalization
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using Concursus.Common.Shared.Models.Finance
@using static Concursus.API.Client.FormHelper
@inject Core.CoreClient CoreClient
@inject Sage200Microservice.API.Protos.Invoice.InvoiceService.InvoiceServiceClient SageClient
@inject UserService UserService

<div class="cb-v2-page">
    <div class="cb-v2-card">
        <div class="cb-v2-card-body">
            <div class="cb-v2-header-row mb-4">
                <div>
                    <div class="cb-v2-subtitle">Finance Admin</div>
                    <h2 class="cb-v2-title">Sage Inbound Diagnostics</h2>
                    <p class="cb-v2-description mb-0">
                        Monitor inbound payment/allocation sync status, inspect latest attempt outcome, and safely requeue records without SQL access.
                    </p>
                </div>

                <div class="cb-v2-actions">
                    <button class="cb-v2-btn-secondary"
                            @onclick="ResetFiltersAsync"
                            disabled="@_isBusy">
                        Reset filters
                    </button>

                    <button class="cb-v2-btn-secondary"
                            @onclick="LoadAsync"
                            disabled="@_isBusy">
                        @if (_isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Refresh
                    </button>
                </div>
            </div>

            <div class="cb-v2-toolbar mb-4">
                <div class="cb-v2-toolbar-left">
                    <div>
                        <label class="form-label">Status</label>
                        <select class="cb-v2-select"
                                @bind="_filters.StatusCode"
                                disabled="@_isBusy">
                            <option value="">All</option>
                            <option value="Pending">Pending</option>
                            <option value="RetryPending">RetryPending</option>
                            <option value="PartiallyPaid">PartiallyPaid</option>
                            <option value="Failed">Failed</option>
                            <option value="Succeeded">Succeeded</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Account reference</label>
                        <input class="cb-v2-input"
                               @bind="_filters.SageAccountReference"
                               @bind:event="oninput"
                               disabled="@_isBusy" />
                    </div>

                    <div>
                        <label class="form-label">Document no</label>
                        <input class="cb-v2-input"
                               @bind="_filters.SageDocumentNo"
                               @bind:event="oninput"
                               disabled="@_isBusy" />
                    </div>

                    <div class="d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input id="retryableOnly"
                                   class="form-check-input"
                                   type="checkbox"
                                   @bind="_retryableOnlyChecked"
                                   disabled="@_isBusy" />
                            <label class="form-check-label" for="retryableOnly">Retryable failures only</label>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <div class="cb-v2-card mb-4">
                    <div class="cb-v2-card-body">
                        <div class="@(_isError ? "cb-v2-badge cb-v2-badge-danger" : "cb-v2-badge cb-v2-badge-success")">
                            @_message
                        </div>
                    </div>
                </div>
            }

            <div class="cb-v2-table-wrap">
                <table class="cb-v2-table">
                    <thead>
                        <tr>
                            <th>Invoice / Transaction</th>
                            <th>Account / Doc</th>
                            <th>Status</th>
                            <th>Amounts</th>
                            <th>Payment State</th>
                            <th>Polling</th>
                            <th>Last success</th>
                            <th>Last failure</th>
                            <th>Retryable</th>
                            <th>Error</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (_rows.Count == 0 && !_isBusy)
                        {
                            <tr>
                                <td colspan="11">
                                    <div class="cb-v2-empty-state">
                                        No inbound sync records match the current filters.
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in _rows)
                            {
                                <tr>
                                    <td>
                                        <div class="cb-v2-strong">@DisplayText(row.InvoiceReference)</div>
                                        <div class="cb-v2-muted small">
                                            @DisplayText(row.TransactionReference) · @DisplayText(row.JobReference)
                                        </div>
                                    </td>

                                    <td>
                                        <div class="cb-v2-strong">@DisplayText(row.SageAccountReference)</div>
                                        <div class="cb-v2-muted small">@DisplayText(row.SageDocumentNo)</div>
                                        @if (!string.IsNullOrWhiteSpace(row.LastSageTransactionReference))
                                        {
                                            <div class="cb-v2-muted small">
                                                Ref: @DisplayText(row.LastSageTransactionReference)
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <span class="cb-v2-badge @GetStatusBadgeClass(row)">@DisplayText(row.StatusCode)</span>
                                        @if (row.IsInProgress)
                                        {
                                            <div class="cb-v2-muted small mt-1">
                                                Claimed @FormatUtc(row.InProgressClaimedOnUtc)
                                            </div>
                                        }
                                        @if (row.IsTerminalState)
                                        {
                                            <div class="cb-v2-muted small mt-1">
                                                Terminal
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div><span class="cb-v2-muted">Gross:</span> @FormatMoney(row.LastGrossAmount)</div>
                                        <div><span class="cb-v2-muted">Allocated:</span> @FormatMoney(row.LastAllocatedValue)</div>
                                        <div><span class="cb-v2-muted">Outstanding:</span> @FormatMoney(row.LastOutstandingAmount)</div>
                                    </td>

                                    <td>
                                        <div>
                                            <span class="cb-v2-badge @GetPaymentStateBadgeClass(row.LastPaymentStateCode)">
                                                @DisplayText(row.LastPaymentStateCode)
                                            </span>
                                        </div>
                                        <div class="cb-v2-muted small mt-1">
                                            Paid: @FormatYesNo(row.LastIsPaid)
                                        </div>
                                        <div class="cb-v2-muted small">
                                            Fully Paid: @FormatYesNo(row.LastIsFullyPaid)
                                        </div>
                                    </td>

                                    <td>
                                        <div><span class="cb-v2-muted">Next:</span> @FormatUtc(row.NextPollDueOnUtc)</div>
                                        <div class="cb-v2-muted small">
                                            Attempts: @row.PollAttemptCount
                                        </div>
                                    </td>

                                    <td>@FormatUtc(row.LastSucceededOnUtc)</td>

                                    <td>
                                        <div>@FormatUtc(row.LastFailedOnUtc)</div>
                                        <div class="cb-v2-muted small">
                                            Attempt: @FormatUtc(row.LastAttemptedOnUtc)
                                        </div>
                                    </td>

                                    <td>@DisplayText(row.RetryableDisplay)</td>

                                    <td style="max-width: 360px;">
                                        <div class="cb-v2-ellipsis" title="@row.EffectiveErrorMessage">
                                            @DisplayText(row.EffectiveErrorMessage)
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(row.LastAttemptResponseStatus))
                                        {
                                            <div class="cb-v2-muted small">@row.LastAttemptResponseStatus</div>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="cb-v2-actions justify-content-end">
                                            <button class="cb-v2-btn-secondary"
                                                    disabled="@(_rowActionGuid == row.CymBuildDocumentGuid || !row.CanRequeue || _isBusy)"
                                                    @onclick="() => RequeueAsync(row, false)">
                                                Requeue
                                            </button>

                                            <button class="cb-v2-btn-secondary"
                                                    disabled="@(_rowActionGuid == row.CymBuildDocumentGuid || !row.CanForceRequeue || _isBusy)"
                                                    @onclick="() => RequeueAsync(row, true)">
                                                Force Requeue
                                            </button>

                                            <button class="cb-v2-btn-secondary"
                                                    disabled="@(_rowActionGuid == row.CymBuildDocumentGuid || _isBusy)"
                                                    @onclick="() => RunSyncNowAsync(row)">
                                                Run Sync Now
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly List<SageInboundDiagnosticsRowModel> _rows = new();

    private readonly SageInboundDiagnosticsGetRequestModel _filters = new()
    {
        StatusCode = string.Empty,
        SageAccountReference = string.Empty,
        SageDocumentNo = string.Empty,
        OnlyRetryableFailures = null,
        InvoiceRequestId = null,
        TransactionId = null,
        JobId = null
    };

    private FormHelper? _formHelper;
    private bool _retryableOnlyChecked;
    private bool _isBusy;
    private bool _isError;
    private string _message = string.Empty;
    private Guid? _rowActionGuid;

    protected override async Task OnInitializedAsync()
    {
        EnsureFormHelper();
        await LoadAsync();
    }

    private void EnsureFormHelper()
    {
        _formHelper ??= new FormHelper(
            CoreClient,
            SageClient,
            Guid.Empty.ToString(),
            UserService);
    }

    private async Task LoadAsync()
    {
        EnsureFormHelper();

        _isBusy = true;
        _message = string.Empty;
        _isError = false;

        try
        {
            _filters.StatusCode ??= string.Empty;
            _filters.SageAccountReference ??= string.Empty;
            _filters.SageDocumentNo ??= string.Empty;
            _filters.OnlyRetryableFailures = _retryableOnlyChecked ? true : null;

            var rows = await _formHelper!.SageInboundDiagnosticsGetAsync(_filters);

            _rows.Clear();

            if (rows is not null && rows.Count > 0)
            {
                _rows.AddRange(rows);
            }
        }
        catch (Exception ex)
        {
            _rows.Clear();
            _isError = true;
            _message = $"Failed to load Sage inbound diagnostics: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
            StateHasChanged();
        }
    }

    private async Task ResetFiltersAsync()
    {
        _filters.StatusCode = string.Empty;
        _filters.SageAccountReference = string.Empty;
        _filters.SageDocumentNo = string.Empty;
        _filters.OnlyRetryableFailures = null;
        _filters.InvoiceRequestId = null;
        _filters.TransactionId = null;
        _filters.JobId = null;

        _retryableOnlyChecked = false;

        await LoadAsync();
    }

    private async Task RequeueAsync(SageInboundDiagnosticsRowModel row, bool force)
    {
        if (row is null || row.CymBuildDocumentGuid == Guid.Empty)
        {
            _isError = true;
            _message = "The selected row does not contain a valid document guid.";
            return;
        }

        EnsureFormHelper();

        _rowActionGuid = row.CymBuildDocumentGuid;
        _message = string.Empty;
        _isError = false;

        try
        {
            await _formHelper!.SageInboundPaymentSyncEnqueueAsync(row.CymBuildDocumentGuid, force);

            _message = force
                ? $"Force requeue submitted for {DisplayText(row.InvoiceReference)}."
                : $"Requeue submitted for {DisplayText(row.InvoiceReference)}.";

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Requeue failed for {DisplayText(row.InvoiceReference)}: {ex.Message}";
        }
        finally
        {
            _rowActionGuid = null;
            StateHasChanged();
        }
    }

    private async Task RunSyncNowAsync(SageInboundDiagnosticsRowModel row)
    {
        if (row is null || row.CymBuildDocumentGuid == Guid.Empty)
        {
            _isError = true;
            _message = "The selected row does not contain a valid document guid.";
            return;
        }

        EnsureFormHelper();

        _rowActionGuid = row.CymBuildDocumentGuid;
        _message = string.Empty;
        _isError = false;

        try
        {
            await _formHelper!.SageInboundPaymentSyncAsync(row.CymBuildDocumentGuid);

            _message = $"Sync run requested for {DisplayText(row.InvoiceReference)}.";

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _isError = true;
            _message = $"Run Sync Now failed for {DisplayText(row.InvoiceReference)}: {ex.Message}";
        }
        finally
        {
            _rowActionGuid = null;
            StateHasChanged();
        }
    }

    private static string FormatUtc(DateTime? value)
    {
        return value.HasValue
            ? DateTime.SpecifyKind(value.Value, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.InvariantCulture)
            : "-";
    }

    private static string FormatMoney(decimal value)
    {
        return value.ToString("N2", CultureInfo.InvariantCulture);
    }

    private static string FormatYesNo(bool value)
    {
        return value ? "Yes" : "No";
    }

    private static string DisplayText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();
    }

    private static string GetStatusBadgeClass(SageInboundDiagnosticsRowModel row)
    {
        if (row is null)
        {
            return "cb-v2-badge-muted";
        }

        return row.StatusCode switch
        {
            "Succeeded" => "cb-v2-badge-success",
            "Failed" => "cb-v2-badge-danger",
            "RetryPending" => "cb-v2-badge-warning",
            "Pending" => "cb-v2-badge-info",
            "PartiallyPaid" => "cb-v2-badge-warning",
            _ when row.IsInProgress => "cb-v2-badge-muted",
            _ => "cb-v2-badge-muted"
        };
    }

    private static string GetPaymentStateBadgeClass(string? paymentStateCode)
    {
        return paymentStateCode switch
        {
            "Paid" => "cb-v2-badge-success",
            "PartiallyPaid" => "cb-v2-badge-warning",
            "Unpaid" => "cb-v2-badge-info",
            "OverAllocated" => "cb-v2-badge-danger",
            _ => "cb-v2-badge-muted"
        };
    }
}
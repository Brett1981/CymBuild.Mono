@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<h3>Memory Diagnostics Dashboard</h3>

<div class="card shadow-sm border-0 mb-3">
    <div class="card-body p-0">
        <div class="table-responsive" style="max-height: 600px; overflow: auto;">
            <table class="table table-sm table-striped table-hover align-middle mb-0">
                <thead class="table-light sticky-top">
                    <tr>
                        <th style="width: 250px;">Metric</th>
                        <th style="width: 600px;">Description</th>
                        <th style="width: 200px;">Recommended Threshold</th>
                        <th style="width: 200px;">Live Value</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var diagnostic in diagnostics)
                    {
                        <tr>
                            <td class="fw-semibold">@diagnostic.Metric</td>
                            <td>@diagnostic.Description</td>
                            <td>@diagnostic.RecommendedThreshold</td>
                            <td>@diagnostic.Value</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<button type="button" class="btn btn-primary" @onclick="RefreshMetrics">Refresh</button>

@code {
    private List<MemoryMetric> diagnostics = new();
    private IJSObjectReference? _module;

    protected override async Task OnInitializedAsync()
    {
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./memoryDiagnostics.js");
        await RefreshMetrics();
    }

    private async Task RefreshMetrics()
    {
        if (_module is null)
        {
            return;
        }

        var memory = await _module.InvokeAsync<double>("getTotalMemory");
        var jsObjectCount = await _module.InvokeAsync<int>("getJSObjectReferenceCount");
        var cacheSize = await _module.InvokeAsync<double>("getServiceWorkerCacheSizeMB");
        var componentCount = await _module.InvokeAsync<int>("getBlazorComponentCount");

        diagnostics = new()
        {
            new("GC Total Memory (bytes)", "Current memory usage reported by .NET GC", "< 200MB", $"{memory:N0} bytes"),
            new("Page Component Count", "Number of active components on the current page", "< 20 components", componentCount.ToString()),
            new("Active JSObjectReferences", "JS interop object references still held", "< 5 references", jsObjectCount.ToString()),
            new("Service Worker Cache Size (MB)", "Offline cache size used by service worker", "< 50MB", $"{cacheSize:F2} MB"),
            new("Native Diagnostic Tables Rendered", "Number of native diagnostic tables on the page", "<= 1 table", "1"),
            new("Blazor Circuit Count", "Total active SignalR circuits (Blazor Server only)", "< 3", "N/A in WebAssembly"),
        };
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Component is being disposed after the JS runtime disconnected.
            }
        }
    }

    public record MemoryMetric(string Metric, string Description, string RecommendedThreshold, string Value);
}

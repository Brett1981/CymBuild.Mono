<nav class="cb-native-dev-pager" aria-label="Queue pages">
    <span>Showing @FirstItem to @LastItem of @ItemCount</span>
    <button type="button" class="btn btn-outline-secondary" @onclick="OnPrevious" disabled="@(CurrentPage <= 1)">Previous</button>
    <span>Page @CurrentPage of @TotalPages</span>
    <button type="button" class="btn btn-outline-secondary" @onclick="OnNext" disabled="@(CurrentPage >= TotalPages)">Next</button>
</nav>

@code {
    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int ItemCount { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }

    private int FirstItem => ItemCount == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int LastItem => Math.Min(CurrentPage * PageSize, ItemCount);
}

@using Concursus.API.Client.Models
@using Concursus.API.Core
@using Concursus.API.Client
@using Concursus.PWA.Helpers
@using Concursus.PWA.Classes
@using Google.Protobuf.WellKnownTypes

@inject Core.CoreClient coreClient
@inject UserService userService
@if (IsWindowOpen)
{
    <section class="sharepoint-browser cb-v2-card m-1 flex-grow-1" aria-labelledby="sharepoint-browser-title">
        <div class="card-body cb-v2-card-body">
            <header class="sharepoint-browser-header cb-v2-header-row">
                <div>
                    <h5 id="sharepoint-browser-title" class="mb-1">Documents</h5>
                    <p class="text-muted mb-0">Double-click a document to select it.</p>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="LoadDriveListItems" disabled="@isLoading">
                    <span aria-hidden="true">↻</span> Refresh
                </button>
            </header>

            @if (isLoading)
            {
                <div class="sharepoint-browser-state cb-v2-loading-state cb-v2-state-surface" role="status">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    Loading documents...
                </div>
            }
            else if (driveListItems.Count == 0)
            {
                <div class="sharepoint-browser-empty cb-v2-empty-state cb-v2-state-surface compact" role="status">No documents found.</div>
            }
            else
            {
                <div class="sharepoint-browser-table-wrap cb-v2-table-wrap">
                    <table class="cb-v2-table cb-v2-table-compact sharepoint-browser-table" aria-label="SharePoint documents">
                        <thead class="cb-v2-table-sticky-head">
                            <tr>
                                <th scope="col" class="sharepoint-browser-name-column">
                                    <button type="button" class="sharepoint-browser-sort cb-v2-sort-button" @onclick="@(() => SetSort(SortColumn.Name))">
                                        Document Name <span aria-hidden="true">@GetSortIndicator(SortColumn.Name)</span>
                                    </button>
                                </th>
                                <th scope="col">
                                    <button type="button" class="sharepoint-browser-sort cb-v2-sort-button" @onclick="@(() => SetSort(SortColumn.Created))">
                                        Created Date <span aria-hidden="true">@GetSortIndicator(SortColumn.Created)</span>
                                    </button>
                                </th>
                                <th scope="col">
                                    <button type="button" class="sharepoint-browser-sort cb-v2-sort-button" @onclick="@(() => SetSort(SortColumn.Modified))">
                                        Last Modified Date <span aria-hidden="true">@GetSortIndicator(SortColumn.Modified)</span>
                                    </button>
                                </th>
                                <th scope="col">
                                    <button type="button" class="sharepoint-browser-sort cb-v2-sort-button" @onclick="@(() => SetSort(SortColumn.Size))">
                                        File Size <span aria-hidden="true">@GetSortIndicator(SortColumn.Size)</span>
                                    </button>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedItems)
                            {
                                <tr class="cb-v2-clickable-row cb-v2-focusable-row"
                                    tabindex="0"
                                    title="Double-click to select @item.Name"
                                    @ondblclick="@(() => OnRowDoubleClickHandler(item))"
                                    @onkeydown="@(args => OnRowKeyDownAsync(args, item))">
                                    <td>@item.Name</td>
                                    <td class="text-nowrap">@FormatDate(item.CreatedDateTime)</td>
                                    <td class="text-nowrap">@FormatDate(item.LastModifiedDateTime)</td>
                                    <td class="text-nowrap">@FormatSize(item.Size)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <nav class="sharepoint-browser-pager cb-v2-table-footer" aria-label="Document pages">
                    <span>Showing @FirstVisibleItem to @LastVisibleItem of @driveListItems.Count</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(CurrentPage <= 1)">Previous</button>
                    <span>Page @CurrentPage of @TotalPages</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)">Next</button>
                </nav>
            }
        </div>
    </section>
}

@code {
    private const int PageSize = 10;

    [Parameter] public string EntityTypeGuid { get; set; } = Guid.Empty.ToString();
    [Parameter] public string SharePointSiteId { get; set; } = string.Empty;
    [Parameter] public EventCallback<DriveListItem> OnItemDoubleClick { get; set; }
    [Parameter] public bool IsWindowOpen { get; set; } = true;
    [Parameter] public EventCallback CloseWindow { get; set; }
    [Parameter] public string TemplateFolderName { get; set; } = "Job Folders";
    [Parameter] public EventCallback<Exception> OnError { get; set; }

    private readonly List<DriveListItem> driveListItems = new();
    private FormHelper? formHelper;
    private string siteId = string.Empty;
    private bool isLoading;
    private int CurrentPage { get; set; } = 1;
    private SortColumn CurrentSort { get; set; } = SortColumn.Name;
    private bool SortDescending { get; set; }

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(driveListItems.Count / (double)PageSize));
    private int FirstVisibleItem => driveListItems.Count == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int LastVisibleItem => Math.Min(CurrentPage * PageSize, driveListItems.Count);
    private IEnumerable<DriveListItem> PagedItems => SortedItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private IEnumerable<DriveListItem> SortedItems
    {
        get
        {
            Func<DriveListItem, object?> selector = CurrentSort switch
            {
                SortColumn.Created => item => item.CreatedDateTime?.ToDateTime(),
                SortColumn.Modified => item => item.LastModifiedDateTime?.ToDateTime(),
                SortColumn.Size => item => item.Size,
                _ => item => item.Name
            };

            return SortDescending
                ? driveListItems.OrderByDescending(selector).ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase)
                : driveListItems.OrderBy(selector).ThenBy(item => item.Name, StringComparer.OrdinalIgnoreCase);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            formHelper = new FormHelper(coreClient, PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(EntityTypeGuid).ToString(), userService);
            siteId = SharePointSiteId;
            await LoadDriveListItems();
        }
        catch (Exception ex)
        {
            await ReportErrorAsync(ex, "An error occurred while initializing the SharePointBrowser component.", "SharePointBrowser/OnInitializedAsync()");
        }
    }

    private async Task LoadDriveListItems()
    {
        if (formHelper is null || isLoading) return;

        try
        {
            isLoading = true;
            var items = await formHelper.GetSharePointSitesAsync(siteId, TemplateFolderName);
            var loadedItems = new List<DriveListItem>();

            foreach (var item in items)
            {
                if (!string.IsNullOrEmpty(item.ErrorReturned)) throw new InvalidOperationException(item.ErrorReturned);

                loadedItems.Add(new DriveListItem
                {
                    Id = item.Id,
                    Name = item.Name,
                    CreatedDateTime = item.CreatedDateTime,
                    LastModifiedDateTime = item.LastModifiedDateTime,
                    WebUrl = item.WebUrl,
                    MimeType = item.MimeType,
                    Size = item.Size,
                    ParentFolder = item.ParentFolder,
                    SharePointFile = item.SharePointFile
                });
            }

            driveListItems.Clear();
            driveListItems.AddRange(loadedItems);
            CurrentPage = Math.Min(CurrentPage, TotalPages);
        }
        catch (Exception ex)
        {
            await ReportErrorAsync(ex, "An error occurred while loading SharePoint drive list items.", "SharePointBrowser/LoadDriveListItems()");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SetSort(SortColumn column)
    {
        if (CurrentSort == column) SortDescending = !SortDescending;
        else { CurrentSort = column; SortDescending = false; }
        CurrentPage = 1;
    }

    private string GetSortIndicator(SortColumn column) => CurrentSort != column ? string.Empty : SortDescending ? "▼" : "▲";
    private void PreviousPage() => CurrentPage = Math.Max(1, CurrentPage - 1);
    private void NextPage() => CurrentPage = Math.Min(TotalPages, CurrentPage + 1);

    private async Task OnRowKeyDownAsync(KeyboardEventArgs args, DriveListItem item)
    {
        if (args.Key is "Enter" or " ") await OnRowDoubleClickHandler(item);
    }

    private async Task OnRowDoubleClickHandler(DriveListItem item)
    {
        try
        {
            Console.WriteLine($"Item ID: {item.Id}, Name: {item.Name}, WebUrl: {item.WebUrl}, Size: {item.Size}");
            await OnItemDoubleClick.InvokeAsync(item);
            IsWindowOpen = false;
            await CloseWindow.InvokeAsync(IsWindowOpen);
        }
        catch (Exception ex)
        {
            await ReportErrorAsync(ex, "An error occurred while handling double-click on a row.", "SharePointBrowser/OnRowDoubleClickHandler()");
        }
    }

    private async Task ReportErrorAsync(Exception ex, string additionalInfo, string pageMethod)
    {
        ex.Data["MessageType"] = MessageDisplay.ShowMessageType.Error;
        ex.Data["AdditionalInfo"] = additionalInfo;
        ex.Data["PageMethod"] = pageMethod;
        await OnError.InvokeAsync(ex);
    }

    private static string FormatDate(Timestamp? value) => value is null
        ? string.Empty
        : UiFormattingHelper.FormatDateForUI(UiFormattingHelper.NormalizeToLocal(value), false);
    private static string FormatSize(long size) => $"{size / (1024.0 * 1024.0):F2} MB";

    private enum SortColumn { Name, Created, Modified, Size }
}

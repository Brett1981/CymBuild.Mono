@using Concursus.Components.Shared.Modals
@using Concursus.Components.Shared.Services
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject IToastService ToastService
@implements IDisposable

<div class="page">
    <div class="sidebar shadow">
        <NavMenu />
    </div>

    @* floating diagnostics *@
    @if (IsDebug)
    {
        <TaskList />
        <FloatingDiagnostics />
    }
    else if (showDiagnostics)
    {
        <FloatingDiagnostics />
    }

    <main>
        <UniversalSearch />
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@if (_toastNotifications.Count > 0)
{
    <div class="global-toast-container" role="status" aria-live="polite" aria-atomic="false">
        @foreach (var toast in _toastNotifications)
        {
            <div class="toast-wrapper @GetToastCssClass(toast.Kind)" @key="toast.Id">
                <div class="toast-header-row">
                    <div class="toast-title">@toast.Title</div>
                    <button type="button"
                            class="toast-dismiss"
                            title="Dismiss notification"
                            aria-label="Dismiss notification"
                            @onclick="() => DismissToast(toast.Id)">
                        ×
                    </button>
                </div>
                <div class="toast-message">@toast.Message</div>
                <div class="toast-time">@GetToastAgeText(toast.CreatedOn)</div>
            </div>
        }
    </div>
}

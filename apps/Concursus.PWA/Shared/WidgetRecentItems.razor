@using Concursus.API.Client.Classes
@using Concursus.API.Client.Models
@using Concursus.API.Core
@using Newtonsoft.Json
@using System.Web

@inject Core.CoreClient CoreClient
@inject UserService UserService
@inject NavigationManager Navigation

<div class="cb-v2-table-wrap">
    <table class="cb-v2-table cb-v2-dashboard-grid">
        <thead>
            <tr>
                <th>Type</th>
                <th>Record</th>
            </tr>
        </thead>
        <tbody>
            @if (_recentItems?.RecentItems == null || _recentItems.RecentItems.Count == 0)
            {
                <tr>
                    <td colspan="2">
                        <div class="cb-v2-muted">No recent items found.</div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in _recentItems.RecentItems)
                {
                    <tr class="cb-v2-clickable-row"
                        @ondblclick="() => OpenRecentItem(item)">
                        <td>@item.EntityTypeLabel</td>
                        <td>
                            <div class="cb-v2-ellipsis" title="@item.Label">@item.Label</div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public DataObjectReference ParentDataObjectReference { get; set; } = new("", "");

    private RecentItemResponse? _recentItems;

    protected override async Task OnInitializedAsync()
    {
        var userId = UserService?.UserId ?? -1;

        if (userId <= 0)
        {
            return;
        }

        _recentItems = await CoreClient.RecentItemsGetAsync(new RecentItemRequest
        {
            UserId = userId
        });
    }

    private void OpenRecentItem(RecentItem item)
    {
        if (item == null || string.IsNullOrWhiteSpace(item.DetailPageUri))
        {
            return;
        }

        var serializedParentReference = HttpUtility.UrlEncode(JsonConvert.SerializeObject(
            ParentDataObjectReference ?? new DataObjectReference("", "")));

        if (item.DetailPageUri == "DynamicEdit")
        {
            Navigation.NavigateTo(
                $"{item.DetailPageUri}/{ClientFunctions.ParseAndReturnEmptyGuidIfInvalid(item.EntityTypeGuid)}/{Guid.Empty}/{serializedParentReference}/{HttpUtility.UrlEncode(Navigation.Uri)}");
        }
        else
        {
            Navigation.NavigateTo(
                $"{item.DetailPageUri}/{ClientFunctions.ParseAndReturnEmptyGuidIfInvalid(item.RecordGuid)}/{serializedParentReference}/{HttpUtility.UrlEncode(Navigation.Uri)}");
        }
    }
}
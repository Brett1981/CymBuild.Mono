        color: #334155;
    }

    .invoice-preview-toolbar__actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .invoice-preview-counter {
        font-weight: 500;
        margin-left: 6px;
    }

    .invoice-preview-host {
        flex: 1 1 auto;
        overflow: auto;
        background: #eef1f4;

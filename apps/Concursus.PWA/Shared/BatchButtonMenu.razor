        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border-bottom: 1px solid #d9dde3;
        background: #ffffff;
        flex: 0 0 auto;
    }

    .invoice-preview-toolbar__status {
        text-align: center;
        font-size: 0.95rem;

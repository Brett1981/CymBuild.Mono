@using Concursus.API.Client.Classes
@using Concursus.API.Core
@using Concursus.Components.Shared.Modals
@using Concursus.PWA.Helpers
@inject Core.CoreClient CoreClient
@inject CymBuildModalService ModalService
@implements IAsyncDisposable

<div class="cb-v2-table-wrap">
    <table class="cb-v2-table cb-v2-dashboard-grid">
        <thead>
            <tr>
                <th>Start</th>
                <th>Title</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (_isLoading)
            {
                <tr>
                    <td colspan="3">
                        <div class="cb-v2-muted">Loading scheduled items...</div>
                    </td>
                </tr>
            }
            else if (!string.IsNullOrWhiteSpace(_loadError))
            {
                <tr>
                    <td colspan="3">
                        <div class="cb-v2-badge cb-v2-badge-danger">@_loadError</div>
                    </td>
                </tr>
            }
            else if (_scheduleItems?.ScheduleItems == null || _scheduleItems.ScheduleItems.Count == 0)
            {
                <tr>
                    <td colspan="3">
                        <div class="cb-v2-muted">No scheduled items found.</div>
                    </td>
                </tr>
            }
            else
            {
                @foreach (var item in _scheduleItems.ScheduleItems)
                {
                    <tr>
                        <td>@UiFormattingHelper.FormatDateForUI(item.Start.ToDateTime(), false)</td>
                        <td>
                            <div class="cb-v2-ellipsis" title="@item.Title">@item.Title</div>
                        </td>
                        <td class="text-end">
                            <button type="button"
                                    class="cb-v2-btn-secondary"
                                    @onclick="() => OpenScheduleInfoAsync(item)">
                                View
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@code {
    private readonly CancellationTokenSource _cancellationTokenSource = new();

    private ScheduleItemsGetResponse? _scheduleItems;
    private bool _hasStartedLoad;
    private bool _isLoading = true;
    private string? _loadError;

    protected override Task OnInitializedAsync()
    {
        return Task.CompletedTask;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hasStartedLoad)
        {
            return Task.CompletedTask;
        }

        _hasStartedLoad = true;
        _ = LoadAsync(_cancellationTokenSource.Token);

        return Task.CompletedTask;
    }

    private async Task LoadAsync(CancellationToken cancellationToken)
    {
        try
        {
            _isLoading = true;
            _loadError = null;
            await InvokeAsync(StateHasChanged);

            var request = new ScheduleItemsGetRequest
            {
                CurrentUserOnly = true
            };

            var response = await CoreClient.ScheduleItemsGetAsync(
                request,
                cancellationToken: cancellationToken);

            if (cancellationToken.IsCancellationRequested)
            {
                return;
            }

            var earlyDate = DateTime.UtcNow.AddDays(-7);
            var lateDate = DateTime.UtcNow.AddDays(7);

            _scheduleItems = new ScheduleItemsGetResponse();

            if (response?.ScheduleItems is null)
            {
                return;
            }

            foreach (var item in response.ScheduleItems)
            {
                var start = item.Start.ToDateTime();

                if (start.IsBetweenTwoDates(earlyDate, lateDate))
                {
                    _scheduleItems.ScheduleItems.Add(item);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load scheduled items: {ex.Message}";
        }
        finally
        {
            if (!cancellationToken.IsCancellationRequested)
            {
                _isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OpenScheduleInfoAsync(ScheduleItem item)
    {
        var parameters = new Dictionary<string, object?>
        {
            { nameof(ScheduleItemView.StartDateTime), UiFormattingHelper.FormatDateForUI(item.Start.ToDateTime(), false) },
            { nameof(ScheduleItemView.EndDateTime), UiFormattingHelper.FormatDateForUI(item.End.ToDateTime(), false) },
            { nameof(ScheduleItemView.Title), item.Title ?? string.Empty },
            { nameof(ScheduleItemView.Description), item.Description ?? string.Empty },
            { nameof(ScheduleItemView.JobNumber), item.JobNumber ?? string.Empty }
        };

        await ModalService.ShowAsync<ScheduleItemView>("Schedule Info", parameters);
    }

    public async ValueTask DisposeAsync()
    {
        if (!_cancellationTokenSource.IsCancellationRequested)
        {
            await _cancellationTokenSource.CancelAsync();
        }

        _cancellationTokenSource.Dispose();
    }
}
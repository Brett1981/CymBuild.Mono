@using System.Dynamic
@using Concursus.API.Client.Models
@using Concursus.Components.Shared.Services
@using Concursus.PWA.Helpers
@inject ModalService modalService
@inject Core.CoreClient coreClient
@inject IJSRuntime JsRuntime
@inject NavigationManager NavManager
@inject UserInteractionTrackerService InteractionTracker

@attribute [Authorize]

<MessageDisplay @ref="_messageDisplay" ErrorMessage="@ErrorMessage" PageMethod="@PageMethod" MessageType="MessageType" />

<ErrorBoundary>
    <ChildContent>
        @if (ViewDefinition is not null)
        {
            <div class="cb-tree-grid-shell @(FullGrid ? "cb-tree-grid-full" : "cb-tree-grid-modal")">
                <div class="cb-tree-grid-header">
                    <div>
                        <h5 class="cb-tree-grid-title view-name">@ViewDefinition.Name</h5>
                        <div class="cb-v2-muted">@FilteredRows.Count row(s)</div>
                    </div>

                    <div class="cb-v2-actions">
                        <button type="button"
                                class="cb-v2-btn-secondary"
                                @onclick="ExportToExcelAsync"
                                disabled="@isLoading">
                            <i class="bi bi-file-earmark-excel"></i> Export Excel
                        </button>

                        <button type="button"
                                class="cb-v2-btn-secondary"
                                @onclick="RefreshMe">
                            Refresh
                        </button>
                    </div>
                </div>

                <div class="cb-tree-grid-scroll" @ref="_scrollContainer">
                    <table class="cb-v2-table cb-tree-grid-table">
                        <thead>
                            <tr>
                                @foreach (var column in VisibleColumns)
                                {
                                    <th>@column.Title</th>
                                }
                            </tr>
                            <tr>
                                @foreach (var column in VisibleColumns)
                                {
                                    <th>
                                        <input class="cb-tree-grid-filter"
                                               value="@GetFilterValue(column.Name)"
                                               @oninput="e => SetFilterValue(column.Name, e.Value?.ToString())"
                                               placeholder="Filter..." />
                                    </th>
                                }
                            </tr>
                        </thead>

                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="@VisibleColumns.Count">
                                        <div class="cb-v2-muted">Loading...</div>
                                    </td>
                                </tr>
                            }
                            else if (!FilteredRows.Any())
                            {
                                <tr>
                                    <td colspan="@VisibleColumns.Count">
                                        <div class="cb-v2-muted">No records found.</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var row in VisibleTreeRows)
                                {
                                    var rowId = GetRowId(row);
                                    var level = GetLevel(row);
                                    var isGroup = IsGroupRow(row);
                                    var hasChildren = HasChildren(rowId);
                                    var css = GetRowCss(row);

                                    @if (IsGroupRow(row))
                                    {
                                        <tr class="@css">
                                            <td colspan="@VisibleColumns.Count">
                                                <div class="cb-tree-grid-group-row"
                                                     style="padding-left:@(level * 22)px">
                                                    <button type="button"
                                                            class="cb-tree-grid-toggle"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="() => ToggleExpanded(rowId)">
                                                        <i class="bi @(IsExpanded(rowId) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                                                    </button>

                                                    <span>@GetGroupDisplayText(row)</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr class="@css"
                                            @ondblclick="() => OnRowDoubleClickHandler(row)">
                                            @foreach (var column in VisibleColumns)
                                            {
                                                <td>
                                                    <div class="cb-v2-ellipsis" title="@GetValue(row, column.Name)">
                                                        @GetValue(row, column.Name)
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (FullGrid)
                {
                    <div class="back-to-top-button">
                        <button type="button" class="cb-v2-btn-secondary" @onclick="ScrollToTopAsync">
                            <i class="bi bi-arrow-up-circle"></i> Back To Top
                        </button>
                    </div>
                }
            </div>

            @if (ViewDefinition.IsDetailWindowed && WindowIsVisible && _detailPageType is not null)
            {
                <div class="cb-modal-backdrop"></div>
                <div class="cb-modal-shell" role="dialog" aria-modal="true">
                    <div class="cb-modal-card cb-tree-detail-modal">
                        <div class="cb-modal-header">
                            <h5>@WindowTitle</h5>
                            <button type="button"
                                    class="cb-modal-close"
                                    @onclick="CloseWindow">
                                ×
                            </button>
                        </div>

                        <div class="cb-modal-body">
                            <DynamicComponent Type="@_detailPageType"
                                              Parameters="@_detailPageParameters" />
                        </div>
                    </div>
                </div>
            }
        }
    </ChildContent>

    <ErrorContent Context="ex">
        <ErrorDisplay ErrorMessage="@ex.Message" />
    </ErrorContent>
</ErrorBoundary>
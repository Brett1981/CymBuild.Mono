@using _AvailabilityEvent = Concursus.PWA.Shared.Scheduler.Classes.AvailabilityEvent
@using Concursus.PWA.Helpers;

@if (ModalShowing && appointment != null)
{
    <div class="cb-availability-modal-backdrop" role="presentation">
        <div class="cb-availability-modal" role="dialog" aria-modal="true" aria-labelledby="cb-availability-modal-title">
            <div class="cb-availability-modal__header">
                <h5 id="cb-availability-modal-title">@Title</h5>
                <button type="button" class="btn-close" aria-label="Close" @onclick="CloseModal"></button>
            </div>
            <div class="cb-availability-modal__body">
                <EditForm Model="@appointment">
                    <div class="d-flex flex-column gap-3">
                        @if (appointment.CssClass == "scheduled-work")
                        {
                            <label class="width100">
                                Job Number:<br />
                                <input class="form-control" @bind="appointment.JobNumber" />
                            </label>

                            <label class="width100">
                                Activity Note(s):<br />
                                <input class="form-control" value="@appointment.Note" disabled />
                            </label>
                        }
                        else
                        {
                            <label class="width100">
                                Absence Type:<br />
                                <input class="form-control" value="@appointment.Title" disabled />
                            </label>
                        }

                        <label class="width100">
                            Start:<br />
                            <input class="form-control" type="datetime-local" value="@dateTimeUTCStart.ToString("yyyy-MM-ddTHH:mm")" disabled />
                        </label>

                        <label class="width100">
                            End:<br />
                            <input class="form-control" type="datetime-local" value="@dateTimeUTCEnd.ToString("yyyy-MM-ddTHH:mm")" disabled />
                        </label>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public _AvailabilityEvent appointment { get; set; }
    [Parameter] public EventCallback CloseModalCllback { get; set; }

    [Parameter] public bool ModalShowing { get; set; } = false;

    private string Title { get; set; }
    private string StartTime { get; set; }
    private string EndTime { get; set; }
    private DateTime dateTimeUTCStart { get; set; }
    private DateTime dateTimeUTCEnd { get; set; }

    public async Task CloseModal()
    {
        ModalShowing = false;
        await CloseModalCllback.InvokeAsync();
    }

    public void ShowModal()
    {
        ModalShowing = true;
    }

    protected override void OnParametersSet()
    {
        if (appointment != null)
        {
            Title = appointment.CssClass == "scheduled-work"
                ? $"Appointment - {UiFormattingHelper.FormatDateForUI(appointment.Start, false)}"
                : $"Absence - {UiFormattingHelper.FormatDateForUI(appointment.Start, false)}";

            dateTimeUTCStart = appointment.Start.ToLocalTime();
            dateTimeUTCEnd = appointment.End.ToLocalTime();
        }

        base.OnParametersSet();
    }
}

@using Concursus.API.Client.Models
@using Concursus.Components.Shared.Services
@using Concursus.PWA.Services
@using static Concursus.PWA.Shared.MessageDisplay
@inject UserInteractionTrackerService InteractionTracker
@inject IToastService Toast

<button type="button"
        class="btn btn-primary py-2 mx-1 cb-grid-bulk-update-button"
        disabled="@Disabled"
        @onclick="OpenBatchEditModalAsync">
    <i class="bi bi-stack me-2" aria-hidden="true"></i>
    Bulk Update
</button>

<MessageDisplay @ref="_messageDisplay"
                ErrorMessage="@ErrorMessage"
                PageMethod="@PageMethod"
                MessageType="MessageType" />

@code {
    [Inject] public NavigationManager NavManager { get; set; } = default!;

    [Parameter] public EventCallback OnOpenBatchGrid { get; set; }
    [Parameter] public GridViewDefinition? ViewDefinition { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private MessageDisplay? _messageDisplay;
    private MessageDisplay.ShowMessageType MessageType { get; set; } = MessageDisplay.ShowMessageType.Error;
    private string ErrorMessage { get; set; } = string.Empty;
    private string PageMethod { get; set; } = "GridButtonMenu";

    private async Task OpenBatchEditModalAsync()
    {
        try
        {
            if (Disabled)
                return;

            if (!OnOpenBatchGrid.HasDelegate)
            {
                Toast.ShowWarning("Bulk update is not available for this grid.");
                return;
            }

            InteractionTracker.Log(
                NavManager.Uri ?? "GridButtonMenu.OpenBatchEditModalAsync",
                $"User opened bulk update for grid view '{ViewDefinition?.Name ?? ViewDefinition?.Code ?? "Unknown"}'.");

            await OnOpenBatchGrid.InvokeAsync().ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            ex.Data["MessageType"] = MessageDisplay.ShowMessageType.Error;
            ex.Data["PageMethod"] = "GridButtonMenu/OpenBatchEditModalAsync()";
            await OnError(ex).ConfigureAwait(false);
        }
    }

    public async Task OnError(Exception error)
    {
        if (string.IsNullOrWhiteSpace(error.Message))
            return;

        ErrorMessage = error.Message;
        PageMethod = error.Data.Contains("PageMethod")
            ? error.Data["PageMethod"]?.ToString() ?? "Not Set"
            : "Not Set";

        MessageType = error.Data.Contains("MessageType")
            ? (ShowMessageType)(error.Data["MessageType"] ?? ShowMessageType.Information)
            : ShowMessageType.Error;

        _messageDisplay?.UpdateExceptionData(
            error.Data.Count > 0
                ? error.Data.Cast<System.Collections.DictionaryEntry>()
                    .ToDictionary(de => de.Key?.ToString() ?? "UnknownKey", de => de.Value!)
                : null);

        _messageDisplay?.UpdateStackTrace(error.StackTrace ?? "No additional details available.");
        _messageDisplay?.ShowError(true);

        Toast.ShowError(error.Message);
        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }
}

    private async Task RunBusyAsync(string busyMessage, Func<Task> action, bool preserveMessage = false)
    {
        Error = string.Empty;
        if (!preserveMessage)
        {
            Message = string.Empty;
        }

        IsBusy = true;
        BusyMessage = busyMessage;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
            BusyMessage = string.Empty;
        }
    }


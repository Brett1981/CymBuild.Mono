    private string BuildDeploymentPlanSqlScript()
    {
        var runGuid = HasRunGuid ? CurrentRunGuid().ToString().ToUpperInvariant() : "00000000-0000-0000-0000-000000000000";
        var targetServer = string.IsNullOrWhiteSpace(TargetServerNameDisplay) ? "current SQL Server" : TargetServerNameDisplay;

        return $@"/*
    CYB-361 Schema Deployment Plan
    Target server   : {targetServer}
    Target database : {TargetDatabaseName}
    Run Guid        : {runGuid}

    This script returns the persistent source-controlled deployment plan for the run.
    It does not execute DDL. Run tools/SchemaDeployment/Invoke-CymBuildSchemaDeployment.ps1
    from a controlled deployment account to apply the accepted source-controlled plan.
*/

USE {SqlQuoteIdentifier(TargetDatabaseName)};
GO

DECLARE @RunGuid UNIQUEIDENTIFIER = '{runGuid}';

SELECT
    sr.Guid,
    sr.RunStatus,
    sr.IsReviewed AS IsAcceptedForDeployment,
    sr.ReviewedOnUtc,
    sr.ReleaseReference,
    sr.DeploymentReference
FROM [SMigration].[Schema_Run] AS sr
WHERE sr.Guid = @RunGuid
  AND sr.RowStatus <> 0
  AND sr.RowStatus <> 254;

EXEC [SMigration].[SchemaDeploymentPlan_Get]
    @RunGuid = @RunGuid;
GO";
    }

    private string BuildDeploymentPowerShellScript(bool apply)
    {
        var runGuid = HasRunGuid
            ? CurrentRunGuid().ToString().ToUpperInvariant()
            : "00000000-0000-0000-0000-000000000000";
        var targetServer = string.IsNullOrWhiteSpace(TargetServerName)
            ? "<TARGET-SERVER>"
            : TargetServerName.Trim();
        var targetDatabase = string.IsNullOrWhiteSpace(TargetDatabaseName)
            ? "<TARGET-DATABASE>"
            : TargetDatabaseName.Trim();
        var releaseReference = EffectiveRunnerReleaseReference;

        var lines = new List<string>
        {
            @".\tools\SchemaDeployment\Invoke-CymBuildSchemaDeployment.ps1 `",
            $"    -TargetServer {PowerShellQuote(targetServer)} `",
            $"    -TargetDatabase {PowerShellQuote(targetDatabase)} `",
            $"    -RunGuid {PowerShellQuote(runGuid)} `"
        };

        if (!string.IsNullOrWhiteSpace(releaseReference))
        {
            lines.Add($"    -ReleaseReference {PowerShellQuote(releaseReference)} `");
        }

        lines.Add(apply ? "    -Apply" : "    -WhatIf");

        var isFailedDeploymentRetry = (Dashboard?.Run.RunStatus ?? string.Empty)
            .StartsWith("DeploymentFailed", StringComparison.OrdinalIgnoreCase);
        if (isFailedDeploymentRetry)
        {
            lines[^1] += " `";
            lines.Add("    -RetryFailedDeployment");
        }

        return string.Join(Environment.NewLine, lines);
    }

    private static string PowerShellQuote(string value) =>
        "'" + (value ?? string.Empty).Replace("'", "''", StringComparison.Ordinal) + "'";

    private static string SqlQuoteIdentifier(string value)
    {
        var safeValue = string.IsNullOrWhiteSpace(value) ? "CymBuild_Dev" : value.Trim();
        return "[" + safeValue.Replace("]", "]]") + "]";
    }


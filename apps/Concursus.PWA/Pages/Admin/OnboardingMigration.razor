        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, ClearAuditFilters));
        builder.AddContent(seq++, "Clear Filters");
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();

        if (AuditDashboard is null || FilteredExecutionLog.Count == 0)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "cb-v2-empty-state compact");
            builder.AddContent(seq++, "No execution log entries recorded.");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "cb-v2-table-wrap onboarding-section-block");
            builder.OpenElement(seq++, "table");
            builder.AddAttribute(seq++, "class", "cb-v2-table");
            builder.OpenElement(seq++, "thead");
            builder.OpenElement(seq++, "tr");
            builder.OpenElement(seq++, "th"); builder.AddContent(seq++, "Step"); builder.CloseElement();
            builder.OpenElement(seq++, "th"); builder.AddContent(seq++, "Entity"); builder.CloseElement();
            builder.OpenElement(seq++, "th"); builder.AddContent(seq++, "Action"); builder.CloseElement();
            builder.OpenElement(seq++, "th"); builder.AddContent(seq++, "Affected"); builder.CloseElement();
            builder.OpenElement(seq++, "th"); builder.AddContent(seq++, "Details"); builder.CloseElement();
            builder.OpenElement(seq++, "th"); builder.AddContent(seq++, "UTC"); builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
            builder.OpenElement(seq++, "tbody");
            foreach (var item in FilteredExecutionLog)
            {
                builder.OpenElement(seq++, "tr");
                builder.AddAttribute(seq++, "class", RowAccentForAction(item.ActionName));
                builder.OpenElement(seq++, "td"); builder.AddContent(seq++, item.StepName); builder.CloseElement();
                builder.OpenElement(seq++, "td"); builder.AddContent(seq++, item.EntityName); builder.CloseElement();
                builder.OpenElement(seq++, "td"); builder.AddContent(seq++, item.ActionName); builder.CloseElement();
                builder.OpenElement(seq++, "td"); builder.AddContent(seq++, item.AffectedCount); builder.CloseElement();
                builder.OpenElement(seq++, "td"); builder.AddContent(seq++, item.Details); builder.CloseElement();
                builder.OpenElement(seq++, "td"); builder.AddContent(seq++, item.LoggedUtcText); builder.CloseElement();
                builder.CloseElement();
            }
            builder.CloseElement();
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
        builder.CloseElement();
    };


            StageSelections = await FormHelper.OnboardingMigrationStageSelectionListAsync(runGuid, TargetServerName, TargetDatabaseName);
            DiffRows = await FormHelper.OnboardingMigrationDiffAsync(runGuid, SelectedDiffEntity, TargetServerName, TargetDatabaseName);
            SelectedDiffRow = DiffRows.FirstOrDefault();
        }, clearMessage: false, busyMessage: "Loading entity comparison rows...");
    }

    private async Task ExecuteAsync(Func<Task> action, bool clearMessage = true, string busyMessage = "Working...")
    {
        if (IsBusy)
            return;

        IsBusy = true;
        BusyMessage = busyMessage;
        Error = string.Empty;

        if (clearMessage)
            Message = string.Empty;

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
            BusyMessage = "Working...";
            StateHasChanged();
        }
    }


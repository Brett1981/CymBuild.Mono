            var runGuid = GetRequiredRunGuid();
            StageSelections = await FormHelper.OnboardingMigrationStageSelectionSaveAsync(runGuid, StageSelections, TargetServerName, TargetDatabaseName);
            Message = StageSelections.Count == 0
                ? "Row selection cleared. Apply will use all staged rows."
                : $"Saved {StageSelections.Count} row selection(s). Apply will use selected rows only.";

    private RenderFragment AuditFilterCard(
        string title,
        int value,
        string css,
        string actionFilter,
        string entityFilter) => builder =>
    {
        var isActive =
            string.Equals(SelectedAuditAction, actionFilter ?? string.Empty, StringComparison.OrdinalIgnoreCase)
            && string.Equals(SelectedAuditEntity, entityFilter ?? string.Empty, StringComparison.OrdinalIgnoreCase);

        var seq = 0;

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "type", "button");
        builder.AddAttribute(seq++, "class", $"cb-v2-summary-card {css} {(isActive ? "active" : string.Empty)}");
        builder.AddAttribute(seq++, "onclick",
            EventCallback.Factory.Create(this, () => ApplyAuditCardFilter(actionFilter, entityFilter)));

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cb-v2-summary-title");
        builder.AddContent(seq++, title);
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cb-v2-summary-value");
        builder.AddContent(seq++, value);
        builder.CloseElement();

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "cb-v2-summary-subtitle");
        builder.AddContent(seq++, string.IsNullOrWhiteSpace(actionFilter) ? "Clear filter" : $"Filter: {actionFilter}");
        builder.CloseElement();

        builder.CloseElement();
    };

    private RenderFragment DiffBadge(string diffType) => builder =>
    {
        var css = diffType switch
        {
            "MissingInTarget" => "cb-v2-badge cb-v2-badge-danger",
            "Different" => "cb-v2-badge cb-v2-badge-warning",
            "Same" => "cb-v2-badge cb-v2-badge-success",
            _ => "cb-v2-badge cb-v2-badge-muted"
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, diffType);
        builder.CloseElement();
    };

    private RenderFragment SeverityBadge(string severity) => builder =>
    {
        var css = severity switch
        {
            "Error" => "cb-v2-badge cb-v2-badge-danger",
            "Warning" => "cb-v2-badge cb-v2-badge-warning",
            _ => "cb-v2-badge cb-v2-badge-info"
        };

        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", css);
        builder.AddContent(2, severity);
        builder.CloseElement();
    };


    private void SelectDiffRow(OnboardingMigrationDiffRowModel row) => SelectedDiffRow = row;

    private static string BuildStageSelectionKey(string entityName, Guid rowGuid) =>
        $"{entityName.Trim().ToUpperInvariant()}|{rowGuid:D}";

    private bool IsDiffRowSelected(OnboardingMigrationDiffRowModel row) =>
        row is not null
        && row.RowGuid != Guid.Empty
        && StageSelections.Any(selection => string.Equals(selection.EntityName, row.EntityName, StringComparison.OrdinalIgnoreCase)
            && selection.RowGuid == row.RowGuid);

    private void ToggleDiffRowSelection(OnboardingMigrationDiffRowModel row, ChangeEventArgs args)
    {
        if (row is null || row.RowGuid == Guid.Empty)
            return;

        var isSelected = args.Value is bool boolValue
            ? boolValue
            : bool.TryParse(Convert.ToString(args.Value), out var parsed) && parsed;

        var key = BuildStageSelectionKey(row.EntityName, row.RowGuid);
        StageSelections = StageSelections
            .Where(selection => BuildStageSelectionKey(selection.EntityName, selection.RowGuid) != key)
            .ToList();

        if (isSelected)
        {
            StageSelections.Add(new OnboardingMigrationStageSelectionModel
            {
                EntityName = row.EntityName,
                RowGuid = row.RowGuid
            });
        }
    }

    private async Task SelectVisibleDiffRowsAsync()
    {
        await ExecuteAsync(async () =>
        {
            var existing = StageSelections
                .GroupBy(selection => BuildStageSelectionKey(selection.EntityName, selection.RowGuid))
                .ToDictionary(group => group.Key, group => group.First());

            foreach (var row in FilteredDiffRows)
            {
                if (row.RowGuid == Guid.Empty || string.IsNullOrWhiteSpace(row.EntityName))
                    continue;

                existing[BuildStageSelectionKey(row.EntityName, row.RowGuid)] = new OnboardingMigrationStageSelectionModel
                {
                    EntityName = row.EntityName,
                    RowGuid = row.RowGuid
                };
            }

            StageSelections = existing.Values
                .OrderBy(x => x.EntityName)
                .ThenBy(x => x.RowGuid)
                .ToList();

            Message = $"Selected {FilteredDiffRows.Count} visible comparison row(s). Save selection to persist it for apply.";
            await Task.CompletedTask;
        }, clearMessage: false, busyMessage: "Selecting visible OnBoarding rows...");
    }

    private async Task SaveRowSelectionAsync()

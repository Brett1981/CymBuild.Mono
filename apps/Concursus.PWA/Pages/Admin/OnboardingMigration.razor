    private API.Client.FormHelper FormHelper =>
        _formHelper ?? throw new InvalidOperationException("FormHelper has not been initialised.");

    private async Task StageAsync()
    {
        await ExecuteAsync(StageCoreAsync, busyMessage: "Staging OnBoarding source data...");
    }

    private async Task StageCoreAsync()
    {
        if (!Guid.TryParse(BusinessUnitGroupGuidText, out var businessUnitGuid))
            throw new InvalidOperationException("Business Unit Group Guid must be a valid Guid.");

        await EnsureEntityScopeDefaultsForRunCoreAsync();

        var runGuid = Guid.TryParse(RunGuidText, out var parsedRunGuid)
            ? parsedRunGuid
            : (Guid?)null;

        StageResult = await FormHelper.OnboardingMigrationStageAsync(
            SourceDatabase,
            businessUnitGuid,
            runGuid,
            Notes,
            SourceServerName,
            TargetServerName,
            TargetDatabaseName);

        RunGuidText = StageResult.RunGuid.ToString();
        SelectedAuditRunGuidText = RunGuidText;
        Message = $"Stage completed for run {RunGuidText}.";

        await RefreshAllAsync(clearMessage: false);
    }

    private void ClearAuditFilters()
    {
        SelectedAuditAction = string.Empty;
        SelectedAuditEntity = string.Empty;
        SelectedValidationSeverity = string.Empty;
    }

    private async Task ValidateAsync()
    {
        await ExecuteAsync(async () =>
        {
            var runGuid = GetRequiredRunGuid();
            var issues = await FormHelper.OnboardingMigrationValidateAsync(runGuid, TargetServerName, TargetDatabaseName);

            Message = $"Validation completed. Issues found: {issues.Count}.";
            await RefreshAllAsync(clearMessage: false);
        }, busyMessage: "Validating staged OnBoarding data...");
    }

    private async Task PreviewAsync()
    {
        await ExecuteAsync(async () =>
        {
            var runGuid = GetRequiredRunGuid();

            Message = await FormHelper.OnboardingMigrationApplyAsync(
                runGuid,
                AllowWarnings,
                previewOnly: true,
                targetServerName: TargetServerName,
                targetDatabaseName: TargetDatabaseName);

            PreviewOnly = true;
            await RefreshAllAsync(clearMessage: false);
        }, busyMessage: "Running OnBoarding apply preview...");
    }

    private async Task ApplyAsync()
    {
        await ExecuteAsync(async () =>
        {
            var runGuid = GetRequiredRunGuid();

            Message = await FormHelper.OnboardingMigrationApplyAsync(
                runGuid,
                AllowWarnings,
                PreviewOnly,
                TargetServerName,
                TargetDatabaseName);

            await RefreshAllAsync(clearMessage: false);
        }, busyMessage: PreviewOnly ? "Running OnBoarding preview..." : "Applying OnBoarding migration...");
    }

    private async Task LoadLookupsAsync()
    {
        await ExecuteAsync(async () =>
        {
            BusinessUnitGroups = await FormHelper.OnboardingMigrationBusinessUnitGroupsAsync(SourceDatabase, SourceServerName, TargetServerName, TargetDatabaseName);
            AvailableRuns = await FormHelper.OnboardingMigrationRunsAsync(SourceDatabase, SourceServerName, TargetServerName, TargetDatabaseName);

            if (BusinessUnitGroups.Count == 1)
                BusinessUnitGroupGuidText = BusinessUnitGroups[0].Guid.ToString();

            Message = "Lookup data refreshed.";
        }, busyMessage: "Loading OnBoarding lookup data...");
    }

    private async Task RefreshAllAsync(bool clearMessage = true)
    {
        if (!Guid.TryParse(RunGuidText, out var runGuid))
            return;

        await ExecuteAsync(async () =>
        {
            Report = await FormHelper.OnboardingMigrationReportAsync(runGuid, TargetServerName, TargetDatabaseName);
            ApplyReportContextToSetup();
            AuditDashboard = await FormHelper.OnboardingMigrationAuditDashboardAsync(runGuid, TargetServerName, TargetDatabaseName);
            EntitySelections = await FormHelper.OnboardingMigrationRunEntitySelectionListAsync(runGuid, TargetServerName, TargetDatabaseName);
            StageSelections = await FormHelper.OnboardingMigrationStageSelectionListAsync(runGuid, TargetServerName, TargetDatabaseName);
            EnsureSelectedEntityAvailable();
            SelectedAuditRunGuidText = RunGuidText;
            StagedRows = InspectableEntityCodes.Count == 0
                ? new List<OnboardingMigrationStagedRowModel>()
                : await FormHelper.OnboardingMigrationStagedDataAsync(runGuid, SelectedStagedEntity, TargetServerName, TargetDatabaseName);
            DiffRows = InspectableEntityCodes.Count == 0
                ? new List<OnboardingMigrationDiffRowModel>()
                : await FormHelper.OnboardingMigrationDiffAsync(runGuid, SelectedDiffEntity, TargetServerName, TargetDatabaseName);

            SelectedStagedRow = StagedRows.FirstOrDefault();
            SelectedDiffRow = DiffRows.FirstOrDefault();

            if (clearMessage)
                Message = "Migration data refreshed.";
        }, clearMessage, busyMessage: "Refreshing OnBoarding run data...");
    }


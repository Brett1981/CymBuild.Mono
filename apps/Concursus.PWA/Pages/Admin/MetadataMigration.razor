                            <td>
                                <button type="button" class="cb-v2-btn-secondary compact" @onclick="@(() => UnignoreRecordAsync(row))" disabled="@(IsBusy || !row.IsActive)">Unignore</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment RegistrySection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Registry</h2>
                <p>Registry status inferred from staged counts for this UI patch.</p>
            </div>
        </div>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Schema</th><th>Table</th><th>Total Staged</th><th>Validation Errors</th></tr></thead>
                <tbody>
                    @foreach (var row in TableSummaryRows)
                    {
                        <tr>
                            <td>@row.SchemaName</td>
                            <td>@row.TableName</td>
                            <td>@row.TotalCount</td>
                            <td>@row.ValidationErrorCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

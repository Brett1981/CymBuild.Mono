    private RenderFragment ComingSoonSection(string title, string description) => @<section class="metadata-card metadata-empty-panel">
        <span class="bi bi-tools"></span>
        <h2>@title</h2>
        <p>@description</p>
    </section>;

    private RenderFragment DetailTabButton(string tab, string label) => @<button type="button"
        class="metadata-detail-tab @(SelectedDetailTab == tab ? "selected" : string.Empty)"
        @onclick="@(() => SetDetailTab(tab))">
        @label
    </button>;


    private void SetDetailTab(string tab)
    {
        SelectedDetailTab = tab;
    }

    private RenderFragment ComparisonPanel() => @<div class="metadata-comparison-body">
        @if (SelectedDiffRow is null)
        {
            <div class="metadata-empty-state">Select a record to view its source and target values.</div>
        }
        else
        {
            <div class="metadata-comparison-grid">
                <div class="metadata-comparison-table-wrap">
                    <table class="metadata-table metadata-comparison-table">
                        <thead>
                            <tr>
                                <th>Column</th>
                                <th>Source (@SourceEnvironment)</th>
                                <th>Target (@TargetEnvironment)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var column in AllColumnNames(SelectedDiffRow))
                            {
                                var sourceValue = GetSourceValue(SelectedDiffRow, column);
                                var targetValue = GetTargetValue(SelectedDiffRow, column);
                                <tr class="@ComparisonRowClass(sourceValue, targetValue)">
                                    <td><strong>@column</strong></td>
                                    <td>@sourceValue</td>
                                    <td>@targetValue</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <aside class="metadata-record-info-panel">
                    <h3>Record Information</h3>
                    <dl>
                        <dt>Table</dt><dd>@SelectedDiffRow.EntityName</dd>
                        <dt>Difference</dt><dd>@DifferenceBadge(SelectedDiffRow.DifferenceType)</dd>
                        <dt>Source Guid</dt><dd>@SelectedDiffRow.SourceRowGuid</dd>
                        <dt>Changed Columns</dt><dd>@SelectedDiffRow.DifferingColumns.Count</dd>
                        <dt>Run</dt><dd>@RunGuidText</dd>
                    </dl>
                    <h3>Ignore Status</h3>
                    <dl>
                        <dt>Selected for apply</dt><dd>@(SelectedDiffRow.IsSelected ? "Yes" : "No")</dd>
                        <dt>Ignored</dt><dd>@(SelectedDiffRow.IsIgnored ? "Yes" : "No")</dd>
                        <dt>Reason</dt><dd>@(string.IsNullOrWhiteSpace(SelectedDiffRow.IgnoreReason) ? "-" : SelectedDiffRow.IgnoreReason)</dd>
                        <dt>Ignored On</dt><dd>@(string.IsNullOrWhiteSpace(SelectedDiffRow.IgnoredOnUtcText) ? "-" : SelectedDiffRow.IgnoredOnUtcText)</dd>
                    </dl>
                </aside>
            </div>
        }
    </div>;

    private RenderFragment JsonPanel() => @<div class="metadata-json-grid">
        @JsonViewer("Source JSON", SelectedDiffRow?.SourceValues, true)
        @JsonViewer("Target JSON", SelectedDiffRow?.TargetValues, false)
    </div>;

    private RenderFragment JsonViewer(string title, Dictionary<string, string>? values, bool isSource) => @<div class="metadata-json-panel">
        <h3>@title</h3>
        @if (SelectedDiffRow is null || values is null || values.Count == 0)
        {
            <pre>{}</pre>
        }
        else
        {
            <div class="metadata-json-lines" role="table" aria-label="@title">
                @foreach (var line in PrettyJsonLines(values))
                {
                    <div class="@JsonLineClass(line, SelectedDiffRow, isSource)" role="row">
                        <span class="metadata-json-line-number" role="cell">@line.LineNumber</span>
                        <code role="cell">@line.Text</code>
                    </div>
                }
            </div>
        }
    </div>;

    private RenderFragment SqlPreviewPanel() => @<div class="metadata-json-panel">
        <h3>SQL View</h3>
        <p>The backend apply remains procedure-driven. This view shows the selected-only apply context for the active record.</p>
        <pre>@SqlPreviewText()</pre>
    </div>;

    private RenderFragment Badge(string text) => @<span class="metadata-badge @BadgeClass(text)">@text</span>;

    private RenderFragment DifferenceBadge(string differenceType) => @<span class="metadata-badge @DifferenceBadgeClass(differenceType)">@DisplayDifference(differenceType)</span>;

    private async Task SelectSectionAsync(string section)
    {
        SelectedSection = section;

        if ((section == "audit" || section == "identity" || section == "registry" || section == "overview") && HasRunGuid)
        {
            await RefreshDashboardAsync(false);
        }
        else if (section == "ignored" && HasRunGuid)
        {
            await LoadIgnoredRecordsAsync();
        }
    }

    private async Task RefreshCurrentViewAsync()
    {
        if (!HasRunGuid)
        {
            await LoadRunsAsync();
            return;
        }

        await RefreshDashboardAsync();

        if (SelectedSection == "stage" && !string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            await LoadRecordsAsync();
        }
    }

    private async Task SelectRunAsync(MetadataMigrationRunModel run)
    {
        RunGuidText = run.RunGuid.ToString();
        SourceEnvironment = run.SourceEnvironment;
        TargetEnvironment = run.TargetEnvironment;
        SourceServerName = run.SourceServerName;
        SourceDatabaseName = run.SourceDatabaseName;
        TargetServerName = run.TargetServerName;
        TargetDatabaseName = run.TargetDatabaseName;
        SelectedRecordKeys.Clear();
        DiffRows.Clear();
        SelectedDiffRow = null;
        await RefreshDashboardAsync();
    }

    private async Task OpenStageWithDifferenceAsync(string differenceType)
    {
        SelectedSection = "stage";
        SelectedDifferenceType = differenceType;
        ShowNoChange = differenceType == DifferenceNoChange || ShowNoChange;
        await RefreshDashboardAsync(false);

        var firstTable = FilteredTableSummaryRows.FirstOrDefault(row => differenceType switch
        {
            DifferenceInsert => row.InsertCount > 0,
            DifferenceUpdate => row.UpdateCount > 0,
            DifferenceNoChange => row.NoChangeCount > 0,
            _ => row.TotalCount > 0
        }) ?? FilteredTableSummaryRows.FirstOrDefault();

        if (firstTable is not null)
        {
            await SelectTableAsync(firstTable);
        }
    }

    private async Task OpenAuditSeverityAsync(string severity)
    {
        SelectedSection = "audit";
        SelectedAuditSeverity = severity;
        ShowMissingTargetsOnly = false;
        await RefreshDashboardAsync(false);
    }

    private async Task OpenMissingTargetsAsync()
    {
        SelectedSection = "identity";
        SelectedAuditSeverity = string.Empty;
        ShowMissingTargetsOnly = true;
        await RefreshDashboardAsync(false);
    }

    private async Task SelectTableAsync(MetadataTableSummaryRow row)
    {
        SelectedTableSummary = row;
        SelectedEntityName = row.EntityName;
        RecordSearchText = string.Empty;

        if (string.IsNullOrWhiteSpace(SelectedDifferenceType))
        {
            SelectedDifferenceType = row.UpdateCount > 0
                ? DifferenceUpdate
                : row.InsertCount > 0
                    ? DifferenceInsert
                    : DifferenceNoChange;
        }

        await LoadRecordsAsync();
    }

    private void SelectRecord(MetadataMigrationDiffRowModel row)
    {
        SelectedDiffRow = row;
        SelectedDetailTab = "comparison";
    }

    private async Task LoadRunsAsync() => await ExecuteAsync(async () =>
    {
        await LoadRunsCoreAsync();
        Message = $"Loaded {AvailableRuns.Count} metadata run(s).";
    });

    private async Task CreateRunAsync() => await ExecuteAsync(async () =>
    {
        var run = await CurrentFormHelper.MetadataMigrationRunCreateAsync(SourceEnvironment, TargetEnvironment, SourceServerName, SourceDatabaseName, TargetServerName, TargetDatabaseName, IsValidateOnly);
        RunGuidText = run.RunGuid.ToString();
        await LoadRunsCoreAsync();
        await RefreshDashboardCoreAsync(false);
        SelectedSection = "stage";
        Message = $"Created metadata run {RunGuidText}.";
    });

    private async Task StageAsync() => await ExecuteAsync(async () =>
    {
        await CurrentFormHelper.MetadataMigrationStageAsync(CurrentRunGuid(), TargetServerName, TargetDatabaseName);
        await RefreshDashboardCoreAsync(false);
        Message = "Metadata staged successfully.";
    }, busyMessage: "Staging metadata for the selected run. This can take a while; please wait and do not refresh the page.");

    private async Task ValidateAsync() => await ExecuteAsync(async () =>
    {
        var issues = await CurrentFormHelper.MetadataMigrationValidateAsync(CurrentRunGuid(), TargetServerName, TargetDatabaseName);
        await RefreshDashboardCoreAsync(false);
        Message = issues.Count == 0 ? "Validation passed with no issues." : $"Validation completed with {issues.Count} issue(s).";
    });

    private async Task BuildIdentityMapAsync() => await ExecuteAsync(async () =>
    {
        var rows = await CurrentFormHelper.MetadataMigrationBuildIdentityMapAsync(CurrentRunGuid(), TargetServerName, TargetDatabaseName);
        await RefreshDashboardCoreAsync(false);
        Message = $"Identity map built for {rows.Count} table group(s).";
    });

    private async Task ApplyAsync() => await ExecuteAsync(async () =>
    {
        Message = await CurrentFormHelper.MetadataMigrationApplyAsync(CurrentRunGuid(), ForceApply, TargetServerName, TargetDatabaseName);
        await RefreshDashboardCoreAsync(false);
        if (SelectedSection == "stage" && !string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            await LoadRecordsCoreAsync(false);
        }
    });

    private async Task ApplySelectedAsync() => await ExecuteAsync(async () =>
    {
        Message = await CurrentFormHelper.MetadataMigrationApplySelectedAsync(CurrentRunGuid(), ForceApply, TargetServerName, TargetDatabaseName);
        await RefreshDashboardCoreAsync(false);
        if (SelectedSection == "stage" && !string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            await LoadRecordsCoreAsync(false);
        }
    });

    private async Task RefreshDashboardAsync(bool clearMessage = true) => await ExecuteAsync(async () =>
    {
        await RefreshDashboardCoreAsync(clearMessage);
    }, clearMessage);

    private async Task LoadRecordsAsync() => await ExecuteAsync(async () =>
    {
        await LoadRecordsCoreAsync();
    });

    private async Task LoadRunsCoreAsync()
    {
        AvailableRuns = await CurrentFormHelper.MetadataMigrationRunsAsync(50, TargetServerName, TargetDatabaseName);
    }

    private async Task RefreshDashboardCoreAsync(bool clearMessage = true)
    {
        Dashboard = await CurrentFormHelper.MetadataMigrationDashboardAsync(CurrentRunGuid(), TargetServerName, TargetDatabaseName);

        if (Dashboard.Run is not null && Dashboard.Run.RunGuid != Guid.Empty)
        {
            if (!string.IsNullOrWhiteSpace(Dashboard.Run.SourceEnvironment))
            {
                SourceEnvironment = Dashboard.Run.SourceEnvironment;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.TargetEnvironment))
            {
                TargetEnvironment = Dashboard.Run.TargetEnvironment;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.SourceServerName))
            {
                SourceServerName = Dashboard.Run.SourceServerName;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.SourceDatabaseName))
            {
                SourceDatabaseName = Dashboard.Run.SourceDatabaseName;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.TargetServerName))
            {
                TargetServerName = Dashboard.Run.TargetServerName;
            }

            if (!string.IsNullOrWhiteSpace(Dashboard.Run.TargetDatabaseName))
            {
                TargetDatabaseName = Dashboard.Run.TargetDatabaseName;
            }
        }

        if (clearMessage)
        {
            Message = "Metadata dashboard refreshed.";
        }

        if (string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            var firstTable = FilteredTableSummaryRows.FirstOrDefault();
            if (firstTable is not null)
            {
                SelectedTableSummary = firstTable;
                SelectedEntityName = firstTable.EntityName;
            }
        }
    }

    private async Task LoadRecordsCoreAsync(bool setMessage = true)
    {
        var (schema, table) = SplitEntityName(SelectedEntityName);
        DiffRows = await CurrentFormHelper.MetadataMigrationDiffAsync(CurrentRunGuid(), schema, table, SelectedDifferenceType, TargetServerName, TargetDatabaseName, ShowIgnored);
        SelectedRecordKeys.Clear();
        foreach (var selectedRow in DiffRows.Where(row => row.IsSelected))
        {
            SelectedRecordKeys.Add(RecordKey(selectedRow));
        }

        SelectedDiffRow = FilteredDiffRows.FirstOrDefault();
        if (setMessage)
        {
            Message = $"Loaded {DiffRows.Count} record(s) for {SelectedEntityName}.";
        }
    }

    private async Task ClearAuditFiltersAsync()
    {
        SelectedAuditSeverity = string.Empty;
        ShowMissingTargetsOnly = false;
        await RefreshDashboardAsync(false);
    }

    private Guid CurrentRunGuid() => Guid.TryParse(RunGuidText, out var runGuid)
        ? runGuid
        : throw new InvalidOperationException("A metadata run must be selected first.");

    private async Task ExecuteAsync(Func<Task> action, bool clearMessage = true, string busyMessage = "")
    {
        if (IsBusy)
        {
            return;
        }

        IsBusy = true;
        BusyMessage = string.IsNullOrWhiteSpace(busyMessage)
            ? "Metadata operation is running. Please wait."
            : busyMessage;

        if (clearMessage)
        {
            Message = string.Empty;
            Error = string.Empty;
        }

        await InvokeAsync(StateHasChanged);

        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            IsBusy = false;
            BusyMessage = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }


    private async Task ToggleShowIgnoredAsync(ChangeEventArgs args)
    {
        ShowIgnored = args.Value is bool value && value;
        if (SelectedSection == "stage" && HasRunGuid && !string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            await LoadRecordsAsync();
        }
    }

    private async Task ToggleIgnoreSelectedRecordAsync()
    {
        if (SelectedDiffRow is null)
        {
            return;
        }

        var row = SelectedDiffRow;
        var shouldIgnore = !row.IsIgnored;

        await ExecuteAsync(async () =>
        {
            var result = await CurrentFormHelper.MetadataMigrationIgnoreUpsertAsync(
                CurrentRunGuid(),
                row.SchemaName,
                row.TableName,
                row.SourceRowGuid,
                shouldIgnore,
                shouldIgnore ? IgnoreReason : string.Empty,
                TargetServerName,
                TargetDatabaseName);

            await RefreshDashboardCoreAsync(false);
            if (SelectedSection == "stage" && !string.IsNullOrWhiteSpace(SelectedEntityName))
            {
                await LoadRecordsCoreAsync(false);
            }

            if (SelectedSection == "ignored")
            {
                await LoadIgnoredRecordsCoreAsync();
            }

            IgnoreReason = string.Empty;
            Message = result.Message;
        });
    }

    private async Task LoadIgnoredRecordsAsync() => await ExecuteAsync(async () =>
    {
        await LoadIgnoredRecordsCoreAsync();
        Message = $"Loaded {IgnoredRecords.Count} ignored record(s).";
    });

    private async Task LoadIgnoredRecordsCoreAsync()
    {
        IgnoredRecords = await CurrentFormHelper.MetadataMigrationIgnoredRecordsAsync(
            CurrentRunGuid(),
            TargetServerName,
            TargetDatabaseName,
            ShowInactiveIgnoredRecords);
    }

    private async Task UnignoreRecordAsync(MetadataMigrationIgnoredRecordModel row)
    {
        await ExecuteAsync(async () =>
        {
            var result = await CurrentFormHelper.MetadataMigrationIgnoreUpsertAsync(
                CurrentRunGuid(),
                row.SchemaName,
                row.TableName,
                row.SourceRowGuid,
                false,
                string.Empty,
                TargetServerName,
                TargetDatabaseName);

            await RefreshDashboardCoreAsync(false);
            await LoadIgnoredRecordsCoreAsync();
            if (SelectedSection == "stage" && !string.IsNullOrWhiteSpace(SelectedEntityName))
            {
                await LoadRecordsCoreAsync(false);
            }

            Message = result.Message;
        });
    }

    private async Task PersistRecordSelectionAsync(MetadataMigrationDiffRowModel row, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool checkedValue && checkedValue;
        if (isChecked && !IsSelectableForApply(row))
        {
            Error = "Only Insert and Update metadata rows can be selected for apply.";
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (await SaveSelectionAsync(new[]
        {
            ToSelectionItem(row, isChecked)
        }))
        {
            row.IsSelected = isChecked;
            SyncSelectionKey(row);
        }
    }

    private async Task SelectVisibleRecordsAsync()
    {
        var rows = FilteredDiffRows.Where(IsSelectableForApply).ToList();
        if (rows.Count == 0)
        {
            Message = "There are no visible Insert or Update rows to select.";
            return;
        }

        if (await SaveSelectionAsync(rows.Select(row => ToSelectionItem(row, true)).ToList()))
        {
            foreach (var row in rows)
            {
                row.IsSelected = true;
                SyncSelectionKey(row);
            }
        }
    }

    private async Task ClearTableSelectionAsync()
    {
        if (string.IsNullOrWhiteSpace(SelectedEntityName))
        {
            return;
        }

        var (schema, table) = SplitEntityName(SelectedEntityName);

        await ExecuteAsync(async () =>
        {
            var result = await CurrentFormHelper.MetadataMigrationSelectionClearAsync(CurrentRunGuid(), schema, table, string.Empty, TargetServerName, TargetDatabaseName);
            foreach (var row in DiffRows)
            {
                row.IsSelected = false;
                SelectedRecordKeys.Remove(RecordKey(row));
            }

            await RefreshDashboardCoreAsync(false);
            Message = result.Message;
        }, false);
    }

    private async Task<bool> SaveSelectionAsync(IReadOnlyCollection<MetadataMigrationSelectionItemModel> items)
    {
        if (items.Count == 0)
        {
            return true;
        }

        var succeeded = false;
        await ExecuteAsync(async () =>
        {
            var result = await CurrentFormHelper.MetadataMigrationSelectionUpsertAsync(CurrentRunGuid(), items, TargetServerName, TargetDatabaseName);
            await RefreshDashboardCoreAsync(false);
            Message = result.Message;
            succeeded = true;
        });

        return succeeded;
    }

    private static bool IsRecordSelected(MetadataMigrationDiffRowModel row) => row.IsSelected;

    private static bool IsSelectableForApply(MetadataMigrationDiffRowModel row) =>
        row.DifferenceType.Equals(DifferenceInsert, StringComparison.OrdinalIgnoreCase)
        || row.DifferenceType.Equals(DifferenceUpdate, StringComparison.OrdinalIgnoreCase);

    private static MetadataMigrationSelectionItemModel ToSelectionItem(MetadataMigrationDiffRowModel row, bool isSelected) => new()
    {
        SchemaName = row.SchemaName,
        TableName = row.TableName,
        SourceRowGuid = row.SourceRowGuid,
        DifferenceType = row.DifferenceType,
        IsSelected = isSelected
    };

    private void SyncSelectionKey(MetadataMigrationDiffRowModel row)
    {
        var key = RecordKey(row);
        if (row.IsSelected)
        {
            SelectedRecordKeys.Add(key);
        }
        else
        {
            SelectedRecordKeys.Remove(key);
        }
    }

    private static string RecordKey(MetadataMigrationDiffRowModel row) => $"{row.SchemaName}.{row.TableName}:{row.SourceRowGuid}";

    private string RecordRowClass(MetadataMigrationDiffRowModel row)
    {
        var classes = new List<string>();
        if (SelectedDiffRow == row)
        {
            classes.Add("selected");
        }

        if (row.IsIgnored)
        {
            classes.Add("metadata-record-ignored");
        }

        return string.Join(" ", classes);
    }

    private static (string Schema, string Table) SplitEntityName(string entityName)
    {
        var parts = (entityName ?? string.Empty).Split('.', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        return parts.Length == 2 ? (parts[0], parts[1]) : (string.Empty, string.Empty);
    }

    private static string FormatRunOption(MetadataMigrationRunModel run) => $"{run.CreatedOnUtcText} - {run.SourceEnvironment} → {run.TargetEnvironment} - {run.RunStatus}";

    private static string DisplayDifference(string differenceType) => differenceType switch
    {
        DifferenceNoChange => "No Change",
        _ => differenceType
    };

    private static string BadgeClass(string text)
    {
        var normalized = text ?? string.Empty;
        if (normalized.Equals("Fail", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Failed", StringComparison.OrdinalIgnoreCase))
        {
            return "danger";
        }

        if (normalized.Equals("Warn", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Warning", StringComparison.OrdinalIgnoreCase))
        {
            return "warning";
        }

        if (normalized.Equals("Applied", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Complete", StringComparison.OrdinalIgnoreCase) || normalized.Equals("Completed", StringComparison.OrdinalIgnoreCase))
        {
            return "success";
        }

        return "info";
    }

    private static string DifferenceBadgeClass(string differenceType) => differenceType switch
    {
        DifferenceInsert => "success",
        DifferenceUpdate => "info",
        DifferenceNoChange => "muted",
        _ => "warning"
    };

    private static string GetValue(MetadataMigrationDiffRowModel row, string key)
    {
        if (row.SourceValues.TryGetValue(key, out var sourceValue) && !string.IsNullOrWhiteSpace(sourceValue))
        {
            return sourceValue;
        }

        return row.TargetValues.TryGetValue(key, out var targetValue) ? targetValue : string.Empty;
    }

    private static string GetSourceValue(MetadataMigrationDiffRowModel row, string key) => row.SourceValues.TryGetValue(key, out var value) ? value : string.Empty;
    private static string GetTargetValue(MetadataMigrationDiffRowModel row, string key) => row.TargetValues.TryGetValue(key, out var value) ? value : string.Empty;

    private static IReadOnlyList<string> AllColumnNames(MetadataMigrationDiffRowModel row) => row.SourceValues.Keys
        .Union(row.TargetValues.Keys, StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();

    private static string ComparisonRowClass(string sourceValue, string targetValue)
    {
        if (StringComparer.Ordinal.Equals(sourceValue ?? string.Empty, targetValue ?? string.Empty))
        {
            return string.Empty;
        }

        if (string.IsNullOrWhiteSpace(targetValue) && !string.IsNullOrWhiteSpace(sourceValue))
        {
            return "metadata-row-added";
        }

        if (string.IsNullOrWhiteSpace(sourceValue) && !string.IsNullOrWhiteSpace(targetValue))
        {
            return "metadata-row-removed";
        }

        return "metadata-row-changed";
    }

    private static string FirstNonEmpty(params string[] values) => values.FirstOrDefault(value => !string.IsNullOrWhiteSpace(value)) ?? string.Empty;

    private static string GetDisplayId(MetadataMigrationDiffRowModel row)
    {
        var id = GetValue(row, "ID");
        return string.IsNullOrWhiteSpace(id) ? "-" : id;
    }

    private static string PrettyJson(Dictionary<string, string>? values)
    {
        if (values is null || values.Count == 0)
        {
            return "{}";
        }

        return System.Text.Json.JsonSerializer.Serialize(values, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }

    private static IReadOnlyList<JsonDisplayLine> PrettyJsonLines(Dictionary<string, string>? values)
    {
        var json = PrettyJson(values);
        var lines = json.Replace("\r\n", "\n").Split('\n');

        return lines
            .Select((text, index) => new JsonDisplayLine(index + 1, text, ExtractJsonPropertyName(text)))
            .ToList();
    }

    private static string ExtractJsonPropertyName(string line)
    {
        if (string.IsNullOrWhiteSpace(line))
        {
            return string.Empty;
        }

        var match = System.Text.RegularExpressions.Regex.Match(line, @"^\s*""(?<key>(?:\\.|[^""\\])*)""\s*:");
        return match.Success
            ? System.Text.RegularExpressions.Regex.Unescape(match.Groups["key"].Value)
            : string.Empty;
    }

    private static string JsonLineClass(JsonDisplayLine line, MetadataMigrationDiffRowModel? row, bool isSource)
    {
        var baseClass = isSource
            ? "metadata-json-line metadata-json-line-source"
            : "metadata-json-line metadata-json-line-target";

        if (row is null || string.IsNullOrWhiteSpace(line.PropertyName) || !IsDifferingJsonProperty(row, line.PropertyName))
        {
            return baseClass;
        }

        var sourceValue = GetSourceValue(row, line.PropertyName);
        var targetValue = GetTargetValue(row, line.PropertyName);

        if (string.IsNullOrWhiteSpace(targetValue) && !string.IsNullOrWhiteSpace(sourceValue))
        {
            return $"{baseClass} metadata-json-line-added";
        }

        if (string.IsNullOrWhiteSpace(sourceValue) && !string.IsNullOrWhiteSpace(targetValue))
        {
            return $"{baseClass} metadata-json-line-removed";
        }

        return $"{baseClass} metadata-json-line-changed";
    }

    private static bool IsDifferingJsonProperty(MetadataMigrationDiffRowModel row, string propertyName)
    {
        if (row.DifferingColumns.Any(column => column.Equals(propertyName, StringComparison.OrdinalIgnoreCase)))
        {
            return true;
        }

        var sourceValue = GetSourceValue(row, propertyName) ?? string.Empty;
        var targetValue = GetTargetValue(row, propertyName) ?? string.Empty;

        return !StringComparer.Ordinal.Equals(sourceValue, targetValue);
    }

    private string SqlPreviewText()
    {
        if (SelectedDiffRow is null)
        {
            return "-- Select a record to view apply context.";
        }

        return $"EXEC SMigration.MetadataApply_Run @RunGuid = '{RunGuidText}', @ForceApply = {(ForceApply ? 1 : 0)}, @ApplySelectedOnly = 1;\n-- Selected record context: {SelectedDiffRow.SchemaName}.{SelectedDiffRow.TableName} / {SelectedDiffRow.SourceRowGuid}";
    }

    private sealed class JsonDisplayLine
    {
        public JsonDisplayLine(int lineNumber, string text, string propertyName)
        {
            LineNumber = lineNumber;
            Text = text;
            PropertyName = propertyName;
        }

        public int LineNumber { get; }
        public string Text { get; }
        public string PropertyName { get; }
    }

    private sealed class MetadataTableSummaryRow
    {
        public string SchemaName { get; set; } = string.Empty;
        public string TableName { get; set; } = string.Empty;
        public string EntityName { get; set; } = string.Empty;
        public int InsertCount { get; set; }
        public int UpdateCount { get; set; }
        public int NoChangeCount { get; set; }
        public int ValidationErrorCount { get; set; }
        public int MissingTargetCount { get; set; }
        public int TotalCount => InsertCount + UpdateCount + NoChangeCount;
    }
}

        <h3>Execution Log</h3>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Step</th><th>Status</th><th>Message</th><th>Created UTC</th></tr></thead>
                <tbody>
                    @foreach (var row in Dashboard?.ExecutionLog ?? Enumerable.Empty<MetadataMigrationExecutionLogItemModel>())
                    {
                        <tr>
                            <td>@row.StepName</td>
                            <td>@Badge(row.StepStatus)</td>
                            <td>@row.Message</td>
                            <td>@row.CreatedOnUtcText</td>
                        </tr>
                    }
                </tbody>

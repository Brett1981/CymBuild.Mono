@page "/admin/metadata-migration"
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using Concursus.API.Client.Models.MetadataMigration
@using Microsoft.AspNetCore.Components.Web
@inject Core.CoreClient coreClient
@inject UserService userService
@inject Sage200Microservice.API.Protos.Invoice.InvoiceService.InvoiceServiceClient sageIntegrationService

<div class="metadata-workbench">
    <aside class="metadata-workbench-sidebar">
        <div class="metadata-workbench-brand">
            <span class="metadata-workbench-brand-icon bi bi-database"></span>
            <div>
                <h1>Metadata Migration</h1>
                <span>SMigration workbench</span>
            </div>
        </div>

        <nav class="metadata-workbench-nav" aria-label="Metadata migration sections">
            @NavButton("overview", "bi-house", "Overview")
            <div class="metadata-nav-heading">Migration</div>
            @NavButton("setup", "bi-gear", "Setup")
            @NavButton("runs", "bi-clock-history", "Runs")
            @NavButton("stage", "bi-columns-gap", "Stage & Compare")
            @NavButton("identity", "bi-diagram-3", "Identity Map")
            @NavButton("apply", "bi-arrow-right-circle", "Apply")
            @NavButton("audit", "bi-card-checklist", "Audit")
            <div class="metadata-nav-heading">Configuration</div>
            @NavButton("ignored", "bi-slash-circle", "Ignored Records")
            @NavButton("rules", "bi-signpost-split", "Rules")
            @NavButton("registry", "bi-list-columns-reverse", "Registry")
        </nav>
    </aside>

    <main class="metadata-workbench-main">
        <header class="metadata-workbench-topbar">
            <div class="metadata-environment-flow">
                <div class="metadata-environment-chip">
                    <span class="metadata-env-icon source bi bi-database-fill"></span>
                    <div>
                        <span>Source Environment</span>
                        <strong>@SourceEnvironment</strong>
                        <small>@SourceDatabaseName</small>
                    </div>
                </div>
                <span class="metadata-flow-arrow bi bi-arrow-right-short"></span>
                <div class="metadata-environment-chip">
                    <span class="metadata-env-icon target bi bi-database-fill"></span>
                    <div>
                        <span>Target Environment</span>
                        <strong>@TargetEnvironment</strong>
                        <small>@TargetDatabaseName</small>
                    </div>
                </div>
            </div>

            <div class="metadata-topbar-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="RefreshCurrentViewAsync" disabled="@(IsBusy || !HasRunGuid)">
                    <span class="bi bi-arrow-clockwise"></span>
                    Refresh
                </button>
                <button type="button" class="cb-v2-btn-primary" @onclick="CreateRunAsync" disabled="@(IsBusy || !CanCreateRun)">
                    <span class="bi bi-plus-circle"></span>
                    Create Run
                </button>
                <label class="metadata-run-picker">
                    <span>Run:</span>
                    <select class="cb-v2-select" @bind="RunGuidText">
                        <option value="">New run...</option>
                        @foreach (var run in AvailableRuns)
                        {
                            <option value="@run.RunGuid">@FormatRunOption(run)</option>
                        }
                    </select>
                </label>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(Message))
        {
            <div class="metadata-notice metadata-notice-info">
                <span class="bi bi-info-circle"></span>
                <span>@Message</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Error))
        {
            <div class="metadata-notice metadata-notice-error">
                <span class="bi bi-exclamation-triangle"></span>
                <span>@Error</span>
            </div>
        }

        @if (IsBusy && !string.IsNullOrWhiteSpace(BusyMessage))
        {
            <div class="metadata-notice metadata-notice-processing" role="status" aria-live="polite">
                <span class="metadata-spinner" aria-hidden="true"></span>
                <span>@BusyMessage</span>
            </div>
        }

        @SummaryCards()

        @if (SelectedSection == "overview")
        {
            @OverviewSection()
        }
        else if (SelectedSection == "setup")
        {
            @SetupSection()
        }
        else if (SelectedSection == "runs")
        {
            @RunsSection()
        }
        else if (SelectedSection == "stage")
        {
            @StageCompareSection()
        }
        else if (SelectedSection == "identity")
        {
            @IdentitySection()
        }
        else if (SelectedSection == "apply")
        {
            @ApplySection()
        }
        else if (SelectedSection == "audit")
        {
            @AuditSection()
        }
        else if (SelectedSection == "ignored")
        {
            @IgnoredRecordsSection()
        }
        else if (SelectedSection == "rules")
        {
            @ComingSoonSection("Rules", "Rule management will sit behind the same FormHelper → gRPC → SQL flow once the backend ignore/selection model is added.")
        }
        else if (SelectedSection == "registry")
        {
            @RegistrySection()
        }
    </main>
</div>

@code {
    private const string DifferenceInsert = "Insert";
    private const string DifferenceUpdate = "Update";
    private const string DifferenceNoChange = "NoChange";

    private string SelectedSection { get; set; } = "stage";
    private string SelectedDetailTab { get; set; } = "comparison";
    private bool IsBusy { get; set; }
    private string Message { get; set; } = string.Empty;
    private string Error { get; set; } = string.Empty;
    private string BusyMessage { get; set; } = string.Empty;

    private string SourceEnvironment { get; set; } = "DEV";
    private string TargetEnvironment { get; set; } = "QA";
    private string SourceServerName { get; set; } = @"SOC-SQLDEVBRE01\GENERAL";
    private string SourceDatabaseName { get; set; } = "CymBuild_Dev";
    private string TargetServerName { get; set; } = @"SOC-SQLDEVBRE01\GENERAL";
    private string TargetDatabaseName { get; set; } = "CymBuild_QA";
    private bool IsValidateOnly { get; set; }
    private bool ForceApply { get; set; }
    private string RunGuidText { get; set; } = string.Empty;

    private MetadataMigrationDashboardModel? Dashboard { get; set; }
    private List<MetadataMigrationRunModel> AvailableRuns { get; set; } = new();
    private List<MetadataMigrationDiffRowModel> DiffRows { get; set; } = new();
    private MetadataMigrationDiffRowModel? SelectedDiffRow { get; set; }
    private MetadataTableSummaryRow? SelectedTableSummary { get; set; }
    private List<MetadataMigrationIgnoredRecordModel> IgnoredRecords { get; set; } = new();

    private string SelectedEntityName { get; set; } = string.Empty;
    private string SelectedDifferenceType { get; set; } = DifferenceUpdate;
    private string TableSearchText { get; set; } = string.Empty;
    private string RecordSearchText { get; set; } = string.Empty;
    private string SelectedSchemaFilter { get; set; } = string.Empty;
    private string SelectedAuditSeverity { get; set; } = string.Empty;
    private bool ShowNoChange { get; set; }
    private bool ShowIgnored { get; set; }
    private bool ShowInactiveIgnoredRecords { get; set; }
    private bool ShowMissingTargetsOnly { get; set; }
    private string IgnoreReason { get; set; } = string.Empty;

    private HashSet<string> SelectedRecordKeys { get; } = new(StringComparer.OrdinalIgnoreCase);

    private Concursus.API.Client.FormHelper? formHelper;

    protected override void OnInitialized()
    {
        formHelper = new Concursus.API.Client.FormHelper(
            coreClient,
            sageIntegrationService,
            Guid.Empty.ToString(),
            userService);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadRunsAsync();
    }

    private Concursus.API.Client.FormHelper CurrentFormHelper =>
        formHelper ?? throw new InvalidOperationException("FormHelper has not been initialised.");

    private bool HasRunGuid => Guid.TryParse(RunGuidText, out _);
    private bool CanCreateRun => !string.IsNullOrWhiteSpace(SourceEnvironment)
        && !string.IsNullOrWhiteSpace(TargetEnvironment)
        && !string.IsNullOrWhiteSpace(SourceDatabaseName)
        && !string.IsNullOrWhiteSpace(TargetDatabaseName);
    private bool IsForceApplyDisabled => !TargetEnvironment.Equals("LIVE", StringComparison.OrdinalIgnoreCase);
    private bool CanApply => HasRunGuid && !IsValidateOnly && (IsForceApplyDisabled || ForceApply) && (Dashboard?.FailCount ?? 0) == 0;
    private bool CanApplySelected => CanApply && SelectedPersistedCount > 0;

    private int InsertCount => Dashboard?.InsertCount ?? 0;
    private int UpdateCount => Dashboard?.UpdateCount ?? 0;
    private int NoChangeCount => Dashboard?.NoChangeCount ?? 0;
    private int ValidationErrorCount => Dashboard?.FailCount ?? 0;
    private int WarningCount => Dashboard?.WarnCount ?? 0;
    private int IgnoredCount => Dashboard?.IgnoredCount ?? 0;
    private int SelectedPersistedCount => Dashboard?.SelectedCount ?? 0;
    private int SelectedLoadedCount => DiffRows.Count(row => row.IsSelected);
    private int OnlyInSourceCount => InsertCount;
    private int OnlyInTargetCount => Dashboard?.MissingTargetRows ?? 0;

    private IEnumerable<string> SchemaFilters => TableSummaryRows
        .Select(x => x.SchemaName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x);

    private List<MetadataTableSummaryRow> TableSummaryRows
    {
        get
        {
            if (Dashboard?.StagedCounts is null || Dashboard.StagedCounts.Count == 0)
            {
                return new List<MetadataTableSummaryRow>();
            }

            var validationGroups = (Dashboard.ValidationIssues ?? new List<MetadataMigrationValidationIssueModel>())
                .GroupBy(x => x.EntityName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(x => x.Key, x => x.Count(v => v.Severity.Equals("Fail", StringComparison.OrdinalIgnoreCase)), StringComparer.OrdinalIgnoreCase);

            var missingTargetGroups = (Dashboard.IdentityMap ?? new List<MetadataMigrationIdentityMapModel>())
                .ToDictionary(x => x.EntityName, x => x.MissingTargetRows, StringComparer.OrdinalIgnoreCase);

            return Dashboard.StagedCounts
                .GroupBy(x => x.EntityName, StringComparer.OrdinalIgnoreCase)
                .Select(group =>
                {
                    var first = group.First();
                    var entityName = first.EntityName;
                    return new MetadataTableSummaryRow
                    {
                        SchemaName = first.SchemaName,
                        TableName = first.TableName,
                        EntityName = entityName,
                        InsertCount = group.Where(x => x.DifferenceType.Equals(DifferenceInsert, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Count),
                        UpdateCount = group.Where(x => x.DifferenceType.Equals(DifferenceUpdate, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Count),
                        NoChangeCount = group.Where(x => x.DifferenceType.Equals(DifferenceNoChange, StringComparison.OrdinalIgnoreCase)).Sum(x => x.Count),
                        ValidationErrorCount = validationGroups.TryGetValue(entityName, out var failCount) ? failCount : 0,
                        MissingTargetCount = missingTargetGroups.TryGetValue(entityName, out var missingTargetCount) ? missingTargetCount : 0
                    };
                })
                .OrderBy(x => x.SchemaName)
                .ThenBy(x => x.TableName)
                .ToList();
        }
    }

    private IEnumerable<MetadataTableSummaryRow> FilteredTableSummaryRows => TableSummaryRows
        .Where(row => string.IsNullOrWhiteSpace(SelectedSchemaFilter) || row.SchemaName.Equals(SelectedSchemaFilter, StringComparison.OrdinalIgnoreCase))
        .Where(row => ShowNoChange || row.InsertCount > 0 || row.UpdateCount > 0 || row.ValidationErrorCount > 0 || row.MissingTargetCount > 0)
        .Where(row => string.IsNullOrWhiteSpace(TableSearchText) || row.EntityName.Contains(TableSearchText, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MetadataMigrationDiffRowModel> FilteredDiffRows => DiffRows
        .Where(row => ShowNoChange || !row.DifferenceType.Equals(DifferenceNoChange, StringComparison.OrdinalIgnoreCase))
        .Where(row => ShowIgnored || !row.IsIgnored)
        .Where(row => string.IsNullOrWhiteSpace(RecordSearchText)
            || row.SourceRowGuid.ToString().Contains(RecordSearchText, StringComparison.OrdinalIgnoreCase)
            || row.SourceValues.Values.Concat(row.TargetValues.Values).Any(v => v.Contains(RecordSearchText, StringComparison.OrdinalIgnoreCase))
            || row.DifferingColumns.Any(v => v.Contains(RecordSearchText, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<MetadataMigrationValidationIssueModel> FilteredValidationIssues => (Dashboard?.ValidationIssues ?? Enumerable.Empty<MetadataMigrationValidationIssueModel>())
        .Where(row => string.IsNullOrWhiteSpace(SelectedAuditSeverity) || row.Severity.Equals(SelectedAuditSeverity, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<MetadataMigrationIdentityMapModel> FilteredIdentityMap => (Dashboard?.IdentityMap ?? Enumerable.Empty<MetadataMigrationIdentityMapModel>())
        .Where(row => !ShowMissingTargetsOnly || row.MissingTargetRows > 0)
        .OrderBy(row => row.SchemaName)
        .ThenBy(row => row.TableName);

    private RenderFragment NavButton(string section, string icon, string label) => @<button type="button"
        class="metadata-nav-button @(SelectedSection == section ? "selected" : string.Empty)"
        @onclick="@(() => SelectSectionAsync(section))">
        <span class="bi @icon"></span>
        <span>@label</span>
    </button>;

    private RenderFragment SummaryCards() => @<section class="metadata-summary-grid" aria-label="Metadata migration summary">
        @SummaryCard("Insert", InsertCount, "success", () => OpenStageWithDifferenceAsync(DifferenceInsert))
        @SummaryCard("Update", UpdateCount, "info", () => OpenStageWithDifferenceAsync(DifferenceUpdate))
        @SummaryCard("No Change", NoChangeCount, "muted", () => OpenStageWithDifferenceAsync(DifferenceNoChange))
        @SummaryCard("Only in Source", OnlyInSourceCount, "orange", () => OpenStageWithDifferenceAsync(DifferenceInsert))
        @SummaryCard("Only in Target", OnlyInTargetCount, "purple", OpenMissingTargetsAsync)
        @SummaryCard("Ignored", IgnoredCount, "muted", () => SelectSectionAsync("ignored"))
        @SummaryCard("Validation Errors", ValidationErrorCount, "danger", () => OpenAuditSeverityAsync("Fail"))
        @SummaryCard("Warnings", WarningCount, "warning", () => OpenAuditSeverityAsync("Warn"))
    </section>;

    private RenderFragment SummaryCard(string title, int count, string tone, Func<Task> onClick) => @<button type="button"
        class="metadata-summary-card metadata-summary-card-@tone"
        @onclick="@(() => onClick())"
        disabled="@IsSummaryCardDisabled(title)">
        <span>@title</span>
        <strong>@count</strong>
    </button>;

    private bool IsSummaryCardDisabled(string title) => IsBusy || (!HasRunGuid && !title.Equals("Ignored", StringComparison.OrdinalIgnoreCase));

    private RenderFragment OverviewSection() => @<section class="metadata-card metadata-overview-grid">
        <div>
            <h2>Run overview</h2>
            <p>The workbench keeps the existing CymBuild migration route and presents the staged comparison in a single review surface.</p>
            <dl class="metadata-definition-grid">
                <dt>Current run</dt><dd>@(HasRunGuid ? RunGuidText : "No run selected")</dd>
                <dt>Status</dt><dd>@(Dashboard?.Run?.RunStatus ?? "Not loaded")</dd>
                <dt>Created UTC</dt><dd>@(Dashboard?.Run?.CreatedOnUtcText ?? "-")</dd>
                <dt>Validated UTC</dt><dd>@(Dashboard?.Run?.ValidatedOnUtcText ?? "-")</dd>
                <dt>Applied UTC</dt><dd>@(Dashboard?.Run?.AppliedOnUtcText ?? "-")</dd>
            </dl>
        </div>
        <div class="metadata-step-list">
            <h3>Recommended flow</h3>
            <ol>
                <li>Create or select a run.</li>
                <li>Stage source metadata into the run.</li>
                <li>Validate and build identity map.</li>
                <li>Review differences in Stage & Compare.</li>
                <li>Apply using the existing guarded apply path.</li>
            </ol>
        </div>
    </section>;

    private RenderFragment SetupSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Setup</h2>
                <p>Configure source and target for the migration run.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="LoadRunsAsync" disabled="@IsBusy">Load Runs</button>
                <button type="button" class="cb-v2-btn-primary" @onclick="CreateRunAsync" disabled="@(IsBusy || !CanCreateRun)">Create Run</button>
            </div>
        </div>

        <div class="metadata-form-grid">
            <label class="metadata-field">
                <span>Source Environment</span>
                <select class="cb-v2-select" @bind="SourceEnvironment">
                    <option>DEV</option>
                    <option>QA</option>
                    <option>UAT</option>
                </select>
            </label>
            <label class="metadata-field">
                <span>Target Environment</span>
                <select class="cb-v2-select" @bind="TargetEnvironment">
                    <option>QA</option>
                    <option>UAT</option>
                    <option>LIVE</option>
                </select>
            </label>
            <label class="metadata-field">
                <span>Source Server</span>
                <input class="cb-v2-input" @bind="SourceServerName" />
            </label>
            <label class="metadata-field">
                <span>Source Database</span>
                <input class="cb-v2-input" @bind="SourceDatabaseName" />
            </label>
            <label class="metadata-field">
                <span>Target Server</span>
                <input class="cb-v2-input" @bind="TargetServerName" />
            </label>
            <label class="metadata-field">
                <span>Target Database</span>
                <input class="cb-v2-input" @bind="TargetDatabaseName" />
            </label>
        </div>

        <div class="metadata-toggle-row">
            <label><input type="checkbox" @bind="IsValidateOnly" /> Validate only</label>
            <label><input type="checkbox" @bind="ForceApply" disabled="@IsForceApplyDisabled" /> Force apply for LIVE</label>
        </div>
    </section>;

    private RenderFragment RunsSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Runs</h2>
                <p>Select an existing migration run or create a new one from Setup.</p>
            </div>
            <button type="button" class="cb-v2-btn-secondary" @onclick="LoadRunsAsync" disabled="@IsBusy">Refresh Runs</button>
        </div>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead>
                    <tr>
                        <th>Run</th>
                        <th>Source</th>
                        <th>Target</th>
                        <th>Status</th>
                        <th>Created UTC</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in AvailableRuns)
                    {
                        <tr class="@(RunGuidText == run.RunGuid.ToString() ? "selected" : string.Empty)">
                            <td>@run.RunGuid</td>
                            <td>@run.SourceEnvironment / @run.SourceDatabaseName</td>
                            <td>@run.TargetEnvironment / @run.TargetDatabaseName</td>
                            <td>@Badge(run.RunStatus)</td>
                            <td>@run.CreatedOnUtcText</td>
                            <td><button type="button" class="cb-v2-btn-secondary" @onclick="@(() => SelectRunAsync(run))" disabled="@IsBusy">Select</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>;

    private RenderFragment StageCompareSection() => @<section class="metadata-stage-layout">
        <div class="metadata-card metadata-table-summary-card">
            <div class="metadata-section-header compact">
                <div>
                    <h2>Differences</h2>
                    <p>@TableSummaryRows.Count table(s) staged for the selected run.</p>
                </div>
                <div class="metadata-section-actions">
                    <button type="button" class="cb-v2-btn-secondary" @onclick="StageAsync" disabled="@(IsBusy || !HasRunGuid)">Stage</button>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="ValidateAsync" disabled="@(IsBusy || !HasRunGuid)">Validate</button>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="BuildIdentityMapAsync" disabled="@(IsBusy || !HasRunGuid)">Build Map</button>
                </div>
            </div>

            <div class="metadata-toolbar">
                <input class="cb-v2-input" placeholder="Search tables..." @bind="TableSearchText" />
                <select class="cb-v2-select" @bind="SelectedSchemaFilter">
                    <option value="">All Schemas</option>
                    @foreach (var schema in SchemaFilters)
                    {
                        <option value="@schema">@schema</option>
                    }
                </select>
                <label><input type="checkbox" @bind="ShowNoChange" /> Show no change</label>
                <label><input type="checkbox" checked="@ShowIgnored" @onchange="ToggleShowIgnoredAsync" /> Show ignored</label>
            </div>

            <div class="metadata-table-wrap metadata-table-summary-wrap">
                <table class="metadata-table metadata-table-summary">
                    <thead>
                        <tr>
                            <th>Schema</th>
                            <th>Table</th>
                            <th>Insert</th>
                            <th>Update</th>
                            <th>No Change</th>
                            <th>Only in Source</th>
                            <th>Only in Target</th>
                            <th>Validation</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredTableSummaryRows)
                        {
                            <tr class="@(SelectedEntityName.Equals(row.EntityName, StringComparison.OrdinalIgnoreCase) ? "selected" : string.Empty)" @onclick="@(() => SelectTableAsync(row))">
                                <td>@row.SchemaName</td>
                                <td><strong>@row.TableName</strong></td>
                                <td class="metadata-count success">@row.InsertCount</td>
                                <td class="metadata-count info">@row.UpdateCount</td>
                                <td>@row.NoChangeCount</td>
                                <td class="metadata-count orange">@row.InsertCount</td>
                                <td class="metadata-count purple">@row.MissingTargetCount</td>
                                <td class="@(row.ValidationErrorCount > 0 ? "metadata-count danger" : string.Empty)">@row.ValidationErrorCount</td>
                                <td><button type="button" class="cb-v2-btn-secondary compact" @onclick:stopPropagation="true" @onclick="@(() => SelectTableAsync(row))">View</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="metadata-record-panels">
            <div class="metadata-card metadata-record-grid-card">
                <div class="metadata-section-header compact">
                    <div>
                        <h2>@(string.IsNullOrWhiteSpace(SelectedEntityName) ? "Records" : SelectedEntityName)</h2>
                        <p>@DiffRows.Count loaded record(s), @SelectedLoadedCount selected in this table, @SelectedPersistedCount selected in run.</p>
                    </div>
                    <div class="metadata-section-actions">
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="SelectVisibleRecordsAsync" disabled="@(IsBusy || !FilteredDiffRows.Any(IsSelectableForApply))">Select Visible</button>
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="ClearTableSelectionAsync" disabled="@(IsBusy || SelectedLoadedCount == 0)">Clear Table</button>
                    </div>
                </div>

                <div class="metadata-toolbar">
                    <select class="cb-v2-select" @bind="SelectedDifferenceType">
                        <option value="">All</option>
                        <option value="Insert">Insert</option>
                        <option value="Update">Update</option>
                        <option value="NoChange">No Change</option>
                    </select>
                    <button type="button" class="cb-v2-btn-secondary" @onclick="LoadRecordsAsync" disabled="@(IsBusy || !HasRunGuid || string.IsNullOrWhiteSpace(SelectedEntityName))">Load Records</button>
                    <input class="cb-v2-input" placeholder="Search records..." @bind="RecordSearchText" />
                </div>

                <div class="metadata-table-wrap metadata-record-table-wrap">
                    <table class="metadata-table metadata-record-table">
                        <thead>
                            <tr>
                                <th class="metadata-checkbox-col"></th>
                                <th>ID / Guid</th>
                                <th>Difference</th>
                                <th>Changed Columns</th>
                                <th>Default?</th>
                                <th>Description</th>
                                <th>Selected</th>
                                <th>Ignored</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in FilteredDiffRows)
                            {
                                <tr class="@(RecordRowClass(row))" @onclick="@(() => SelectRecord(row))">
                                    <td class="metadata-checkbox-col">
                                        <input type="checkbox" checked="@IsRecordSelected(row)" disabled="@(!IsSelectableForApply(row) && !row.IsSelected)" @onclick:stopPropagation="true" @onchange="@((ChangeEventArgs args) => PersistRecordSelectionAsync(row, args))" />
                                    </td>
                                    <td>
                                        <strong>@GetDisplayId(row)</strong>
                                        <small>@row.SourceRowGuid</small>
                                    </td>
                                    <td>@DifferenceBadge(row.DifferenceType)</td>
                                    <td>@row.DifferingColumns.Count</td>
                                    <td>@GetValue(row, "IsDefault")</td>
                                    <td>@FirstNonEmpty(GetValue(row, "Description"), GetValue(row, "Name"), GetValue(row, "Code"), "-")</td>
                                    <td>
                                        @if (row.IsSelected)
                                        {
                                            @Badge("Selected")
                                        }
                                        else
                                        {
                                            <span class="metadata-muted-icon bi bi-dash-circle" title="Not selected for apply"></span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.IsIgnored)
                                        {
                                            @Badge("Ignored")
                                        }
                                        else
                                        {
                                            <span class="metadata-muted-icon bi bi-dash-circle" title="Not ignored"></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="metadata-card metadata-comparison-card">
                <div class="metadata-comparison-header">
                    <div>
                        <h2>Comparison</h2>
                        <p>@(SelectedDiffRow is null ? "Select a record to compare source and target values." : $"{SelectedDiffRow.SchemaName}.{SelectedDiffRow.TableName} / {SelectedDiffRow.SourceRowGuid}")</p>
                    </div>
                    <div class="metadata-ignore-actions">
                        <input class="cb-v2-input metadata-ignore-reason" placeholder="Ignore reason (optional)" @bind="IgnoreReason" disabled="@(IsBusy || SelectedDiffRow?.IsIgnored == true)" />
                        <button type="button" class="cb-v2-btn-secondary compact" @onclick="ToggleIgnoreSelectedRecordAsync" disabled="@(IsBusy || SelectedDiffRow is null)">
                            <span class="bi bi-slash-circle"></span>
                            @(SelectedDiffRow?.IsIgnored == true ? "Unignore Record" : "Ignore Record")
                        </button>
                    </div>
                </div>

                <div class="metadata-tab-row">
                    @DetailTabButton("comparison", "Comparison")
                    @DetailTabButton("json", "JSON")
                    @DetailTabButton("sql", "SQL View")
                </div>

                @if (SelectedDetailTab == "comparison")
                {
                    @ComparisonPanel()
                }
                else if (SelectedDetailTab == "json")
                {
                    @JsonPanel()
                }
                else
                {
                    @SqlPreviewPanel()
                }
            </div>
        </div>
    </section>;

    private RenderFragment IdentitySection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Identity Map</h2>
                <p>Identity map coverage for the selected metadata run.</p>
            </div>
            <button type="button" class="cb-v2-btn-secondary" @onclick="BuildIdentityMapAsync" disabled="@(IsBusy || !HasRunGuid)">Build Identity Map</button>
        </div>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Entity</th><th>Map Rows</th><th>Missing Targets</th></tr></thead>
                <tbody>
                    @foreach (var row in FilteredIdentityMap)
                    {
                        <tr>
                            <td>@row.EntityName</td>
                            <td>@row.MapRows</td>
                            <td class="@(row.MissingTargetRows > 0 ? "metadata-count danger" : string.Empty)">@row.MissingTargetRows</td>
                        </tr>
                    }
                </tbody>
            </table>

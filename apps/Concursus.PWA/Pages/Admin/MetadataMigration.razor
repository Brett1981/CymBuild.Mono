    private RenderFragment IgnoredRecordsSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Ignored Records</h2>
                <p>Ignored metadata records are persisted for @TargetDatabaseName and are skipped in future runs against that database.</p>
            </div>
            <div class="metadata-section-actions">
                <label><input type="checkbox" @bind="ShowInactiveIgnoredRecords" /> Show inactive</label>
                <button type="button" class="cb-v2-btn-secondary" @onclick="LoadIgnoredRecordsAsync" disabled="@(IsBusy || !HasRunGuid)">Refresh Ignored</button>
            </div>
        </div>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Database</th><th>Table</th><th>Source Guid</th><th>Reason</th><th>Ignored UTC</th><th>Status</th><th>Action</th></tr></thead>
                <tbody>
                    @foreach (var row in IgnoredRecords)
                    {
                        <tr>
                            <td>@row.DatabaseName</td>
                            <td>@row.EntityName</td>
                            <td>@row.SourceRowGuid</td>
                            <td>@(string.IsNullOrWhiteSpace(row.Reason) ? "-" : row.Reason)</td>

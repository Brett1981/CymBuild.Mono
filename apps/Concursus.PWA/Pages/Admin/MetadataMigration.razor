    </section>;

    private RenderFragment ApplySection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Apply</h2>
                <p>Apply selected uses the persisted run selection. Apply all valid keeps the existing guarded backend path.</p>
            </div>
            <div class="metadata-section-actions">
                <button type="button" class="cb-v2-btn-secondary" @onclick="ApplySelectedAsync" disabled="@(IsBusy || !CanApplySelected)">Apply Selected (@SelectedPersistedCount)</button>
                <button type="button" class="cb-v2-btn-primary" @onclick="ApplyAsync" disabled="@(IsBusy || !CanApply)">Apply All Valid</button>
            </div>
        </div>
        <dl class="metadata-definition-grid">
            <dt>Run</dt><dd>@(HasRunGuid ? RunGuidText : "No run selected")</dd>
            <dt>Validation errors</dt><dd>@ValidationErrorCount</dd>
            <dt>Warnings</dt><dd>@WarningCount</dd>
            <dt>Selected records</dt><dd>@SelectedPersistedCount</dd>
            <dt>LIVE force apply</dt><dd>@(ForceApply ? "Enabled" : "Disabled")</dd>
            <dt>Validate only</dt><dd>@(IsValidateOnly ? "Yes" : "No")</dd>
        </dl>
        @if (TargetEnvironment == "LIVE" && !ForceApply)
        {
            <div class="metadata-notice metadata-notice-warning">
                <span class="bi bi-shield-lock"></span>
                <span>LIVE apply remains blocked until Force apply for LIVE is explicitly enabled.</span>
            </div>
        }
    </section>;

    private RenderFragment AuditSection() => @<section class="metadata-card">
        <div class="metadata-section-header">
            <div>
                <h2>Audit</h2>
                <p>Validation issues, identity map warnings and execution log for the selected run.</p>
            </div>
            <button type="button" class="cb-v2-btn-secondary" @onclick="ClearAuditFiltersAsync" disabled="@IsBusy">Clear Filters</button>
        </div>

        <div class="metadata-audit-summary">
            <div>Status: <strong>@(Dashboard?.Run?.RunStatus ?? "")</strong></div>
            <div>Run: <strong>@RunGuidText</strong></div>
            <div>Applied: <strong>@(Dashboard?.Run?.AppliedOnUtcText ?? "-")</strong></div>
        </div>

        <h3>Validation Issues</h3>
        <div class="metadata-table-wrap">
            <table class="metadata-table">
                <thead><tr><th>Severity</th><th>Entity</th><th>Issue Code</th><th>Message</th></tr></thead>
                <tbody>
                    @foreach (var row in FilteredValidationIssues)
                    {
                        <tr>
                            <td>@Badge(row.Severity)</td>
                            <td>@row.EntityName</td>
                            <td>@row.IssueCode</td>
                            <td>@row.IssueMessage</td>
                        </tr>

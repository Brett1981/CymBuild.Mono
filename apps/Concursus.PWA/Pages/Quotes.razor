@page "/quotes/{DrawerGuid}"
@using Google.Protobuf.WellKnownTypes
@using Concursus.Components.Shared.Controls
@attribute [Authorize]

<div class="cb-native-tabstrip">
    <div class="cb-native-tab-list" role="tablist" aria-label="Quote workspace tabs">
        <button type="button" class="@NativeTabButtonCss(QuotesTab.Quotes)" role="tab" aria-selected="@IsNativeTabActive(QuotesTab.Quotes)" @onclick="@(() => SelectNativeTab(QuotesTab.Quotes))">
            <i class="bi bi-newspaper" aria-hidden="true"></i>
            <span>Quoting</span>
        </button>

        <button type="button" class="@NativeTabButtonCss(QuotesTab.FilteredQuotes)" role="tab" aria-selected="@IsNativeTabActive(QuotesTab.FilteredQuotes)" @onclick="@(() => SelectNativeTab(QuotesTab.FilteredQuotes))">
            <i class="bi bi-filter-square" aria-hidden="true"></i>
            <span>Filtered Quoting</span>
        </button>

        <button type="button" class="@NativeTabButtonCss(QuotesTab.QuoteDashboard)" role="tab" aria-selected="@IsNativeTabActive(QuotesTab.QuoteDashboard)" @onclick="@(() => SelectNativeTab(QuotesTab.QuoteDashboard))">
            <i class="bi bi-bar-chart" aria-hidden="true"></i>
            <span>Quote Dashboard</span>
        </button>
    </div>

    <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(QuotesTab.Quotes))">
        <DynamicGrid GridCode="QUOTES" DrawerGuid="@DrawerGuid" FullGrid="true" TransientVirtualProperties="@TransientVirtualProperties" />
    </section>

    <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(QuotesTab.FilteredQuotes))">
        @if (ShouldRenderNativeTab(QuotesTab.FilteredQuotes))
        {
            <DynamicGrid GridCode="FILTEREDQUOTES" DrawerGuid="@DrawerGuid" FullGrid="true" TransientVirtualProperties="@TransientVirtualProperties" />
        }
    </section>

    <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(QuotesTab.QuoteDashboard))">
        @if (ShouldRenderNativeTab(QuotesTab.QuoteDashboard))
        {
            <QuoteDashboardV2 />
        }
    </section>
</div>

@code {

    [Parameter]
    public string DrawerGuid { get; set; } = "";
    [Parameter]
    public Dictionary<string, Any> TransientVirtualProperties { get; set; } = new();

    private enum QuotesTab
    {
        Quotes,
        FilteredQuotes,
        QuoteDashboard
    }

    private QuotesTab _nativeActiveTab = QuotesTab.Quotes;
    private readonly HashSet<QuotesTab> _nativeVisitedTabs = new() { QuotesTab.Quotes };

    private void SelectNativeTab(QuotesTab tab)
    {
        _nativeActiveTab = tab;
        _nativeVisitedTabs.Add(tab);
    }

    private bool IsNativeTabActive(QuotesTab tab) => _nativeActiveTab == tab;

    private bool ShouldRenderNativeTab(QuotesTab tab) => _nativeVisitedTabs.Contains(tab);

    private string NativeTabButtonCss(QuotesTab tab) =>
        IsNativeTabActive(tab) ? "cb-native-tab-button active" : "cb-native-tab-button";
}

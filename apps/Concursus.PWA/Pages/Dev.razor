<script>
    window.scrollToBottom = function (element) {
        element.scrollTop = element.scrollHeight;
    };
</script>

@code{
    private StringBuilder logOutputBuilder = new StringBuilder();
    private string logOutput = string.Empty;
    private ElementReference logOutputRef;
    private MessageDisplay? messageDisplay;

    private enum DevRootTab
    {
        Development,
        DevAdvanced
    }

    private enum DevAdvancedTab
    {
        Routines,
        Translation,
        UsageStatistics,
        MemoryDiagnostics,
        WaitStats,
        SageApiTest,
        AiErrorAdmin,
        SyncQueue,
        StepLogs,
        PostcodeLookup
    }

    private DevRootTab activeDevRootTab = DevRootTab.Development;
    private DevAdvancedTab activeDevAdvancedTab = DevAdvancedTab.Routines;
    private readonly HashSet<DevRootTab> visitedDevRootTabs = new() { DevRootTab.Development };
    private readonly HashSet<DevAdvancedTab> visitedDevAdvancedTabs = new() { DevAdvancedTab.Routines };

    private void SelectDevRootTab(DevRootTab tab)
    {
        activeDevRootTab = tab;
        visitedDevRootTabs.Add(tab);

        if (tab == DevRootTab.DevAdvanced)
        {
            visitedDevAdvancedTabs.Add(activeDevAdvancedTab);
        }
    }

    private void SelectDevAdvancedTab(DevAdvancedTab tab)
    {
        activeDevRootTab = DevRootTab.DevAdvanced;
        visitedDevRootTabs.Add(DevRootTab.DevAdvanced);
        activeDevAdvancedTab = tab;
        visitedDevAdvancedTabs.Add(tab);
    }

    private bool IsDevRootTabActive(DevRootTab tab) => activeDevRootTab == tab;
    private bool HasVisitedDevRootTab(DevRootTab tab) => visitedDevRootTabs.Contains(tab);
    private bool IsDevAdvancedTabActive(DevAdvancedTab tab) => activeDevRootTab == DevRootTab.DevAdvanced && activeDevAdvancedTab == tab;
    private bool HasVisitedDevAdvancedTab(DevAdvancedTab tab) => visitedDevAdvancedTabs.Contains(tab);

    private string DevRootTabButtonCss(DevRootTab tab) => IsDevRootTabActive(tab) ? "cb-native-tab-button active" : "cb-native-tab-button";
    private string DevAdvancedTabButtonCss(DevAdvancedTab tab) => IsDevAdvancedTabActive(tab) ? "cb-native-tab-button active" : "cb-native-tab-button";

    protected API.Client.FormHelper? formHelper;
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }
    [Parameter]
    public Dictionary<string, Any> TransientVirtualProperties { get; set; } = new();

    private int localeID = -1;
    private List<LanguageItemModel> Languages = LanguageData.GetLanguages().OrderBy(lang => lang.Text).ToList();
    private List<LanguageLabelModel> languagesSet = new List<LanguageLabelModel>().OrderBy(lang => lang.Name).ToList();
    private List<LanguageLabelsModel> languageLabels = new List<LanguageLabelsModel>().OrderBy(lang => lang.Name).ToList();
    private List<LanguageLabelTranslationModel> languageLabelsTranslations = new List<LanguageLabelTranslationModel>().OrderBy(lang => lang.Text).ToList();

    private string SelectedLanguage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync() { }

    // After updating logOutput, call this method to scroll to the bottom
    private async Task ScrollToBottom()
    {
        await jsRuntime.InvokeVoidAsync("scrollToBottom", logOutputRef);
    }

    private async Task UpdateQuotes()
    {
        try
        {
            // Clear the previous log output
            logOutputBuilder.Clear();
            logOutput = string.Empty;

            // Get GridDataList from GridRef
            GridDataListRequest gridDataListRequest = new()
                {
                    GridCode = "QUOTES",
                    GridViewCode = "ALLQUOTES",
                    ParentGuid = PWAFunctions.ParseAndReturnEmptyGuidIfInvalid("00000000-0000-0000-0000-000000000000").ToString()
                };

            var gridDataListReply = await coreClient.GridDataListAsync(gridDataListRequest);
            if (gridDataListReply.TotalRows > 0)
            {
                var dataObjectGetRequest = new DataObjectGetRequest()
                    {
                        EntityTypeGuid = PWAFunctions.ParseAndReturnEmptyGuidIfInvalid("1c4794c1-f956-4c32-b886-5500ac778a56").ToString(),
                        ForInformationView = false
                    };
                // Get the list of existing SharePoint folders
                var ospResponse = await coreClient.ObjectSharePointPathCollectionGetAsync(new ObjectSharePointPathCollectionGetRequest());

                // Create a HashSet of GUIDs from the ospResponse for fast lookup
                var existingGuids = new HashSet<string>(ospResponse.ObjectSharePointPaths.Select(o => o.ObjectGuid));

                foreach (var gridDataRow in gridDataListReply.DataTable)
                {
                    var objectGuid = gridDataRow.Columns[1].Value.ToString(); // Assuming column 1 contains the Guid

                    // Skip processing if the objectGuid exists in ospResponse
                    if (existingGuids.Contains(objectGuid))
                    {
                        // Log the record as being skipped to the logOutputBuilder
                        logOutputBuilder.AppendLine($"Skipping Record: {objectGuid} As already exists");

                        // Update the UI
                        logOutput = logOutputBuilder.ToString();
                        StateHasChanged();
                        // Scroll to the bottom
                        await ScrollToBottom();
                        continue; // Skip this iteration
                    }

                    // Find the "Number" column in the row
                    var numberColumn = gridDataRow.Columns.FirstOrDefault(c => c.Name == "Number");

                    // Check if the "Number" column exists and its value is numeric
                    if (numberColumn != null && !numberColumn.Value.Contains("SHORE"))
                    {
                        // Process each ObjectGuid individually
                        dataObjectGetRequest.ObjectGuids.Clear();
                        dataObjectGetRequest.ObjectGuids.Add(objectGuid);

                        // Call the API and process each object
                        var response = await coreClient.DataObjectListGetSingleAsync(dataObjectGetRequest);

                        foreach (var dataObject in response.DataObjects)
                        {
                            // Log the Guid and SharePointUrl to the logOutputBuilder
                            logOutputBuilder.AppendLine($"Record: {dataObject.Label}, SharePointUrl: {dataObject.SharePointUrl}");

                            // Update the UI
                            logOutput = logOutputBuilder.ToString();
                            StateHasChanged();
                            // Scroll to the bottom
                            await ScrollToBottom();
                        }
                    }
                }

                logOutputBuilder.AppendLine("All items processed successfully.");
                logOutput = logOutputBuilder.ToString();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while updating Quotes.");
            ex.Data.Add("PageMethod", "DetailView/UpdateQuotes()");
            _ = OnError.InvokeAsync(ex);
        }
    }

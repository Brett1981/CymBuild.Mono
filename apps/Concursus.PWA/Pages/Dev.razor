@page "/dev"
@using Concursus.Components.Shared.Services
@using Concursus.PWA.Classes
@using Concursus.PWA.Pages.Admin.Monitoring
@using Concursus.PWA.Services
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using System.Text
@using Google.Protobuf.WellKnownTypes
@inject OfflineSyncService SyncService
@inject Core.CoreClient coreClient
@inject UserService userService
@inject IJSRuntime jsRuntime
@inject AiErrorReporter AiErrorReporter
@inject IToastService Toast

@attribute [Authorize]

<Concursus.PWA.Shared.MessageDisplay @ref="messageDisplay" />
<h4><i class="bi bi-code me-2" style="font-size: 1.2rem;"></i> Development</h4>

<div class="cb-native-tabstrip cb-dev-native-tabs">
    <div class="cb-native-tab-list" role="tablist" aria-label="Development tabs">
        <button type="button" class="@DevRootTabButtonCss(DevRootTab.Development)" role="tab" aria-selected="@IsDevRootTabActive(DevRootTab.Development)" @onclick="@(() => SelectDevRootTab(DevRootTab.Development))">
            <i class="bi bi-code" aria-hidden="true"></i>
            <span>Development</span>
        </button>
        <button type="button" class="@DevRootTabButtonCss(DevRootTab.DevAdvanced)" role="tab" aria-selected="@IsDevRootTabActive(DevRootTab.DevAdvanced)" @onclick="@(() => SelectDevRootTab(DevRootTab.DevAdvanced))">
            <i class="bi bi-tools" aria-hidden="true"></i>
            <span>Dev Advanced</span>
        </button>
    </div>

    @if (HasVisitedDevRootTab(DevRootTab.Development))
    {
        <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsDevRootTabActive(DevRootTab.Development))">
            <div class="row">
                <DynamicGrid GridCode="DEV" FullGrid="true" TransientVirtualProperties="@TransientVirtualProperties" />
            </div>
        </section>
    }

    @if (HasVisitedDevRootTab(DevRootTab.DevAdvanced))
    {
        <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsDevRootTabActive(DevRootTab.DevAdvanced))">
            <div class="cb-native-tabstrip cb-dev-advanced-native-tabs">
                <div class="cb-native-tab-list" role="tablist" aria-label="Development advanced tabs">
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.Routines)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.Routines)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.Routines))">
                        <i class="bi bi-collection-play" aria-hidden="true"></i>
                        <span>Routines</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.Translation)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.Translation)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.Translation))">
                        <i class="bi bi-translate" aria-hidden="true"></i>
                        <span>Translation</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.UsageStatistics)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.UsageStatistics)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.UsageStatistics))">
                        <i class="bi bi-bar-chart" aria-hidden="true"></i>
                        <span>Usage Statistics</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.MemoryDiagnostics)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.MemoryDiagnostics)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.MemoryDiagnostics))">
                        <i class="bi bi-memory" aria-hidden="true"></i>
                        <span>Memory Diagnostics</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.WaitStats)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.WaitStats)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.WaitStats))">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                        <span>Wait Stats</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.SageApiTest)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.SageApiTest)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.SageApiTest))">
                        <i class="bi bi-plug" aria-hidden="true"></i>
                        <span>Sage API test</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.AiErrorAdmin)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.AiErrorAdmin)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.AiErrorAdmin))">
                        <i class="bi bi-braces" aria-hidden="true"></i>
                        <span>AI Error Admin</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.SyncQueue)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.SyncQueue)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.SyncQueue))">
                        <i class="bi bi-upload" aria-hidden="true"></i>
                        <span>Sync Queue</span>
                    </button>
                    <button type="button" class="@DevAdvancedTabButtonCss(DevAdvancedTab.StepLogs)" role="tab" aria-selected="@IsDevAdvancedTabActive(DevAdvancedTab.StepLogs)" @onclick="@(() => SelectDevAdvancedTab(DevAdvancedTab.StepLogs))">
                        <i class="bi bi-textarea" aria-hidden="true"></i>
                        <span>Step Logs</span>
                    </button>

@page "/dev-v2"
@using Concursus.Components.Shared.Services
@using Concursus.PWA.Classes
@using Concursus.PWA.Pages
@using Concursus.PWA.Pages.Admin
@using Concursus.PWA.Pages.Admin.Monitoring
@using Concursus.PWA.Services
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using System.Text
@using Google.Protobuf.WellKnownTypes
@inject OfflineSyncService SyncService
@inject Core.CoreClient coreClient
@inject UserService userService
@inject IJSRuntime jsRuntime
@inject AiErrorReporter AiErrorReporter
@inject IToastService Toast

@attribute [Authorize]

<Concursus.PWA.Shared.MessageDisplay @ref="messageDisplay" />

<div class="cb-v2-shell">
    <div class="cb-v2-page dev-v2-page">
        <div class="cb-v2-card">
            <div class="cb-v2-card-body">
                <div class="cb-v2-panel-header">
                    <div class="dev-v2-title-block">
                        <div class="cb-v2-icon-wrap">
                            <i class="bi bi-code"></i>
                        </div>
                        <div>
                            <h2 class="cb-v2-title">Development</h2>
                            <div class="cb-v2-description">
                                Developer tools, diagnostics, routines and operational test utilities.
                            </div>
                        </div>
                    </div>

                    <div class="cb-v2-actions">
                        @foreach (var tab in DevV2Tabs)
                        {
                            <button type="button"
                                    class="cb-v2-btn-chip @(SelectedDevV2Tab == tab.Key ? "selected" : string.Empty)"
                                    @onclick="@(() => SelectDevV2Tab(tab.Key))">
                                @tab.Title
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>

        @if (SelectedDevV2Tab == "development")
        {
            <div class="cb-v2-card">
                <div class="cb-v2-card-body">
                    <div class="cb-v2-panel-header dev-v2-section-header">
                        <div>
                            <h3 class="cb-v2-title">Development Grid</h3>
                            <div class="cb-v2-description">Existing development metadata grid preserved unchanged.</div>
                        </div>
                    </div>

                    <div class="dev-v2-component-wrap">
                        <DynamicGrid GridCode="DEV" FullGrid="true" TransientVirtualProperties="@TransientVirtualProperties" />
                    </div>
                </div>
            </div>
        }

        @if (SelectedDevV2Tab == "advanced")
        {
            <div class="cb-v2-card">
                <div class="cb-v2-card-body">
                    <div class="cb-v2-panel-header">
                        <div>
                            <h3 class="cb-v2-title">Dev Advanced</h3>
                            <div class="cb-v2-description">Advanced diagnostics, routines, queues and migration tooling.</div>
                        </div>
                    </div>

                    <div class="dev-v2-tab-scroll">
                        <div class="cb-v2-actions dev-v2-tab-actions">
                            @foreach (var tab in DevV2AdvancedTabs)
                            {
                                <button type="button"
                                        class="cb-v2-btn-chip @(SelectedDevV2AdvancedTab == tab.Key ? "selected" : string.Empty)"
                                        @onclick="@(() => SelectDevV2AdvancedTab(tab.Key))">
                                    @tab.Title
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (SelectedDevV2AdvancedTab == "routines")
            {
                <div class="cb-v2-card">
                    <div class="cb-v2-card-body">
                        <div class="cb-v2-panel-header">
                            <div>
                                <h3 class="cb-v2-title">Routines</h3>
                                <div class="cb-v2-description">Controlled developer routines for SharePoint preparation and legacy status import.</div>
                            </div>
                        </div>

                        <div class="dev-v2-routine-list">
                            <div class="dev-v2-routine-card">
                                <div>
                                    <div class="dev-v2-routine-title">Update Jobs</div>
                                    <div class="cb-v2-description">Receives all jobs and runs routines to create SharePoint folders and permissions.</div>
                                </div>
                                <button type="button" class="cb-v2-btn-secondary" @onclick="UpdateJobs">Update Jobs</button>
                            </div>

                            <div class="dev-v2-routine-card">
                                <div>
                                    <div class="dev-v2-routine-title">Update Enquiries</div>
                                    <div class="cb-v2-description">Receives all enquiries and runs routines to create SharePoint folders and permissions.</div>
                                </div>
                                <button type="button" class="cb-v2-btn-secondary" @onclick="UpdateEnquiries">Update Enquiries</button>
                            </div>

                            <div class="dev-v2-routine-card">
                                <div>
                                    <div class="dev-v2-routine-title">Update Quotes</div>
                                    <div class="cb-v2-description">Receives all quotes and runs routines to create SharePoint folders and permissions.</div>
                                </div>
                                <button type="button" class="cb-v2-btn-secondary" @onclick="UpdateQuotes">Update Quotes</button>
                            </div>

                            <div class="dev-v2-routine-card">
                                <div>
                                    <div class="dev-v2-routine-title">Update Accounts</div>
                                    <div class="cb-v2-description">Receives all CRM accounts and runs routines to create SharePoint folders and permissions.</div>
                                </div>
                                <button type="button" class="cb-v2-btn-secondary" @onclick="UpdateAccounts">Update Accounts</button>
                            </div>

                            <div class="dev-v2-routine-card">
                                <div>
                                    <div class="dev-v2-routine-title">Update Properties</div>
                                    <div class="cb-v2-description">Receives all assets and runs routines to create SharePoint folders and permissions.</div>
                                </div>
                                <button type="button" class="cb-v2-btn-secondary" @onclick="UpdateProperties">Update Properties</button>
                            </div>

                            <div class="dev-v2-routine-card">
                                <div>
                                    <div class="dev-v2-routine-title">Import Legacy Statuses</div>
                                    <div class="cb-v2-description">Imports the latest status for enquiries, quotes and jobs into the new status management system.</div>
                                </div>
                                <button type="button" class="cb-v2-btn-secondary" @onclick="ImportLegacyStatuses">Import Legacy Statuses</button>
                            </div>
                        </div>

                        <div class="dev-v2-log-panel">
                            <label for="logOutput" class="cb-v2-strong">Routine Log</label>
                            <textarea id="logOutput"
                                      class="cb-v2-input dev-v2-log-output"
                                      rows="10"
                                      readonly
                                      @ref="logOutputRef">@logOutput</textarea>
                        </div>
                    </div>
                </div>
            }


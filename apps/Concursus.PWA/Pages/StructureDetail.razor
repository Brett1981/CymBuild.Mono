@page "/StructureDetail/{RecordGuid}/{SerializedDataObjectReference}/{ReturnUrl}"
@inject Core.CoreClient CoreClient
@inherits EditPageBase
@using Google.Protobuf.WellKnownTypes
@using Concursus.PWA.Classes
@using Concursus.API.Client
@using Concursus.API.Client.Models
@using Newtonsoft.Json
@using System.Web
@using Concursus.API.Client.GeoData
@inject UserService userService
@inject IJSRuntime JS
@inject ModalService modalService
@inject NavigationManager Navigation


@attribute [Authorize]

<EditPage @ref="@editPage"
          EntityTypeGuid="2cfbff39-93cd-436b-b8ca-b2fcf7609707"
          Windowed="@Windowed"
          @bind-RecordGuid="@RecordGuid"
          ModalId="@ModalId"
          @bind-ParentDataObjectReference="@ParentDataObjectReference"
          ReturnUrl="@ReturnUrl"
          FormSubmittedPre="@FormSubmittedPre"
          PostCodeChangedPre="@PostCodeChangedPre"
          CloseWindow="@CloseWindow"
          GridUpdated="@GridUpdated"
          IsDetailWindowed="IsDetailWindowed"
          EnableBrowserTabTitle="true"
          BrowserTabTitlePropertyName="Number"
          BrowserTabTitlePrefix="Asset"
          IdentifyingFieldChanged="@OnIdentifyingFieldChanged"
          TransientVirtualProperties="@TransientVirtualProperties">
    <FormTitle>
        <i class="bi bi-buildings-fill me-2" style="font-size: 1.2rem;"></i>
    </FormTitle>
    <FormBody>
        <div class="cb-structure-detail">
            <ul class="nav nav-tabs cb-structure-tabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button type="button"
                            class="nav-link @GetTabCss(StructureDetailTab.Asset)"
                            role="tab"
                            aria-selected="@(ActiveTab == StructureDetailTab.Asset)"
                            @onclick="@(() => SetActiveTab(StructureDetailTab.Asset))">
                        <i class="bi bi-buildings-fill me-2" style="font-size: 1.2rem;"></i>Asset
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button type="button"
                            class="nav-link @GetTabCss(StructureDetailTab.RelatedRecords)"
                            role="tab"
                            aria-selected="@(ActiveTab == StructureDetailTab.RelatedRecords)"
                            @onclick="@(() => SetActiveTab(StructureDetailTab.RelatedRecords))">
                        <i class="bi bi-book me-2" style="font-size: 1.2rem;"></i>Related Records
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button type="button"
                            class="nav-link @GetTabCss(StructureDetailTab.ChildAssets)"
                            role="tab"
                            aria-selected="@(ActiveTab == StructureDetailTab.ChildAssets)"
                            @onclick="@(() => SetActiveTab(StructureDetailTab.ChildAssets))">
                        <i class="bi bi-house-down-fill me-2" style="font-size: 1.2rem;"></i>Child Assets
                    </button>
                </li>
            </ul>

            <div class="cb-structure-tab-panel">
                @if (ActiveTab == StructureDetailTab.Asset)
                {
                    <div class="row">
                        <div class="col-md-12 col-lg-6">
                            @if (RecordGuid == Guid.Empty.ToString())
                            {
                                <div class="alert alert-info d-flex align-items-start mt-3" role="alert">
                                    <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                                    <div>
                                        <strong>Before saving, check this isn't a duplicate.</strong>
                                        Enter as much of the <strong>Number</strong>, <strong>Address Lines</strong>,
                                        <strong>Town</strong>, <strong>County</strong> and <strong>Postcode</strong> as you can,
                                        then click <strong>Validate</strong> below to check for existing assets. The more of
                                        these you fill in, the more accurate the result.
                                    </div>
                                </div>
                            }
                            <FlexPropertyGroups @ref="@editPage.flexPropertyGroups"
                                                entityProperties="@editPage.entityProperties"
                                                entityPropertyGroups="@editPage.entityPropertyGroups"
                                                IsMainRecordContext="@IsMainRecordContext"
                                                dataObject="@editPage.dataObject"
                                                RecordGuid="@RecordGuid"
                                                inputUpdated="@editPage.HandleInputUpdated"
                                                ValidateAddressCallback="@ValidateAddress"
                                                editPageRef="@editPage" />
                        </div>
                        <div class="col-md-12 col-lg-6">
                            <div class="card shadow-sm p-2 m-2 flex-fill cb-structure-map-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                        <div>
                                            <h6 class="card-title mb-1">
                                                <i class="bi bi-geo-alt-fill me-2"></i>Location
                                            </h6>
                                            <div class="text-muted small">
                                                @GetMapStatusText()
                                            </div>
                                        </div>

                                        <div class="btn-group btn-group-sm" role="group" aria-label="Map actions">
                                            <button type="button"
                                                    class="btn btn-outline-primary"
                                                    title="Find location from postcode"
                                                    @onclick="FindFromPostcodeAsync">
                                                <i class="bi bi-search me-1"></i>Postcode
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    title="Apply the latitude and longitude currently entered on the form"
                                                    @onclick="ApplyCoordinateFieldsAsync">
                                                <i class="bi bi-crosshair me-1"></i>Apply coords
                                            </button>
                                        </div>
                                    </div>

                                    <div class="cb-structure-map-preview">
                                        <iframe title="Asset location map"
                                                src="@MapEmbedUrl"
                                                loading="lazy"
                                                referrerpolicy="no-referrer-when-downgrade"></iframe>
                                    </div>

                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                                        <div class="small text-muted">
                                            Latitude: <strong>@MapCenter[0].ToString("0.000000")</strong>
                                            <span class="mx-1">|</span>
                                            Longitude: <strong>@MapCenter[1].ToString("0.000000")</strong>
                                        </div>

                                        <a class="btn btn-sm btn-outline-secondary"
                                           href="@OpenStreetMapLink"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>Open map
                                        </a>
                                    </div>

                                    <div class="alert alert-light border small mt-3 mb-0">
                                        The Telerik map has been replaced with a native OpenStreetMap preview.
                                        Use <strong>Postcode</strong> or <strong>Apply coords</strong> to update the stored location.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (ActiveTab == StructureDetailTab.RelatedRecords)
                {
                    <DynamicGrid GridCode="PROPERTYJOBS"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus"
                                 TransientVirtualProperties="@TransientVirtualProperties" />
                }
                else if (ActiveTab == StructureDetailTab.ChildAssets)
                {
                    <DynamicGrid GridCode="ASSETSCHILDREN"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus"
                                 TransientVirtualProperties="@TransientVirtualProperties" />
                }
            </div>
        </div>

        @if (ShowAssetConfirmationModal)
        {
            <div class="shore-input-modal-backdrop"></div>
            <div class="shore-input-modal-shell" role="dialog" aria-modal="true">
                <div class="shore-input-modal-card dup-select-modal-card">
                    <div class="shore-input-modal-header">
                        <div class="shore-input-modal-title-wrap">
                            <div class="shore-input-modal-title">
                                <i class="bi bi-arrow-up-right-square"></i>
                                <span>Possible Asset Duplicates</span>
                            </div>
                        </div>

                        <div class="shore-input-modal-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-light"
                                    title="Close"
                                    @onclick="CloseModal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="shore-input-modal-body dup-select-modal-body">

                        @if (HasDuplicateAssets)
                        {
                            <div class="alert alert-info small py-2 mb-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Select a match below and click <strong>Use Selected</strong> to be taken to that asset
                                instead, where you can make any changes needed - or click <strong>Cancel</strong> if none match.
                            </div>

                            <div class="d-flex flex-row justify-content-around">
                                <ShoreLookupInput Value="@DuplicateSelection"
                                                  ValueChanged="@OnNativeLookupValueChangedAsync"
                                                  LoadItems="@LoadDuplicateValues"
                                                  Placeholder="Select possible duplicate"
                                                  ReadOnly="false"
                                                  IsInvalid="false"
                                                  CssClass="w-100" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="HandleModelOnClick">
                                    <span class="bi bi bi-info-circle"></span>
                                </button>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button"
                                        class="btn btn-success"
                                        @onclick="DuplicatePresent">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Use Selected
                                </button>

                                <button type="button"
                                        class="btn btn-danger"
                                        @onclick="DuplicateNotPresent">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success small mb-3">
                                <i class="bi bi-check-circle me-2"></i>
                                <strong>No potential duplicates found.</strong><br />
                                The address you have entered does not closely match any existing asset records.
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button"
                                        class="btn btn-success"
                                        @onclick="DuplicateNotPresent">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Continue
                                </button>
                            </div>
                        }

                    </div>
                </div>
            </div>


            @if (SecondaryModalIsVisible)
            {
                var informationComponentType = InformationPageComponentType;

                <!-- Secondary modal for inspecting asset records-->
                <div class="shore-input-modal-backdrop"></div>
                <div class="shore-input-modal-shell" role="dialog" aria-modal="true">
                    <div class="shore-input-modal-card">
                        <div class="shore-input-modal-header">
                            <div class="shore-input-modal-title-wrap">
                                <div class="shore-input-modal-title">
                                    <i class="bi bi-info-circle"></i>
                                    <span>"Information"</span>
                                </div>
                            </div>
                            <div class="shore-input-modal-actions">
                                <button type="button" class="btn btn-sm btn-outline-light" title="Maximise" @onclick="() => {SecondaryModalIsVisible = !SecondaryModalIsVisible;}">
                                    <i class="bi bi-arrows-fullscreen"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-light" title="Close" @onclick="() => {SecondaryModalIsVisible = !SecondaryModalIsVisible;}">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="shore-input-modal-body">
                            @if (informationComponentType is not null)
                            {
                                <DynamicComponent Type="@informationComponentType" Parameters="@_detailPageParameters" />
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    Could not resolve information component: StructureDetail
                                </div>
                            }
                        </div>
                    </div>
                </div>


            }
           
        }
    </FormBody>
</EditPage>


<style>
 
</style>

@code {
    [Parameter]
    public int ParentRowStatus { get; set; } = -1;
    [Parameter] public bool IsMainRecordContext { get; set; } = true;
    [Parameter]
    public Dictionary<string, Any> TransientVirtualProperties { get; set; } = new();

    private enum StructureDetailTab
    {
        Asset,
        RelatedRecords,
        ChildAssets
    }

    private StructureDetailTab ActiveTab { get; set; } = StructureDetailTab.Asset;

    private double[] MapCenter { get; set; } = { 54.0, -2.0 }; // Center of UK
    private bool HasSpecificLocation { get; set; }

    private bool FirstUpdate = false;
    private readonly Geodata _geoData = new();
    [Parameter]
    public string? SerializedDataObjectReference { get; set; }
    [Parameter] public string? ModalId { get; set; }
    [Parameter]
    public EventCallback<DataObjectReference> ParentDataObjectReferenceChanged { get; set; }
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }
    [Parameter] public bool IsDetailWindowed { get; set; } = false;

    private const string StructureEntityTypeGuid = "2cfbff39-93cd-436b-b8ca-b2fcf7609707";
    private const string PostcodePropertyGuid = "64e674c3-e42d-4a4b-8747-16212d7db19d";
    private const string LatitudePropertyGuid = "14bf36ce-da62-4dc3-b832-dd9b485ff32e";
    private const string LongitudePropertyGuid = "8bdb4d5c-ebbf-4db3-86e4-1dd33e5b8bba";
    private const string CountyPropertyGuid = "313686fc-322f-45cd-87bf-8131c333a1a9";
    private const string CountryPropertyGuid = "a4a1588d-38b5-4a10-9c91-a2fccc2562f9";

    private const string DuplicateCheckNameGuid = "2dbe3a12-4ce8-4849-ae2d-7accca6b5483";
    private const string DuplicateCheckNumberGuid = "465ac77b-18c4-463f-86ea-f3c7f111454e";
    private const string DuplicateCheckAddressLine1Guid = "c1282f49-d1f5-4de9-aa4d-293238e889b0";
    private const string DuplicateCheckAddressLine2Guid = "43fbb638-9d69-4649-bf67-6371637fb8c4";
    private const string DuplicateCheckAddressLine3Guid = "5056c116-88b2-4287-90cb-64f0a3f1ab1d";
    private const string DuplicateCheckTownGuid = "41758df6-ab2b-4010-ba0c-a06e43fb10d1";
    private bool _validationConfirmed = false;

    private bool ShowAssetConfirmationModal = false;
    private bool HasDuplicateAssets = false;
    private bool SecondaryModalIsVisible = false;
    private List<ComboDataItem> _duplicateItems = new();
    private IDictionary<string, object> _detailPageParameters = new Dictionary<string, object>();
    private System.Type? InformationPageComponentType => ResolvePageComponentType("StructureDetail");



    private Guid DuplicateSelection { get; set; }

    // When a windowed duplicate-check modal is reloaded onto an existing record (see
    // DuplicatePresent), this component is still hosted by a DynamicComponent whose Parameters
    // dictionary was built once, for the original *new* record, and never updated. OnParametersSetAsync
    // below re-derives ParentDataObjectReference from that same stale SerializedDataObjectReference on
    // every parameter-set pass, so remembering the resolved record here and reasserting it last keeps
    // the swap from reverting.
    private string? _resolvedRecordGuid;
    private DataObjectReference? _resolvedParentDataObjectReference;


    private API.Client.FormHelper? _formHelper;


    private string MapEmbedUrl
    {
        get
        {
            var latitude = MapCenter[0];
            var longitude = MapCenter[1];
            var latitudePadding = HasSpecificLocation ? 0.006 : 4.5;
            var longitudePadding = HasSpecificLocation ? 0.010 : 7.5;

            var bbox = string.Join(",",
                FormatInvariant(longitude - longitudePadding),
                FormatInvariant(latitude - latitudePadding),
                FormatInvariant(longitude + longitudePadding),
                FormatInvariant(latitude + latitudePadding));

            var marker = HasSpecificLocation
                ? $"&marker={FormatInvariant(latitude)},{FormatInvariant(longitude)}"
                : string.Empty;

            return $"https://www.openstreetmap.org/export/embed.html?bbox={bbox}&layer=mapnik{marker}";
        }
    }

    private string OpenStreetMapLink =>
        HasSpecificLocation
            ? $"https://www.openstreetmap.org/?mlat={FormatInvariant(MapCenter[0])}&mlon={FormatInvariant(MapCenter[1])}#map=18/{FormatInvariant(MapCenter[0])}/{FormatInvariant(MapCenter[1])}"
            : "https://www.openstreetmap.org/#map=6/54.000/-2.000";

    public void RefreshPage()
    {
        editPage.SetHasChangedToTrue();
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (ParentDataObjectReference != null)
            {
                ParentDataObjectReference = JsonConvert.DeserializeObject<DataObjectReference>(HttpUtility.UrlDecode(SerializedDataObjectReference) ?? string.Empty);
                await ParentDataObjectReferenceChanged.InvokeAsync(ParentDataObjectReference);
            }

            if (_resolvedRecordGuid != null)
            {
                RecordGuid = _resolvedRecordGuid;
                ParentDataObjectReference = _resolvedParentDataObjectReference!;
            }

            await base.OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/OnParametersSetAsync()");
        }
    }

    string? GetStringValue(Any? any)
    {
        if (any == null)
            return null;

        return any.Unpack<StringValue>().Value;
    }



    private async Task<bool> ValidateAddress()
    {
        try
        {
            _formHelper = new API.Client.FormHelper(CoreClient, PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(RecordGuid).ToString(), userService);


            var name            = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "2dbe3a12-4ce8-4849-ae2d-7accca6b5483").FirstOrDefault().Value) ?? "";
            var number          = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "465ac77b-18c4-463f-86ea-f3c7f111454e").FirstOrDefault().Value) ?? "";
            var addressLine1    = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "c1282f49-d1f5-4de9-aa4d-293238e889b0").FirstOrDefault().Value) ?? "";
            var addressLine2    = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "43fbb638-9d69-4649-bf67-6371637fb8c4").FirstOrDefault().Value) ?? "";
            var addressLine3    = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "5056c116-88b2-4287-90cb-64f0a3f1ab1d").FirstOrDefault().Value) ?? "";
            var town            = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "41758df6-ab2b-4010-ba0c-a06e43fb10d1").FirstOrDefault().Value) ?? "";
            var countyGuid      = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "313686fc-322f-45cd-87bf-8131c333a1a9").FirstOrDefault().Value) ?? "";
            var postcode        = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == "64e674c3-e42d-4a4b-8747-16212d7db19d").FirstOrDefault().Value) ?? "";

            //Check if all the variables are empty. (e.g. user clicked "Validate" but didn't enter an address)
            if (new[]
            {
                number,
                addressLine1,
                addressLine2,
                addressLine3,
                town,
                postcode
            }.All(string.IsNullOrEmpty))
            {
                await JS.InvokeVoidAsync("alert", "Please, enter an address before validating.");
                return false;
            }


            var duplicates = await _formHelper.DuplicateAssetsGet(name,number, addressLine1, addressLine2, addressLine3, town, countyGuid, postcode);

            _duplicateItems = duplicates?.Duplicates
                 .Select(x => new ComboDataItem(
                     new DropDownDataListItem
                     {
                         Value = x.Guid,
                         Name = x.FormattedAddress
                     }))
                 .ToList() ?? new List<ComboDataItem>();

            HasDuplicateAssets = _duplicateItems.Count > 0;

            //Disable the save button until the user confirms via the modal.
            editPage.ValidationRequired();

            ShowAssetConfirmationModal = true;
            StateHasChanged();

            //Modal drives the final "Validated" state via DuplicatePresent/DuplicateNotPresent.
            return false;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/ValidateAddress()");
            return false;
        }
    }

    private Task OnNativeLookupValueChangedAsync(Guid value)
    {
        DuplicateSelection = value;
        return Task.CompletedTask;
    }


    private Task<IReadOnlyList<ComboDataItem>> LoadDuplicateValues(string searchText)
    {
        var items = _duplicateItems
            .Where(x => string.IsNullOrWhiteSpace(searchText) ||
                        x.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

        return Task.FromResult<IReadOnlyList<ComboDataItem>>(items);
    }

    private async void DuplicatePresent()
    {

        if(DuplicateSelection == null || DuplicateSelection == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "No structure has been selected");
            return;
        }

        var parentDataObjectRef = new DataObjectReference(DuplicateSelection.ToString(), "2cfbff39-93cd-436b-b8ca-b2fcf7609707");

        ShowAssetConfirmationModal = false;

        if (Windowed)
        {
            // Loaded inside a modal: reload this same modal with the selected existing asset
            // instead of navigating the whole browser tab away from it.
            _resolvedRecordGuid = DuplicateSelection.ToString();
            _resolvedParentDataObjectReference = parentDataObjectRef;
            RecordGuid = _resolvedRecordGuid;
            ParentDataObjectReference = parentDataObjectRef;
            await editPage.ReloadRecordAsync(RecordGuid, parentDataObjectRef);
        }
        else
        {
            var serializeParentDataObjectReferenced = HttpUtility.UrlEncode(JsonConvert.SerializeObject(parentDataObjectRef));
            var returnUri = System.Web.HttpUtility.UrlEncode(Navigation.Uri);
            var url = $"StructureDetail/{DuplicateSelection.ToString()}/{serializeParentDataObjectReferenced}/{returnUri}";

            Navigation.NavigateTo(url, true);
        }

        StateHasChanged();
    }

    private void DuplicateNotPresent()
    {

        ShowAssetConfirmationModal = false;
        editPage.flexPropertyGroups?.ChangeValidationBtnText("Validated", "btn btn-success");

        editPage.DataHasBeenValidated();
        _validationConfirmed = true;

        StateHasChanged();
    }

    /// <summary>
    /// Re-arms the "Validate" button if any of the identifying address fields are edited after
    /// the asset was already confirmed via the duplicate-check modal, so the user can re-check.
    /// </summary>
    private void OnIdentifyingFieldChanged(Guid entityPropertyGuid)
    {
        var identifyingGuids = new[]
        {
            DuplicateCheckNameGuid, DuplicateCheckNumberGuid, DuplicateCheckAddressLine1Guid,
            DuplicateCheckAddressLine2Guid, DuplicateCheckAddressLine3Guid, DuplicateCheckTownGuid,
            CountyPropertyGuid, PostcodePropertyGuid
        };
        var isIdentifyingField = identifyingGuids.Any(guid => entityPropertyGuid == new Guid(guid));

        if (!DuplicateCheckRevalidation.ShouldRearm(_validationConfirmed, isIdentifyingField, RecordGuid))
        {
            return;
        }

        _validationConfirmed = false;
        editPage.flexPropertyGroups?.ChangeValidationBtnText("Validate", "btn btn-primary");
        editPage.ValidationRequired();
    }


    private void CloseModal()
    {
        ShowAssetConfirmationModal = false;
        StateHasChanged();
    }

    protected void HandleModelOnClick()
    {

        if (SecondaryModalIsVisible) return; // Prevent modal from being re-registered

        var modalId = "";
        try
        {
            string serializeParentDataObjectReferenced = HttpUtility.UrlEncode(JsonConvert.SerializeObject(ParentDataObjectReference ?? new DataObjectReference("", ""))); ;
            if (ParentDataObjectReference == null || (ParentDataObjectReference.EntityTypeGuid == Guid.Empty)
                && ParentDataObjectReference.DataObjectGuid == Guid.Empty)
            {
                try
                {
                    ParentDataObjectReference = new DataObjectReference(DuplicateSelection.ToString(), "2cfbff39-93cd-436b-b8ca-b2fcf7609707");
                    serializeParentDataObjectReferenced = HttpUtility.UrlEncode(JsonConvert.SerializeObject(ParentDataObjectReference));
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex);
                }
            }
            //Get new ModalId, add it to Parameter and register it
            modalId = Guid.NewGuid().ToString();
            _detailPageParameters.Clear();
            _detailPageParameters.Add("EntityTypeGuid", "2cfbff39-93cd-436b-b8ca-b2fcf7609707");
            _detailPageParameters.Add("Windowed", true);
            _detailPageParameters.Add("CloseWindow", EventCallback.Factory.Create(this, CloseWindow));
            _detailPageParameters.Add("RecordGuid",
                PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(DuplicateSelection.ToString()).ToString());
            _detailPageParameters.Add("SerializedDataObjectReference", serializeParentDataObjectReferenced);
            _detailPageParameters.Add("ParentDataObjectReference", ParentDataObjectReference);
            // _detailPageParameters.Add("PassedEntityProperty",
            //     EntityProperty); //this will be the Object that needs populating
            _detailPageParameters.Add("ReturnUrl", "");
            _detailPageParameters.Add("IsInformationPage", true);
            _detailPageParameters.Add("ModalId", modalId);

            modalService.RegisterModal(modalId, ParentDataObjectReference);

            SecondaryModalIsVisible = true;
        }
        catch (Exception ex)
        {
            ex.Data["MessageType"] = MessageDisplay.ShowMessageType.Error;
            ex.Data["AdditionalInfo"] = "Error in HandleModelOnClick().";
            ex.Data["PageMethod"] = "ShoreInput/HandleModelOnClick()";
            _ = OnError.InvokeAsync(ex);
        }
    }

    private static System.Type? ResolvePageComponentType(string? pageUri)
    {
        var trimmedPageUri = pageUri?.Trim();

        if (string.IsNullOrWhiteSpace(trimmedPageUri))
        {
            return null;
        }

        var candidates = new[]
        {
            trimmedPageUri,
            $"{trimmedPageUri}, Concursus.PWA",
            $"Concursus.PWA.Pages.{trimmedPageUri}",
            $"Concursus.PWA.Pages.{trimmedPageUri}, Concursus.PWA",
            $"Concursus.PWA.Shared.{trimmedPageUri}",
            $"Concursus.PWA.Shared.{trimmedPageUri}, Concursus.PWA"
        };

        foreach (var candidate in candidates)
        {
            var type = System.Type.GetType(candidate, throwOnError: false, ignoreCase: false);

            if (type is not null)
            {
                return type;
            }
        }

        return AppDomain.CurrentDomain
            .GetAssemblies()
            .Select(assembly => assembly.GetType($"Concursus.PWA.Pages.{trimmedPageUri}", throwOnError: false, ignoreCase: false)
                             ?? assembly.GetType($"Concursus.PWA.Shared.{trimmedPageUri}", throwOnError: false, ignoreCase: false)
                             ?? assembly.GetType(trimmedPageUri, throwOnError: false, ignoreCase: false))
            .FirstOrDefault(type => type is not null);
    }


    protected override void OnInitialized()
    {
        EntityTypeGuid = StructureEntityTypeGuid;

        base.OnInitialized();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await base.OnInitializedAsync();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/OnInitializedAsync()");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeMapAsync();

            // Check this component's own RecordGuid, not the outer browser URL. When previewing a
            // duplicate match via the info (i) popup, this page is rendered inline with its own
            // RecordGuid for an *existing* record while the browser URL still points at the record
            // being created, so the URL-based check wrongly forced validation on the read-only
            // preview (CYB-312 QA feedback).
            if (!IsInformationPage && RecordGuid == Guid.Empty.ToString())
            {
                editPage.ValidationRequired();
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void SetActiveTab(StructureDetailTab tab)
    {
        ActiveTab = tab;
    }

    private string GetTabCss(StructureDetailTab tab) => ActiveTab == tab ? "active" : string.Empty;

    private async Task InitializeMapAsync()
    {
        try
        {
            if (ParentRowStatus != 999 && !FirstUpdate)
            {
                if (editPage.entityProperties.Count > 0)
                {
                    var postcodeProperty = GetEntityPropertyValue<string>(PostcodePropertyGuid);
                    var latitudeProperty = Math.Round(GetEntityPropertyValue<double>(LatitudePropertyGuid), 6);
                    var longitudeProperty = Math.Round(GetEntityPropertyValue<double>(LongitudePropertyGuid), 6);

                    if (!string.IsNullOrEmpty(postcodeProperty))
                    {
                        if (latitudeProperty == 0 && longitudeProperty == 0)
                        {
                            await GetLatLonFromPostCode(postcodeProperty.ToLower());
                        }
                        else
                        {
                            await SetLocationValues(new NativeMapLocation { Latitude = latitudeProperty, Longitude = longitudeProperty });
                        }
                    }
                    else
                    {
                        SetDefaultMapLocation();
                    }
                }
            }
            FirstUpdate = true;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/InitializeMapAsync()");
        }
        StateHasChanged();
    }

    protected async void PostCodeChangedPre((API.Client.GeoData.PostcodeInfo postcodeInfo, bool update) p)
    {
        try
        {
            var latitude = Math.Round(p.postcodeInfo.Result[0].Latitude, 6);
            var longitude = Math.Round(p.postcodeInfo.Result[0].Longitude, 6);
            await SetLocationValues(new NativeMapLocation { Latitude = latitude, Longitude = longitude });
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/PostCodeChangedPre()");
        }
    }

    protected async void FormSubmittedPre((EditContext editContext, bool save, bool exit) p)
    {
        var postcodeProperty = GetEntityPropertyValue<string>(PostcodePropertyGuid) ?? "";

        if (p.save)
        {
            try
            {
                var latitude = Math.Round(GetEntityPropertyValue<double>(LatitudePropertyGuid), 6);
                var longitude = Math.Round(GetEntityPropertyValue<double>(LongitudePropertyGuid), 6);

                if (latitude != 0 || longitude != 0)
                {
                    await SetLocationValues(new NativeMapLocation { Latitude = latitude, Longitude = longitude });
                }
                else if (!string.IsNullOrEmpty(postcodeProperty))
                {
                    await GetLatLonFromPostCode(postcodeProperty);
                }
            }
            catch (Exception ex)
            {
                await HandleErrorAsync(ex, "PropertyDetail/FormSubmittedPre()");
            }
        }

        if (!p.save)
        {
            try
            {
                var latitude = Math.Round(GetEntityPropertyValue<double>(LatitudePropertyGuid), 6);
                var longitude = Math.Round(GetEntityPropertyValue<double>(LongitudePropertyGuid), 6);

                if (latitude != 0 || longitude != 0)
                {
                    await SetLocationValues(new NativeMapLocation { Latitude = latitude, Longitude = longitude });
                }
            }
            catch (Exception ex)
            {
                await HandleErrorAsync(ex, "PropertyDetail/FormSubmittedPre()");
            }
        }
        StateHasChanged();
    }

    private async Task FindFromPostcodeAsync()
    {
        try
        {
            var postcode = GetEntityPropertyValue<string>(PostcodePropertyGuid) ?? string.Empty;
            if (string.IsNullOrWhiteSpace(postcode))
            {
                return;
            }

            await GetLatLonFromPostCode(postcode.Trim());
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/FindFromPostcodeAsync()");
        }
    }

    private async Task ApplyCoordinateFieldsAsync()
    {
        try
        {
            var latitude = Math.Round(GetEntityPropertyValue<double>(LatitudePropertyGuid), 6);
            var longitude = Math.Round(GetEntityPropertyValue<double>(LongitudePropertyGuid), 6);

            if (latitude == 0 && longitude == 0)
            {
                SetDefaultMapLocation();
                StateHasChanged();
                return;
            }

            await SetLocationValues(new NativeMapLocation { Latitude = latitude, Longitude = longitude });
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/ApplyCoordinateFieldsAsync()");
        }
    }

    private async Task GetLatLonFromPostCode(string postcode)
    {
        try
        {
            var postcodeInfo = await _geoData.GetGeoDataAsync(postcode);
            if (postcodeInfo.Result.Count == 0) return;

            var lat = Math.Round(postcodeInfo.Result[0].Latitude, 6);
            var lon = Math.Round(postcodeInfo.Result[0].Longitude, 6);
            await SetLocationValues(new NativeMapLocation { Latitude = lat, Longitude = lon });
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/GetLatLonFromPostCode()");
        }
    }

    private async Task SetLocationValues(NativeMapLocation location)
    {
        try
        {
            var roundedLatitude = Math.Round(location.Latitude, 6);
            var roundedLongitude = Math.Round(location.Longitude, 6);

            MapCenter = new double[] { roundedLatitude, roundedLongitude };
            HasSpecificLocation = roundedLatitude != 0 || roundedLongitude != 0;

            PWAFunctions.SetDataPropertyValue(LatitudePropertyGuid, WellKnownType.Double, roundedLatitude, editPage);
            PWAFunctions.SetDataPropertyValue(LongitudePropertyGuid, WellKnownType.Double, roundedLongitude, editPage);

            await SetAndRebindAddressFromLocation(new NativeMapLocation { Latitude = roundedLatitude, Longitude = roundedLongitude });

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/SetLocationValues()");
        }
    }

    private async Task SetAndRebindAddressFromLocation(NativeMapLocation location)
    {
        try
        {
            var roundedLatitude = Math.Round(location.Latitude, 6);
            var roundedLongitude = Math.Round(location.Longitude, 6);

            var postcodeInfo = await _geoData.GetGeoDataByCoordinatesAsync(roundedLongitude, roundedLatitude);
            if (postcodeInfo.Result.Count > 0 && postcodeInfo.Result[0]?.Outcode != null)
            {
                await UpdateDropDownLists(postcodeInfo.Result[0]);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/SetAndRebindAddressFromLocation()");
        }
    }

    private async Task UpdateDropDownLists(PostcodeResult result)
    {
        var tasks = new List<Task>();

        var countyDropDownList = editPage.entityProperties.FirstOrDefault(p => p.Guid == CountyPropertyGuid);
        if (countyDropDownList?.DropDownListDefinitionGuid != Guid.Empty.ToString())
        {
            tasks.Add(UpdateDropDownList(countyDropDownList, result.AdminCounty));
        }

        var countryDropDownList = editPage.entityProperties.FirstOrDefault(p => p.Guid == CountryPropertyGuid);
        if (countryDropDownList?.DropDownListDefinitionGuid != Guid.Empty.ToString())
        {
            tasks.Add(UpdateDropDownList(countryDropDownList, result.Country));
        }

        await Task.WhenAll(tasks);
        StateHasChanged();
    }

    private Task UpdateDropDownList(API.Core.EntityProperty property, string value)
    {
        return PWAFunctions.SetDropDownListValueAsync(
            PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(property.Guid).ToString(),
            PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(property.DropDownListDefinitionGuid).ToString(),
            editPage.MyDataObjectReference.DataObjectGuid.ToString(),
            PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(RecordGuid).ToString(),
            value ?? "",
            editPage,
            CoreClient);
    }

    private void SetDefaultMapLocation()
    {
        MapCenter = new double[] { 54.0, -2.0 };
        HasSpecificLocation = false;
    }

    private string GetMapStatusText()
    {
        return HasSpecificLocation
            ? "Previewing the current asset coordinates."
            : "No coordinates are set. Showing the UK map.";
    }

    private static string FormatInvariant(double value)
    {
        return value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture);
    }

    private async Task HandleErrorAsync(Exception ex, string method)
    {
        ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
        ex.Data.Add("AdditionalInfo", "An error occurred while processing the request. Please try again later.");
        ex.Data.Add("PageMethod", method);
        await OnError.InvokeAsync(ex);
    }

    private T GetEntityPropertyValue<T>(string guid)
    {
        return (T)PWAFunctions.GetValueByEntityPropertyGuid(editPage, guid, typeof(T) == typeof(double) ? WellKnownType.Double : WellKnownType.String);
    }

    private sealed class NativeMapLocation
    {
        public double Latitude { get; init; }
        public double Longitude { get; init; }
    }
}

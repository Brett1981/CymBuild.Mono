@page "/ModalCollection"
@using Concursus.API.Client.Models
@using Concursus.PWA.Classes

@inject Core.CoreClient coreClient
@inject UserService userService
@inject IJSRuntime JS
@inject ModalService modalService

@inherits EditPageBase
@attribute [Authorize]

<section class="cb-v2-page cb-native-dev-page">
    <div class="cb-v2-card cb-native-dev-card">
        <div class="cb-v2-card-body">
            <div class="cb-v2-panel-header cb-native-dev-header">
                <div class="cb-native-dev-title-wrap">
                    <div class="cb-v2-icon-wrap"><i class="bi bi-window-stack"></i></div>
                    <div>
                        <h3 class="cb-v2-title mb-1">Modal Collection</h3>
                        <div class="cb-v2-description">Review and manage currently registered CymBuild modal windows.</div>
                    </div>
                </div>

                <button type="button" class="btn btn-outline-secondary" @onclick="LoadData">
                    <i class="bi bi-arrow-clockwise"></i>
                    Refresh
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <div class="alert alert-danger mt-3">@ErrorMessage</div>
            }

            @if (ModalList is null || ModalList.Count == 0)
            {
                <div class="cb-native-dev-empty mt-3">No open modals are currently registered.</div>
            }
            else
            {
                <div class="cb-native-dev-table-wrap mt-3">
                    <table class="table cb-v2-table cb-native-dev-table">
                        <thead>
                            <tr>
                                <th>Modal ID</th>
                                <th>Data Object Guid</th>
                                <th>Entity Type Guid</th>
                                <th>Timestamp</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var modal in ModalList)
                            {
                                <tr>
                                    @if (IsEditing(modal))
                                    {
                                        <td>@modal.ModalId</td>
                                        <td>
                                            <input class="form-control form-control-sm" @bind="editDataObjectGuid" />
                                        </td>
                                        <td>
                                            <input class="form-control form-control-sm" @bind="editEntityTypeGuid" />
                                        </td>
                                        <td>@modal.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Modal edit actions">
                                                <button type="button" class="btn btn-primary" @onclick="() => SaveEdit(modal)">
                                                    <i class="bi bi-check-lg"></i>
                                                    Save
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                                    Cancel
                                                </button>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>@modal.ModalId</td>
                                        <td>@modal.DataObjectGuid</td>
                                        <td>@modal.EntityTypeGuid</td>
                                        <td>@modal.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm" role="group" aria-label="Modal actions">
                                                <button type="button" class="btn btn-outline-primary" @onclick="() => BeginEdit(modal)">
                                                    <i class="bi bi-pencil"></i>
                                                    Edit
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" @onclick="() => DeleteModal(modal)">
                                                    <i class="bi bi-trash"></i>
                                                    Delete
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@page "/EnquiryDetail/{RecordGuid}/{SerializedDataObjectReference}/{ReturnUrl}"
@using Concursus.API.Client.Models
@using Concursus.Components.Shared.Controls.Documents
@using Concursus.PWA.Classes
@using Google.Protobuf.WellKnownTypes
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using System.Web
@inherits EditPageBase

@inject Core.CoreClient coreClient
@inject UserService userService
@inject Sage200Microservice.API.Protos.Invoice.InvoiceService.InvoiceServiceClient sageIntegrationService
@inject IOptions<ClientConfiguration> Config

@attribute [Authorize]

<EditPage @ref="@editPage"
          EntityTypeGuid="3b4f2df9-b6cf-4a49-9eed-2206473867a1"
          Windowed="@Windowed"
          @bind-RecordGuid="@RecordGuid"
          ModalId="@ModalId"
          @bind-ParentDataObjectReference="@ParentDataObjectReference"
          ReturnUrl="@ReturnUrl"
          CloseWindow="@CloseWindow"
          GridUpdated="@GridUpdated"
          IsDetailWindowed="IsDetailWindowed"
          EnableBrowserTabTitle="true"
          BrowserTabTitlePropertyName="Number"
          BrowserTabTitlePrefix="Enquiry"
          TransientVirtualProperties="@TransientVirtualProperties">
    <FormTitle>
        <i class="bi bi-search me-2" style="font-size: 1.2rem;"></i>
    </FormTitle>
    <FormBody>

        <div class="cb-native-tabstrip">
            <div class="cb-native-tab-list" role="tablist" aria-label="Enquiry detail tabs">
                <button type="button" class="@NativeTabButtonCss(EnquiryDetailTab.EnquiryDetails)" role="tab" aria-selected="@IsNativeTabActive(EnquiryDetailTab.EnquiryDetails)" @onclick="@(() => SelectNativeTab(EnquiryDetailTab.EnquiryDetails))">
                    <i class="bi bi-briefcase" aria-hidden="true"></i>
                    <span>Enquiry Details</span>
                </button>

                <button type="button" class="@NativeTabButtonCss(EnquiryDetailTab.ProjectDetails)" role="tab" aria-selected="@IsNativeTabActive(EnquiryDetailTab.ProjectDetails)" @onclick="@(() => SelectNativeTab(EnquiryDetailTab.ProjectDetails))">
                    <i class="bi bi-person-vcard" aria-hidden="true"></i>
                    <span>Project Details</span>
                </button>

                <button type="button" class="@NativeTabButtonCss(EnquiryDetailTab.ScheduleOfInfo)" role="tab" aria-selected="@IsNativeTabActive(EnquiryDetailTab.ScheduleOfInfo)" @onclick="@(() => SelectNativeTab(EnquiryDetailTab.ScheduleOfInfo))">
                    <i class="bi bi-calendar-range" aria-hidden="true"></i>
                    <span>Schedule of Info</span>
                </button>

                @if (ShowDocumentsTab)
                {
                    <button type="button" class="@NativeTabButtonCss(EnquiryDetailTab.Documents)" role="tab" aria-selected="@IsNativeTabActive(EnquiryDetailTab.Documents)" @onclick="@(() => SelectNativeTab(EnquiryDetailTab.Documents))">
                        <i class="bi bi-folder2-open" aria-hidden="true"></i>
                        <span>Documents</span>
                    </button>
                }
            </div>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(EnquiryDetailTab.EnquiryDetails))">
                <DynamicGrid FormHelper="@_formHelper" GridCode="RECORDSTATUS" ParentGuid="@RecordGuid" ParentDataObjectReference="@editPage.MyDataObjectReference" ParentRowStatus="@editPage.dataObject.RowStatus" ResyncDataObject="@editPage.ReSyncDataObject" TransientVirtualProperties="@TransientVirtualProperties" />

                <FlexPropertyGroups
                    @ref="@editPage.flexPropertyGroups"
                    entityProperties="@editPage.entityProperties"
                    entityPropertyGroups="@editPage.entityPropertyGroups"
                    IsMainRecordContext="@IsMainRecordContext"
                    FormHelper="@_formHelper"
                    dataObject="@editPage.dataObject"
                    RecordGuid="@RecordGuid"
                    inputUpdated="@editPage.HandleInputUpdated"
                    editPageRef="@editPage" />

                <DynamicGrid FormHelper="@_formHelper" GridCode="ENQUIRYSERVICES" ParentGuid="@RecordGuid" ParentDataObjectReference="@editPage.MyDataObjectReference" ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
            </section>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(EnquiryDetailTab.ProjectDetails))">
                <CymLazyRecordTab IsLoaded="@IsTabRequested(EnquiryDetailTab.ProjectDetails)"
                                  Label="Project Details"
                                  OnLoadRequested="@(() => RequestTab(EnquiryDetailTab.ProjectDetails))">
                    <div class="card shadow-sm">
                        <div class="card-header" style="background-color: #17a2b8; color:#ffffff;">
                            <i class="bi bi-info-circle" style=" margin-right: 9px !important; color: #ffffff">  </i>Information
                        </div>
                        <div class="card-body">
                            <p class="card-text">Project Details are shared across all records linked to this project. Changes you make here will be visible on any Enquiry, Quote or Job for this project, even if they belong to a different Business Unit.</p>
                        </div>
                    </div>
                    <DynamicGrid FormHelper="@_formHelper" GridCode="ENQUIRYPROJECTDIRECTORY  " ParentGuid="@RecordGuid" ParentDataObjectReference="@editPage.MyDataObjectReference" ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    <DynamicGrid FormHelper="@_formHelper" GridCode="ENQUIRYKEYDATES  " ParentGuid="@RecordGuid" ParentDataObjectReference="@editPage.MyDataObjectReference" ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                </CymLazyRecordTab>
            </section>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(EnquiryDetailTab.ScheduleOfInfo))">
                <CymLazyRecordTab IsLoaded="@IsTabRequested(EnquiryDetailTab.ScheduleOfInfo)"
                                  Label="Schedule of Info"
                                  OnLoadRequested="@(() => RequestTab(EnquiryDetailTab.ScheduleOfInfo))">
                    <DynamicGrid FormHelper="@_formHelper" GridCode="SCHEDULEOFCLIENTINFO" FullGrid="true" ParentGuid="@RecordGuid" ParentDataObjectReference="@editPage.MyDataObjectReference" ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                </CymLazyRecordTab>
            </section>

            @if (ShowDocumentsTab)
            {
                <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(EnquiryDetailTab.Documents))">
                    <CymLazyRecordTab IsLoaded="@IsTabRequested(EnquiryDetailTab.Documents)"
                                      Label="Documents"
                                      OnLoadRequested="@(() => RequestTab(EnquiryDetailTab.Documents))">
                        <ErrorBoundary @ref="_docsBoundary">
                            <ChildContent>
                                @if (_formHelper is null
                                     || editPage is null
                                     || editPage.dataObject is null
                                     || string.IsNullOrWhiteSpace(editPage.dataObject.Guid)
                                     || editPage.dataObject.Guid == Guid.Empty.ToString())
                                {
                                    <div class="alert alert-info mb-0">
                                        Documents are loading...
                                    </div>
                                }
                                else
                                {
                                    <RecordDocumentBrowserV2 FormHelper="_formHelper"
                                                             DataObject="editPage.dataObject"
                                                             EntityQueryGuid="a29deace-3166-451c-a1ec-0ddf84d0dfa0"
                                                             EntityTypeId="83"
                                                             EntityProperties="editPage.entityProperties"
                                                             EmailRecordNumberPropertyName="Number"
                                                             EmailRecordDescriptionPropertyName="DescriptionOfWorks"
                                                             EmailRecordLocationPropertyName="FormattedAddressComma" />
                                }
                            </ChildContent>

                            <ErrorContent Context="ex">
                                <div class="alert alert-danger">
                                    <strong>Documents tab crashed.</strong><br />
                                    @ex.Message

                                    <div class="mt-2">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RecoverDocumentsTab">Recover</button>
                                    </div>
                                </div>
                            </ErrorContent>
                        </ErrorBoundary>
                    </CymLazyRecordTab>
                </section>
            }
        </div>

    </FormBody>
</EditPage>

@code {

    [Parameter]
    public string? SerializedDataObjectReference { get; set; }
    [Parameter] public string? ModalId { get; set; }
    [Parameter]
    public EventCallback<DataObjectReference> ParentDataObjectReferenceChanged { get; set; }
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }
    [Parameter] public bool IsDetailWindowed { get; set; } = false;
    [Parameter] public bool IsMainRecordContext { get; set; } = true;
    [Parameter]
    public Dictionary<string, Any> TransientVirtualProperties { get; set; } = new();

    private enum EnquiryDetailTab
    {
        EnquiryDetails,
        ProjectDetails,
        ScheduleOfInfo,
        Documents
    }

    private readonly HashSet<EnquiryDetailTab> _requestedTabs = new()
    {
        EnquiryDetailTab.EnquiryDetails
    };

    private EnquiryDetailTab _nativeActiveTab = EnquiryDetailTab.EnquiryDetails;

    private API.Client.FormHelper? _formHelper;
    private ErrorBoundary? _docsBoundary;

    private bool ShowDocumentsTab =>
        Config.Value.Environment.ShowDocumentsTab;

    private void SelectNativeTab(EnquiryDetailTab tab)
    {
        _nativeActiveTab = tab;
        RequestTab(tab);
    }

    private bool IsNativeTabActive(EnquiryDetailTab tab) => _nativeActiveTab == tab;

    private string NativeTabButtonCss(EnquiryDetailTab tab) =>
        IsNativeTabActive(tab) ? "cb-native-tab-button active" : "cb-native-tab-button";

    private void RequestTab(EnquiryDetailTab tab)
    {
        if (_requestedTabs.Add(tab))
        {
            Console.WriteLine($"[CymBuildPerf] Layer=UI Method=EnquiryDetail Step=TabRequested Tab={tab}");
            StateHasChanged();
        }
    }

    private bool IsTabRequested(EnquiryDetailTab tab) => _requestedTabs.Contains(tab);

    private void RecoverDocumentsTab()
    {
        _docsBoundary?.Recover();
        StateHasChanged();
    }
    private void EnsureFormHelper()
    {
        if (_formHelper != null) return;

        _formHelper = new API.Client.FormHelper(
            coreClient,
            sageIntegrationService,
            "3b4f2df9-b6cf-4a49-9eed-2206473867a1",
            userService);
    }
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (ParentDataObjectReference != null)
            {
                ParentDataObjectReference =
                    JsonConvert.DeserializeObject<DataObjectReference>(
                        HttpUtility.UrlDecode(SerializedDataObjectReference) ?? string.Empty);

                await ParentDataObjectReferenceChanged.InvokeAsync(ParentDataObjectReference);
            }

            EnsureFormHelper();

            await base.OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while setting parameters for the Enquiry Detail page.");
            ex.Data.Add("PageMethod", "EnquiryDetail/OnParametersSetAsync()");
            _ = OnError.InvokeAsync(ex);
        }
    }
}

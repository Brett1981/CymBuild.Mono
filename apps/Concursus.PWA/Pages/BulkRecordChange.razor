@page "/BulkRecordChange"
@using Concursus.API.Client.Models
@using Concursus.PWA.Classes
@using Google.Protobuf
@using Google.Protobuf.WellKnownTypes
@using Newtonsoft.Json
@using System.Web
@using System.Dynamic
@using Concursus.Components.Shared.Helpers
@inherits EditPageBase
@implements IDisposable
@inject Core.CoreClient coreClient
@inject UserService userService
@inject IJSRuntime JsRuntime
@attribute [Authorize]

<EditPage @ref="@editPage"
          EntityTypeGuid="@_EntityTypeGuid"
          Windowed="@Windowed"
          @bind-RecordGuid="@RecordGuid"
          ModalId="@ModalId"
          @bind-ParentDataObjectReference="@ParentDataObjectReference"
          ReturnUrl="@ReturnUrl"
          CloseWindow="@CloseWindow"
          GridUpdated="@GridUpdated"
          IsDetailWindowed="IsDetailWindowed"
          IsBulkUpdate="IsBulkUpdate"
          TransientVirtualProperties="@TransientVirtualProperties">
    <FormTitle>
        <i class="bi bi-briefcase-fill me-2" style="font-size: 1.2rem;"></i>
    </FormTitle>
    <FormBody>
        <FlexPropertyGroups @ref="@editPage.flexPropertyGroups"
                            entityProperties="@filteredEntityProperties"
                            entityPropertyGroups="@editPage.entityPropertyGroups"
                            IsMainRecordContext="@IsMainRecordContext"
                            dataObject="@editPage.dataObject"
                            RecordGuid="@RecordGuid"
                            inputUpdated="@HandleInputUpdated"
                            IsBulkUpdate="true" />
    </FormBody>

    <!-- Buttons for Confirm and Cancel -->
    <FormButtons>
        <button class="btn btn-danger" @onclick="CloseModal">Cancel</button>
        <button class="btn btn-success" @onclick="ConfirmChanges">Confirm</button>
    </FormButtons>
</EditPage>
<!-- Loading Overlay -->
@if (IsProcessing)
{
    <div class="bulk-change-overlay">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        @if (Progress is not null && Progress.Total > 0)
        {
            <p class="mb-2">Updating record @Math.Min(Progress.Processed + 1, Progress.Total) of @Progress.Total...</p>
            <div class="progress bulk-change-progress mb-2" role="progressbar" aria-valuenow="@ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                <div class="progress-bar" style="width: @(ProgressPercent)%"></div>
            </div>
            <p class="small text-muted mb-2">
                @Progress.Succeeded updated
                @if (Progress.Failed > 0)
                {
                    <span class="text-danger">, @Progress.Failed failed</span>
                }
                @if (Progress.Skipped > 0)
                {
                    <span>, @Progress.Skipped skipped</span>
                }
            </p>
            <button type="button" class="btn btn-outline-danger btn-sm" @onclick="StopProcessing" disabled="@(_cancellation?.IsCancellationRequested == true)">
                Stop after current record
            </button>
        }
        else
        {
            <p>Processing changes, please wait...</p>
        }
    </div>
}
@if (IsConfirmVisible)
{
    <div class="bulk-change-overlay">
        <div class="bulk-change-result" role="dialog" aria-modal="true" aria-labelledby="bulk-change-confirm-title">
            @if (ValuesToSet.Count == 0)
            {
                <h5 id="bulk-change-confirm-title">No changes selected</h5>
                <p class="mb-3">Tick at least one field and choose its new value before applying a bulk update.</p>
                <button type="button" class="btn btn-primary" @onclick="CancelConfirm">OK</button>
            }
            else
            {
                <h5 id="bulk-change-confirm-title">Apply bulk update?</h5>
                <p class="mb-3">
                    The selected changes will be applied to @SelectedItems.Count record(s).
                    Fields that are read-only on a record (for example on completed activities) are left unchanged and that record is reported as skipped.
                </p>
                <button type="button" class="btn btn-danger me-2" @onclick="CancelConfirm">Cancel</button>
                <button type="button" class="btn btn-success" @onclick="ApplyChangesAsync">Apply changes</button>
            }
        </div>
    </div>
}
@if (!IsProcessing && Result is not null && (!Result.IsCompleteSuccess || Result.Skipped > 0))
{
    <div class="bulk-change-overlay">
        <div class="bulk-change-result">
            <h5>Bulk update @(Result.Stopped ? "stopped" : Result.Failed > 0 ? "finished with errors" : "finished")</h5>
            <p class="mb-2">
                @Result.Succeeded of @Result.Total records updated.
                @if (Result.Failed > 0)
                {
                    <span class="text-danger">@Result.Failed failed.</span>
                }
                @if (Result.Skipped > 0)
                {
                    <span>@Result.Skipped skipped (fields read-only or record not found).</span>
                }
                @if (Result.NotProcessed > 0)
                {
                    <span>@Result.NotProcessed not processed.</span>
                }
            </p>
            @if (Result.Failures.Count > 0)
            {
                <ul class="bulk-change-failures">
                    @foreach (var failure in Result.Failures)
                    {
                        <li><strong>@DescribeSelection(failure.Item)</strong>: @failure.Message</li>
                    }
                </ul>
            }
            <button type="button" class="btn btn-primary" @onclick="CloseResultAsync">Close</button>
        </div>
    </div>
}
<style>
    .modal-footer {
        padding-top: 1rem;
        border-top: 1px solid #ddd;
    }

        .modal-footer .btn {
            min-width: 100px;
        }

    /* CYB-579: own class - EditPage.razor's global .overlay rule sets pointer-events: none, which made
       the Stop / Apply changes / Cancel / Close buttons on these overlays unclickable. */
    .bulk-change-overlay {
        pointer-events: auto;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.8);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 1050;
    }

    .bulk-change-progress {
        width: min(420px, 80vw);
    }

    .bulk-change-result {
        width: min(640px, 92vw);
        max-height: 80vh;
        overflow: auto;
        background: #ffffff;
        border: 1px solid #e5edf7;
        border-radius: 12px;
        padding: 1.25rem;
    }

    .bulk-change-failures {
        max-height: 40vh;
        overflow: auto;
        padding-left: 1.25rem;
    }

    .spinner-border {
        width: 3rem;
        height: 3rem;
    }
</style>

@code {
    [Parameter] public string? ModalId { get; set; }
    [Parameter] public EventCallback<Exception> OnError { get; set; }
    [Parameter] public bool IsDetailWindowed { get; set; } = false;
    [Parameter] public List<ExpandoObject> SelectedItems { get; set; } = new List<ExpandoObject>();
    [Parameter] public EventCallback<DataObjectReference> ParentDataObjectReferenceChanged { get; set; }
    [Parameter] public string? SerializedDataObjectReference { get; set; }
    [Parameter] public bool IsBulkUpdate { get; set; } = false;
    [Parameter] public bool IsMainRecordContext { get; set; } = true;
    [Parameter]
    public Dictionary<string, Any> TransientVirtualProperties { get; set; } = new();

    private string _EntityTypeGuid = Guid.Empty.ToString();
    private List<EntityProperty> filteredEntityProperties = new();
    private EntityType EntityTypeProperties = new();
    private FlexPropertyGroup FlexPropertyGroup { get; set; }
    private bool IsProcessing { get; set; } = false;
    private BulkOperationProgress? Progress { get; set; }
    private BulkOperationResult<ExpandoObject>? Result { get; set; }
    private CancellationTokenSource? _cancellation;

    //Here, we set the new values for the entity properties
    private Dictionary<string, Any> ValuesToSet { get; set; } = new Dictionary<string, Any>();

    // Store the changes to be applied
    private Dictionary<string, object> ChangesToApply = new();

    private bool IsConfirmVisible { get; set; }

    // CYB-579: confirm in-page rather than with a native browser confirm()/alert(), which blocks
    // the whole page (and browser automation) until it is dismissed.
    private void ConfirmChanges() => IsConfirmVisible = true;

    private void CancelConfirm() => IsConfirmVisible = false;

    private async Task ApplyChangesAsync()
    {
        IsConfirmVisible = false;
        var formHelper = new API.Client.FormHelper(coreClient, PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(EntityTypeGuid).ToString(), userService);

        IsProcessing = true; // Show the loading overlay
        Progress = new BulkOperationProgress(SelectedItems.Count, 0, 0, 0, 0);
        Result = null;
        _cancellation?.Dispose();
        _cancellation = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            // CYB-579: select-all can span every page, so report progress per record and carry on
            // past a failed record; the failures are listed once the run finishes.
            Result = await BulkOperationRunner.RunAsync(
                SelectedItems,
                (selection, _) => ApplyChangesToRecordAsync(formHelper, selection),
                async progress =>
                {
                    Progress = progress;
                    await InvokeAsync(StateHasChanged);
                },
                cancellationToken: _cancellation.Token);

            // Only close silently when every record was actually updated; skipped records are
            // reported so a run against e.g. completed activities does not look like a success.
            if (Result.IsCompleteSuccess && Result.Skipped == 0)
            {
                await GridUpdated.InvokeAsync();
                CloseModal();
            }
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while confirming the changes.");
            ex.Data.Add("PageMethod", "BulkRecordChange/ConfirmChanges()");
            await OnError.InvokeAsync(ex);
        }
        finally
        {
            IsProcessing = false; // Hide the loading overlay
            StateHasChanged();
        }
    }

    private async Task<BulkItemOutcome> ApplyChangesToRecordAsync(API.Client.FormHelper formHelper, ExpandoObject selection)
    {
        var selectionId = GetRecordGuidFromSelection(selection);
        if (selectionId == Guid.Empty) return BulkItemOutcome.Skipped;

        var dataObject = await formHelper.ReadDataObjectAsync(selectionId.ToString(), ParentDataObjectReference);
        if (dataObject == null) return BulkItemOutcome.Skipped;

        // CYB-579: if none of the chosen fields could be changed on this record (all read-only,
        // e.g. a completed activity), don't save it and count it as skipped rather than updated.
        if (ApplyBulkValues(dataObject, ValuesToSet) == 0) return BulkItemOutcome.Skipped;

        // UpsertDataObject reports API errors and validation failures in its message rather than
        // throwing; surface them as a failed record instead of silently moving on.
        var (upsertMessage, _) = await formHelper.UpsertDataObject(dataObject, null, false);
        if (!string.IsNullOrWhiteSpace(upsertMessage))
            throw new InvalidOperationException(upsertMessage);

        return BulkItemOutcome.Succeeded;
    }

    /// <summary>
    /// Copies each new value onto the matching data property and returns how many were applied.
    /// Read-only properties are left unchanged ([OE: CBLD-471] - since CBLD-92, user/group
    /// restrictions also make fields read-only) and missing properties are ignored.
    /// </summary>
    internal static int ApplyBulkValues(DataObject dataObject, IReadOnlyDictionary<string, Any> valuesToSet)
    {
        var applied = 0;

        foreach (var (entityPropertyGuid, value) in valuesToSet)
        {
            var property = dataObject.DataProperties.FirstOrDefault(x => x.EntityPropertyGuid == entityPropertyGuid);
            if (property is null || property.IsReadOnly) continue;

            property.Value = value;
            applied++;
        }

        return applied;
    }

    private void StopProcessing() => _cancellation?.Cancel();

    private async Task CloseResultAsync()
    {
        Result = null;
        await GridUpdated.InvokeAsync();
        CloseModal();
    }

    private int ProgressPercent =>
        Progress is null || Progress.Total == 0 ? 0 : (int)Math.Round(Progress.Processed * 100.0 / Progress.Total);

    // A readable label for a failed row: the first couple of visible values, falling back to the Guid.
    private static string DescribeSelection(ExpandoObject selection)
    {
        var dictionary = (IDictionary<string, object>)selection;
        var label = string.Join(" - ", dictionary
            .Where(kv => !string.Equals(kv.Key, "Guid", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(kv.Key, "ID", StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(kv.Key, "RowStatus", StringComparison.OrdinalIgnoreCase)
                         && !string.IsNullOrWhiteSpace(kv.Value?.ToString()))
            .Take(2)
            .Select(kv => kv.Value!.ToString()));

        if (!string.IsNullOrWhiteSpace(label))
            return label;

        return dictionary.TryGetValue("Guid", out var guid) ? guid?.ToString() ?? "Record" : "Record";
    }

    public void Dispose()
    {
        _cancellation?.Cancel();
        _cancellation?.Dispose();
    }


    private Guid GetRecordGuidFromSelection(ExpandoObject selection)
    {
        if (selection == null)
            return Guid.Empty;

        var dictionary = selection as IDictionary<string, object>;
        if (dictionary != null && dictionary.ContainsKey("Guid"))
        {
            return PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(dictionary["Guid"]?.ToString() ?? string.Empty);
        }

        return Guid.Empty;
    }

    private void CloseModal()
    {
        CloseWindow.InvokeAsync();
        GridUpdated.InvokeAsync();
        StateHasChanged();
    }
    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (ParentDataObjectReference != null)
            {
                ParentDataObjectReference = JsonConvert.DeserializeObject<DataObjectReference>(HttpUtility.UrlDecode(SerializedDataObjectReference) ?? string.Empty);
                await ParentDataObjectReferenceChanged.InvokeAsync(ParentDataObjectReference);
            }
            _EntityTypeGuid = EntityTypeGuid.ToString();

            // Filter entity properties to show only relevant ones
            await FilterEntityProperties();

            await base.OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while setting the parameters for the Bulk Record Change page.");
            ex.Data.Add("PageMethod", "BulkRecordChange/OnParametersSetAsync()");
            _ = OnError.InvokeAsync(ex);
        }
    }

    private async Task FilterEntityProperties()
    {
        try
        {
            // Use FormHelper to get entity type properties
            var formHelper = new API.Client.FormHelper(coreClient, _EntityTypeGuid, userService);
            EntityTypeProperties = await formHelper.GetEntityType();

            // List of property GUIDs that are allowed for bulk changes
            List<string> fieldsToShow = new()
            {
                "5bb14d82-b4b4-492e-968a-57e3a8b78596", // TypeGuid
                "0e46fceb-ac8c-4800-9ddc-367d8ad9769c", // AssigneeGuid
                "4014840f-b27e-48b3-8ae4-e700fb4988ba"  // StatusGuid
            };

            // Filter the entity properties based on AllowBulkChange or specific GUIDs
            filteredEntityProperties = EntityTypeProperties.EntityProperties
                .Where(x => x.AllowBulkChange == true || fieldsToShow.Contains(x.Guid.ToString()))
                .ToList();

            // Optionally, load the data object if needed
            //dataObject = await formHelper.ReadDataObjectAsync(RecordGuid, ParentDataObjectReference);
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while filtering entity properties for the Bulk Record Change page.");
            ex.Data.Add("PageMethod", "BulkRecordChange/FilterEntityProperties()");
            _ = OnError.InvokeAsync(ex);
        }
    }

    public async void HandleInputUpdated(InputUpdatedArgs inputUpdatedArgs)
    {
        try
        {
            var entityGuid = inputUpdatedArgs.EntityId.ToString();
            var newValue = inputUpdatedArgs.NewValue;
            var typeUrl = newValue.TypeUrl;

            // Determine if the key already exists in the dictionary
            if (ValuesToSet.ContainsKey(entityGuid))
            {
                // Update the existing value
                ValuesToSet[entityGuid] = newValue;
            }
            else
            {
                // Add a new value
                ValuesToSet.Add(entityGuid, newValue);
            }

            // Handle specific types for unpacking or validation
            switch (typeUrl)
            {
                case "type.googleapis.com/google.protobuf.Timestamp":
                    if (newValue.TryUnpack(out Timestamp timestampValue))
                    {
                        Console.WriteLine($"Timestamp unpacked: {timestampValue}");
                    }
                    break;

                case "type.googleapis.com/google.protobuf.Int32Value":
                    if (newValue.TryUnpack(out Int32Value int32Value))
                    {
                        Console.WriteLine($"Int32 unpacked: {int32Value.Value}");
                    }
                    break;

                case "type.googleapis.com/google.protobuf.Int64Value":
                    if (newValue.TryUnpack(out Int64Value int64Value))
                    {
                        Console.WriteLine($"Int64 unpacked: {int64Value.Value}");
                    }
                    break;

                case "type.googleapis.com/google.protobuf.StringValue":
                    if (newValue.TryUnpack(out StringValue stringValueObj))
                    {
                        Console.WriteLine($"String unpacked: {stringValueObj.Value}");
                    }
                    break;

                case "type.googleapis.com/google.protobuf.BoolValue":
                    if (newValue.TryUnpack(out BoolValue boolValue))
                    {
                        Console.WriteLine($"Boolean unpacked: {boolValue.Value}");
                    }
                    break;

                case "type.googleapis.com/google.protobuf.DoubleValue":
                    if (newValue.TryUnpack(out DoubleValue doubleValue))
                    {
                        Console.WriteLine($"Double unpacked: {doubleValue.Value}");
                    }
                    break;

                case "type.googleapis.com/google.protobuf.FloatValue":
                    if (newValue.TryUnpack(out FloatValue floatValue))
                    {
                        Console.WriteLine($"Float unpacked: {floatValue.Value}");
                    }
                    break;

                case "type.googleapis.com/google.protobuf.BytesValue":
                    if (newValue.TryUnpack(out BytesValue bytesValue))
                    {
                        Console.WriteLine($"Bytes unpacked: {BitConverter.ToString(bytesValue.Value.ToByteArray())}");
                    }
                    break;

                default:
                    // Treat unhandled types as strings
                    var defaultValue = newValue.Value.ToStringUtf8();
                    Console.WriteLine($"Unhandled type treated as string: {defaultValue}");

                    // Update ValuesToSet with the string value
                    ValuesToSet[entityGuid] = new Any
                        {
                            Value = ByteString.CopyFromUtf8(defaultValue)
                        };
                    break;
            }

            // Rebind properties in the UI to reflect changes
            FlexPropertyGroup.RebindFromPropertyChange(inputUpdatedArgs);

            Console.WriteLine("Updated ValuesToSet:");
            foreach (var value in ValuesToSet)
            {
                Console.WriteLine($"Key: {value.Key}, Value: {value.Value}");
            }
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while handling input updates.");
            ex.Data.Add("PageMethod", "HandleInputUpdated");
            await OnError.InvokeAsync(ex);
        }
    }




}
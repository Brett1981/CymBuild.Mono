@page "/kafkatest"
@inject IHttpClientFactory HttpClientFactory

<section class="cb-v2-page cb-native-dev-page">
    <div class="cb-v2-card cb-native-dev-card">
        <div class="cb-v2-card-body">
            <div class="cb-v2-panel-header cb-native-dev-header">
                <div class="cb-native-dev-title-wrap">
                    <div class="cb-v2-icon-wrap"><i class="bi bi-send"></i></div>
                    <div>
                        <h3 class="cb-v2-title mb-1">Kafka Test Publisher</h3>
                        <div class="cb-v2-description">Send a test customer transaction message, then review recent transaction records.</div>
                    </div>
                </div>
            </div>

            <EditForm Model="@testModel" OnValidSubmit="@SendToKafka" class="cb-native-dev-form mt-3">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="cb-native-dev-form-grid">
                    <div class="cb-native-dev-field">
                        <label for="sourceTransactionId">Transaction ID</label>
                        <InputText id="sourceTransactionId" class="form-control" @bind-Value="testModel.SourceTransactionId" />
                    </div>

                    <div class="cb-native-dev-field">
                        <label for="customerAccountNumber">Customer No</label>
                        <InputText id="customerAccountNumber" class="form-control" @bind-Value="testModel.CustomerAccountNumber" />
                    </div>

                    <div class="cb-native-dev-field">
                        <label for="customerAccountName">Customer Name</label>
                        <InputText id="customerAccountName" class="form-control" @bind-Value="testModel.CustomerAccountName" />
                    </div>

                    <div class="cb-native-dev-field">
                        <label for="externalReferenceId">External Ref</label>
                        <InputText id="externalReferenceId" class="form-control" @bind-Value="testModel.ExternalReferenceId" />
                    </div>
                </div>

                <div class="cb-native-dev-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send"></i>
                        Send
                    </button>
                </div>
            </EditForm>

            @if (!string.IsNullOrWhiteSpace(statusMessage))
            {
                <div class="mt-3 alert alert-info">@statusMessage</div>
            }
        </div>
    </div>

    <KafkaTransactionViewer />
</section>

@code {
    private TransactionModel testModel = new()
    {
        TransactionType = "V2CreateCustomers",
        SourceTransactionId = $"UI-{Guid.NewGuid():N}",
        ExternalReferenceId = "TEST-UI-001",
        CustomerAccountName = "Test UI Customer",
        CustomerAccountNumber = "TESTUI001"
    };

    private string statusMessage = string.Empty;

    private async Task SendToKafka()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("SageIntegrationAPI");
            var response = await client.PostAsJsonAsync("api/kafka/publish", testModel);

            statusMessage = response.IsSuccessStatusCode
                ? "Message sent to Kafka"
                : $"Failed: {response.StatusCode}";
        }
        catch (Exception ex)
        {
            statusMessage = $"Exception: {ex.Message}";
        }
    }

    public class TransactionModel
    {
        public string SourceTransactionId { get; set; } = string.Empty;
        public string TransactionType { get; set; } = "V2CreateCustomers";
        public string SageReference { get; set; } = string.Empty;
        public string ExternalReferenceId { get; set; } = string.Empty;
        public string CustomerAccountName { get; set; } = string.Empty;
        public string CustomerAccountNumber { get; set; } = string.Empty;
    }
}

@using Concursus.API.Client.Models
@using Concursus.PWA.Helpers
@using System.Globalization
@using System.Text
@inject Core.CoreClient coreClient
@inject UserService userService
@inject IJSRuntime JSRuntime

<section class="usage-dashboard cb-v2-stack" aria-labelledby="usage-dashboard-title">
    <header class="usage-dashboard-header cb-v2-card cb-v2-panel-body cb-v2-header-row">
        <div>
            <p class="usage-dashboard-eyebrow cb-v2-eyebrow">@(ActiveReport == UsageReportMode.LastSevenDays ? "Management overview" : "Developer diagnostics")</p>
            <h3 id="usage-dashboard-title">System Usage Analytics</h3>
            <p>@(ActiveReport == UsageReportMode.LastSevenDays ? "A concise view of CymBuild engagement by user." : "Review feature adoption and activity for the selected reporting period.")</p>
        </div>
        <div class="usage-dashboard-actions cb-v2-actions">
            <button type="button" class="btn btn-outline-primary" @onclick="ExportToCSV" disabled="@(!CurrentReportHasData)">
                <i class="bi bi-filetype-csv" aria-hidden="true"></i> Export CSV
            </button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ExportToPDF" disabled="@(!CurrentReportHasData)">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i> Export PDF
            </button>
        </div>
    </header>

    <div class="usage-report-switcher cb-v2-card" role="group" aria-label="Usage report type">
        <button type="button"
                class="@(ActiveReport == UsageReportMode.LastSevenDays ? "active" : null)"
                aria-pressed="@(ActiveReport == UsageReportMode.LastSevenDays)"
                @onclick="ShowLastSevenDaysReport">
            Last 7 days by user
        </button>
        <button type="button"
                class="@(ActiveReport == UsageReportMode.Detailed ? "active" : null)"
                aria-pressed="@(ActiveReport == UsageReportMode.Detailed)"
                @onclick="ShowDetailedReport">
            Detailed usage
        </button>
    </div>

    @if (ActiveReport == UsageReportMode.Detailed)
    {
    <div class="usage-filter-panel cb-v2-card cb-v2-panel-body">
        <div class="usage-filter-field cb-v2-field">
            <label for="usage-start-date">Start date</label>
            <input id="usage-start-date" class="form-control" type="date" value="@StartDate.ToString("yyyy-MM-dd")" @onchange="OnStartDateChanged" />
        </div>
        <div class="usage-filter-field cb-v2-field">
            <label for="usage-end-date">End date</label>
            <input id="usage-end-date" class="form-control" type="date" value="@EndDate.ToString("yyyy-MM-dd")" @onchange="OnEndDateChanged" />
        </div>
        <div class="usage-filter-field usage-filter-user cb-v2-field">
            <label for="usage-user">User</label>
            <select id="usage-user" class="form-select" value="@SelectedUserGuid" @onchange="OnUserChanged">
                <option value="">All users</option>
                @foreach (var item in Users)
                {
                    <option value="@item.UserGuid">@item.Username</option>
                }
            </select>
        </div>
        <div class="usage-filter-buttons cb-v2-actions">
            <button type="button" class="btn btn-primary" @onclick="FetchUsageReport" disabled="@IsLoading">Apply</button>
            <button type="button" class="btn btn-outline-secondary" @onclick="ResetFilters" disabled="@IsLoading">Reset</button>
        </div>
    </div>
    }

    @if (!string.IsNullOrWhiteSpace(ValidationMessage))
    {
        <div class="alert alert-warning py-2" role="alert">@ValidationMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger py-2" role="alert">@ErrorMessage</div>
    }

    @if (IsLoading)
    {
        <div class="usage-loading cb-v2-loading-state" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            Loading usage analytics...
        </div>
    }
    else if (ActiveReport == UsageReportMode.LastSevenDays)
    {
        <div class="usage-summary-grid">
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">Active users</span><strong class="cb-v2-stat-value">@UserUsageLast7Days.Count(x => x.UsageCountLast7Days > 0).ToString("N0")</strong></article>
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">Usage events</span><strong class="cb-v2-stat-value">@UserUsageLast7Days.Sum(x => x.UsageCountLast7Days).ToString("N0")</strong></article>
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">Active accounts</span><strong class="cb-v2-stat-value">@UserUsageLast7Days.Count.ToString("N0")</strong></article>
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">No activity</span><strong class="cb-v2-stat-value">@UserUsageLast7Days.Count(x => x.UsageCountLast7Days == 0).ToString("N0")</strong></article>
        </div>

        @if (UserUsageLast7Days.Any())
        {
            <section class="usage-panel usage-table-panel cb-v2-card cb-v2-panel-body" aria-labelledby="user-usage-results-title">
                <div class="usage-panel-heading cb-v2-panel-header">
                    <div>
                        <h4 id="user-usage-results-title">User engagement</h4>
                        <p>High-level activity for today and the preceding six calendar days, in UTC.</p>
                    </div>
                </div>
                <div class="table-responsive cb-v2-table-wrap">
                    <table class="table table-hover align-middle usage-table">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th class="text-end">Events</th>
                                <th class="text-end">Active days</th>
                                <th class="text-end">Features used</th>
                                <th>Last activity</th>
                                <th>Compared with prior 7 days</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in UserUsageLast7Days.OrderByDescending(x => x.UsageCountLast7Days).ThenBy(x => x.Username))
                            {
                                <tr>
                                    <td>@item.Username</td>
                                    <td class="text-end">@item.UsageCountLast7Days.ToString("N0")</td>
                                    <td class="text-end">@item.ActiveDaysLast7Days of 7</td>
                                    <td class="text-end">@item.FeaturesUsedLast7Days.ToString("N0")</td>
                                    <td>@FormatLastActivity(item)</td>
                                    <td><span class="usage-trend @GetTrendClass(item.UsageTrend)">@item.UsageTrend</span></td>
                                    <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ShowUserDetail(item.UserGuid)">View detail</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else
        {
            <div class="usage-empty-state cb-v2-empty-state cb-v2-card">No active users are available for this report.</div>
        }
    }
    else
    {
        <div class="usage-summary-grid">
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">Events</span><strong class="cb-v2-stat-value">@UsageReport.Sum(x => x.UsageCount).ToString("N0")</strong></article>
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">Features</span><strong class="cb-v2-stat-value">@FeatureSummaries.Count.ToString("N0")</strong></article>
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">Users</span><strong class="cb-v2-stat-value">@UsageReport.Select(x => x.Username).Distinct().Count().ToString("N0")</strong></article>
            <article class="cb-v2-stat-card"><span class="cb-v2-stat-label">Rows</span><strong class="cb-v2-stat-value">@UsageReport.Count.ToString("N0")</strong></article>
        </div>

        @if (UsageReport.Any())
        {
            <div class="usage-chart-grid">
                <section class="usage-panel cb-v2-card cb-v2-panel-body" aria-labelledby="feature-bar-title">
                    <div class="usage-panel-heading cb-v2-panel-header">
                        <div>
                            <h4 id="feature-bar-title">Feature usage</h4>
                            <p>Select a feature to drill into its records.</p>
                        </div>
                        @if (IsFeatureDrillDown)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetUsageReport">Reset view</button>
                        }
                    </div>
                    <div class="usage-bars">
                        @foreach (var feature in FeatureSummaries)
                        {
                            <button type="button" class="usage-bar-row" @onclick="() => FilterByFeature(feature.FeatureName)" title="View @feature.FeatureName records">
                                <span class="usage-bar-label">@feature.FeatureName</span>
                                <span class="usage-bar-track"><span class="usage-bar-fill" style="width: @FormatPercent(feature.BarPercent)"></span></span>
                                <strong>@feature.UsageCount.ToString("N0")</strong>
                            </button>
                        }
                    </div>
                </section>

                <section class="usage-panel cb-v2-card cb-v2-panel-body" aria-labelledby="feature-share-title">
                    <div class="usage-panel-heading cb-v2-panel-header">
                        <div>
                            <h4 id="feature-share-title">Feature share</h4>
                            <p>Usage distribution across the current result set.</p>
                        </div>
                    </div>
                    <div class="usage-share-layout">
                        <svg class="usage-donut" viewBox="0 0 100 100" role="img" aria-label="Feature usage distribution">
                            <circle class="usage-donut-background" cx="50" cy="50" r="34" pathLength="100"></circle>
                            @foreach (var feature in FeatureSummaries)
                            {
                                <circle class="usage-donut-segment"
                                        cx="50" cy="50" r="34" pathLength="100"
                                        stroke="@feature.Colour"
                                        stroke-dasharray="@FormatDashArray(feature.SharePercent)"
                                        stroke-dashoffset="@FormatNumber(-feature.OffsetPercent)"
                                        @onclick="() => FilterByFeature(feature.FeatureName)">
                                    <title>@feature.FeatureName: @feature.UsageCount.ToString("N0") (@FormatPercent(feature.SharePercent))</title>
                                </circle>
                            }
                            <text x="50" y="48" text-anchor="middle">Total</text>
                            <text class="usage-donut-total" x="50" y="59" text-anchor="middle">@UsageReport.Sum(x => x.UsageCount).ToString("N0")</text>
                        </svg>
                        <div class="usage-legend">
                            @foreach (var feature in FeatureSummaries)
                            {
                                <button type="button" @onclick="() => FilterByFeature(feature.FeatureName)">
                                    <span class="usage-legend-colour" style="background-color: @feature.Colour"></span>
                                    <span>@feature.FeatureName</span>
                                    <strong>@FormatPercent(feature.SharePercent)</strong>
                                </button>
                            }
                        </div>
                    </div>
                </section>
            </div>

            <section class="usage-panel usage-table-panel cb-v2-card cb-v2-panel-body" aria-labelledby="usage-results-title">
                <div class="usage-panel-heading cb-v2-panel-header">
                    <div>
                        <h4 id="usage-results-title">Usage records</h4>
                        <p>Showing @FirstVisibleRow-@LastVisibleRow of @SortedUsageReport.Count records.</p>
                    </div>
                    <label class="usage-page-size">Rows per page
                        <select class="form-select form-select-sm" value="@PageSize" @onchange="OnPageSizeChanged">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </label>
                </div>
                <div class="table-responsive cb-v2-table-wrap">
                    <table class="table table-hover align-middle usage-table">
                        <thead>
                            <tr>
                                <th><button type="button" class="cb-v2-sort-button" @onclick="() => SetSort(UsageSort.Username)">User @SortIndicator(UsageSort.Username)</button></th>
                                <th><button type="button" class="cb-v2-sort-button" @onclick="() => SetSort(UsageSort.FeatureName)">Feature @SortIndicator(UsageSort.FeatureName)</button></th>
                                <th class="text-end"><button type="button" class="cb-v2-sort-button" @onclick="() => SetSort(UsageSort.UsageCount)">Usage @SortIndicator(UsageSort.UsageCount)</button></th>
                                <th class="text-end"><button type="button" class="cb-v2-sort-button" @onclick="() => SetSort(UsageSort.WeeklyAverage)">Weekly avg @SortIndicator(UsageSort.WeeklyAverage)</button></th>
                                <th><button type="button" class="cb-v2-sort-button" @onclick="() => SetSort(UsageSort.FirstAccessed)">First accessed @SortIndicator(UsageSort.FirstAccessed)</button></th>
                                <th><button type="button" class="cb-v2-sort-button" @onclick="() => SetSort(UsageSort.LastAccessed)">Last accessed @SortIndicator(UsageSort.LastAccessed)</button></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedUsageReport)
                            {
                                <tr>
                                    <td>@item.Username</td>
                                    <td>@item.FeatureName</td>
                                    <td class="text-end">@item.UsageCount.ToString("N0")</td>
                                    <td class="text-end">@item.WeeklyAverage</td>
                                    <td>@item.FirstAccessed</td>
                                    <td>@item.LastAccessed</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <nav class="usage-pagination cb-v2-table-footer" aria-label="Usage records pagination">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="PreviousPage" disabled="@(CurrentPage <= 1)">Previous</button>
                    <span>Page @CurrentPage of @TotalPages</span>
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(CurrentPage >= TotalPages)">Next</button>
                </nav>
            </section>
        }
        else
        {
            <div class="usage-empty-state cb-v2-empty-state cb-v2-card">No usage records match the selected filters.</div>
        }
    }
</section>

@code {
    private static readonly string[] ChartColours = ["#2563eb", "#16a34a", "#f59e0b", "#dc2626", "#7c3aed", "#0891b2", "#db2777", "#4f46e5", "#65a30d", "#ea580c"];
    private List<UsageData> UsageReport = [];
    private List<UsageData> OriginalUsageReport = [];
    private List<UserUsageLast7DaysData> UserUsageLast7Days = [];
    private List<UserItem> Users = [];
    private DateTime StartDate = DateTime.UtcNow.AddDays(-30).Date;
    private DateTime EndDate = DateTime.UtcNow.Date;
    private string? SelectedUserGuid;
    private string? ValidationMessage;
    private string? ErrorMessage;
    private bool IsLoading;
    private int CurrentPage = 1;
    private int PageSize = 20;
    private UsageSort ActiveSort = UsageSort.UsageCount;
    private bool SortDescending = true;
    private UsageReportMode ActiveReport = UsageReportMode.LastSevenDays;
    private API.Client.FormHelper? _formHelper;

    private API.Client.FormHelper FormHelper =>
        _formHelper ?? throw new InvalidOperationException("FormHelper has not been initialised.");
    private bool CurrentReportHasData => ActiveReport == UsageReportMode.LastSevenDays
        ? UserUsageLast7Days.Any()
        : UsageReport.Any();

    private bool IsFeatureDrillDown => UsageReport.Count != OriginalUsageReport.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(SortedUsageReport.Count / (double)PageSize));
    private int FirstVisibleRow => SortedUsageReport.Count == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int LastVisibleRow => Math.Min(CurrentPage * PageSize, SortedUsageReport.Count);
    private List<UsageData> PagedUsageReport => SortedUsageReport.Skip((CurrentPage - 1) * PageSize).Take(PageSize).ToList();

    private List<UsageData> SortedUsageReport => (ActiveSort, SortDescending) switch
    {
        (UsageSort.Username, false) => UsageReport.OrderBy(x => x.Username).ThenBy(x => x.FeatureName).ToList(),
        (UsageSort.Username, true) => UsageReport.OrderByDescending(x => x.Username).ThenBy(x => x.FeatureName).ToList(),
        (UsageSort.FeatureName, false) => UsageReport.OrderBy(x => x.FeatureName).ThenBy(x => x.Username).ToList(),
        (UsageSort.FeatureName, true) => UsageReport.OrderByDescending(x => x.FeatureName).ThenBy(x => x.Username).ToList(),
        (UsageSort.UsageCount, false) => UsageReport.OrderBy(x => x.UsageCount).ToList(),
        (UsageSort.UsageCount, true) => UsageReport.OrderByDescending(x => x.UsageCount).ToList(),
        (UsageSort.WeeklyAverage, false) => UsageReport.OrderBy(x => x.WeeklyAverage).ToList(),
        (UsageSort.WeeklyAverage, true) => UsageReport.OrderByDescending(x => x.WeeklyAverage).ToList(),
        (UsageSort.FirstAccessed, false) => UsageReport.OrderBy(x => ParseUsageDate(x.FirstAccessed)).ToList(),
        (UsageSort.FirstAccessed, true) => UsageReport.OrderByDescending(x => ParseUsageDate(x.FirstAccessed)).ToList(),
        (UsageSort.LastAccessed, false) => UsageReport.OrderBy(x => ParseUsageDate(x.LastAccessed)).ToList(),
        _ => UsageReport.OrderByDescending(x => ParseUsageDate(x.LastAccessed)).ToList()
    };

    private List<FeatureSummary> FeatureSummaries
    {
        get
        {
            var grouped = UsageReport.GroupBy(x => x.FeatureName)
                .Select(x => new { FeatureName = x.Key, UsageCount = x.Sum(y => y.UsageCount) })
                .OrderByDescending(x => x.UsageCount)
                .ToList();
            var total = grouped.Sum(x => x.UsageCount);
            var maximum = grouped.Count == 0 ? 0 : grouped.Max(x => x.UsageCount);
            var offset = 0d;
            return grouped.Select((x, index) =>
            {
                var share = total == 0 ? 0 : x.UsageCount * 100d / total;
                var result = new FeatureSummary(x.FeatureName, x.UsageCount, maximum == 0 ? 0 : x.UsageCount * 100d / maximum, share, offset, ChartColours[index % ChartColours.Length]);
                offset += share;
                return result;
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _formHelper = new API.Client.FormHelper(coreClient, Guid.Empty.ToString(), userService);
        await LoadUsers();
        await FetchUserUsageLast7Days();
    }

    private async Task LoadUsers()
    {
        try
        {
            var response = await FormHelper.GetUsageReportUsersAsync();
            Users = response.Select(x => new UserItem { UserGuid = x.Guid, Username = x.FullName }).OrderBy(x => x.Username).ToList();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Users could not be loaded: {ex.Message}";
        }
    }

    private async Task FetchUsageReport()
    {
        if (!ValidateDates()) return;
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var request = new UsageReportRequest
            {
                Days = Math.Max(1, (EndDate - StartDate).Days),
                UserGuid = SelectedUserGuid ?? string.Empty,
                StartDateUtc = UiFormattingHelper.ToTimestamp(StartDate),
                EndDateUtc = UiFormattingHelper.ToTimestamp(EndDate.AddDays(1).AddTicks(-1))
            };
            OriginalUsageReport = await FormHelper.GetUsageReportAsync(request);
            UsageReport = OriginalUsageReport.ToList();
            CurrentPage = 1;
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Usage analytics could not be loaded: {ex.Message}";
            OriginalUsageReport = [];
            UsageReport = [];
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task FetchUserUsageLast7Days()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            UserUsageLast7Days = await FormHelper.GetUserUsageLast7DaysAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"The seven-day user usage report could not be loaded: {ex.Message}";
            UserUsageLast7Days = [];
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ShowLastSevenDaysReport()
    {
        ActiveReport = UsageReportMode.LastSevenDays;
        if (!UserUsageLast7Days.Any()) await FetchUserUsageLast7Days();
    }

    private async Task ShowDetailedReport()
    {
        ActiveReport = UsageReportMode.Detailed;
        if (!UsageReport.Any()) await FetchUsageReport();
    }

    private async Task ShowUserDetail(string userGuid)
    {
        SelectedUserGuid = userGuid;
        ActiveReport = UsageReportMode.Detailed;
        await FetchUsageReport();
    }

    private bool ValidateDates()
    {
        ValidationMessage = EndDate < StartDate ? "End date cannot be before start date." : null;
        return ValidationMessage is null;
    }

    private async Task OnStartDateChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var value)) StartDate = value.Date;
        if (ValidateDates()) await FetchUsageReport();
    }

    private async Task OnEndDateChanged(ChangeEventArgs args)
    {
        if (DateTime.TryParse(args.Value?.ToString(), CultureInfo.InvariantCulture, DateTimeStyles.None, out var value)) EndDate = value.Date;
        if (ValidateDates()) await FetchUsageReport();
    }

    private async Task OnUserChanged(ChangeEventArgs args)
    {
        SelectedUserGuid = args.Value?.ToString();
        await FetchUsageReport();
    }

    private async Task ResetFilters()
    {
        StartDate = DateTime.UtcNow.AddDays(-30).Date;
        EndDate = DateTime.UtcNow.Date;
        SelectedUserGuid = null;
        await FetchUsageReport();
    }

    private void FilterByFeature(string featureName)
    {
        UsageReport = OriginalUsageReport.Where(x => x.FeatureName == featureName).ToList();
        CurrentPage = 1;
    }

    private void ResetUsageReport()
    {
        UsageReport = OriginalUsageReport.ToList();
        CurrentPage = 1;
    }

    private void SetSort(UsageSort sort)
    {
        if (ActiveSort == sort) SortDescending = !SortDescending;
        else { ActiveSort = sort; SortDescending = false; }
        CurrentPage = 1;
    }

    private string SortIndicator(UsageSort sort) => ActiveSort != sort ? string.Empty : SortDescending ? "↓" : "↑";
    private void PreviousPage() => CurrentPage = Math.Max(1, CurrentPage - 1);
    private void NextPage() => CurrentPage = Math.Min(TotalPages, CurrentPage + 1);

    private void OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value)) PageSize = value;
        CurrentPage = 1;
    }

    private async Task ExportToCSV()
    {
        if (ActiveReport == UsageReportMode.LastSevenDays)
        {
            var summaryCsv = new StringBuilder("Username,UsageCountLast7Days,ActiveDaysLast7Days,FeaturesUsedLast7Days,LastAccessedLast7Days,UsageCountPrevious7Days,UsageTrend\r\n");
            foreach (var item in UserUsageLast7Days.OrderByDescending(x => x.UsageCountLast7Days).ThenBy(x => x.Username))
            {
                summaryCsv.AppendLine(string.Join(',', Csv(item.Username), item.UsageCountLast7Days, item.ActiveDaysLast7Days, item.FeaturesUsedLast7Days, Csv(FormatLastActivity(item)), item.UsageCountPrevious7Days, Csv(item.UsageTrend)));
            }
            await JSRuntime.InvokeVoidAsync("downloadFile", "UserUsageLast7Days.csv", $"data:text/csv;charset=utf-8,{Uri.EscapeDataString(summaryCsv.ToString())}");
            return;
        }

        var csv = new StringBuilder("Username,FeatureName,UsageCount,WeeklyAverage,FirstAccessed,LastAccessed\r\n");
        foreach (var item in UsageReport)
        {
            csv.AppendLine(string.Join(',', Csv(item.Username), Csv(item.FeatureName), item.UsageCount, item.WeeklyAverage, Csv(item.FirstAccessed?.ToString()), Csv(item.LastAccessed?.ToString())));
        }
        await JSRuntime.InvokeVoidAsync("downloadFile", "UsageReport.csv", $"data:text/csv;charset=utf-8,{Uri.EscapeDataString(csv.ToString())}");
    }

    private async Task ExportToPDF()
    {
        if (ActiveReport == UsageReportMode.LastSevenDays)
        {
            var summary = "CymBuild user usage - last 7 days\n\n" + string.Join("\n", UserUsageLast7Days.OrderByDescending(x => x.UsageCountLast7Days).Select(x => $"{x.Username}: {x.UsageCountLast7Days:N0} events across {x.ActiveDaysLast7Days} days and {x.FeaturesUsedLast7Days} features; {x.UsageTrend}."));
            await JSRuntime.InvokeVoidAsync("downloadFile", "UserUsageLast7Days.pdf", $"data:text/plain;charset=utf-8,{Uri.EscapeDataString(summary)}");
            return;
        }

        var content = "System Usage Report\n\n" + string.Join("\n", UsageReport.Select(x => $"{x.Username} - {x.FeatureName}: First Accessed: {x.FirstAccessed} - {x.UsageCount} times (Last Accessed: {x.LastAccessed}) - Weekly Average: {x.WeeklyAverage}"));
        await JSRuntime.InvokeVoidAsync("downloadFile", "UsageReport.pdf", $"data:text/plain;charset=utf-8,{Uri.EscapeDataString(content)}");
    }

    private static string Csv(string? value) => $"\"{(value ?? string.Empty).Replace("\"", "\"\"")}\"";
    private static DateTime ParseUsageDate(string? value) => DateTime.TryParse(value, out var result) ? result : DateTime.MinValue;
    private static string FormatPercent(double value) => $"{FormatNumber(value)}%";
    private static string FormatNumber(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string FormatDashArray(double value) => $"{FormatNumber(value)} {FormatNumber(Math.Max(0, 100 - value))}";
    private static string FormatLastActivity(UserUsageLast7DaysData item) =>
        item.LastAccessedLast7Days is null ? "No activity" : item.LastAccessedLast7Days.ToDateTime().ToString("dd MMM yyyy HH:mm", CultureInfo.InvariantCulture);
    private static string GetTrendClass(string trend) => trend.Replace(" ", "-").ToLowerInvariant();

    private enum UsageReportMode { LastSevenDays, Detailed }
    private enum UsageSort { Username, FeatureName, UsageCount, WeeklyAverage, FirstAccessed, LastAccessed }
    private sealed record FeatureSummary(string FeatureName, int UsageCount, double BarPercent, double SharePercent, double OffsetPercent, string Colour);
    private sealed class UserItem { public string UserGuid { get; set; } = string.Empty; public string Username { get; set; } = string.Empty; }
}

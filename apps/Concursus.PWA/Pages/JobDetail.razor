    private string GetJobSummaryCardCss(JobSummaryCardKind kind)
    {
        var variant = kind switch
        {
            JobSummaryCardKind.CurrentStatus => GetCurrentStatusSummaryVariant(),
            JobSummaryCardKind.OpenItems => GetOpenItemsSummaryVariant(),
            JobSummaryCardKind.FinancialOverview => GetFinancialSummaryVariant(),
            JobSummaryCardKind.InvoiceRequests => GetInvoiceRequestsSummaryVariant(),
            _ => "neutral"
        };

        return $"card shadow-sm h-100 cb-job-summary-card cb-job-summary-card--{variant}";
    }

    private string GetCurrentStatusSummaryVariant()
    {
        var status = _jobSummary?.CurrentStatusName?.Trim();
        if (string.IsNullOrWhiteSpace(status)) return "neutral";

        // Explicit mappings for the current Job workflow statuses.
        // Unknown/local statuses intentionally fall back to neutral unless a safe
        // keyword match below can infer the intent.
        var statusKey = status.ToUpperInvariant();
        var exactVariant = statusKey switch
        {
            "N/A" => "neutral",
            "TEST STATUS" => "neutral",

            "NOT STARTED" => "new",
            "NEW" => "new",
            "REOPENED" => "new",

            "LIVE" => "active",
            "JOB STARTED" => "active",

            "DORMANT" => "dormant",

            "CLOSURE REQUEST" => "review",
            "COMPLETE FOR REVIEW" => "review",

            "QUOTE EXPIRED" => "warning",

            "PART ACCEPTED" => "success",
            "REVIEWED" => "success",
            "COMPLETED" => "success",
            "APPROVE CLOSURE" => "success",

            "CANCELLED" => "danger",
            "DEAD" => "danger",
            "CLOSURE REJECTED" => "danger",

            _ => null
        };

        if (!string.IsNullOrWhiteSpace(exactVariant)) return exactVariant;

        var normalised = status.ToLowerInvariant();

        if (ContainsAny(normalised, "cancel", "dead", "declin", "reject", "failed", "lost")) return "danger";
        if (ContainsAny(normalised, "complete", "completed", "accepted", "approved", "reviewed", "won")) return "success";
        if (ContainsAny(normalised, "closure", "review", "approval", "authoris")) return "review";
        if (ContainsAny(normalised, "pending", "await", "expired", "hold", "paused", "dormant")) return "warning";
        if (ContainsAny(normalised, "sent", "submit", "issued")) return "info";
        if (ContainsAny(normalised, "new", "open", "reopen", "not started")) return "new";
        if (ContainsAny(normalised, "live", "started", "progress", "active", "work", "quoting")) return "active";

        return "neutral";
    }
    private string GetOpenItemsSummaryVariant()
    {
        if (_jobSummary is null) return "neutral";

        var openCount = _jobSummary.OpenMilestoneCount + _jobSummary.OpenActivityCount + _jobSummary.OpenActionCount;
        return openCount <= 0 ? "success" : "warning";
    }

    private string GetFinancialSummaryVariant()
    {
        if (_jobSummary is null) return "neutral";

        var financial = _jobSummary.FinancialOverview;
        if (financial.AgreedFeeIncludingCap <= 0) return "neutral";
        if (financial.InvoicedNet <= 0) return "warning";
        if (financial.InvoicedNet >= financial.AgreedFeeIncludingCap) return "success";

        return "info";
    }

    private string GetInvoiceRequestsSummaryVariant()
    {
        if (_jobSummary is null) return "neutral";

        var financial = _jobSummary.FinancialOverview;
        if (financial.BlockedInvoiceRequestCount > 0 || financial.ReconciliationRequiredInvoiceRequestCount > 0) return "danger";
        if (_jobSummary.PendingInvoiceRequestCount > 0 || financial.InvoiceRequestPendingTotal > 0) return "warning";

        return "success";
    }

    private static bool ContainsAny(string value, params string[] tokens)
    {
        foreach (var token in tokens)
        {
            if (value.Contains(token, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }


            EnsureFormHelper();

            await base.OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while setting parameters for the Job Detail page.");
            ex.Data.Add("PageMethod", "JobDetail/OnParametersSetAsync()");
            _ = OnError.InvokeAsync(ex);
        }
    }



    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender) return;

        try
        {
            EnsureFormHelper();
            if (_formHelper is null) return;
            if (!Guid.TryParse(RecordGuid, out var jobGuid) || jobGuid == Guid.Empty) return;

            _currentMode = await _formHelper.JobInvoiceProcessingModeGetAsync(jobGuid);
            _selectedMode = _currentMode;
            await RefreshJobSummaryAsync(updateReplacementScheduleButton: true);

            Console.WriteLine($"[CymBuildPerf] Layer=UI Method=JobDetail Step=FirstRenderComplete DurationMs={_jobDetailInitialLoadStopwatch.ElapsedMilliseconds}");
            StateHasChanged();
        }
        catch
        {
            // Non-blocking
        }
    }


    private async Task OnJobDataObjectLoadedAsync(DataObject loadedDataObject)
    {
        try
        {
            ShowSubContractorGrid = true;

            if (loadedDataObject?.DataProperties == null || editPage?.entityProperties == null)
                return;

            var orgUnitPropertyGuid = editPage.entityProperties
                .FirstOrDefault(x => string.Equals(x.Name, "OrganisationalUnitID", StringComparison.OrdinalIgnoreCase))
                ?.Guid;

            if (string.IsNullOrWhiteSpace(orgUnitPropertyGuid))
                return;

            var orgUnitProperty = loadedDataObject.DataProperties
                .FirstOrDefault(x => string.Equals(x.EntityPropertyGuid, orgUnitPropertyGuid, StringComparison.OrdinalIgnoreCase));

            if (orgUnitProperty?.Value == null)
                return;

            var orgUnitValue = string.Empty;

            if (orgUnitProperty.Value.Is(StringValue.Descriptor))
            {
                orgUnitValue = orgUnitProperty.Value.Unpack<StringValue>().Value?.Trim() ?? string.Empty;
            }

            var excludedOrgUnits = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            "2C9489BD-EAE8-4703-90D7-56C94E802EDA", // CDM
            "A5068E63-B86B-4DF6-A0DF-4F8ACE9CF94A", // BRAC
            "0125329F-003B-4CE4-A2C9-8C6DCC1A4DFF",
            "F233BB03-3181-49AE-B331-39C58F328457",
            "830E1F3B-FD6A-4D98-BE41-CBB630F7EF1C"
        };

            ShowSubContractorGrid =
                string.IsNullOrWhiteSpace(orgUnitValue)
                || !excludedOrgUnits.Contains(orgUnitValue);

            await RefreshJobSummaryAsync(updateReplacementScheduleButton: true);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            ShowSubContractorGrid = true;
        }
    }


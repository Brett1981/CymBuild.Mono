    private Dictionary<string, Any> BuildInvoiceScheduleTransientVirtualProperties()
    {
        var result = new Dictionary<string, Any>(StringComparer.OrdinalIgnoreCase);

        if (TransientVirtualProperties is not null)
        {
            foreach (var item in TransientVirtualProperties)
            {
                result[item.Key] = item.Value;
            }
        }

        result[AllowAutomatedMonthlyDrawdownAmendmentKey] =
            Any.Pack(new BoolValue

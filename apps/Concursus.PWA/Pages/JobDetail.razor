    private Task CreateReplacementInvoiceScheduleAsync()
    {
        try
        {
            if (editPage?.MyDataObjectReference == null)
            {
                return Task.CompletedTask;
            }

            var parentGuid = Guid.Empty.ToString();

            var (parentDataObjectReference, serializedParentDataObjectReference) =
                PWAFunctions.ProcessDataObjectReference(
                    modalService,
                    editPage.MyDataObjectReference,
                    parentGuid,
                    "00000000-0000-0000-0000-000000000000");

            var encodedReturnUrl = System.Web.HttpUtility.UrlEncode(NavManager.Uri);

            var url =
                "InvoicingScheduleDetail/" +
                Guid.Empty + "/" +
                serializedParentDataObjectReference + "/" +
                encodedReturnUrl;

            NavManager.NavigateTo(url, forceLoad: false);

            return Task.CompletedTask;
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("PageMethod", "JobDetail/CreateReplacementInvoiceScheduleAsync()");
            _ = OnError.InvokeAsync(ex);
            return Task.CompletedTask;
        }
    }


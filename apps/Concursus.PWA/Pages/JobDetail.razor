    private async Task RefreshReplacementInvoiceScheduleButtonAsync()
    {
        try
        {
            ShowReplacementInvoiceScheduleButton = false;

            EnsureFormHelper();

            if (_formHelper is null || string.IsNullOrWhiteSpace(RecordGuid))
            {

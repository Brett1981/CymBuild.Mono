@page "/JobDetail/{RecordGuid}/{SerializedDataObjectReference}/{ReturnUrl}"

@using Google.Protobuf.WellKnownTypes
@using Microsoft.Extensions.Options
@using Newtonsoft.Json
@using Concursus.API.Client.Models
@using Concursus.API.Client.Models.JobPerformance
@using System.Web
@using System.Diagnostics
@using Concursus.PWA.Classes
@using Concursus.Components.Shared.Controls.Documents
@using static Concursus.API.Client.FormHelper

@inherits EditPageBase

@inject Core.CoreClient coreClient
@inject UserService userService
@inject NavigationManager NavManager
@inject RefreshService refreshService
@inject AppConfiguration appConfiguration
@inject ModalService modalService
@inject IOptions<ClientConfiguration> Config

@attribute [Authorize]

<EditPage @ref="@editPage"
          EntityTypeGuid="63542427-46ab-4078-abd1-1d583c24315c"
          Windowed="@Windowed"
          @bind-RecordGuid="@RecordGuid"
          ModalId="@ModalId"
          @bind-ParentDataObjectReference="@ParentDataObjectReference"
          ReturnUrl="@ReturnUrl"
          CloseWindow="@CloseWindow"
          IsDetailWindowed="IsDetailWindowed"
          InvoiceProcessingModeText="@GetModeLabel(_currentMode)"
          InvoiceProcessingModeCss="@GetModeCss(_currentMode)"
          InvoiceProcessingModeTooltip="Invoice automation mode for this job"
          EnableBrowserTabTitle="true"
          BrowserTabTitlePropertyName="Number"
          BrowserTabTitlePrefix="Job"
          PrepareStorageUrlOnInitialLoad="false"
          TransientVirtualProperties="@TransientVirtualProperties"
          DataObjectLoaded="@OnJobDataObjectLoadedAsync">
    <FormTitle>
        <i class="bi bi-briefcase-fill me-2" style="font-size: 1.2rem;"></i>
    </FormTitle>

    <FormBody>
        <div class="cb-native-tabstrip cb-job-detail-tabs">
            <div class="cb-native-tab-list" role="tablist" aria-label="Job detail tabs">
                <button type="button" class="@NativeTabButtonCss(JobDetailTab.Job)" role="tab" aria-selected="@IsNativeTabActive(JobDetailTab.Job)" @onclick="@(() => SelectNativeTab(JobDetailTab.Job))">
                    <i class="bi bi-briefcase"></i>
                    <span>Job</span>
                </button>

                <button type="button" class="@NativeTabButtonCss(JobDetailTab.Fees)" role="tab" aria-selected="@IsNativeTabActive(JobDetailTab.Fees)" @onclick="@(() => SelectNativeTab(JobDetailTab.Fees))">
                    <i class="bi bi-cash-stack"></i>
                    <span>Fees</span>
                </button>

                <button type="button" class="@NativeTabButtonCss(JobDetailTab.ProjectDetails)" role="tab" aria-selected="@IsNativeTabActive(JobDetailTab.ProjectDetails)" @onclick="@(() => SelectNativeTab(JobDetailTab.ProjectDetails))">
                    <i class="bi bi-journal-medical"></i>
                    <span>Project Details</span>
                </button>

                <button type="button" class="@NativeTabButtonCss(JobDetailTab.Milestones)" role="tab" aria-selected="@IsNativeTabActive(JobDetailTab.Milestones)" @onclick="@(() => SelectNativeTab(JobDetailTab.Milestones))">
                    <i class="bi bi-signpost-split-fill"></i>
                    <span>Milestones</span>
                </button>

                <button type="button" class="@NativeTabButtonCss(JobDetailTab.Activity)" role="tab" aria-selected="@IsNativeTabActive(JobDetailTab.Activity)" @onclick="@(() => SelectNativeTab(JobDetailTab.Activity))">
                    <i class="bi bi-activity"></i>
                    <span>Activities</span>
                </button>

                <button type="button" class="@NativeTabButtonCss(JobDetailTab.Actions)" role="tab" aria-selected="@IsNativeTabActive(JobDetailTab.Actions)" @onclick="@(() => SelectNativeTab(JobDetailTab.Actions))">
                    <i class="bi bi-card-checklist"></i>
                    <span>Actions</span>
                </button>

                @if (ShowDocumentsTab)
                {
                    <button type="button" class="@NativeTabButtonCss(JobDetailTab.Documents)" role="tab" aria-selected="@IsNativeTabActive(JobDetailTab.Documents)" @onclick="@(() => SelectNativeTab(JobDetailTab.Documents))">
                        <i class="bi bi-folder2-open"></i>
                        <span>Documents</span>
                    </button>
                }
            </div>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(JobDetailTab.Job))">

                    <div class="row">
                        <JobProgress @ref="jobProgressRef" DataObject="@editPage.dataObject" />
                    </div>

                    @if (_jobSummary is not null)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-md-3">
                                <div class="@GetJobSummaryCardCss(JobSummaryCardKind.CurrentStatus)">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Current status</div>
                                        <div class="fw-semibold">@SafeText(_jobSummary.CurrentStatusName, "Not set")</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="@GetJobSummaryCardCss(JobSummaryCardKind.OpenItems)">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Open items</div>
                                        <div class="fw-semibold">@_jobSummary.OpenMilestoneCount milestones · @_jobSummary.OpenActivityCount activities · @_jobSummary.OpenActionCount actions</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="@GetJobSummaryCardCss(JobSummaryCardKind.FinancialOverview)">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Financial overview</div>
                                        <div class="fw-semibold">@FormatCurrency(_jobSummary.FinancialOverview.InvoicedNet) invoiced / @FormatCurrency(_jobSummary.FinancialOverview.AgreedFeeIncludingCap)</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="@GetJobSummaryCardCss(JobSummaryCardKind.InvoiceRequests)">
                                    <div class="card-body py-2">
                                        <div class="text-muted small">Invoice requests</div>
                                        <div class="fw-semibold">@_jobSummary.PendingInvoiceRequestCount pending · @FormatCurrency(_jobSummary.FinancialOverview.InvoiceRequestPendingTotal)</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="row">
                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="RECORDSTATUS"
                                     OnActionCompleted="OnRecordStatusActionCompletedAsync"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus"
                                     ResyncDataObject="@editPage.ReSyncDataObject" TransientVirtualProperties="@TransientVirtualProperties" />

                    <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBCRITICALNOTES"
                                 OnActionCompleted="OnRecordStatusActionCompletedAsync"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus"
                                 ResyncDataObject="@editPage.ReSyncDataObject" TransientVirtualProperties="@TransientVirtualProperties" />

                        <FlexPropertyGroups @ref="@editPage.flexPropertyGroups"
                                            entityProperties="@editPage.entityProperties"
                                            entityPropertyGroups="@editPage.entityPropertyGroups"
                                            IsMainRecordContext="@IsMainRecordContext"
                                            FormHelper="@ActiveFormHelper"
                                            @bind-dataObject="@editPage.dataObject"
                                            RecordGuid="@RecordGuid"
                                            inputUpdated="@editPage.HandleInputUpdated" />
                    </div>

                    <div class="row">
                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOB_MEMOS"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />

                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBMEMOS"
                                     OnActionCompleted="RefreshJobProgress"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    </div>

            </section>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(JobDetailTab.Fees))">

                    @if (IsTabRequested(JobDetailTab.Fees))
                    {
@*                     @if (ShowReplacementInvoiceScheduleButton)
                    {
                        <div class="mb-2">
                            <button class="btn btn-primary"
                                    @onclick="CreateReplacementInvoiceScheduleAsync">
                                New Invoice Schedule
                            </button>
                        </div>
                    } *@
                    <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBFEES"
                                 OnActionCompleted="RefreshJobProgressAndInvoiceScheduleActions"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus"
                                 TransientVirtualProperties="@BuildInvoiceScheduleTransientVirtualProperties()" />

                    <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBFINANCEMEMO"
                                 OnActionCompleted="RefreshJobProgress"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    <div class="card shadow-sm mb-3">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <div>
                                <i class="bi bi-sliders me-2"></i>
                                Invoicing Mode
                            </div>
                            <span class="badge @GetModeBadgeCss(_currentMode)">
                                @GetModeLabel(_currentMode)
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="row align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label">Processing mode</label>
                                    <select class="form-select" @bind="_selectedMode">
                                        <option value="@InvoiceProcessingModeUi.Automated">Automated</option>
                                        <option value="@InvoiceProcessingModeUi.Manual">Manual</option>
                                        <option value="@InvoiceProcessingModeUi.Paused">Paused</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Reason (audit)</label>
                                    <input class="form-control" placeholder="Why are you changing the mode?"
                                           @bind="_modeChangeReason" />
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2">
                                <button type="button"
                                        class="btn btn-primary"
                                        @onclick="PromptModeChangeAsync"
                                        disabled="@(_selectedMode == _currentMode)">
                                    Apply mode change
                                </button>


                                <div class="text-muted small align-self-center">
                                    Changing mode is logged and auditable.
                                </div>
                            </div>
                        </div>
                    </div>

                    <DynamicGrid @ref="@gridRef" FormHelper="@ActiveFormHelper" GridCode="JOBINVOICEPROCMODEHISTORY"
                                OnActionCompleted = "RefreshJobProgress"
                                ParentGuid = "@RecordGuid"
                                ParentDataObjectReference = "@editPage.MyDataObjectReference"
                                ParentRowStatus = "@editPage.dataObject.RowStatus"
                                Disabled = "@(_currentMode == InvoiceProcessingModeUi.Paused || editPage.GetValueAsBool("CannotBeInvoiced"))"
                                DisabledMessage = "@GetInvoiceRequestsDisabledMessage()" TransientVirtualProperties = "@TransientVirtualProperties" />

                    <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBINVOICES"
                                 OnActionCompleted="RefreshJobProgress"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus"
                                 Disabled="@(_currentMode == InvoiceProcessingModeUi.Paused || editPage.GetValueAsBool("CannotBeInvoiced"))"
                                 DisabledMessage="@GetInvoiceRequestsDisabledMessage()" TransientVirtualProperties="@TransientVirtualProperties" />


                    <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBINVOICEREQUESTS"
                                 OnActionCompleted="OnInvoiceRequestsActionCompletedAsync"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus"
                                 Disabled="@(_currentMode == InvoiceProcessingModeUi.Paused || editPage.GetValueAsBool("CannotBeInvoiced"))"
                                 DisabledMessage="@GetInvoiceRequestsDisabledMessage()" TransientVirtualProperties="@TransientVirtualProperties" />


                    <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="PURCHASEORDERS"
                                 OnActionCompleted="RefreshJobProgress"
                                 ParentGuid="@RecordGuid"
                                 ParentDataObjectReference="@editPage.MyDataObjectReference"
                                 ParentRowStatus="@editPage.dataObject.RowStatus"
                                 DisabledMessage="@GetInvoiceRequestsDisabledMessage()" TransientVirtualProperties="@TransientVirtualProperties" />

                    @if (ShowSubContractorGrid)
                    {
                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="SUBCONTRACTOR"
                                     OnActionCompleted="RefreshJobProgress"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    }
                    }
                    else
                    {
                        @RenderLazyTabPlaceholder(JobDetailTab.Fees, "Fees")
                    }

            </section>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(JobDetailTab.ProjectDetails))">

                    <CymLazyRecordTab IsLoaded="@IsTabRequested(JobDetailTab.ProjectDetails)"
                                      Label="Project Details"
                                      OnLoadRequested="@(() => RequestTab(JobDetailTab.ProjectDetails))">
                        <div class="card shadow-sm">
                            <div class="card-header" style="background-color: #17a2b8; color:#ffffff;">
                                <i class="bi bi-info-circle" style="margin-right: 9px !important; color: #ffffff"></i>
                                Information
                            </div>
                            <div class="card-body">
                                <p class="card-text">
                                    Project Details are shared across all records linked to this project.
                                    Changes you make here will be visible on any Enquiry, Quote or Job for this project,
                                    even if they belong to a different Business Unit.
                                </p>
                            </div>
                        </div>

                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBPROJECTDIRECTORY"
                                     OnActionCompleted="RefreshJobProgress"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />

                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBKEYDATES"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    </CymLazyRecordTab>

            </section>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(JobDetailTab.Milestones))">

                    <CymLazyRecordTab IsLoaded="@IsTabRequested(JobDetailTab.Milestones)"
                                      Label="Milestones"
                                      OnLoadRequested="@(() => RequestTab(JobDetailTab.Milestones))">
                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBMILESTONES"
                                     OnActionCompleted="RefreshJobProgress"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    </CymLazyRecordTab>

            </section>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(JobDetailTab.Activity))">

                    <CymLazyRecordTab IsLoaded="@IsTabRequested(JobDetailTab.Activity)"
                                      Label="Activities"
                                      OnLoadRequested="@(() => RequestTab(JobDetailTab.Activity))">
                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBACTIVITY"
                                     OnActionCompleted="OnActivityActionCompletedAsync"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    </CymLazyRecordTab>

            </section>

            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(JobDetailTab.Actions))">

                    <CymLazyRecordTab IsLoaded="@IsTabRequested(JobDetailTab.Actions)"
                                      Label="Actions"
                                      OnLoadRequested="@(() => RequestTab(JobDetailTab.Actions))">
                        <DynamicGrid FormHelper="@ActiveFormHelper" GridCode="JOBACTIONS"
                                     OnActionCompleted="RefreshJobProgress"
                                     ParentGuid="@RecordGuid"
                                     ParentDataObjectReference="@editPage.MyDataObjectReference"
                                     ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                    </CymLazyRecordTab>

            </section>
            @if (ShowDocumentsTab)
{
            <section class="cb-native-tab-panel" role="tabpanel" hidden="@(!IsNativeTabActive(JobDetailTab.Documents))">


                    @if (IsTabRequested(JobDetailTab.Documents))
                    {
                    <ErrorBoundary @ref="_docsBoundary">
                        <ChildContent>
                            @* Only render when EditPage has actually loaded a real record *@
                            @if (ActiveFormHelper is null
                                                        || editPage is null
                                                        || editPage.dataObject is null
                                                        || string.IsNullOrWhiteSpace(editPage.dataObject.Guid)
                                                        || editPage.dataObject.Guid == Guid.Empty.ToString())
                            {
                                <div class="alert alert-info mb-0">
                                    Documents are loading...
                                </div>
                            }
                            else
                            {
                                <RecordDocumentBrowserV2 FormHelper="@ActiveFormHelper"
                                                       DataObject="editPage.dataObject"
                                                       EntityQueryGuid="a29deace-3166-451c-a1ec-0ddf84d0dfa0"
                                                             EntityTypeId="9"
                                                             EntityProperties="editPage.entityProperties"
                                                             EmailRecordNumberPropertyName="Number"
                                                             EmailRecordDescriptionPropertyName="JobDescription"
                                                             EmailRecordLocationPropertyName="FormattedAddressComma" />
                            }
                        </ChildContent>

                        <ErrorContent Context="ex">
                            <div class="alert alert-danger">
                                <strong>Documents tab crashed.</strong><br />
                                @ex.Message

                                <div class="mt-2">
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="RecoverDocumentsTab">Recover</button>
                                </div>
                            </div>
                        </ErrorContent>
                    </ErrorBoundary>

                    }
                    else
                    {
                        @RenderLazyTabPlaceholder(JobDetailTab.Documents, "Documents")
                    }

            </section>
            }
        </div>

        @if (_showConfirmModeChange)
        {
            <div class="cb-job-native-modal-backdrop"></div>
            <div class="cb-job-native-modal-shell" role="dialog" aria-modal="true" aria-labelledby="job-confirm-mode-title">
                <div class="cb-job-native-modal-card cb-job-native-modal-card-sm">
                    <div class="cb-job-native-modal-header">
                        <div>
                            <div id="job-confirm-mode-title" class="cb-job-native-modal-title">Confirm invoicing mode change</div>
                            <div class="cb-job-native-modal-subtitle">Review the change before applying it to this job.</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Close" @onclick="CloseConfirmModeChangeModal">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div class="cb-job-native-modal-body">
                        <p class="mb-2">
                            You are about to change this jobâ€™s invoicing mode to:
                            <strong>@GetModeLabel(_pendingNewMode)</strong>
                        </p>

                        <div class="alert alert-warning mb-0">
                            <strong>Warning:</strong>
                            Changing this affects whether invoice requests are generated automatically.
                        </div>
                    </div>
                    <div class="cb-job-native-modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelModeChange">
                            Cancel
                        </button>

                        <button type="button" class="btn btn-primary" @onclick="ConfirmModeChangeAsync">
                            Confirm
                        </button>
                    </div>
                </div>
            </div>
        }

        @if (_showPausedGeneratePrompt)
        {
            <div class="cb-job-native-modal-backdrop"></div>
            <div class="cb-job-native-modal-shell" role="dialog" aria-modal="true" aria-labelledby="job-paused-generate-title">
                <div class="cb-job-native-modal-card cb-job-native-modal-card-md">
                    <div class="cb-job-native-modal-header">
                        <div>
                            <div id="job-paused-generate-title" class="cb-job-native-modal-title">Invoicing is paused</div>
                            <div class="cb-job-native-modal-subtitle">Confirm whether invoice requests should still be generated.</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Close" @onclick="ClosePausedGeneratePrompt">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div class="cb-job-native-modal-body">
                        <p>
                            This jobâ€™s invoicing is paused.
                            There are <strong>@_pendingTriggerCount</strong> completed item(s) that could generate invoice requests.
                        </p>

                        <div class="alert alert-info mb-0">
                            â€œThis jobâ€™s invoicing is paused. Do you still want to generate an invoice request?â€
                        </div>
                    </div>
                    <div class="cb-job-native-modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelGenerateInvoicesWhilePaused">
                            No
                        </button>

                        <button type="button" class="btn btn-primary" @onclick="ConfirmGenerateInvoicesWhilePausedAsync">
                            Yes, generate invoice requests
                        </button>
                    </div>
                </div>
            </div>
        }
        @if (_showAutomationReenableModal)
        {
            <div class="cb-job-native-modal-backdrop"></div>
            <div class="cb-job-native-modal-shell cb-job-native-modal-shell-lg" role="dialog" aria-modal="true" aria-labelledby="job-automation-reenable-title">
                <div class="cb-job-native-modal-card cb-job-native-modal-card-lg">
                    <div class="cb-job-native-modal-header">
                        <div>
                            <div id="job-automation-reenable-title" class="cb-job-native-modal-title">Review invoicing schedule before re-enabling automation</div>
                            <div class="cb-job-native-modal-subtitle">Confirm the remaining pre-scheduled dates before automation is enabled.</div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-secondary" aria-label="Close" @onclick="CloseAutomationReenableModal">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>

                    <div class="cb-job-native-modal-body automation-modal-body">
                        <div class="alert alert-warning">
                            <strong>As Automation is being turned on whilst a Job is Active</strong>, you must ensure the remaining pre-scheduled dates are correct and expected.
                            <br /><br />
                            Once Automation is re-enabled, all past Invoice Requests not previously created will be processed at once potentially creating duplicates.
                            This includes any Manual Invoice requests created whilst in Manual / Paused mode.
                        </div>

                        @if (_loadingScheduleForAutomation)
                        {
                            <div class="d-flex justify-content-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                            </div>
                        }
                        else if (_jobInvoiceScheduleGuid == Guid.Empty)
                        {
                            <div class="alert alert-danger">
                                No invoicing schedule could be resolved for this job. Automation cannot be enabled.
                            </div>
                        }
                        else
                        {
                            <div class="border rounded p-2">
                                <InvoicingScheduleDetail @key="_jobInvoiceScheduleGuid"
                                                         @ref="_scheduleDetailRef"
                                                         RecordGuid="@_jobInvoiceScheduleGuid.ToString()"
                                                         ParentDataObjectReference="@editPage.MyDataObjectReference"
                                                         ReturnUrl=""
                                                         Windowed="true"
                                                         IsDetailWindowed="true"
                                                         HideDefaultActions="true"
                                                         BypassReadOnlyForAutomationReenable="true"
                                                         ScheduleReenabled="true"
                                                         TransientVirtualProperties="@TransientVirtualProperties" />
                            </div>
                        }
                    </div>

                    <div class="cb-job-native-modal-footer automation-modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelAutomationReenableAsync">
                            Cancelled - Manual Mode
                        </button>

                        <button type="button"
                                class="btn btn-primary"
                                @onclick="AcceptAutomationReenableAsync"
                                disabled="@(_loadingScheduleForAutomation || _jobInvoiceScheduleGuid == Guid.Empty)">
                            Accepted - Re-enable Automations
                        </button>
                    </div>
                </div>
            </div>
        }
    </FormBody>
</EditPage>

@code {

    [Parameter] public string? SerializedDataObjectReference { get; set; }
    [Parameter] public string? ModalId { get; set; }
    [Parameter] public EventCallback<DataObjectReference> ParentDataObjectReferenceChanged { get; set; }
    [Parameter] public EventCallback<Exception> OnError { get; set; }
    [Parameter] public bool IsDetailWindowed { get; set; } = false;
    [Parameter] public bool IsMainRecordContext { get; set; } = true;
    [Parameter] public Dictionary<string, Any> TransientVirtualProperties { get; set; } = new();

    public DynamicGrid gridRef { get; set; }

    private enum JobDetailTab
    {
        Job,
        Fees,
        ProjectDetails,
        Milestones,
        Activity,
        Actions,
        Documents
    }

    private readonly HashSet<JobDetailTab> _requestedTabs = new()
    {
        JobDetailTab.Job
    };

    private JobDetailTab _nativeActiveTab = JobDetailTab.Job;

    private void SelectNativeTab(JobDetailTab tab)
    {
        _nativeActiveTab = tab;
        RequestTab(tab);
    }

    private bool IsNativeTabActive(JobDetailTab tab) => _nativeActiveTab == tab;

    private string NativeTabButtonCss(JobDetailTab tab) =>
        IsNativeTabActive(tab) ? "cb-native-tab-button active" : "cb-native-tab-button";

    private void RequestTab(JobDetailTab tab)
    {
        if (_requestedTabs.Add(tab))
        {
            Console.WriteLine($"[CymBuildPerf] Layer=UI Method=JobDetail Step=TabRequested Tab={tab}");

            if (tab == JobDetailTab.Fees)
            {
                _ = RefreshReplacementInvoiceScheduleButtonAsync();
            }
        }
    }

    private bool IsTabRequested(JobDetailTab tab) => _requestedTabs.Contains(tab);

    private RenderFragment RenderLazyTabPlaceholder(JobDetailTab tab, string label) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "alert alert-light border d-flex align-items-center justify-content-between mb-0");

        builder.OpenElement(sequence++, "span");

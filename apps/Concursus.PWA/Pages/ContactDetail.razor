@page "/ContactDetail/{RecordGuid}/{SerializedDataObjectReference}/{ReturnUrl}"
@using Concursus.API.Client.Models
@using Google.Protobuf.WellKnownTypes
@using Newtonsoft.Json
@using System.Web
@using Concursus.API.Client
@inject Concursus.API.Client.Models.UserService userService
@inject Core.CoreClient CoreClient
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ModalService modalService

@inherits EditPageBase

@attribute [Authorize]

<EditPage @ref="@editPage"
          EntityTypeGuid="fbdcc47f-1d4e-4ad1-8de5-e08cd296fdfa"
          Windowed="@Windowed"
          @bind-RecordGuid="@RecordGuid"
          ModalId="@ModalId"
          @bind-ParentDataObjectReference="@ParentDataObjectReference"
          ReturnUrl="@ReturnUrl"
          CloseWindow="@CloseWindow"
          GridUpdated="@GridUpdated"
          IsDetailWindowed="IsDetailWindowed"
          IdentifyingFieldChanged="@OnIdentifyingFieldChanged"
          TransientVirtualProperties="@TransientVirtualProperties">
    <FormTitle>
        <i class="bi bi-briefcase-fill me-2" style="font-size: 1.2rem;"></i>
    </FormTitle>
    <FormBody>
        <div class="cb-native-tabstrip">
            <div class="cb-native-tab-list" role="tablist" aria-label="Contact detail tabs">
                <button type="button" class="@NativeTabButtonCss(0)" role="tab" aria-selected="@(_nativeActiveTab == 0)" @onclick="@(() => SelectNativeTab(0))">
                    <i class="bi bi-person-fill" aria-hidden="true"></i>
                    <span>Contact</span>
                </button>
                <button type="button" class="@NativeTabButtonCss(1)" role="tab" aria-selected="@(_nativeActiveTab == 1)" @onclick="@(() => SelectNativeTab(1))">
                    <i class="bi bi-calendar-week-fill" aria-hidden="true"></i>
                    <span>History</span>
                </button>
            </div>

            @if (ShouldRenderNativeTab(0))
            {
                <section class="cb-native-tab-panel" role="tabpanel" hidden="@(_nativeActiveTab != 0)">
                    @if (RecordGuid == Guid.Empty.ToString())
                    {
                        <div class="alert alert-info d-flex align-items-start mt-3" role="alert">
                            <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                            <div>
                                <strong>Before saving, check this isn't a duplicate.</strong>
                                Enter as many of <strong>Display Name</strong>, <strong>First Name</strong>, <strong>Surname</strong>
                                and <strong>Initials</strong> as you can, then click <strong>Validate</strong> above to check for
                                existing contacts. The more of these you fill in, the more accurate the result.
                            </div>
                        </div>
                    }
                    <FlexPropertyGroups @ref="@editPage.flexPropertyGroups"
                                        entityProperties="@editPage.entityProperties"
                                        entityPropertyGroups="@editPage.entityPropertyGroups"
                                        IsMainRecordContext="@IsMainRecordContext"
                                        dataObject="@editPage.dataObject"
                                        RecordGuid="@RecordGuid"
                                        inputUpdated="@editPage.HandleInputUpdated"
                                        ValidateAddressCallback="@ValidateAddress"/>

                    <DynamicGrid GridCode="CONTACTDETAILS" ParentDataObjectReference="@editPage.MyDataObjectReference" ParentGuid="@editPage.dataObject.Guid" ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                </section>
            }

            @if (ShouldRenderNativeTab(1))
            {
                <section class="cb-native-tab-panel" role="tabpanel" hidden="@(_nativeActiveTab != 1)">
                    <DynamicGrid GridCode="CONTACTJOBHISTORY" ParentDataObjectReference="@editPage.MyDataObjectReference" ParentGuid="@editPage.dataObject.Guid"
                                 ParentRowStatus="@editPage.dataObject.RowStatus" TransientVirtualProperties="@TransientVirtualProperties" />
                </section>
            }
        </div>

        @if (ShowAssetConfirmationModal)
        {
            <div class="shore-input-modal-backdrop"></div>
            <div class="shore-input-modal-shell" role="dialog" aria-modal="true">
                <div class="shore-input-modal-card dup-select-modal-card">
                    <div class="shore-input-modal-header">
                        <div class="shore-input-modal-title-wrap">
                            <div class="shore-input-modal-title">
                                <i class="bi bi-arrow-up-right-square"></i>
                                <span>Possible Contact Duplicates</span>
                            </div>
                        </div>

                        <div class="shore-input-modal-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-light"
                                    title="Close"
                                    @onclick="CloseModal">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="shore-input-modal-body dup-select-modal-body">

                        @if (HasDuplicateAssets)
                        {
                            <div class="alert alert-info small py-2 mb-2">
                                <i class="bi bi-info-circle me-1"></i>
                                Select a match below and click <strong>Use Selected</strong> to be taken to that contact
                                instead, where you can make any changes needed - or click <strong>Cancel</strong> if none match.
                            </div>

                            <div class="d-flex flex-row justify-content-around">
                                <ShoreLookupInput Value="@DuplicateSelection"
                                                  ValueChanged="@OnNativeLookupValueChangedAsync"
                                                  LoadItems="@LoadDuplicateValues"
                                                  Placeholder="Select possible duplicate"
                                                  ReadOnly="false"
                                                  IsInvalid="false"
                                                  CssClass="w-100" />
                                <button class="btn btn-outline-secondary" type="button" @onclick="HandleModelOnClick">
                                    <span class="bi bi bi-info-circle"></span>
                                </button>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-3">
                                <button type="button"
                                        class="btn btn-success"
                                        @onclick="DuplicatePresent">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Use Selected
                                </button>

                                <button type="button"
                                        class="btn btn-danger"
                                        @onclick="DuplicateNotPresent">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success small mb-3">
                                <i class="bi bi-check-circle me-2"></i>
                                <strong>No potential duplicates found.</strong><br />
                                The details you have entered do not closely match any existing contact records.
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button"
                                        class="btn btn-success"
                                        @onclick="DuplicateNotPresent">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Continue
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>


            @if (SecondaryModalIsVisible)
            {
                var informationComponentType = InformationPageComponentType;

                <!-- Secondary modal for inspecting asset records-->
                <div class="shore-input-modal-backdrop"></div>
                <div class="shore-input-modal-shell" role="dialog" aria-modal="true">
                    <div class="shore-input-modal-card">
                        <div class="shore-input-modal-header">
                            <div class="shore-input-modal-title-wrap">
                                <div class="shore-input-modal-title">
                                    <i class="bi bi-info-circle"></i>
                                    <span>"Information"</span>
                                </div>
                                @*
                                 <div class="shore-input-modal-subtitle">@PropertyName</div>
                            *@
                            </div>
                            <div class="shore-input-modal-actions">
                                <button type="button" class="btn btn-sm btn-outline-light" title="Maximise" @onclick="() => { SecondaryModalIsVisible = !SecondaryModalIsVisible; }">
                                    <i class="bi bi-arrows-fullscreen"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-light" title="Close" @onclick="() => { SecondaryModalIsVisible = !SecondaryModalIsVisible; }">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                        <div class="shore-input-modal-body">
                            @if (informationComponentType is not null)
                            {
                                <DynamicComponent Type="@informationComponentType" Parameters="@_detailPageParameters" />
                            }
                            else
                            {
                                <div class="alert alert-warning mb-0">
                                    Could not resolve information component: StructureDetail
                                </div>
                            }
                        </div>
                    </div>
                </div>


            }

        }

    </FormBody>
</EditPage>

@code {

    private int _nativeActiveTab;
    private readonly System.Collections.Generic.HashSet<int> _nativeVisitedTabs = new() { 0 };

    private void SelectNativeTab(int index)
    {
        _nativeActiveTab = index;
        _nativeVisitedTabs.Add(index);
    }

    private bool ShouldRenderNativeTab(int index) => _nativeVisitedTabs.Contains(index);

    private string NativeTabButtonCss(int index) =>
        _nativeActiveTab == index ? "cb-native-tab-button active" : "cb-native-tab-button";

    [Parameter]
    public string? SerializedDataObjectReference { get; set; }
    [Parameter] public string? ModalId { get; set; }
    [Parameter]
    public EventCallback<DataObjectReference> ParentDataObjectReferenceChanged { get; set; }
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }
    [Parameter] public bool IsDetailWindowed { get; set; } = false;
    [Parameter] public bool IsMainRecordContext { get; set; } = true;
    [Parameter]
    public Dictionary<string, Any> TransientVirtualProperties { get; set; } = new();


    private List<ComboDataItem> _duplicateItems = new();
    private Guid DuplicateSelection { get; set; }
    private bool ShowAssetConfirmationModal = false;
    private bool HasDuplicateAssets = false;
    private bool SecondaryModalIsVisible = false;
    private IDictionary<string, object> _detailPageParameters = new Dictionary<string, object>();
    private System.Type? InformationPageComponentType => ResolvePageComponentType("ContactDetail");
    private const string ContactEntityTypeGuid = "fbdcc47f-1d4e-4ad1-8de5-e08cd296fdfa";
    private const string DisplayNameGuid = "1152fb68-9edd-48bc-b761-2ff68facf795";
    private const string FirstNameGuid = "06bc5d95-30fc-4649-8621-6a998019b08e";
    private const string SurNameGuid = "f20537ad-ee04-41bc-b485-86c9f058a56e";
    private const string InitialsGuid = "95f95545-bbf6-4588-988a-215fe0efcda8";
    private bool _validationConfirmed = false;

    private bool NeedsValidation => Navigation.Uri.Contains("ContactDetail/00000000-0000-0000-0000-000000000000");

    // When a windowed duplicate-check modal is reloaded onto an existing record (see
    // DuplicatePresent), this component is still hosted by a DynamicComponent whose Parameters
    // dictionary was built once, for the original *new* record, and never updated. OnParametersSetAsync
    // below re-derives ParentDataObjectReference from that same stale SerializedDataObjectReference on
    // every parameter-set pass, so remembering the resolved record here and reasserting it last keeps
    // the swap from reverting.
    private string? _resolvedRecordGuid;
    private DataObjectReference? _resolvedParentDataObjectReference;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (ParentDataObjectReference != null)
            {
                ParentDataObjectReference = JsonConvert.DeserializeObject<DataObjectReference>(HttpUtility.UrlDecode(SerializedDataObjectReference) ?? string.Empty);
                //await ParentDataObjectReferenceChanged.InvokeAsync(ParentDataObjectReference);
            }

            if (_resolvedRecordGuid != null)
            {
                RecordGuid = _resolvedRecordGuid;
                ParentDataObjectReference = _resolvedParentDataObjectReference!;
            }

            await base.OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while setting the parameters for the Job Detail page.");
            ex.Data.Add("PageMethod", "JobDetail/OnParametersSetAsync()");
            _ = OnError.InvokeAsync(ex);
        }

    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            // Check this component's own RecordGuid, not the outer browser URL. When previewing a
            // duplicate match via the info (i) popup, this page is rendered inline with its own
            // RecordGuid for an *existing* record while the browser URL still points at the record
            // being created, so the URL-based check wrongly forced validation on the read-only
            // preview (CYB-312 QA feedback).
            if (!IsInformationPage && RecordGuid == Guid.Empty.ToString())
            {
                editPage.ValidationRequired();
            }
        }
        base.OnAfterRender(firstRender);
    }


    /// <summary>
    /// Helper function to extract the values from the input fields.
    /// </summary>
    /// <param name="any">Input field value as type Any (Google Protobuff)</param>
    /// <returns></returns>
    string? GetStringValue(Any? any)
    {
        if (any == null)
            return null;

        return any.Unpack<StringValue>().Value;
    }

    private Task<IReadOnlyList<ComboDataItem>> LoadDuplicateValues(string searchText)
    {
        var items = _duplicateItems
            .Where(x => string.IsNullOrWhiteSpace(searchText) ||
                        x.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase))
            .ToList();

        return Task.FromResult<IReadOnlyList<ComboDataItem>>(items);
    }


    /// <summary>
    /// Executes when the user finds a record that is a duplicate.
    /// Upon confirming, we redirect the user to the duplciate page.
    /// </summary>
    private async void DuplicatePresent()
    {

        if (DuplicateSelection == null || DuplicateSelection == Guid.Empty)
        {
            await JS.InvokeVoidAsync("alert", "No contact has been selected");
            return;
        }

        var parentDataObjectRef = new DataObjectReference(DuplicateSelection.ToString(), "fbdcc47f-1d4e-4ad1-8de5-e08cd296fdfa");

        //Prevent popup from appearing (e.g. you have changes...)
        editPage.SetHasChangesToFalse();

        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            "Your changes will be lost. Do you want to continue?"
        );

        if (!confirmed)
        {
            ShowAssetConfirmationModal = false;
            StateHasChanged();
            return;
        }

        if (Windowed)
        {
            // Loaded inside a modal: reload this same modal with the selected existing contact
            // instead of navigating the whole browser tab away from it.
            ShowAssetConfirmationModal = false;
            _resolvedRecordGuid = DuplicateSelection.ToString();
            _resolvedParentDataObjectReference = parentDataObjectRef;
            RecordGuid = _resolvedRecordGuid;
            ParentDataObjectReference = parentDataObjectRef;
            await editPage.ReloadRecordAsync(RecordGuid, parentDataObjectRef);
        }
        else
        {
            var serializeParentDataObjectReferenced = HttpUtility.UrlEncode(JsonConvert.SerializeObject(parentDataObjectRef));
            var returnUri = System.Web.HttpUtility.UrlEncode(Navigation.Uri);
            var url = $"ContactDetail/{DuplicateSelection.ToString()}/{serializeParentDataObjectReferenced}/{returnUri}";

            Navigation.NavigateTo(url, true);
        }

        StateHasChanged();
    }


    /// <summary>
    /// Describes what should happen when the given record is not present in the list.
    /// In this case, it should close the modal & update the validate button => "Validated"
    /// </summary>
    private void DuplicateNotPresent()
    {

        ShowAssetConfirmationModal = false;
        editPage.DataHasBeenValidated();
        editPage.flexPropertyGroups?.ChangeValidationBtnText("Validated", "btn btn-success");
        _validationConfirmed = true;

        StateHasChanged();
    }

    /// <summary>
    /// Re-arms the "Validate" button if any of the identifying name fields are edited after the
    /// contact was already confirmed via the duplicate-check modal, so the user can re-check.
    /// </summary>
    private void OnIdentifyingFieldChanged(Guid entityPropertyGuid)
    {
        var identifyingGuids = new[] { DisplayNameGuid, FirstNameGuid, SurNameGuid, InitialsGuid };
        var isIdentifyingField = identifyingGuids.Any(guid => entityPropertyGuid == new Guid(guid));

        if (!DuplicateCheckRevalidation.ShouldRearm(_validationConfirmed, isIdentifyingField, RecordGuid))
        {
            return;
        }

        _validationConfirmed = false;
        editPage.flexPropertyGroups?.ChangeValidationBtnText("Validate", "btn btn-primary");
        editPage.ValidationRequired();
    }


    /// <summary>
    /// Closes the confirmation modal.
    /// </summary>
    private void CloseModal()
    {
        ShowAssetConfirmationModal = false;
        StateHasChanged();
    }

    /// <summary>
    /// We use this function to inspect possible duplicate records in the dropdown.
    /// 
    /// </summary>
    protected void HandleModelOnClick()
    {

        if (SecondaryModalIsVisible) return; // Prevent modal from being re-registered

        var modalId = "";
        try
        {
            string serializeParentDataObjectReferenced = HttpUtility.UrlEncode(JsonConvert.SerializeObject(ParentDataObjectReference ?? new DataObjectReference("", ""))); ;
            if (ParentDataObjectReference == null || (ParentDataObjectReference.EntityTypeGuid == Guid.Empty)
                && ParentDataObjectReference.DataObjectGuid == Guid.Empty)
            {
                try
                {
                    ParentDataObjectReference = new DataObjectReference(DuplicateSelection.ToString(), ContactEntityTypeGuid);
                    serializeParentDataObjectReferenced = HttpUtility.UrlEncode(JsonConvert.SerializeObject(ParentDataObjectReference));
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex);
                }
            }
            //Get new ModalId, add it to Parameter and register it
            modalId = Guid.NewGuid().ToString();
            _detailPageParameters.Clear();
            _detailPageParameters.Add("EntityTypeGuid", ContactEntityTypeGuid);
            _detailPageParameters.Add("Windowed", true);
            _detailPageParameters.Add("CloseWindow", EventCallback.Factory.Create(this, CloseWindow));
            _detailPageParameters.Add("RecordGuid",
                PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(DuplicateSelection.ToString()).ToString());
            _detailPageParameters.Add("SerializedDataObjectReference", serializeParentDataObjectReferenced);
            _detailPageParameters.Add("ParentDataObjectReference", ParentDataObjectReference);
         
            //     EntityProperty); //this will be the Object that needs populating
            _detailPageParameters.Add("ReturnUrl", "");
            _detailPageParameters.Add("IsInformationPage", true);
            _detailPageParameters.Add("ModalId", modalId);

            modalService.RegisterModal(modalId, ParentDataObjectReference);

            SecondaryModalIsVisible = true;
        }
        catch (Exception ex)
        {
            ex.Data["MessageType"] = MessageDisplay.ShowMessageType.Error;
            ex.Data["AdditionalInfo"] = "Error in HandleModelOnClick().";
            ex.Data["PageMethod"] = "ShoreInput/HandleModelOnClick()";
            _ = OnError.InvokeAsync(ex);
        }
    }

    private static System.Type? ResolvePageComponentType(string? pageUri)
    {
        var trimmedPageUri = pageUri?.Trim();

        if (string.IsNullOrWhiteSpace(trimmedPageUri))
        {
            return null;
        }

        var candidates = new[]
        {
            trimmedPageUri,
            $"{trimmedPageUri}, Concursus.PWA",
            $"Concursus.PWA.Pages.{trimmedPageUri}",
            $"Concursus.PWA.Pages.{trimmedPageUri}, Concursus.PWA",
            $"Concursus.PWA.Shared.{trimmedPageUri}",
            $"Concursus.PWA.Shared.{trimmedPageUri}, Concursus.PWA"
        };

        foreach (var candidate in candidates)
        {
            var type = System.Type.GetType(candidate, throwOnError: false, ignoreCase: false);

            if (type is not null)
            {
                return type;
            }
        }

        return AppDomain.CurrentDomain
            .GetAssemblies()
            .Select(assembly => assembly.GetType($"Concursus.PWA.Pages.{trimmedPageUri}", throwOnError: false, ignoreCase: false)
                             ?? assembly.GetType($"Concursus.PWA.Shared.{trimmedPageUri}", throwOnError: false, ignoreCase: false)
                             ?? assembly.GetType(trimmedPageUri, throwOnError: false, ignoreCase: false))
            .FirstOrDefault(type => type is not null);
    }

    private Task OnNativeLookupValueChangedAsync(Guid value)
    {
        DuplicateSelection = value;
        return Task.CompletedTask;
    }


    private async Task<bool> ValidateAddress()
    {
        try
        {
            //Entity props to extract.
            string DisplayNameGuid  = "1152fb68-9edd-48bc-b761-2ff68facf795";
            string FirstNameGuid    = "06bc5d95-30fc-4649-8621-6a998019b08e";
            string SurNameGuid     = "f20537ad-ee04-41bc-b485-86c9f058a56e";
            string InitiaGuid       = "95f95545-bbf6-4588-988a-215fe0efcda8";


            var _formHelper = new API.Client.FormHelper(CoreClient, PWAFunctions.ParseAndReturnEmptyGuidIfInvalid(RecordGuid).ToString(), userService);
            
            var DisplayName = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == DisplayNameGuid).FirstOrDefault().Value) ?? "";
            var FirstName   = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == FirstNameGuid).FirstOrDefault().Value) ?? "";
            var SurName    = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == SurNameGuid).FirstOrDefault().Value) ?? "";
            var Initials    = GetStringValue(editPage.dataObject.DataProperties.Where(x => x.EntityPropertyGuid == InitiaGuid).FirstOrDefault().Value) ?? "";


            //Check if any value has been entered at all.
            if (new[]
            {
                DisplayName,
                FirstName,
                SurName,
                Initials

            }.All(string.IsNullOrEmpty))
            {
                await JS.InvokeVoidAsync("alert", "Please, enter details before validating.");
                return false;
            }

            //Get possible list of duplicates.
            var duplicates = await _formHelper.DuplicateContactsGet(DisplayName, FirstName, SurName, Initials);

            _duplicateItems = duplicates?.Duplicates
                 .Select(x => new ComboDataItem(
                     new DropDownDataListItem
                     {
                         Value = x.Guid,
                         Name = x.DisplayName
                     }))
                 .ToList() ?? new List<ComboDataItem>();

            HasDuplicateAssets = _duplicateItems.Count > 0;

            //Disable the save button until the user confirms via the modal.
            editPage.ValidationRequired();

            ShowAssetConfirmationModal = true;
            StateHasChanged();

            //Modal drives the final "Validated" state via DuplicatePresent/DuplicateNotPresent.
            return false;
        }
        catch (Exception ex)
        {
            await HandleErrorAsync(ex, "PropertyDetail/ValidateAddress()");
            return false;
        }
    }

    private async Task HandleErrorAsync(Exception ex, string method)
    {
        ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
        ex.Data.Add("AdditionalInfo", "An error occurred while processing the request. Please try again later.");
        ex.Data.Add("PageMethod", method);
        await OnError.InvokeAsync(ex);
    }

}

    private async Task OnInvoiceScheduleDataObjectLoadedAsync(Concursus.API.Core.DataObject loadedDataObject)
    {
        try
        {
            ApplyScheduleReenabledFlagToLoadedDataObject();
            ShowCorrectInvoiceSchedulingGrid();
            ShouldDisableNewButton();

            if (ShowMonthBreakDownGrid || ShowPercentageBreakDownGrid)
            {
                QueueTotalsRefreshIfNeeded();
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while preparing the invoice schedule child grids.");
            ex.Data.Add("PageMethod", "InvoicingScheduleDetail/OnInvoiceScheduleDataObjectLoadedAsync()");
            _ = OnError.InvokeAsync(ex);
        }
    }

    /// <summary>
    /// Extracts the set configuration from the dropdown (Invoicing Structure)
    /// and shows the appropriate grid.
    /// </summary>
    private void ShowCorrectInvoiceSchedulingGrid()
    {
        const string MonthlyTriggerType = "1a6296d5-6f78-4692-9acb-895ba1e7e9bb";
        const string PercentageTriggerType = "3f5d1de2-05cf-47ed-9e0d-af56cc6cead0";

        var dataObject = editPage?.dataObject;
        if (dataObject?.DataProperties == null)
        {
            return;
        }

        var triggerTypeProperty = dataObject.DataProperties
            .FirstOrDefault(x => string.Equals(x.EntityPropertyGuid, InvoiceScheduleTriggerTypePropertyGuid.ToString(), StringComparison.OrdinalIgnoreCase));

        var triggerTypeValue = ReadAnyAsString(triggerTypeProperty?.Value);
        var normalisedTrigger = NormaliseTriggerValue(triggerTypeValue);

        var shouldShowMonthly =
            string.Equals(normalisedTrigger, MonthlyTriggerType, StringComparison.OrdinalIgnoreCase)
            || normalisedTrigger.Contains("monthly", StringComparison.OrdinalIgnoreCase)
            || normalisedTrigger.Contains("month", StringComparison.OrdinalIgnoreCase);

        var shouldShowPercentage =
            string.Equals(normalisedTrigger, PercentageTriggerType, StringComparison.OrdinalIgnoreCase)
            || normalisedTrigger.Contains("percentage", StringComparison.OrdinalIgnoreCase)
            || normalisedTrigger.Contains("percent", StringComparison.OrdinalIgnoreCase);

        var updated = false;

        if (!shouldShowMonthly && ShowMonthBreakDownGrid)
        {
            ShowMonthBreakDownGrid = false;
            updated = true;
        }

        if (!shouldShowPercentage && ShowPercentageBreakDownGrid)
        {
            ShowPercentageBreakDownGrid = false;
            updated = true;
        }

        if (ShowMonthBreakDownGrid != shouldShowMonthly)
        {
            ShowMonthBreakDownGrid = shouldShowMonthly;
            updated = true;
        }

        if (ShowPercentageBreakDownGrid != shouldShowPercentage)
        {
            ShowPercentageBreakDownGrid = shouldShowPercentage;
            updated = true;
        }

        if (!shouldShowMonthly && !shouldShowPercentage)
        {
            _lastTotalsInvoiceScheduleGuid = null;
            _totals = new InvoiceScheduleConfigurationTotalsModel();
        }

        if (updated)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleInvoiceScheduleInputUpdatedAsync(InputUpdatedArgs inputUpdatedArgs)
    {
        try
        {
            if (editPage is not null)
            {
                await editPage.HandleInputUpdated(inputUpdatedArgs);
            }

            ShowCorrectInvoiceSchedulingGrid();
            ShouldDisableNewButton();

            if (inputUpdatedArgs.EntityId == InvoiceScheduleTriggerTypePropertyGuid)
            {
                _lastTotalsInvoiceScheduleGuid = null;

                if (ShowMonthBreakDownGrid || ShowPercentageBreakDownGrid)
                {
                    QueueTotalsRefreshIfNeeded();
                }
                else
                {
                    _totals = new InvoiceScheduleConfigurationTotalsModel();
                }
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            ex.Data.Add("MessageType", MessageDisplay.ShowMessageType.Error);
            ex.Data.Add("AdditionalInfo", "An error occurred while updating the invoice schedule form.");
            ex.Data.Add("PageMethod", "InvoicingScheduleDetail/HandleInvoiceScheduleInputUpdatedAsync()");
            _ = OnError.InvokeAsync(ex);
        }
    }

    private async Task ApplyScheduleReenabledFlagToLoadedDataObjectAsync(bool markAsChanged)
    {
        if (!ApplyScheduleReenabledFlagToLoadedDataObject() || !markAsChanged)
        {
            return;
        }

        var packedValue = Any.Pack(new BoolValue { Value = true });
        await editPage.HandleInputUpdated(new InputUpdatedArgs
        {
            EntityId = ScheduleReenabledPropertyGuid,
            NewValue = packedValue
        });
    }

    private bool ApplyScheduleReenabledFlagToLoadedDataObject()
    {
        if (!ScheduleReenabled)
        {
            return false;
        }

        var dataObject = editPage?.dataObject;
        if (dataObject?.DataProperties == null)
        {
            return false;
        }

        var scheduleReenabledProperty = dataObject.DataProperties
            .FirstOrDefault(x => string.Equals(x.EntityPropertyGuid, ScheduleReenabledPropertyGuid.ToString(), StringComparison.OrdinalIgnoreCase));

        if (scheduleReenabledProperty == null)
        {
            return false;
        }

        if (ReadAnyAsBool(scheduleReenabledProperty.Value))
        {
            return false;
        }

        scheduleReenabledProperty.Value = Any.Pack(new BoolValue { Value = true });
        return true;
    }

    private static bool ReadAnyAsBool(Any? value)
    {
        if (value is null)
        {
            return false;
        }

        if (value.Is(BoolValue.Descriptor))
        {
            return value.Unpack<BoolValue>().Value;
        }

        if (value.Is(StringValue.Descriptor))
        {
            return bool.TryParse(value.Unpack<StringValue>().Value, out var parsed) && parsed;
        }

        if (value.Is(Int32Value.Descriptor))
        {
            return value.Unpack<Int32Value>().Value != 0;
        }

        if (value.Is(Int64Value.Descriptor))
        {
            return value.Unpack<Int64Value>().Value != 0;
        }

        return false;
    }

    private static string ReadAnyAsString(Any? value)
    {
        if (value is null)
        {
            return string.Empty;
        }

        if (value.Is(StringValue.Descriptor))
        {
            return value.Unpack<StringValue>().Value?.Trim() ?? string.Empty;
        }

        if (value.Is(Int32Value.Descriptor))
        {
            return value.Unpack<Int32Value>().Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }

        if (value.Is(Int64Value.Descriptor))
        {
            return value.Unpack<Int64Value>().Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        }

        if (value.Is(BoolValue.Descriptor))
        {
            return value.Unpack<BoolValue>().Value.ToString();
        }

        return value.ToString();
    }

    private static string NormaliseTriggerValue(string? value)
    {
        return (value ?? string.Empty)
            .Trim()
            .Trim('{', '}')
            .ToLowerInvariant();
    }
    /// <summary>
    /// Hides the "New" button for the grid - based on the "IsEnabled" prop for the field "Name".
    /// </summary>
    private void ShouldDisableNewButton()
    {
        const string NameFieldGuid = "e770228e-e75a-4a36-bd58-5ebdd365f234";

        if (BypassReadOnlyForAutomationReenable || CanAmendAutomatedMonthlyDrawdowns)
        {
            DisableNewButton = false;
            return;
        }

        var nameField = editPage.dataObject.DataProperties
            .FirstOrDefault(x => x.EntityPropertyGuid == NameFieldGuid);

        DisableNewButton = nameField?.IsReadOnly == true;
    }

    public Task SaveAndExitAsync()
    {
        return editPage.SaveAndExitAsync();
    }

    public async Task SaveAndExitForAutomationReenableAsync()
    {
        await ApplyScheduleReenabledFlagToLoadedDataObjectAsync(markAsChanged: true);
        await editPage.SaveAndExitAsync();
    }

    public Task CancelAndExitAsync()
    {
        return editPage.CancelAndExitAsync();
    }
}

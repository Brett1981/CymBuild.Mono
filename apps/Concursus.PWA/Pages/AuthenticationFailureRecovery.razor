@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

<div class="container py-4" role="alert" aria-live="assertive">
    <h2>@Heading</h2>

    <p>@StatusMessage</p>

    @if (_navigationStarted)
    {
        <p role="status">Opening a fresh Microsoft sign-in session…</p>
    }
    else
    {
        <button type="button"
                class="btn btn-primary"
                @onclick="SignInAgainAsync">
            Sign in again
        </button>
    }

    @if (!_isRecoverableFailure && !string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <details class="mt-3">
            <summary>Technical sign-in details</summary>
            <pre class="mt-2 text-wrap">@ErrorMessage</pre>
        </details>
    }
</div>

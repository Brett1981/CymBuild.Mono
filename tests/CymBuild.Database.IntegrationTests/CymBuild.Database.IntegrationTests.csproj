    <ProjectReference Include="..\..\services\Concursus.API\Concursus.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Update="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageReference Update="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Update="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
